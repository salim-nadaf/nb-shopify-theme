{% comment %} NIAMAT BIRYANI — Delivery Areas Section {% endcomment %}

<section class="nb-section">
  <div class="nb-container">
    <div class="nb-delivery-card">
      <div class="nb-delivery-icon">📍</div>
      <h2 class="nb-section-title">{{ section.settings.heading | default: "Where We Deliver" }}</h2>
      <p class="nb-section-desc">{{ section.settings.subheading | default: "Serving Kalyan and selected nearby areas. Delivery availability and charges are confirmed during checkout based on your location." }}</p>

      <div class="nb-area-pills">
        <span class="nb-area-pill">Kalyan West</span>
        <span class="nb-area-pill">Kalyan East</span>
        <span class="nb-area-pill">Khadakpada</span>
        <span class="nb-area-pill">Adharwadi</span>
        <span class="nb-area-pill">Shahad</span>
        <span class="nb-area-pill">Dombivli (Select Areas)</span>
      </div>

      <button type="button" class="nb-btn-gold" onclick="nbCheckDeliveryModal()">Check Delivery Availability</button>
    </div>
  </div>
</section>

<!-- Delivery Modal -->
<div id="nb-delivery-modal" class="nb-modal-overlay">
  <div class="nb-modal-box">
    <button type="button" class="nb-modal-close" onclick="nbCloseDeliveryModal()">×</button>
    <h3>📍 Delivery Coverage</h3>
    <p>We deliver freshly prepared Dum Biryani across:</p>
    <ul class="nb-modal-list">
      <li>✓ Kalyan West (30–45 mins)</li>
      <li>✓ Kalyan East (35–50 mins)</li>
      <li>✓ Khadakpada & Adharwadi (30–40 mins)</li>
      <li>✓ Shahad & Titwala Road (40–60 mins)</li>
      <li>✓ Dombivli (Select Pincodes)</li>
    </ul>
    <p class="nb-modal-note">Exact delivery time & fee confirmed automatically at checkout.</p>
    <button type="button" class="nb-btn-gold nb-btn-full" onclick="nbCloseDeliveryModal()">Got it!</button>
  </div>
</div>

<style>
.nb-delivery-card { background: #FFF; border: 1px solid rgba(200, 146, 42, 0.2); border-radius: 20px; padding: 32px 20px; text-align: center; max-width: 680px; margin: 0 auto; }
.nb-delivery-icon { font-size: 2.5rem; margin-bottom: 8px; }
.nb-area-pills { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 18px 0 24px; }
.nb-area-pill { font-size: 0.78rem; font-weight: 600; background: rgba(200, 146, 42, 0.1); color: #2C1810; padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(200, 146, 42, 0.2); }

.nb-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; }
.nb-modal-overlay.active { display: flex; }
.nb-modal-box { background: #FFFDF7; border: 1px solid #C8922A; border-radius: 18px; padding: 24px; max-width: 420px; width: 100%; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
.nb-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 1.6rem; color: #2C1810; cursor: pointer; line-height: 1; }
.nb-modal-box h3 { font-size: 1.2rem; font-weight: 800; color: #2C1810; margin: 0 0 8px; }
.nb-modal-box p { font-size: 0.85rem; color: #7A5C4A; margin: 0 0 12px; }
.nb-modal-list { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 8px; font-size: 0.84rem; font-weight: 600; color: #2C1810; }
.nb-modal-note { font-size: 0.78rem !important; font-style: italic; color: #C8922A !important; }
</style>

<script>
function nbCheckDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.add('active');
}
function nbCloseDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.remove('active');
}
</script>

{% schema %}
{
  "name": "📍 Delivery Areas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where We Deliver"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Serving Kalyan and selected nearby areas. Delivery availability and charges are confirmed during checkout based on your location."
    }
  ],
  "presets": [
    {
      "name": "📍 Delivery Areas"
    }
  ]
}
{% endschema %}
