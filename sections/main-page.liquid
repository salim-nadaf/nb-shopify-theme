

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% liquid
      assign ph = page.handle | downcase
      assign pt = page.title | downcase
      assign rp = request.path | downcase
    %}
    {% if ph contains 'contact' or pt contains 'contact' or rp contains 'contact' %}
      {% render 'nb-contact-snippet' %}
    {% elsif ph contains 'about' or pt contains 'about' or pt contains 'story' or rp contains 'about' or rp contains 'story' %}
      {% render 'nb-our-story-snippet' %}
    {% elsif ph contains 'family' or pt contains 'family' or ph contains 'feast' or pt contains 'feast' or ph contains 'pre-order' or pt contains 'pre-order' or rp contains 'family' or rp contains 'feast' %}
      {% render 'nb-family-orders-snippet' %}
    {% elsif ph contains 'bulk' or pt contains 'bulk' or ph contains 'catering' or pt contains 'catering' or rp contains 'bulk' or rp contains 'catering' %}
      {% render 'nb-bulk-orders-snippet' %}
    {% elsif ph contains 'calculator' or pt contains 'calculator' or rp contains 'calculator' %}
      {% render 'nb-biryani-calculator-snippet' %}
    {% elsif ph contains 'account' or pt contains 'account' or ph contains 'profile' or pt contains 'profile' or ph contains 'order' or pt contains 'order' %}
      {% render 'nb-account-snippet' %}
    {% elsif ph contains 'shipping' or pt contains 'shipping' or ph contains 'delivery' or pt contains 'delivery' or rp contains 'shipping' or rp contains 'delivery' %}
      {% render 'nb-shipping-snippet' %}
    {% else %}
      {% if page.content != blank %}
        <div class="rte">
          {{ page.content }}
        </div>
      {% endif %}
    {% endif %}

    <!-- FULL THEME EDITOR APP BLOCKS & CUSTOM FORM BLOCKS SUPPORT -->
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
