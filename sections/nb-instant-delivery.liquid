</style>

<script>
(function() {
  function initInstantDelivery() {
    document.querySelectorAll('.nb-variant-selector').forEach(function(selector) {
      var productId = selector.dataset.productId;
      selector.querySelectorAll('.nb-variant-pill').forEach(function(pill) {
        if (pill.dataset.bound) return;
        pill.dataset.bound = 'true';

        pill.addEventListener('click', function() {
          selector.querySelectorAll('.nb-variant-pill').forEach(function(p) { p.classList.remove('active'); });
          pill.classList.add('active');
          var variantId = pill.dataset.variantId;
          var price = pill.dataset.price;
          var available = pill.dataset.available === 'true';

          var input = document.querySelector('.nb-variant-input[data-product="' + productId + '"]');
          if (input) input.value = variantId;

          var priceEl = document.querySelector('[data-price-display="' + productId + '"]');
          if (priceEl) priceEl.textContent = price;

          var form = document.querySelector('.nb-quick-form[data-form="' + productId + '"]');
          if (form) {
            var btn = form.querySelector('button');
            if (!available) {
              btn.textContent = 'Sold Out';
              btn.disabled = true;
              btn.className = 'nb-btn nb-btn--disabled nb-btn--sm';
            } else {
              btn.textContent = 'Order Now';
              btn.disabled = false;
              btn.className = 'nb-btn nb-btn--gold nb-btn--sm';
            }
          }
        });
      });
    });
  }

  function initTrialProduct() {
    var trialInput = document.getElementById('nb-trial-variant-input');
    if (trialInput && (!trialInput.value || trialInput.value === '')) {
      fetch('/products.json')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.products) {
            var p = data.products.find(function(item) {
              var t = (item.title || '').toLowerCase();
              return t.includes('trial') || t.includes('99');
            });
            if (p && p.variants && p.variants.length > 0) {
              trialInput.value = p.variants[0].id;
              var form = document.getElementById('nb-trial-add-form');
              if (form) form.dataset.product = p.id;
            }
          }
        })
        .catch(function() {});
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initInstantDelivery();
      initTrialProduct();
    });
  } else {
    initInstantDelivery();
    initTrialProduct();
  }
})();
</script>

