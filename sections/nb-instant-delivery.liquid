{% comment %} NIAMAT BIRYANI — Instant Delivery Section with ₹99 Trial Hero {% endcomment %}
{% render 'food-card-styles' %}

{% liquid
  assign is_instant_enabled = settings.nb_instant_delivery_enabled
  if shop.metafields.niamat.instant_delivery_enabled != blank
    if shop.metafields.niamat.instant_delivery_enabled == false or shop.metafields.niamat.instant_delivery_enabled == 'false'
      assign is_instant_enabled = false
    else
      assign is_instant_enabled = true
    endif
  endif

  assign trial_prod = all_products[section.settings.trial_product]
  if trial_prod == blank
    assign trial_prod = all_products['99-new-customer-trial-biryani']
  endif
  if trial_prod == blank
    assign trial_prod = all_products['new-customer-trial-biryani']
  endif
  if trial_prod == blank
    assign trial_prod = all_products['trial-biryani']
  endif

  assign trial_variant = trial_prod.selected_or_first_available_variant | default: trial_prod.variants.first

  assign trial_img_url = 'https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=600'
%}

<div class="nb-instant-section">

  <!-- ===== 1. ₹99 BIRYANI SPECIAL TRIAL OFFER HERO SECTION ===== -->
  <section class="nb-trial-hero" aria-labelledby="nb-trial-heading">
    <div class="nb-trial-card">
      <div class="nb-diet-corner-badge" aria-hidden="true" style="display: inline-flex; gap: 4px;">
        {% render 'nb-diet-icon', diet: 'veg' %}
        {% render 'nb-diet-icon', diet: 'nonveg' %}
      </div>
      <div class="nb-trial-card__inner">
        
        <!-- Left / Content Area -->
        <div class="nb-trial-content">
          <!-- Small Badge -->
          <div class="nb-trial-badge">
            <span>{{ section.settings.trial_badge_text | default: '🍽️ SPECIAL TRIAL OFFER' }}</span>
          </div>

          <!-- Main Headline -->
          <h1 id="nb-trial-heading" class="nb-trial-title">
            {{ section.settings.trial_heading_prefix | default: 'TRY NIAMAT BIRYANI FOR' }} <span class="nb-trial-price-highlight">{{ section.settings.trial_price | default: '₹99' }}</span>
          </h1>

          <!-- Supporting Headline -->
          <p class="nb-trial-subtitle">
            {{ section.settings.trial_subheading | default: 'Your first taste of Biryani Palace by Niamat — at a special introductory price.' }}
          </p>

          <!-- Price & Preference Display -->
          <div class="nb-trial-price-container">
            <div class="nb-trial-price-display">
              <span class="nb-trial-price-main">{{ section.settings.trial_price | default: '₹99' }}</span>
              <span class="nb-trial-price-badge-intro">Special Trial Offer</span>
            </div>
            <div class="nb-trial-portion-subtext" style="display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap;">
              <span style="display: inline-flex; gap: 3px; align-items: center;">
                {% render 'nb-diet-icon', diet: 'veg' %}
                {% render 'nb-diet-icon', diet: 'nonveg' %}
              </span>
              <span><strong>Veg or Non-Veg:</strong> Please mention your choice on WhatsApp</span>
            </div>
          </div>

          <!-- Supporting Copy -->
          <p class="nb-trial-copy">
            Available in both Vegetarian and Chicken Non-Veg options. After placing your order, simply message us your preference on WhatsApp.
          </p>

          <!-- CTA Area: Submits to Cart Directly via AJAX Quick-Form -->
          <div class="nb-trial-cta-block">
            <form action="/cart/add" method="post" class="nb-quick-form nb-trial-quick-form" id="nb-trial-add-form" data-form="{{ trial_prod.id }}">
              <input type="hidden" name="id" value="{{ trial_variant.id }}" id="nb-trial-variant-input" />
              <input type="hidden" name="quantity" value="1" />
              <button type="submit" class="nb-trial-btn" id="nb-trial-cta-button">
                {{ section.settings.trial_cta_text | default: 'GET YOUR ₹99 BIRYANI' }}
              </button>
            </form>
          </div>
        </div>

        <!-- Right / Image Area -->
        <div class="nb-trial-visual">
          <div class="nb-trial-img-wrap">
            <img
              src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=600"
              alt="Biryani Palace by Niamat Kalyan — ₹99 Special Trial Biryani (Veg & Non-Veg Available)"
              width="360"
              height="260"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="nb-trial-img"
              style="aspect-ratio: 360 / 260; object-fit: cover;"
            />
            <span class="nb-trial-img-badge">🍲 Dum Cooked & Tasty</span>
          </div>
          <div class="nb-trial-trust-pills">
            <span>⚡ Dum Cooked Fresh</span>
            <span>📍 Kalyan Delivery</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Transition to Regular Menu -->
    <div class="nb-trial-transition" id="nb-regular-portions-menu">
      <div class="nb-transition-divider"></div>
      <div class="nb-transition-content">
        <h2 class="nb-transition-heading">Looking for a regular portion?</h2>
        <p class="nb-transition-subheading">Single • Double • Half Kg &amp; more</p>
      </div>
    </div>
  </section>

  <!-- ===== 2. EXISTING REGULAR MENU HEADER & BANNER ===== -->
  <div class="nb-section-header">
    <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
      <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #2C1810;">⚡ Instant Delivery</h3>
      {% render 'nb-instant-delivery-status' %}
    </div>
    <p>Freshly prepared biryani & starters · Ready in 30–60 minutes · Kalyan & Nearby</p>

    {% unless is_instant_enabled %}
      <div class="nb-instant-off-banner" style="max-width: 680px; margin: 16px auto 0; padding: 20px 24px; background: #FFF3E0; border: 1px solid #FFE0B2; border-left: 4px solid #E65100; border-radius: 16px; text-align: center;">
        <div style="font-weight: 800; font-size: 1.05rem; color: #C62828; margin-bottom: 6px;">
          🔴 Instant Delivery Currently Unavailable
        </div>
        <p style="font-size: 0.92rem; color: #5C4033; margin: 0 0 14px;">
          {{ settings.nb_instant_delivery_off_msg | default: "Online delivery is temporarily paused. We'll be back soon — thank you for your patience!" }}
        </p>
        <a href="{{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' }}" class="nb-btn nb-btn--gold" style="display: inline-block;">
          📅 Choose a Scheduled / Pre-Order
        </a>
      </div>
    {% endunless %}
  </div>

  {% liquid
    assign instant_collection = collection
    if instant_collection == blank or instant_collection.products.size == 0
      assign instant_collection = collections['instant-delivery']
    endif
    if instant_collection == blank or instant_collection.products.size == 0
      assign instant_collection = collections['all']
    endif
  %}

  <div class="nb-food-grid">
    {% if instant_collection != blank and instant_collection.products.size > 0 %}
      <!-- 1. FEATURED MEALS FIRST (FULL-WIDTH AT TOP) -->
      {% for product in instant_collection.products %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'meal' or title_lower contains 'meals' or title_lower contains 'combo' %}
          {% liquid
            assign first_variant = product.selected_or_first_available_variant
            assign is_available = first_variant.available
            assign item_badge = 'Featured Meal'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '👑'
          %}
          <div class="nb-food-card nb-food-card--meal {% unless is_available %}nb-food-card--soldout{% endunless %}">
            <div class="nb-food-card__header-row">
              <div class="nb-food-card__image">
                {% if product.featured_media %}
                  <img src="{{ product.featured_media | image_url: width: 240, format: 'webp' }}"
                       alt="{{ product.featured_media.alt | default: product.title | escape }}"
                       width="120" height="120" loading="lazy" decoding="async" style="aspect-ratio: 1 / 1;" />
                {% else %}
                  <div class="nb-food-card__image-placeholder">🍛</div>
                {% endif %}
                <span class="nb-badge {{ badge_class }}">{{ badge_icon }} {{ item_badge }}</span>
              </div>

              <!-- Mobile Top Row Title & Description -->
              <div class="nb-food-card__intro nb-mobile-only-intro">
                <h3 class="nb-food-card__title">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="nb-food-card__desc">{{ product.description | strip_html }}</p>
                {% endif %}
              </div>
            </div>

            <div class="nb-food-card__actions">
              <!-- Desktop Right Column Title & Description -->
              <div class="nb-food-card__intro nb-desktop-only-intro">
                <h3 class="nb-food-card__title">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="nb-food-card__desc">{{ product.description | strip_html }}</p>
                {% endif %}
              </div>

              {% if product.variants.size > 1 %}
                <div class="nb-variant-selector" data-product-id="{{ product.id }}">
                  {% for variant in product.variants %}
                    <span class="nb-variant-pill {% if forloop.first %}active{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-price="{{ variant.price | money }}"
                          data-available="{{ variant.available }}">
                      <span class="nb-pill-diet-tag" style="margin-right: 8px; display: inline-flex; flex-shrink: 0; align-items: center;">
                        {% render 'nb-diet-icon', title: variant.title %}
                      </span>
                      <span class="nb-pill-text">{{ variant.title }}</span>
                    </span>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="nb-food-card__bottom">
                <span class="nb-food-card__price" data-price-display="{{ product.id }}">
                  {{ first_variant.price | money }}
                </span>
                {% if is_available %}
                  {% if is_instant_enabled %}
                    <form action="/cart/add" method="post" class="nb-quick-form" data-form="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ first_variant.id }}" class="nb-variant-input" data-product="{{ product.id }}" />
                      <input type="hidden" name="quantity" value="1" />
                      <button type="submit" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
                    </form>
                  {% else %}
                    <a href="{{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' }}" class="nb-btn nb-btn--gold nb-btn--sm" style="font-size: 0.78rem;">📅 Pre-Order</a>
                  {% endif %}
                {% else %}
                  <button type="button" class="nb-btn nb-btn--disabled nb-btn--sm" disabled>Sold Out</button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <!-- 2. ALL OTHER PRODUCTS -->
      {% for product in instant_collection.products %}
        {% assign title_lower = product.title | downcase %}
        {% unless title_lower contains 'meal' or title_lower contains 'meals' or title_lower contains 'combo' %}
          {% liquid
            assign first_variant = product.selected_or_first_available_variant
            assign is_available = first_variant.available
          %}
          {% liquid
            assign item_badge = ''
            assign badge_class = ''
            assign badge_icon = ''

            if title_lower contains 'hyderabadi mutton dum'
              assign item_badge = 'Popular'
              assign badge_class = 'nb-tag--popular'
              assign badge_icon = '🔥'
            elsif title_lower contains 'gosht-e-dum' or title_lower contains 'gosht e dum'
              assign item_badge = 'Must try'
              assign badge_class = 'nb-tag--musttry'
              assign badge_icon = '⭐'
            elsif title_lower contains 'hyderabadi murgh dum'
              assign item_badge = 'Popular'
              assign badge_class = 'nb-tag--popular'
              assign badge_icon = '🔥'
            elsif title_lower contains 'ustaadi murgh dum'
              assign item_badge = 'Classic'
              assign badge_class = 'nb-tag--chef'
              assign badge_icon = '👑'
            elsif title_lower contains 'zam-zam' or title_lower contains 'zam zam' or title_lower contains 'zamzam'
              assign item_badge = 'Must try'
              assign badge_class = 'nb-tag--musttry'
              assign badge_icon = '⭐'
            elsif title_lower contains 'nayaabi italiano'
              assign item_badge = 'Must try'
              assign badge_class = 'nb-tag--musttry'
              assign badge_icon = '⭐'
            elsif title_lower contains 'makhmali malai' or title_lower contains 'makhmali'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'banjara'
              assign item_badge = 'New'
              assign badge_class = 'nb-tag--new'
              assign badge_icon = '✨'
            elsif title_lower contains 'boneless lazzat'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'lababdaar seekh'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'lazzat-e-tikka' or title_lower contains 'lazzat e tikka'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'alishaan'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'paneer'
              assign item_badge = 'Must try'
              assign badge_class = 'nb-tag--musttry'
              assign badge_icon = '⭐'
            elsif title_lower contains 'sabz tikka'
              assign item_badge = 'Bestseller'
              assign badge_class = 'nb-tag--bestseller'
              assign badge_icon = '🏆'
            elsif title_lower contains 'nawabi veg'
              assign item_badge = 'Classic'
              assign badge_class = 'nb-tag--chef'
              assign badge_icon = '👑'
            elsif title_lower contains 'nazaakat'
              assign item_badge = 'New'
              assign badge_class = 'nb-tag--new'
              assign badge_icon = '✨'
            elsif title_lower contains 'dhan-e-shikori' or title_lower contains 'dhan e shikori'
              assign item_badge = 'New'
              assign badge_class = 'nb-tag--new'
              assign badge_icon = '✨'
            elsif title_lower contains 'sabziyon'
              assign item_badge = 'New'
              assign badge_class = 'nb-tag--new'
              assign badge_icon = '✨'
            endif
          %}

          <div class="nb-food-card {% unless is_available %}nb-food-card--soldout{% endunless %}">
            <div class="nb-diet-corner-badge" aria-hidden="true">
              {% render 'nb-diet-icon', product: product %}
            </div>
            <div class="nb-food-card__image">
              {% if product.featured_media %}
                <img src="{{ product.featured_media | image_url: width: 220, format: 'webp' }}"
                     alt="{{ product.featured_media.alt | default: product.title | escape }}"
                     width="110" height="110" loading="lazy" decoding="async" style="aspect-ratio: 1 / 1;" />
              {% else %}
                <div class="nb-food-card__image-placeholder">🍛</div>
              {% endif %}
              {% if item_badge != blank %}
                <span class="nb-badge {{ badge_class }}">{{ badge_icon }} {{ item_badge }}</span>
              {% elsif is_available %}
                <span class="nb-badge nb-badge--available">⚡ 30-45m</span>
              {% else %}
                <span class="nb-badge nb-badge--soldout">Sold Out</span>
              {% endif %}

              {% if title_lower contains 'alishaan' or title_lower contains 'ustaadi murgh dum' or title_lower contains 'ustaadi' %}
                <span class="nb-badge-coke">🥤 Free Coke</span>
              {% endif %}
            </div>

            <div class="nb-food-card__body">
              <div>
                <h3 class="nb-food-card__title">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="nb-food-card__desc">{{ product.description | strip_html }}</p>
                {% endif %}

                {% if title_lower contains 'alishaan' or title_lower contains 'ustaadi murgh dum' or title_lower contains 'ustaadi' %}
                  <div class="nb-coke-free-pill">
                    <span class="nb-coke-icon">🥤</span>
                    <span><strong>Free Chilled Coke</strong> included</span>
                  </div>
                {% endif %}
              </div>

              {% if product.variants.size > 1 %}
                <div class="nb-variant-selector" data-product-id="{{ product.id }}">
                  {% for variant in product.variants %}
                    <span class="nb-variant-pill {% if forloop.first %}active{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-price="{{ variant.price | money }}"
                          data-available="{{ variant.available }}">
                      {{ variant.title }}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="nb-food-card__bottom">
                <span class="nb-food-card__price" data-price-display="{{ product.id }}">
                  {{ first_variant.price | money }}
                </span>
                {% if is_available %}
                  {% if is_instant_enabled %}
                    <form action="/cart/add" method="post" class="nb-quick-form" data-form="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ first_variant.id }}" class="nb-variant-input" data-product="{{ product.id }}" />
                      <input type="hidden" name="quantity" value="1" />
                      <button type="submit" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
                    </form>
                  {% else %}
                    <a href="{{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' }}" class="nb-btn nb-btn--gold nb-btn--sm" style="font-size: 0.78rem;">📅 Pre-Order</a>
                  {% endif %}
                {% else %}
                  <button type="button" class="nb-btn nb-btn--disabled nb-btn--sm" disabled>Sold Out</button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endunless %}
      {% endfor %}
    {% else %}
      <!-- Fallback Demo Food Cards if Collection Empty -->
      <div class="nb-food-card">
        <div class="nb-food-card__image">
          <div class="nb-food-card__image-placeholder">🍗</div>
          <span class="nb-badge nb-badge--available">⚡ 30-45m</span>
        </div>
        <div class="nb-food-card__body">
          <div>
            <h3 class="nb-food-card__title">Chicken Dum Biryani</h3>
            <p class="nb-food-card__desc">Tender chicken marinated in aromatic spices and slow-cooked with basmati rice.</p>
          </div>
          <div class="nb-food-card__bottom">
            <span class="nb-food-card__price">₹280</span>
            <button type="button" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
          </div>
        </div>
      </div>

      <div class="nb-food-card">
        <div class="nb-food-card__image">
          <div class="nb-food-card__image-placeholder">🥩</div>
          <span class="nb-badge nb-badge--available">⚡ 30-45m</span>
        </div>
        <div class="nb-food-card__body">
          <div>
            <h3 class="nb-food-card__title">Mutton Dum Biryani</h3>
            <p class="nb-food-card__desc">Rich, tender mutton chunks dum-cooked with layered aromatic basmati rice.</p>
          </div>
          <div class="nb-food-card__bottom">
            <span class="nb-food-card__price">₹360</span>
            <button type="button" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
.nb-instant-section { padding: 16px 14px 100px; max-width: 960px; margin: 0 auto; }
.nb-section-header { margin-bottom: 24px; text-align: center; }
.nb-section-header h3 { font-size: 1.4rem; font-weight: 800; color: #2C1810; margin: 0 0 6px; text-align: center; }
.nb-section-header p { font-size: 0.88rem; color: #7A5C4A; margin: 0; text-align: center; }

/* ===== NEW CUSTOMER ₹99 BIRYANI TRIAL HERO STYLES ===== */
.nb-trial-hero {
  margin-bottom: 24px;
}

.nb-trial-card {
  background: linear-gradient(135deg, #FFFDF9 0%, #FDF7EC 100%);
  border: 1.5px solid rgba(200, 146, 42, 0.45);
  border-radius: 18px;
  padding: 24px;
  box-shadow: 0 8px 30px rgba(44, 24, 16, 0.07);
  position: relative;
  overflow: hidden;
}

.nb-trial-card__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.nb-trial-content {
  flex: 1 1 0;
  min-width: 0;
}

.nb-trial-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #FFF2DC;
  border: 1px solid rgba(200, 146, 42, 0.6);
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 800;
  color: #8C5E0B;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.nb-trial-badge-fire {
  font-size: 0.85rem;
}

.nb-trial-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 2rem;
  font-weight: 800;
  color: #2C1810;
  margin: 0 0 8px;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.nb-trial-price-highlight {
  color: #C8922A;
  text-shadow: 0 1px 2px rgba(200, 146, 42, 0.2);
}

.nb-trial-subtitle {
  font-size: 0.98rem;
  color: #5C4033;
  line-height: 1.45;
  margin: 0 0 14px;
  font-weight: 500;
}

.nb-trial-price-container {
  margin: 0 0 14px 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nb-trial-price-display {
  display: flex;
  align-items: center;
  gap: 10px;
}

.nb-trial-price-main {
  font-size: 2.2rem;
  font-weight: 900;
  color: #C8922A;
  line-height: 1;
  letter-spacing: -0.5px;
}

.nb-trial-price-badge-intro {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: #FFF2DC;
  border: 1px solid rgba(200, 146, 42, 0.45);
  color: #8C5E0B;
  padding: 3px 8px;
  border-radius: 6px;
}

.nb-trial-portion-subtext {
  font-size: 0.84rem;
  color: #66554B;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 5px;
}

.nb-trial-copy {
  font-size: 0.84rem;
  color: #66554B;
  line-height: 1.4;
  margin: 0 0 16px;
}

.nb-trial-cta-block {
  width: 100%;
}

.nb-trial-btn {
  display: block;
  width: 100%;
  text-align: center;
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%);
  color: #FFFFFF !important;
  font-size: 1rem;
  font-weight: 800;
  padding: 14px 20px;
  border-radius: 12px;
  text-decoration: none !important;
  box-shadow: 0 4px 14px rgba(200, 146, 42, 0.35);
  transition: all 0.2s ease;
  box-sizing: border-box;
  letter-spacing: 0.3px;
}

.nb-trial-btn:hover,
.nb-trial-btn:active {
  background: linear-gradient(135deg, #E2A73E 0%, #D49E35 100%);
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(200, 146, 42, 0.45);
}

.nb-trial-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.nb-trial-code-tag {
