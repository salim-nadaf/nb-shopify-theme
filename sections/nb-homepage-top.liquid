<script>
(function syncHomepageWithInstantDelivery() {
  function runSync() {
    var pills = document.querySelectorAll('.nb-badge-pill[data-product-id]');
    if (!pills.length) return;

    fetch('/collections/instant-delivery')
      .then(function(r) { return r.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        pills.forEach(function(pill) {
          var pid = pill.dataset.productId;
          var ptitle = (pill.dataset.productTitle || '').toLowerCase().trim();
          var card = doc.querySelector('.nb-food-card[data-product-id="' + pid + '"]') ||
                     Array.from(doc.querySelectorAll('.nb-food-card')).find(function(c) {
                       var tEl = c.querySelector('.nb-food-card__title');
                       return tEl && tEl.textContent.trim().toLowerCase() === ptitle;
                     });

          if (card) {
            var isSoldOut = card.classList.contains('nb-food-card--soldout');
            var btn = card.querySelector('.nb-quick-form button');
            if (btn && (btn.disabled || btn.textContent.trim().toLowerCase().includes('sold out'))) {
              isSoldOut = true;
            }
            var varPills = card.querySelectorAll('.nb-variant-pill');
            if (varPills.length > 0) {
              var allSold = Array.from(varPills).every(function(vp) {
                return vp.dataset.available === 'false' || vp.classList.contains('nb-variant-pill--soldout') || vp.textContent.toLowerCase().includes('sold out');
              });
              if (allSold) isSoldOut = true;
            }

            var statusEl = pill.querySelector('.nb-badge-pill__status');
            if (statusEl) {
              if (isSoldOut) {
                pill.classList.add('nb-badge-pill--soldout');
                statusEl.className = 'nb-badge-pill__status nb-badge-pill__status--soldout';
                statusEl.innerHTML = '<span class="nb-badge-pill__soldout-dot"></span> Sold Out';
              } else {
                pill.classList.remove('nb-badge-pill--soldout');
                statusEl.className = 'nb-badge-pill__status';
                statusEl.innerHTML = '<span class="nb-badge-pill__pulse"></span> Ready';
              }
            }
          }
        });
      })
      .catch(function() {});
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(function() { setTimeout(runSync, 2500); }, { timeout: 5000 });
  } else {
    setTimeout(runSync, 3000);
  }
})();
</script>

