{% comment %}
  NIAMAT BIRYANI — Google Reviews Section with Consistent Header Spacing & Judge.me Support
{% endcomment %}

<div class="nb-google-reviews-section">
  <div class="nb-container">
    <div class="nb-section-header">
      <span class="nb-tag-badge">{{ section.settings.tag_badge | default: 'GOOGLE REVIEWS' }}</span>
      {% assign reviews_title_rendered = section.settings.title | default: 'Loved by Biryani Enthusiasts Across Kalyan' %}
      {% if reviews_title_rendered contains 'Biryani Enthusiasts' %}
        {% assign reviews_title_rendered = reviews_title_rendered | replace: 'Biryani Enthusiasts', '<span class="nb-gold-highlight">Biryani Enthusiasts</span>' %}
      {% endif %}
      <h2>{{ reviews_title_rendered }}</h2>
    </div>

    <!-- JUDGE.ME APP BLOCKS & NATIVE WIDGET CONTAINERS -->
    <div class="nb-judgeme-content">
      {% content_for 'blocks' %}
      <div class="jdgm-widget jdgm-review-widget" data-id="all"></div>
      <div class="jdgm-carousel-wrapper" data-auto-install="true"></div>
    </div>
  </div>
</div>

<style>
.nb-gold-highlight {
  background: linear-gradient(135deg, #E6AC3C 0%, #C8922A 60%, #9E6B10 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  color: transparent !important;
  font-weight: 800 !important;
  display: inline;
}
.nb-google-reviews-section { background-color: #FDF6EC; padding: 40px 0 !important; text-align: center; width: 100%; }
.nb-container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
.nb-section-header { margin-bottom: 28px !important; text-align: center; }
.nb-tag-badge { display: inline-block; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #C8922A !important; margin-bottom: 6px !important; }
.nb-section-header h2 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 1.8rem; font-weight: 800; color: #2C1810 !important; margin: 0 !important; line-height: 1.25; }

.nb-judgeme-content { width: 100%; margin: 0 auto; }
.nb-judgeme-content .jdgm-widget,
.nb-judgeme-content .jdgm-rev-widg,
.nb-judgeme-content .jdgm-carousel-wrapper { width: 100% !important; display: block !important; }

/* MATCH ALL HOMEPAGE CARDS ON JUDGE.ME REVIEW CARDS */
.nb-judgeme-content .jdgm-carousel-item,
.nb-judgeme-content .jdgm-carousel__item,
.nb-judgeme-content .jdgm-rev__card,
.nb-judgeme-content .jdgm-rev-widg__item,
.nb-judgeme-content .jdgm-card,
.nb-judgeme-content .jdgm-testimonial-card,
.nb-judgeme-content [class*="jdgm-carousel-item"],
.nb-judgeme-content [class*="jdgm-card"] {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
  border: 1px solid rgba(200, 146, 42, 0.28) !important;
  border-top: 4px solid #C8922A !important;
  border-radius: 20px !important;
  padding: 24px !important;
  box-shadow: 0 10px 30px -12px rgba(44, 24, 16, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.9) !important;
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
}

.nb-judgeme-content .jdgm-carousel-item:hover,
.nb-judgeme-content .jdgm-carousel__item:hover,
.nb-judgeme-content .jdgm-rev__card:hover,
.nb-judgeme-content .jdgm-rev-widg__item:hover,
.nb-judgeme-content .jdgm-card:hover,
.nb-judgeme-content .jdgm-testimonial-card:hover,
.nb-judgeme-content [class*="jdgm-carousel-item"]:hover,
.nb-judgeme-content [class*="jdgm-card"]:hover {
  transform: translateY(-5px) !important;
  border-color: rgba(200, 146, 42, 0.5) !important;
  box-shadow: 0 18px 40px -10px rgba(200, 146, 42, 0.25), inset 0 1px 1px rgba(255, 255, 255, 1) !important;
}

.nb-judgeme-content .jdgm-star,
.nb-judgeme-content .jdgm-rev-widg__summary-stars .jdgm-star {
  color: #C8922A !important;
}

@media (min-width: 768px) {
  .nb-section-header h2 { font-size: 2.2rem; }
}
</style>

{% schema %}
{
  "name": "Google Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag_badge",
      "label": "Tag Badge",
      "default": "GOOGLE REVIEWS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Loved by Biryani Enthusiasts Across Kalyan"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Google Reviews"
    }
  ]
}
{% endschema %}
