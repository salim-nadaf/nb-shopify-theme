{% comment %} NIAMAT BIRYANI — Kitchen Status Bar Section {% endcomment %}
{% liquid
  assign status_text = section.settings.status_title
  if status_text == blank
    assign status_text = 'Open'
  endif

  assign status_prep = section.settings.status_prep
  if status_prep == blank
    assign status_prep = '⏱️ Est. Prep: 45–60 Mins'
  endif
%}

<div class="nb-b-status">
  <div class="nb-b-status__inner">
    <div class="nb-b-status__live">
      <span class="nb-b-pulse"></span>
      <span>Kitchen Status: <strong>{{ status_text }}</strong></span>
    </div>
    <span class="nb-b-status__prep">{{ status_prep }}</span>
  </div>
</div>

<style>
.nb-b-status { background: #1E100A; color: #FDF6EC; padding: 12px 16px; border-bottom: 1px solid rgba(200, 146, 42, 0.3); }
.nb-b-status__inner { max-width: 1040px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 0.82rem; }
.nb-b-status__live { display: flex; align-items: center; gap: 8px; }
.nb-b-pulse { width: 9px; height: 9px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); animation: nbPulseGreen 1.8s infinite; }
@keyframes nbPulseGreen { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); } }
.nb-b-status__prep { background: rgba(200, 146, 42, 0.2); color: #C8922A; font-weight: 700; padding: 3px 10px; border-radius: 14px; font-size: 0.75rem; border: 1px solid rgba(200, 146, 42, 0.3); }
</style>

{% schema %}
{
  "name": "Kitchen Status Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "status_title",
      "label": "Status Text",
      "default": "Open"
    },
    {
      "type": "text",
      "id": "status_prep",
      "label": "Prep Time Badge",
      "default": "⏱️ Est. Prep: 45–60 Mins"
    }
  ],
  "presets": [
    {
      "name": "Kitchen Status Bar"
    }
  ]
}
{% endschema %}
