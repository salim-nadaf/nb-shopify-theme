{% comment %} NIAMAT BIRYANI — Kitchen Status Section {% endcomment %}

<section class="nb-section nb-section--status">
  <div class="nb-container">
    <div class="nb-status-card">
      <div class="nb-status-header">
        <div class="nb-status-indicator">
          <span class="nb-pulse-dot"></span>
          <span class="nb-status-title">Kitchen Status: <strong>{{ section.settings.status_title | default: "Open" }}</strong></span>
        </div>
        <span class="nb-prep-badge">{{ section.settings.prep_time | default: "⏱️ Est. Prep: 30–60 Minutes" }}</span>
      </div>
      <p class="nb-status-msg">{{ section.settings.status_msg | default: "Today's fresh batches are now available for instant delivery across Kalyan." }}</p>
      <div class="nb-status-services">
        <span class="nb-service-tag active">☀️ Lunch Service (Active)</span>
        <span class="nb-service-tag active">🌙 Dinner Service (Active)</span>
      </div>
    </div>
  </div>
</section>

<style>
.nb-status-card {
  background: #FFFDF7; border: 1px solid rgba(200, 146, 42, 0.25);
  border-radius: 16px; padding: 18px 20px; box-shadow: 0 4px 20px rgba(44, 24, 16, 0.05);
}
.nb-status-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
.nb-status-indicator { display: flex; align-items: center; gap: 8px; }
.nb-pulse-dot {
  width: 10px; height: 10px; background: #2e7d32; border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7); animation: nbPulse 1.8s infinite;
}
@keyframes nbPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(46, 125, 50, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 125, 50, 0); }
}
.nb-status-title { font-size: 0.95rem; color: #2C1810; }
.nb-prep-badge { font-size: 0.78rem; font-weight: 700; background: rgba(200, 146, 42, 0.12); color: #C8922A; padding: 3px 10px; border-radius: 20px; }
.nb-status-msg { font-size: 0.85rem; color: #7A5C4A; margin: 0 0 12px; }
.nb-status-services { display: flex; gap: 8px; flex-wrap: wrap; }
.nb-service-tag { font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 6px; background: #F5ECD7; color: #2C1810; }
</style>

{% schema %}
{
  "name": "🔴 Kitchen Status",
  "settings": [
    {
      "type": "text",
      "id": "status_title",
      "label": "Status Title",
      "default": "Open"
    },
    {
      "type": "text",
      "id": "prep_time",
      "label": "Estimated Prep Time",
      "default": "⏱️ Est. Prep: 30–60 Minutes"
    },
    {
      "type": "textarea",
      "id": "status_msg",
      "label": "Status Message",
      "default": "Today's fresh batches are now available for instant delivery across Kalyan."
    }
  ],
  "presets": [
    {
      "name": "🔴 Kitchen Status"
    }
  ]
}
{% endschema %}
