}
.nb-delivery-icon { font-size: 2.5rem; margin-bottom: 8px; }
.nb-area-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  margin: 18px 0 24px;
}
.nb-area-pill {
  font-size: 0.78rem;
  font-weight: 600;
  background: rgba(200, 146, 42, 0.1);
  color: var(--nb-dark);
  padding: 5px 12px;
  border-radius: 20px;
  border: 1px solid rgba(200, 146, 42, 0.2);
}

/* SECTION 9: REVIEWS GRID */
.nb-reviews-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.nb-review-card {
  background: #FFF;
  border: 1px solid var(--nb-border);
