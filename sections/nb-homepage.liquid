  color: #fff !important; font-weight: 700; font-size: 0.92rem;
  padding: 14px 22px; border-radius: 12px; text-decoration: none;
  border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(200, 146, 42, 0.25);
}
.nb-btn-gold:hover, .nb-btn-gold:active {
  background: var(--nb-gold-hover, #A67520); transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(200, 146, 42, 0.35);
}

.nb-btn-glass {
  background: rgba(255, 250, 244, 0.08);
  border: 1.5px solid rgba(200, 146, 42, 0.4);
  color: #FDF6EC !important; font-weight: 700; font-size: 0.92rem;
  padding: 14px 22px; border-radius: 12px; text-decoration: none;
  cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.2s ease;
}
.nb-btn-glass:hover, .nb-btn-glass:active {
  background: rgba(200, 146, 42, 0.2); border-color: #C8922A; color: #fff !important;
}

.nb-btn-full { width: 100%; box-sizing: border-box; text-align: center; }

/* SECTIONS COMMON */
.nb-section { padding: 40px 0; }
.nb-section--bg-alt { background: var(--nb-cream-alt, #FDF6EC); }
.nb-section-head { margin-bottom: 24px; }
.nb-section-head.text-center { max-width: 650px; margin-left: auto; margin-right: auto; }
.nb-subhead-badge {
  display: inline-block; font-size: 0.72rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.8px; color: var(--nb-hp-gold, #C8922A); margin-bottom: 4px;
}
.nb-section-title { font-size: 1.4rem; font-weight: 800; color: var(--nb-hp-dark, #2C1810); margin: 0 0 6px; }
.nb-section-desc { font-size: 0.85rem; color: var(--nb-subtext, #7A5C4A); margin: 0; }
.nb-link-gold { color: var(--nb-hp-gold, #C8922A); font-weight: 700; font-size: 0.88rem; text-decoration: none; }
.nb-link-gold:hover { text-decoration: underline; }

@media (min-width: 768px) {
  .nb-section { padding: 60px 0; }
  .nb-section-title { font-size: 1.85rem; }
  .nb-section-desc { font-size: 0.95rem; }
}

/* KITCHEN STATUS */
.nb-status-card {
  background: #FFFDF7; border: 1px solid rgba(200, 146, 42, 0.25);
  border-radius: 16px; padding: 18px 20px; box-shadow: 0 4px 20px rgba(44, 24, 16, 0.05);
}
.nb-status-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
.nb-status-indicator { display: flex; align-items: center; gap: 8px; }
.nb-pulse-dot {
  width: 10px; height: 10px; background: #2e7d32; border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7); animation: nbPulse 1.8s infinite;
}
@keyframes nbPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 125, 50, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(46, 125, 50, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(46, 125, 50, 0); }
}
.nb-status-title { font-size: 0.95rem; color: var(--nb-hp-dark, #2C1810); }
.nb-prep-badge { font-size: 0.78rem; font-weight: 700; background: rgba(200, 146, 42, 0.12); color: var(--nb-hp-gold, #C8922A); padding: 3px 10px; border-radius: 20px; }
.nb-status-msg { font-size: 0.85rem; color: var(--nb-subtext, #7A5C4A); margin: 0 0 12px; }
.nb-status-services { display: flex; gap: 8px; flex-wrap: wrap; }
.nb-service-tag { font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 6px; background: #F5ECD7; color: var(--nb-hp-dark, #2C1810); }

/* EXPERIENCE GRID */
.nb-experience-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
.nb-exp-card { background: #FFF; border: 1px solid var(--nb-border); border-radius: 18px; padding: 24px 20px; position: relative; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
.nb-exp-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(44, 24, 16, 0.08); }
.nb-exp-card--instant { border-color: rgba(200, 146, 42, 0.35); }
.nb-exp-card--family { background: #FFFDF7; border-color: rgba(44, 24, 16, 0.2); }
.nb-exp-card__badge { align-self: flex-start; font-size: 0.72rem; font-weight: 700; background: rgba(200, 146, 42, 0.12); color: var(--nb-hp-gold, #C8922A); padding: 3px 10px; border-radius: 20px; margin-bottom: 12px; }
.nb-exp-card__icon { font-size: 2.2rem; margin-bottom: 8px; }
.nb-exp-card__title { font-size: 1.2rem; font-weight: 800; color: var(--nb-hp-dark, #2C1810); margin: 0 0 8px; }
.nb-exp-card__desc { font-size: 0.85rem; color: var(--nb-subtext, #7A5C4A); margin: 0 0 16px; line-height: 1.45; flex: 1; }
.nb-exp-card__meta { display: flex; gap: 12px; font-size: 0.75rem; font-weight: 600; color: var(--nb-hp-gold, #C8922A); margin-bottom: 18px; flex-wrap: wrap; }

@media (min-width: 768px) {
  .nb-experience-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  .nb-exp-card { padding: 32px 28px; }
}

/* PREP TIME */
.nb-prep-time { display: inline-block; font-size: 0.72rem; font-weight: 600; color: var(--nb-subtext, #7A5C4A); margin-left: 6px; }

/* REASONS GRID */
.nb-reasons-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.nb-reason-card { background: #FFF; border: 1px solid var(--nb-border); border-radius: 14px; padding: 16px; text-align: center; }
.nb-reason-icon { font-size: 2rem; margin-bottom: 8px; }
.nb-reason-card h4 { font-size: 0.95rem; font-weight: 700; color: var(--nb-hp-dark, #2C1810); margin: 0 0 4px; }
.nb-reason-card p { font-size: 0.78rem; color: var(--nb-subtext, #7A5C4A); margin: 0; line-height: 1.4; }

@media (min-width: 768px) {
  .nb-reasons-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .nb-reason-card { padding: 24px 18px; }
}

/* BANNER CARD */
.nb-banner-card { background: linear-gradient(135deg, #2C1810 0%, #3D2015 100%); border-radius: 20px; padding: 36px 24px; color: #fff; text-align: center; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(44, 24, 16, 0.15); }
.nb-banner-content { max-width: 600px; margin: 0 auto; }
.nb-subhead-badge.gold { color: #FDF6EC; background: rgba(200, 146, 42, 0.25); }
.nb-banner-content h2 { font-size: 1.6rem; font-weight: 800; color: #FFFDF7; margin: 8px 0 10px; }
.nb-banner-content p { font-size: 0.88rem; color: #E2D5C5; margin: 0 0 22px; }

/* FAMILY BOX */
.nb-family-box { background: #FFF; border: 1px solid var(--nb-border); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 24px; }
.nb-family-list { list-style: none; padding: 0; margin: 16px 0 24px; font-size: 0.85rem; color: var(--nb-hp-dark, #2C1810); font-weight: 600; display: flex; flex-direction: column; gap: 8px; }
.nb-family-visual { background: linear-gradient(135deg, #FDF6EC 0%, #F5ECD7 100%); border: 1px solid rgba(200, 146, 42, 0.25); border-radius: 16px; padding: 28px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.nb-family-badge-icon { font-size: 3rem; margin-bottom: 8px; }
.nb-family-visual h3 { font-size: 1.1rem; font-weight: 800; color: var(--nb-hp-dark, #2C1810); margin: 0 0 4px; }
.nb-family-visual p { font-size: 0.8rem; color: var(--nb-hp-gold, #C8922A); font-weight: 700; margin: 0; }

@media (min-width: 768px) {
  .nb-family-box { flex-direction: row; align-items: center; padding: 40px; }
  .nb-family-content { flex: 1; }
  .nb-family-visual { width: 280px; flex-shrink: 0; padding: 40px 24px; }
}

/* DELIVERY CARD */
.nb-delivery-card { background: #FFF; border: 1px solid var(--nb-border); border-radius: 20px; padding: 32px 20px; text-align: center; max-width: 680px; margin: 0 auto; }
.nb-delivery-icon { font-size: 2.5rem; margin-bottom: 8px; }
.nb-area-pills { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 18px 0 24px; }
.nb-area-pill { font-size: 0.78rem; font-weight: 600; background: rgba(200, 146, 42, 0.1); color: var(--nb-hp-dark, #2C1810); padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(200, 146, 42, 0.2); }

/* REVIEWS GRID */
.nb-reviews-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
.nb-review-card { background: #FFF; border: 1px solid var(--nb-border); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
.nb-review-stars { color: #f59e0b; font-size: 1.1rem; margin-bottom: 8px; letter-spacing: 2px; }
.nb-review-text { font-size: 0.85rem; color: var(--nb-hp-dark, #2C1810); line-height: 1.5; margin: 0 0 14px; font-style: italic; }
.nb-review-author strong { display: block; font-size: 0.85rem; color: var(--nb-hp-dark, #2C1810); }
.nb-review-author span { font-size: 0.72rem; color: #16a34a; font-weight: 600; }

@media (min-width: 768px) {
  .nb-reviews-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
}

/* FAQ ACCORDION */
.nb-faq-accordion { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
.nb-faq-item { background: #FFF; border: 1px solid var(--nb-border); border-radius: 12px; overflow: hidden; }
.nb-faq-question { padding: 16px 20px; font-size: 0.92rem; font-weight: 700; color: var(--nb-hp-dark, #2C1810); cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; }
.nb-faq-question::-webkit-details-marker { display: none; }
.nb-faq-icon { font-size: 1.2rem; color: var(--nb-hp-gold, #C8922A); font-weight: 400; transition: transform 0.2s; }
.nb-faq-item[open] .nb-faq-icon { transform: rotate(45deg); }
.nb-faq-answer { padding: 0 20px 16px; font-size: 0.84rem; color: var(--nb-subtext, #7A5C4A); line-height: 1.5; }
.nb-faq-answer p { margin: 0; }

/* FINAL CTA */
.nb-final-cta-card { background: linear-gradient(135deg, #1E100A 0%, #2C1810 100%); border-radius: 20px; padding: 40px 20px; text-align: center; color: #fff; max-width: 800px; margin: 0 auto; }
.nb-final-cta-card h2 { font-size: 1.6rem; font-weight: 800; color: #FFFDF7; margin: 0 0 10px; }
.nb-final-cta-card p { font-size: 0.88rem; color: #E2D5C5; max-width: 550px; margin: 0 auto 24px; }
.nb-final-actions { display: flex; flex-direction: column; gap: 12px; max-width: 400px; margin: 0 auto; }
@media (min-width: 768px) {
  .nb-final-cta-card { padding: 56px 40px; }
  .nb-final-cta-card h2 { font-size: 2.2rem; }
  .nb-final-actions { flex-direction: row; max-width: 480px; }
  .nb-final-actions a { flex: 1; }
}

/* MODAL SYSTEM */
.nb-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; }
.nb-modal-overlay.active { display: flex; }
.nb-modal-box { background: #FFFDF7; border: 1px solid var(--nb-hp-gold, #C8922A); border-radius: 18px; padding: 24px; max-width: 420px; width: 100%; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
.nb-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 1.6rem; color: var(--nb-hp-dark, #2C1810); cursor: pointer; line-height: 1; }
.nb-modal-box h3 { font-size: 1.2rem; font-weight: 800; color: var(--nb-hp-dark, #2C1810); margin: 0 0 8px; }
.nb-modal-box p { font-size: 0.85rem; color: var(--nb-subtext, #7A5C4A); margin: 0 0 12px; }
.nb-modal-list { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 8px; font-size: 0.84rem; font-weight: 600; color: var(--nb-hp-dark, #2C1810); }
.nb-modal-note { font-size: 0.78rem !important; font-style: italic; color: var(--nb-hp-gold, #C8922A) !important; }
</style>

<script>
function nbCheckDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.add('active');
}
function nbCloseDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.remove('active');
}
</script>

