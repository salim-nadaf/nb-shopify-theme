  list-style: none;
}
.nb-faq-question::-webkit-details-marker { display: none; }
.nb-faq-icon { font-size: 1.2rem; color: var(--nb-gold); font-weight: 400; transition: transform 0.2s; }
.nb-faq-item[open] .nb-faq-icon { transform: rotate(45deg); }
.nb-faq-answer {
  padding: 0 20px 16px;
  font-size: 0.84rem;
  color: var(--nb-subtext);
  line-height: 1.5;
}
.nb-faq-answer p { margin: 0; }

/* SECTION 11: FINAL CTA */
.nb-final-cta-card {
