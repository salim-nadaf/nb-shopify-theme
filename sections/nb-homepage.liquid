.nb-exp-card__icon { font-size: 2.2rem; margin-bottom: 8px; }
.nb-exp-card__title { font-size: 1.2rem; font-weight: 800; color: var(--nb-dark); margin: 0 0 8px; }
.nb-exp-card__desc { font-size: 0.85rem; color: var(--nb-subtext); margin: 0 0 16px; line-height: 1.45; flex: 1; }
