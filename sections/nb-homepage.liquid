@media (min-width: 768px) {
  .nb-section-block { padding: calc(var(--nb-padding) * 1.5) 0 !important; }
  .nb-section-header h2 { font-size: 2.1rem; }
  .nb-hero-banner { padding: calc(var(--nb-padding) * 1.8) 24px; }
  .nb-hero-title { font-size: 3rem; }
  .nb-home-trial-card { flex-direction: row; padding: 36px 40px; gap: 40px; align-items: center; }
  .nb-home-trial-title { font-size: 2.2rem; }
  .nb-home-trial-visual { max-width: 340px; }
  .nb-home-trial-img { height: 230px; }
  .nb-hero-buttons { flex-direction: row; max-width: 500px; }
  .nb-hero-buttons a { flex: 1; }
  .nb-grid-2 { grid-template-columns: 1fr 1fr; gap: 26px; }
  .nb-grid-3 { grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .nb-grid-4 { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .nb-family-banner { flex-direction: row; padding: 44px; }
  .nb-family-media { width: 380px; flex-shrink: 0; }
  .nb-final-cta-wrap { padding: calc(var(--nb-padding) * 1.6) 24px; }
  .nb-final-box h2 { font-size: 2.5rem; }
  .nb-hero-video-desktop { display: none !important; }
}
@media (max-width: 767px) {
  .nb-hero-video-desktop { display: none !important; }
}
</style>

<script>
(function() {
  var nbVideosInitialized = false;
  function initLazyVideos() {
    if (window.innerWidth < 768) return;
    if (nbVideosInitialized) return;
    nbVideosInitialized = true;
    var lazyVideos = document.querySelectorAll('.nb-lazy-video');
    lazyVideos.forEach(function(video) {
      if (video.closest('.nb-hero-desktop-media')) {
        var src = video.getAttribute('data-src');
        if (src) {
          var source = document.createElement('source');
          source.src = src;
          source.type = 'video/mp4';
          video.appendChild(source);
          video.load();
          video.play().catch(function(err) {});
        }
      }
    });
  }

  // Strictly load on user interaction (scroll, click, touch, mousemove)
  ['click', 'scroll', 'touchstart', 'mousemove'].forEach(function(ev) {
    window.addEventListener(ev, initLazyVideos, { passive: true, once: true });
  });
})();
</script>

