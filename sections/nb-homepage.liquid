{% comment %} NIAMAT BIRYANI — Premium Restaurant Homepage {% endcomment %}
{% render 'food-card-styles' %}

<div class="nb-hp-wrapper">

  <!-- ==================== SECTION 1: HERO ==================== -->
  <section class="nb-hero">
    <div class="nb-hero__bg-glow"></div>
    <div class="nb-container nb-hero__content">
      <span class="nb-hero__badge">⚡ Authentic Hyderabadi Dum Biryani</span>
      <h1 class="nb-hero__headline">Premium Dum Biryani,<br>Freshly Prepared for Every Occasion</h1>
      <p class="nb-hero__subheading">
        Whether you're craving a quick meal or planning a family gathering, enjoy freshly prepared biryani made with carefully selected ingredients and delivered across Kalyan and nearby areas.
      </p>
      
      <div class="nb-hero__actions">
        <a href="/collections/instant-delivery" class="nb-btn-gold">
          <span>⚡ Order Instant Delivery</span>
        </a>
        <a href="/pages/family-feast" class="nb-btn-glass">
          <span>👑 Plan a Family Order</span>
        </a>
      </div>

      <div class="nb-hero__trust">
        <span class="nb-trust-item">✓ Freshly Prepared</span>
        <span class="nb-trust-sep">•</span>
        <span class="nb-trust-item">✓ 100% Halal</span>
        <span class="nb-trust-sep">•</span>
        <span class="nb-trust-item">✓ Secure Online Payments</span>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 2: KITCHEN STATUS ==================== -->
  <section class="nb-section nb-section--status">
    <div class="nb-container">
      <div class="nb-status-card">
        <div class="nb-status-header">
          <div class="nb-status-indicator">
            <span class="nb-pulse-dot"></span>
            <span class="nb-status-title">Kitchen Status: <strong>Open</strong></span>
          </div>
          <span class="nb-prep-badge">⏱️ Est. Prep: 30–60 Minutes</span>
        </div>
        <p class="nb-status-msg">Today's fresh batches are now available for instant delivery across Kalyan.</p>
        <div class="nb-status-services">
          <span class="nb-service-tag active">☀️ Lunch Service (Active)</span>
          <span class="nb-service-tag active">🌙 Dinner Service (Active)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 3: CHOOSE YOUR ORDERING EXPERIENCE ==================== -->
  <section class="nb-section">
    <div class="nb-container">
      <div class="nb-section-head text-center">
        <span class="nb-subhead-badge">Tailored Dining</span>
        <h2 class="nb-section-title">How Would You Like to Order?</h2>
      </div>

      <div class="nb-experience-grid">
        <!-- Instant Delivery Card -->
        <div class="nb-exp-card nb-exp-card--instant">
          <div class="nb-exp-card__badge">⚡ Today's Craving</div>
          <div class="nb-exp-card__icon">🍛</div>
          <h3 class="nb-exp-card__title">Instant Delivery</h3>
          <p class="nb-exp-card__desc">Freshly prepared single & double portions available today. Ready in approximately 30–60 minutes.</p>
          <div class="nb-exp-card__meta">
            <span>🚀 30–60 Min Delivery</span>
            <span>📍 Kalyan & Nearby</span>
          </div>
          <a href="/collections/instant-delivery" class="nb-btn-gold nb-btn-full">Order Now</a>
        </div>

        <!-- Family Orders Card -->
        <div class="nb-exp-card nb-exp-card--family">
          <div class="nb-exp-card__badge">👑 Gatherings & Parties</div>
          <div class="nb-exp-card__icon">👨‍👩‍👧‍👦</div>
          <h3 class="nb-exp-card__title">Family Orders</h3>
          <p class="nb-exp-card__desc">Planning a gathering? Pre-order 1 Kg and above with your preferred delivery schedule.</p>
          <div class="nb-exp-card__meta">
            <span>📦 1 Kg – 10 Kg+ Quantities</span>
            <span>📅 Scheduled Delivery</span>
          </div>
          <a href="/pages/family-feast" class="nb-btn-glass nb-btn-full">Plan Family Order</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 4: TODAY'S AVAILABLE ==================== -->
  <section class="nb-section nb-section--bg-alt">
    <div class="nb-container">
      <div class="nb-section-head">
        <div>
          <span class="nb-subhead-badge">Fresh Batches</span>
          <h2 class="nb-section-title">Available Today</h2>
          <p class="nb-section-desc">Freshly prepared items currently available for instant delivery.</p>
        </div>
        <a href="/collections/instant-delivery" class="nb-link-gold desktop-only">View All Available →</a>
      </div>

      {%- assign instant_coll = collections['instant-delivery'] -%}
      <div class="nb-food-grid">
        {%- if instant_coll.products.size > 0 -%}
          {%- for product in instant_coll.products limit:6 -%}
            {%- liquid
              assign first_variant = product.selected_or_first_available_variant
              assign is_available = first_variant.available
            -%}
            <div class="nb-food-card {% unless is_available %}nb-food-card--soldout{% endunless %}">
              <div class="nb-food-card__image">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="130" height="130">
                {%- else -%}
                  <div class="nb-food-card__image-placeholder">🍛</div>
                {%- endif -%}
                {%- if is_available -%}
                  <span class="nb-badge nb-badge--available">⚡ Available Now</span>
                {%- else -%}
                  <span class="nb-badge nb-badge--soldout">Sold Out</span>
                {%- endif -%}
              </div>

              <div class="nb-food-card__body">
                <div>
                  <h3 class="nb-food-card__title">{{ product.title }}</h3>
                  {%- if product.description != blank -%}
                    <p class="nb-food-card__desc">{{ product.description | strip_html | truncate: 65 }}</p>
                  {%- endif -%}
                </div>

                {%- if product.variants.size > 1 -%}
                  <div class="nb-variant-selector" data-product-id="{{ product.id }}">
                    {%- for variant in product.variants -%}
                      <span class="nb-variant-pill {% if forloop.first %}active{% endif %}"
                            data-variant-id="{{ variant.id }}"
                            data-price="{{ variant.price | money }}"
                            data-available="{{ variant.available }}">
                        {{ variant.title }}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="nb-food-card__bottom">
                  <div>
                    <span class="nb-food-card__price" data-price-display="{{ product.id }}">
                      {{ first_variant.price | money }}
                    </span>
                    <span class="nb-prep-time">⏱️ 30-60m</span>
                  </div>

                  {%- if is_available -%}
                    <form action="/cart/add" method="post" class="nb-quick-form" data-form="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ first_variant.id }}" class="nb-variant-input" data-product="{{ product.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
                    </form>
                  {%- else -%}
                    <button class="nb-btn nb-btn--disabled nb-btn--sm" disabled>Sold Out</button>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback demo items if collection empty -->
          <div class="nb-food-card">
            <div class="nb-food-card__image">
              <div class="nb-food-card__image-placeholder">🍗</div>
              <span class="nb-badge nb-badge--available">⚡ Available Now</span>
            </div>
            <div class="nb-food-card__body">
              <div>
                <h3 class="nb-food-card__title">Chicken Dum Biryani</h3>
                <p class="nb-food-card__desc">Tender chicken marinated in aromatic spices and layered with premium basmati rice.</p>
              </div>
              <div class="nb-food-card__bottom">
                <div>
                  <span class="nb-food-card__price">₹280</span>
                  <span class="nb-prep-time">⏱️ 30-60m</span>
                </div>
                <a href="/collections/instant-delivery" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</a>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="text-center mobile-only mt-20">
        <a href="/collections/instant-delivery" class="nb-btn-gold">View Full Instant Menu →</a>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 5: WHY CHOOSE US ==================== -->
  <section class="nb-section">
    <div class="nb-container">
      <div class="nb-section-head text-center">
        <span class="nb-subhead-badge">Our Commitment</span>
        <h2 class="nb-section-title">Why Customers Choose Biryani Palace by Niamat</h2>
      </div>

      <div class="nb-reasons-grid">
        <div class="nb-reason-card">
          <div class="nb-reason-icon">🍲</div>
          <h4>Freshly Prepared</h4>
          <p>Prepared for every service using carefully selected ingredients and slow-cooked dum perfection.</p>
        </div>

        <div class="nb-reason-card">
          <div class="nb-reason-icon">🌙</div>
          <h4>100% Halal</h4>
          <p>Prepared following strict halal practices from certified suppliers.</p>
        </div>

        <div class="nb-reason-card">
          <div class="nb-reason-icon">🔒</div>
          <h4>Secure Online Ordering</h4>
          <p>Fast, direct, and 100% secure online checkout with instant status confirmation.</p>
        </div>

        <div class="nb-reason-card">
          <div class="nb-reason-icon">👨‍👩‍👧‍👦</div>
          <h4>Family Focused</h4>
          <p>Perfect portions tailored for everyday cravings, weekend meals, and family celebrations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 6: SIGNATURE COLLECTION ==================== -->
  <section class="nb-section nb-section--banner">
    <div class="nb-container">
      <div class="nb-banner-card">
        <div class="nb-banner-content">
          <span class="nb-subhead-badge gold">Full Culinary Range</span>
          <h2>Explore Our Signature Menu</h2>
          <p>Discover our complete range of authentic dum biryanis, succulent starters, gravies, and traditional accompaniments.</p>
          <a href="/collections/all" class="nb-btn-gold">View Full Menu</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 7: FAMILY GATHERINGS ==================== -->
  <section class="nb-section nb-section--bg-alt">
    <div class="nb-container">
      <div class="nb-family-box">
        <div class="nb-family-content">
          <span class="nb-subhead-badge">Advance Catering</span>
          <h2 class="nb-section-title">Made for Family Gatherings</h2>
          <p class="nb-section-desc">Planning a celebration, office lunch, birthday, or weekend family meal? Pre-order your preferred quantity (1 Kg to 10 Kg+) and set your ideal delivery time slot.</p>
          
          <ul class="nb-family-list">
            <li>✓ Custom Portioning (1 Kg Serves 4–5 People)</li>
            <li>✓ Timed Slots Guaranteed Fresh from Handi</li>
            <li>✓ Special Handi Packaging Included</li>
          </ul>

          <a href="/pages/family-feast" class="nb-btn-glass">Book Family Order</a>
        </div>
        <div class="nb-family-visual">
          <div class="nb-family-badge-icon">👑</div>
          <h3>Handi Family Feast</h3>
          <p>1 Kg, 2 Kg & Bulk Packs Available</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 8: DELIVERY AREAS ==================== -->
  <section class="nb-section">
    <div class="nb-container">
      <div class="nb-delivery-card">
        <div class="nb-delivery-icon">📍</div>
        <h2 class="nb-section-title">Where We Deliver</h2>
        <p class="nb-section-desc">Serving Kalyan and selected nearby areas. Delivery availability and charges are confirmed during checkout based on your exact location.</p>

        <div class="nb-area-pills">
          <span class="nb-area-pill">Kalyan West</span>
          <span class="nb-area-pill">Kalyan East</span>
          <span class="nb-area-pill">Khadakpada</span>
          <span class="nb-area-pill">Adharwadi</span>
          <span class="nb-area-pill">Shahad</span>
          <span class="nb-area-pill">Dombivli (Select Areas)</span>
        </div>

        <button type="button" class="nb-btn-gold" onclick="nbCheckDeliveryModal()">Check Delivery Availability</button>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 9: CUSTOMER REVIEWS ==================== -->
  <section class="nb-section nb-section--bg-alt">
    <div class="nb-container">
      <div class="nb-section-head text-center">
        <span class="nb-subhead-badge">Verified Reviews</span>
        <h2 class="nb-section-title">Loved by Our Customers</h2>
        <p class="nb-section-desc">Read genuine Google Reviews from customers who have enjoyed our food.</p>
      </div>

      <div class="nb-reviews-grid">
        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"The Chicken Dum Biryani from Niamat Biryani is authentic and rich in flavor! Meat was super tender, rice perfectly spiced. Best in Kalyan!"</p>
          <div class="nb-review-author">
            <strong>Sumaiya N.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>

        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"Ordered 2 Kg Mutton Biryani for a family weekend lunch. It arrived piping hot right on schedule. Everyone loved the taste and packaging!"</p>
          <div class="nb-review-author">
            <strong>Rahul M.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>

        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"Clean, 100% halal, and extremely hygienic packaging. Fast instant delivery within 35 minutes. Highly recommended for biryani lovers."</p>
          <div class="nb-review-author">
            <strong>Imran K.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 10: FREQUENTLY ASKED QUESTIONS ==================== -->
  <section class="nb-section">
    <div class="nb-container">
      <div class="nb-section-head text-center">
        <span class="nb-subhead-badge">Help & Info</span>
        <h2 class="nb-section-title">Frequently Asked Questions</h2>
      </div>

      <div class="nb-faq-accordion">
        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>How fast is Instant Delivery?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>Instant Delivery orders are prepared fresh and dispatched promptly. Most orders arrive within 30 to 60 minutes depending on your location in Kalyan.</p>
          </div>
        </details>

        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>Which areas do you deliver to?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>We deliver across Kalyan West, Kalyan East, Khadakpada, Adharwadi, Shahad, and surrounding locations. Delivery range and fees are automatically calculated at checkout.</p>
          </div>
        </details>

        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>What payment methods are supported?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>We support all major online payment options including Google Pay, PhonePe, Paytm, Credit/Debit Cards, Net Banking, and Cash on Delivery.</p>
          </div>
        </details>

        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>How do Family Pre-Orders work?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>For orders of 1 Kg and above, you can select your preferred delivery time slot 2 to 48 hours in advance to ensure fresh handi preparation for your event.</p>
          </div>
        </details>

        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>Is the food prepared fresh for every order?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>Yes, absolutely. We prepare our biryanis in fresh dum batches throughout the day to ensure authentic aroma, moisture, and flavor in every portion.</p>
          </div>
        </details>

        <details class="nb-faq-item">
          <summary class="nb-faq-question">
            <span>Is the meat 100% Halal certified?</span>
            <span class="nb-faq-icon">+</span>
          </summary>
          <div class="nb-faq-answer">
            <p>Yes. All meats used at Biryani Palace by Niamat are 100% halal certified and handled following strict hygiene and halal protocols.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 11: FINAL CALL TO ACTION ==================== -->
  <section class="nb-section nb-section--final-cta">
    <div class="nb-container">
      <div class="nb-final-cta-card">
        <h2>Ready to Enjoy Freshly Prepared Biryani?</h2>
        <p>Choose Instant Delivery for today's cravings or plan your next family gathering with our advance ordering service.</p>
        <div class="nb-final-actions">
          <a href="/collections/instant-delivery" class="nb-btn-gold">Order Instant Delivery</a>
          <a href="/pages/family-feast" class="nb-btn-glass">Plan Family Order</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 12: FOOTER ==================== -->
  <footer class="nb-footer">
    <div class="nb-container">
      <div class="nb-footer-grid">
        <div class="nb-footer-col">
          <h3>Biryani Palace by Niamat</h3>
          <p>Premium Dum Biryani freshly prepared for everyday cravings and family celebrations across Kalyan.</p>
          <div class="nb-footer-socials">
            <a href="https://wa.me/918097758616" target="_blank" rel="noopener">WhatsApp</a>
            <a href="#" target="_blank" rel="noopener">Instagram</a>
            <a href="#" target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>

        <div class="nb-footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/collections/instant-delivery">Instant Delivery</a></li>
            <li><a href="/pages/family-feast">Family Pre-Orders</a></li>
            <li><a href="/collections/all">Signature Menu</a></li>
            <li><a href="/pages/about-us">About Us</a></li>
          </ul>
        </div>

        <div class="nb-footer-col">
          <h4>Operating Hours & Location</h4>
          <p>📍 Kalyan West, Maharashtra</p>
          <p>⏰ Open Daily: 11:00 AM – 11:00 PM</p>
          <p>📞 Phone: +91 80977 58616</p>
        </div>

        <div class="nb-footer-col">
          <h4>Delivery Info</h4>
          <p>Serving Kalyan West, Kalyan East, Khadakpada, Adharwadi, Shahad & Nearby.</p>
          <p>100% Halal Certified • Fresh Batch Dum Cooking</p>
        </div>
      </div>

      <div class="nb-footer-bottom">
        <p>© {{ 'now' | date: "%Y" }} Biryani Palace by Niamat. Powered by Cloud Spice.</p>
      </div>
    </div>
  </footer>

</div>

<!-- Delivery Modal -->
<div id="nb-delivery-modal" class="nb-modal-overlay">
  <div class="nb-modal-box">
    <button type="button" class="nb-modal-close" onclick="nbCloseDeliveryModal()">×</button>
    <h3>📍 Delivery Coverage</h3>
    <p>We deliver freshly prepared Dum Biryani across:</p>
    <ul class="nb-modal-list">
      <li>✓ Kalyan West (30–45 mins)</li>
      <li>✓ Kalyan East (35–50 mins)</li>
      <li>✓ Khadakpada & Adharwadi (30–40 mins)</li>
      <li>✓ Shahad & Titwala Road (40–60 mins)</li>
      <li>✓ Dombivli (Select Pincodes)</li>
    </ul>
    <p class="nb-modal-note">Exact delivery time & fee confirmed automatically at checkout.</p>
    <button type="button" class="nb-btn-gold nb-btn-full" onclick="nbCloseDeliveryModal()">Got it!</button>
  </div>
</div>

<!-- ==================== HOMEPAGE STYLES ==================== -->
<style>
/* Color Tokens */
:root {
  --nb-dark: #2C1810;
  --nb-dark-bg: #1E100A;
  --nb-gold: #C8922A;
  --nb-gold-hover: #A67520;
  --nb-cream: #FFFAF4;
  --nb-cream-alt: #FDF6EC;
  --nb-text: #2C1810;
  --nb-subtext: #7A5C4A;
  --nb-border: rgba(200, 146, 42, 0.2);
}

.nb-hp-wrapper {
  background: #FFFAF4;
  color: var(--nb-text);
  font-family: inherit;
  overflow-x: hidden;
}

.nb-container {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 16px;
}

.text-center { text-align: center; }
.desktop-only { display: none; }
.mobile-only { display: block; }
.mt-20 { margin-top: 20px; }

@media (min-width: 768px) {
  .nb-container { padding: 0 24px; }
  .desktop-only { display: inline-block; }
  .mobile-only { display: none; }
}

/* ==================== HERO ==================== */
.nb-hero {
  position: relative;
  background: linear-gradient(135deg, #1E100A 0%, #2C1810 60%, #3D2015 100%);
  color: #fff;
  padding: 48px 16px 56px;
  text-align: center;
  overflow: hidden;
}
.nb-hero__bg-glow {
  position: absolute;
  top: -50px;
  left: 50%;
  transform: translateX(-50%);
  width: 320px;
  height: 320px;
  background: radial-gradient(circle, rgba(200, 146, 42, 0.28) 0%, transparent 70%);
  pointer-events: none;
}
.nb-hero__badge {
  display: inline-block;
  background: rgba(200, 146, 42, 0.18);
  border: 1px solid rgba(200, 146, 42, 0.4);
  color: #FDF6EC;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 4px 14px;
  border-radius: 20px;
  margin-bottom: 16px;
  letter-spacing: 0.3px;
}
.nb-hero__headline {
  font-size: 1.75rem;
  font-weight: 800;
  line-height: 1.25;
  color: #FFFDF7;
  margin: 0 0 14px;
  letter-spacing: -0.3px;
}
.nb-hero__subheading {
  font-size: 0.9rem;
  line-height: 1.5;
  color: #E2D5C5;
  max-width: 680px;
  margin: 0 auto 28px;
}
.nb-hero__actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 380px;
  margin: 0 auto 24px;
}
.nb-hero__trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 0.78rem;
  color: #C8922A;
  font-weight: 600;
  flex-wrap: wrap;
}
.nb-trust-sep { opacity: 0.5; }

@media (min-width: 768px) {
  .nb-hero { padding: 80px 24px 88px; }
  .nb-hero__headline { font-size: 2.75rem; }
  .nb-hero__subheading { font-size: 1.05rem; }
  .nb-hero__actions { flex-direction: row; max-width: 500px; justify-content: center; }
  .nb-hero__actions .nb-btn-gold, .nb-hero__actions .nb-btn-glass { flex: 1; }
}

/* BUTTON SYSTEM */
.nb-btn-gold {
  background: var(--nb-gold);
  color: #fff !important;
  font-weight: 700;
  font-size: 0.92rem;
  padding: 14px 22px;
  border-radius: 12px;
