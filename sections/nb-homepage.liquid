  .nb-b-faq-answer { padding: 0 18px 14px; font-size: 0.83rem; color: #7A5C4A; line-height: 1.45; }
  .nb-b-faq-answer p { margin: 0; }

  /* FINAL CTA */
  .nb-b-final-box { background: linear-gradient(135deg, #160B07 0%, #2C1810 100%); border-radius: 18px; padding: 36px 18px; text-align: center; color: #fff; max-width: 750px; margin: 0 auto; }
