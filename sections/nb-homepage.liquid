  font-weight: 600;
  padding: 3px 10px;
  border-radius: 6px;
  background: #F5ECD7;
  color: var(--nb-dark);
}

/* SECTION 3: EXPERIENCE GRID */
.nb-experience-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.nb-exp-card {
  background: #FFF;
