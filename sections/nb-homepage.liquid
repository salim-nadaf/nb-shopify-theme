  .nb-b-final-box p { font-size: 0.86rem; color: #E2D5C5; max-width: 520px; margin: 0 auto 22px; }
  .nb-b-final-actions { display: flex; flex-direction: column; gap: 10px; max-width: 380px; margin: 0 auto; }

  @media (min-width: 768px) {
    .nb-b-final-box { padding: 50px 36px; }
    .nb-b-final-box h2 { font-size: 2.1rem; }
    .nb-b-final-actions { flex-direction: row; max-width: 460px; }
    .nb-b-final-actions a { flex: 1; }
  }

  /* MODAL */
  .nb-b-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; }
  .nb-b-modal-overlay.active { display: flex; }
  .nb-b-modal-box { background: #FFFDF7; border: 1px solid #C8922A; border-radius: 16px; padding: 22px; max-width: 400px; width: 100%; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.3); }
  .nb-b-modal-close { position: absolute; top: 10px; right: 14px; background: none; border: none; font-size: 1.5rem; color: #2C1810; cursor: pointer; line-height: 1; }
  .nb-b-modal-box h3 { font-size: 1.15rem; font-weight: 800; color: #2C1810; margin: 0 0 8px; }
  .nb-b-modal-box p { font-size: 0.83rem; color: #7A5C4A; margin: 0 0 10px; }
  .nb-b-modal-list { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-direction: column; gap: 6px; font-size: 0.82rem; font-weight: 600; color: #2C1810; }
  .nb-b-modal-note { font-size: 0.76rem !important; font-style: italic; color: #C8922A !important; }
  </style>

  <script>
  function nbOpenDeliveryModal() {
    var modal = document.getElementById('nb-b-delivery-modal');
    if (modal) modal.classList.add('active');
  }
  function nbCloseDeliveryModal() {
    var modal = document.getElementById('nb-b-delivery-modal');
    if (modal) modal.classList.remove('active');
  }
  </script>
</section>

