{% comment %}
  NIAMAT BIRYANI — Behrouz-Inspired Royal Mobile-First Restaurant Homepage
  100% Fully Completed with Full Theme Editor Color Controls
{% endcomment %}

{% liquid
  assign page_bg = section.settings.color_page_bg | default: '#FFFAF4'
  assign dark_bg = section.settings.color_dark_bg | default: '#1E100A'
  assign card_bg = section.settings.color_card_bg | default: '#FFFFFF'
  assign alt_bg = section.settings.color_alt_bg | default: '#FDF6EC'
  assign gold_color = section.settings.color_accent_gold | default: '#C8922A'
  assign text_dark = section.settings.color_text_dark | default: '#2C1810'
  assign text_muted = section.settings.color_text_muted | default: '#7A5C4A'
  assign status_bg = section.settings.color_status_bg | default: '#1E100A'
  assign btn1_bg = section.settings.color_btn1_bg | default: '#C8922A'
  assign btn1_text = section.settings.color_btn1_text | default: '#FFFFFF'

  assign status_text = section.settings.status_text
  if status_text == blank
    assign status_text = 'Kitchen Open - Lunch 12-3 PM, Dinner 6-9 PM'
  endif

  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'Real Biryani. Made Fresh. Delivered to Your Door.'
  endif

  assign hero_subheading = section.settings.hero_subheading
  if hero_subheading == blank
    assign hero_subheading = 'Slow-cooked dum biryani from our cloud kitchen. Order now for delivery in 45-60 minutes.'
  endif

  assign hero_btn1_text = section.settings.hero_btn1_text
  if hero_btn1_text == blank
    assign hero_btn1_text = 'Order Now'
  endif

  assign hero_btn1_url = section.settings.hero_btn1_url
  if hero_btn1_url == blank
    assign hero_btn1_url = '/pages/start-your-order'
  endif

  assign hero_btn2_text = section.settings.hero_btn2_text
  if hero_btn2_text == blank
    assign hero_btn2_text = 'See Full Menu'
  endif

  assign hero_btn2_url = section.settings.hero_btn2_url
  if hero_btn2_url == blank
    assign hero_btn2_url = '/collections/instant-delivery'
  endif

  assign today_heading = section.settings.today_heading
  if today_heading == blank
    assign today_heading = "What's Ready Today"
  endif

  assign today_subheading = section.settings.today_subheading
  if today_subheading == blank
    assign today_subheading = 'Fresh batches coming hot out of the handi for fast dispatch.'
  endif

  assign today_cta_text = section.settings.today_cta_text
  if today_cta_text == blank
    assign today_cta_text = 'Order Instant Items'
  endif

  assign today_cta_url = section.settings.today_cta_url
  if today_cta_url == blank
    assign today_cta_url = '/collections/instant-delivery'
  endif

  assign family_heading = section.settings.family_heading
  if family_heading == blank
    assign family_heading = 'Feeding a Crowd?'
  endif

  assign family_subheading = section.settings.family_subheading
  if family_subheading == blank
    assign family_subheading = 'Planning a party, family gathering or office lunch? Pre-order 1 Kg to 10 Kg handis with scheduled delivery.'
  endif

  assign family_cta_text = section.settings.family_cta_text
  if family_cta_text == blank
    assign family_cta_text = 'Plan Family Order'
  endif

  assign family_cta_url = section.settings.family_cta_url
  if family_cta_url == blank
    assign family_cta_url = '/pages/family-feast'
  endif

  assign final_heading = section.settings.final_heading
  if final_heading == blank
    assign final_heading = 'Ready to Order?'
  endif

  assign final_subheading = section.settings.final_subheading
  if final_subheading == blank
    assign final_subheading = 'Experience authentic dum biryani freshly prepared for your appetite.'
  endif

  assign final_cta_text = section.settings.final_cta_text
  if final_cta_text == blank
    assign final_cta_text = 'Start Your Order'
  endif

  assign final_cta_url = section.settings.final_cta_url
  if final_cta_url == blank
    assign final_cta_url = '/pages/start-your-order'
  endif
%}

<div class="nb-homepage-wrapper" style="
  --nb-page-bg: {{ page_bg }};
  --nb-dark-bg: {{ dark_bg }};
  --nb-card-bg: {{ card_bg }};
  --nb-alt-bg: {{ alt_bg }};
  --nb-gold: {{ gold_color }};
  --nb-text-dark: {{ text_dark }};
  --nb-text-muted: {{ text_muted }};
  --nb-status-bg: {{ status_bg }};
  --nb-btn1-bg: {{ btn1_bg }};
  --nb-btn1-text: {{ btn1_text }};
">

  <!-- 1. STATUS BAR -->
  {% unless section.settings.show_status == false %}
    <div class="nb-status-bar">
      <div class="nb-status-inner">
        <span class="nb-pulse-dot"></span>
        <span>{{ status_text }}</span>
      </div>
    </div>
  {% endunless %}

  <!-- 2. HERO BANNER -->
  {% unless section.settings.show_hero == false %}
    <div class="nb-hero-banner">
      {% if section.settings.hero_video_url != blank %}
        <video autoplay muted loop playsinline class="nb-hero-bg">
          <source src="{{ section.settings.hero_video_url }}" type="video/mp4" />
        </video>
        <div class="nb-hero-overlay"></div>
      {% elsif section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1400 }}" alt="Biryani Palace" class="nb-hero-bg-img" width="1400" height="700" loading="eager" />
        <div class="nb-hero-overlay"></div>
      {% else %}
        <div class="nb-hero-glow"></div>
      {% endif %}

      <div class="nb-hero-content">
        <span class="nb-hero-badge">Authentic Hyderabadi Dum Biryani</span>
        <h1 class="nb-hero-title">{{ hero_heading }}</h1>
        <p class="nb-hero-sub">{{ hero_subheading }}</p>

        <div class="nb-hero-buttons">
          <a href="{{ hero_btn1_url }}" class="nb-btn-gold">{{ hero_btn1_text }}</a>
          <a href="{{ hero_btn2_url }}" class="nb-btn-outline">{{ hero_btn2_text }}</a>
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- 3. ORDER YOUR WAY (2 CARDS) -->
  <div class="nb-section-block">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Dining Options</span>
        <h2>Order Your Way</h2>
      </div>

      <div class="nb-grid-2">
        {% for block in section.blocks %}
          {% if block.type == 'order_way' %}
            <div class="nb-card nb-card-exp" {{ block.shopify_attributes }}>
              <div class="nb-card-top">
                <span class="nb-chip">{{ block.settings.badge }}</span>
              </div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
              <a href="{{ block.settings.cta_url | default: '/collections/instant-delivery' }}" class="nb-btn-gold nb-w-full">
                {{ block.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 4. TODAY'S KITCHEN -->
  {% unless section.settings.show_today == false %}
    <div class="nb-section-block nb-bg-alt">
      <div class="nb-container">
        <div class="nb-section-header flex-between">
          <div>
            <span class="nb-tag-badge">Fresh Dum Batches</span>
            <h2>{{ today_heading }}</h2>
            <p>{{ today_subheading }}</p>
          </div>
          <a href="{{ today_cta_url }}" class="nb-btn-gold">{{ today_cta_text }}</a>
        </div>

        <div class="nb-badges-row">
          {% for block in section.blocks %}
            {% if block.type == 'today_badge' %}
              <div class="nb-badge-pill" {{ block.shopify_attributes }}>
                <span>{{ block.settings.icon }}</span>
                <strong>{{ block.settings.label }}</strong>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- 5. WHY CHOOSE US (4 POINTS) -->
  <div class="nb-section-block">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Our Quality</span>
        <h2>Why Customers Choose Biryani Palace</h2>
      </div>

      <div class="nb-grid-4">
        {% for block in section.blocks %}
          {% if block.type == 'why_point' %}
            <div class="nb-why-box" {{ block.shopify_attributes }}>
              <div class="nb-why-icon">{{ block.settings.icon }}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.body }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 6. SIGNATURE MENU (DISH CARDS) -->
  <div class="nb-section-block nb-bg-alt">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">House Specialties</span>
        <h2>Signature Dum Biryanis & Starters</h2>
      </div>

      <div class="nb-grid-3">
        {% for block in section.blocks %}
          {% if block.type == 'menu_item' %}
            <div class="nb-dish-card" {{ block.shopify_attributes }}>
              <div class="nb-dish-img-wrap">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.name }}" width="300" height="200" loading="lazy" />
                {% else %}
                  <div class="nb-dish-placeholder">🍛</div>
                {% endif %}
              </div>
              <div class="nb-dish-content">
                <div class="nb-dish-header">
                  <h4>{{ block.settings.name }}</h4>
                  <span class="nb-dish-price">{{ block.settings.price }}</span>
                </div>
                <p>{{ block.settings.description }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 7. FAMILY ORDERS -->
  {% unless section.settings.show_family == false %}
    <div class="nb-section-block">
      <div class="nb-container">
        <div class="nb-family-banner">
          <div class="nb-family-text">
            <span class="nb-tag-badge">Bulk & Catering</span>
            <h2>{{ family_heading }}</h2>
            <p>{{ family_subheading }}</p>
            <a href="{{ family_cta_url }}" class="nb-btn-gold">{{ family_cta_text }}</a>
          </div>
          <div class="nb-family-media">
            {% if section.settings.family_image != blank %}
              <img src="{{ section.settings.family_image | image_url: width: 500 }}" alt="Family Feast" width="500" height="350" loading="lazy" />
            {% else %}
              <div class="nb-family-box">
                <span class="nb-crown">👑</span>
                <h3>Handi Family Feast</h3>
                <p>1 Kg to 10 Kg Packs</p>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- 8. DELIVERY AREAS -->
  <div class="nb-section-block nb-bg-alt">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Coverage</span>
        <h2>Where We Deliver</h2>
      </div>

      <div class="nb-grid-3">
        {% for block in section.blocks %}
          {% if block.type == 'delivery_zone' %}
            <div class="nb-zone-card" {{ block.shopify_attributes }}>
              <div class="nb-zone-icon">📍</div>
              <h4>{{ block.settings.zone_name }}</h4>
              <p>ETA: {{ block.settings.eta }}</p>
              <span class="nb-zone-fee">Fee: {{ block.settings.delivery_fee }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 9. CUSTOMER REVIEWS -->
  <div class="nb-section-block">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Verified Feedback</span>
        <h2>Loved by Our Diners</h2>
      </div>

      <div class="nb-grid-3">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="nb-review-card" {{ block.shopify_attributes }}>
              <div class="nb-stars">Rating: {{ block.settings.rating }}</div>
              <p>"{{ block.settings.review_text }}"</p>
              <div class="nb-reviewer">
                <strong>{{ block.settings.author }}</strong>
                <span>{{ block.settings.location }}</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 10. FAQ ACCORDION -->
  <div class="nb-section-block nb-bg-alt">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Help & FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="nb-faq-list">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <details class="nb-faq-box" {{ block.shopify_attributes }}>
              <summary class="nb-faq-sum">
                <span>{{ block.settings.question }}</span>
                <span class="nb-faq-plus">+</span>
              </summary>
              <div class="nb-faq-body">
                <p>{{ block.settings.answer }}</p>
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 11. FINAL CTA -->
  {% unless section.settings.show_cta == false %}
    <div class="nb-final-cta-wrap">
      <div class="nb-container">
        <div class="nb-final-box">
          <h2>{{ final_heading }}</h2>
          <p>{{ final_subheading }}</p>
          <a href="{{ final_cta_url }}" class="nb-btn-gold nb-btn-lg">{{ final_cta_text }}</a>
        </div>
      </div>
    </div>
  {% endunless %}

</div>

<style>
.nb-homepage-wrapper { background: var(--nb-page-bg, #FFFAF4); color: var(--nb-text-dark, #2C1810); font-family: inherit; width: 100%; overflow-x: hidden; }
.nb-container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
.nb-section-block { padding: 40px 0; }
.nb-bg-alt { background: var(--nb-alt-bg, #FDF6EC); }
.nb-section-header { margin-bottom: 24px; text-align: center; }
.nb-section-header.flex-between { display: flex; justify-content: space-between; align-items: flex-end; text-align: left; }
.nb-tag-badge { display: inline-block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--nb-gold, #C8922A); margin-bottom: 6px; }
.nb-section-header h2 { font-size: 1.5rem; font-weight: 800; color: var(--nb-text-dark, #2C1810); margin: 0 0 6px; }
.nb-section-header p { font-size: 0.88rem; color: var(--nb-text-muted, #7A5C4A); margin: 0; }

.nb-status-bar { background: var(--nb-status-bg, #1E100A); color: #FDF6EC; padding: 12px 16px; text-align: center; font-size: 0.85rem; font-weight: 600; border-bottom: 1px solid rgba(200,146,42,0.3); }
.nb-status-inner { display: flex; align-items: center; justify-content: center; gap: 8px; }
.nb-pulse-dot { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; display: inline-block; }

.nb-hero-banner { position: relative; background: linear-gradient(135deg, #160B07 0%, var(--nb-dark-bg, #2C1810) 100%); color: #fff; padding: 50px 16px 60px; text-align: center; overflow: hidden; }
.nb-hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
.nb-hero-bg-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
.nb-hero-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(22, 11, 7, 0.75); z-index: 2; }
.nb-hero-glow { position: absolute; top: -50px; left: 50%; transform: translateX(-50%); width: 300px; height: 300px; background: radial-gradient(circle, rgba(200,146,42,0.3) 0%, transparent 70%); pointer-events: none; z-index: 1; }
.nb-hero-content { position: relative; z-index: 3; max-width: 700px; margin: 0 auto; }
.nb-hero-badge { display: inline-block; background: rgba(200,146,42,0.2); border: 1px solid rgba(200,146,42,0.4); color: #FDF6EC; font-size: 0.78rem; font-weight: 700; padding: 4px 14px; border-radius: 20px; margin-bottom: 14px; }
.nb-hero-title { font-size: 1.8rem; font-weight: 800; color: #FFFDF7; margin: 0 0 12px; line-height: 1.25; }
.nb-hero-sub { font-size: 0.9rem; color: #E2D5C5; margin: 0 0 24px; line-height: 1.5; }
.nb-hero-buttons { display: flex; flex-direction: column; gap: 12px; max-width: 380px; margin: 0 auto; }

.nb-btn-gold { background: var(--nb-btn1-bg, #C8922A); color: var(--nb-btn1-text, #ffffff) !important; font-weight: 700; font-size: 0.9rem; padding: 13px 22px; border-radius: 10px; text-decoration: none; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s ease; box-shadow: 0 4px 14px rgba(200,146,42,0.3); }
.nb-btn-gold:hover { opacity: 0.9; }
.nb-btn-outline { background: rgba(255,250,244,0.08); border: 1.5px solid rgba(200,146,42,0.4); color: #FDF6EC !important; font-weight: 700; font-size: 0.9rem; padding: 13px 22px; border-radius: 10px; text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
.nb-btn-lg { font-size: 1rem; padding: 15px 30px; }
.nb-w-full { width: 100%; box-sizing: border-box; text-align: center; }

.nb-grid-2 { display: grid; grid-template-columns: 1fr; gap: 16px; }
.nb-grid-3 { display: grid; grid-template-columns: 1fr; gap: 16px; }
.nb-grid-4 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.nb-card { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 16px; padding: 22px 18px; display: flex; flex-direction: column; }
.nb-card-exp h3 { font-size: 1.2rem; font-weight: 800; color: var(--nb-text-dark, #2C1810); margin: 8px 0 6px; }
.nb-card-exp p { font-size: 0.84rem; color: var(--nb-text-muted, #7A5C4A); margin: 0 0 16px; flex: 1; line-height: 1.45; }
.nb-chip { font-size: 0.72rem; font-weight: 700; background: rgba(200,146,42,0.12); color: var(--nb-gold, #C8922A); padding: 3px 10px; border-radius: 20px; }

.nb-badges-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 18px; }
.nb-badge-pill { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.25); border-radius: 25px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--nb-text-dark, #2C1810); }

.nb-why-box { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 14px; padding: 18px 14px; text-align: center; }
.nb-why-icon { font-size: 2rem; margin-bottom: 8px; }
.nb-why-box h4 { font-size: 0.92rem; font-weight: 700; color: var(--nb-text-dark, #2C1810); margin: 0 0 4px; }
.nb-why-box p { font-size: 0.78rem; color: var(--nb-text-muted, #7A5C4A); margin: 0; line-height: 1.4; }

.nb-dish-card { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
.nb-dish-img-wrap { width: 100%; height: 160px; background: #F5ECD7; overflow: hidden; }
.nb-dish-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.nb-dish-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; }
.nb-dish-content { padding: 16px; flex: 1; display: flex; flex-direction: column; }
.nb-dish-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.nb-dish-header h4 { font-size: 1rem; font-weight: 700; color: var(--nb-text-dark, #2C1810); margin: 0; }
.nb-dish-price { font-size: 1rem; font-weight: 800; color: var(--nb-gold, #C8922A); }
.nb-dish-content p { font-size: 0.8rem; color: var(--nb-text-muted, #7A5C4A); margin: 0; line-height: 1.4; }

.nb-family-banner { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.25); border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 20px; align-items: center; }
.nb-family-text { flex: 1; }
.nb-family-text h2 { font-size: 1.4rem; font-weight: 800; color: var(--nb-text-dark, #2C1810); margin: 6px 0 8px; }
.nb-family-text p { font-size: 0.86rem; color: var(--nb-text-muted, #7A5C4A); margin: 0 0 18px; line-height: 1.45; }
.nb-family-media { width: 100%; text-align: center; }
.nb-family-media img { width: 100%; border-radius: 12px; object-fit: cover; }
.nb-family-box { background: linear-gradient(135deg, #FDF6EC 0%, #F5ECD7 100%); border: 1px solid rgba(200,146,42,0.3); border-radius: 14px; padding: 30px 20px; }
.nb-crown { font-size: 2.5rem; display: block; margin-bottom: 6px; }
.nb-family-box h3 { font-size: 1.1rem; font-weight: 800; color: #2C1810; margin: 0 0 4px; }
.nb-family-box p { font-size: 0.8rem; color: #C8922A; font-weight: 700; margin: 0; }

.nb-zone-card { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 14px; padding: 18px; text-align: center; }
.nb-zone-icon { font-size: 1.8rem; margin-bottom: 6px; }
.nb-zone-card h4 { font-size: 0.95rem; font-weight: 700; color: var(--nb-text-dark, #2C1810); margin: 0 0 4px; }
.nb-zone-card p { font-size: 0.8rem; color: var(--nb-text-muted, #7A5C4A); margin: 0 0 6px; }
.nb-zone-fee { font-size: 0.74rem; font-weight: 700; background: rgba(200,146,42,0.15); color: var(--nb-gold, #C8922A); padding: 3px 10px; border-radius: 12px; display: inline-block; }

.nb-review-card { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 14px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; }
.nb-stars { color: #f59e0b; font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; }
.nb-review-card p { font-size: 0.83rem; color: var(--nb-text-dark, #2C1810); font-style: italic; line-height: 1.45; margin: 0 0 12px; }
.nb-reviewer strong { display: block; font-size: 0.84rem; color: var(--nb-text-dark, #2C1810); }
.nb-reviewer span { font-size: 0.72rem; color: #16a34a; font-weight: 600; }

.nb-faq-list { max-width: 750px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
.nb-faq-box { background: var(--nb-card-bg, #FFFFFF); border: 1px solid rgba(200,146,42,0.2); border-radius: 12px; overflow: hidden; }
.nb-faq-sum { padding: 14px 18px; font-size: 0.9rem; font-weight: 700; color: var(--nb-text-dark, #2C1810); cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; }
.nb-faq-sum::-webkit-details-marker { display: none; }
.nb-faq-plus { font-size: 1.1rem; color: var(--nb-gold, #C8922A); }
.nb-faq-body { padding: 0 18px 14px; font-size: 0.84rem; color: var(--nb-text-muted, #7A5C4A); line-height: 1.45; }

.nb-final-cta-wrap { background: linear-gradient(135deg, #160B07 0%, var(--nb-dark-bg, #2C1810) 100%); color: #fff; padding: 50px 16px; text-align: center; }
.nb-final-box h2 { font-size: 1.8rem; font-weight: 800; color: #FFFDF7; margin: 0 0 10px; }
.nb-final-box p { font-size: 0.9rem; color: #E2D5C5; max-width: 500px; margin: 0 auto 24px; line-height: 1.5; }

@media (min-width: 768px) {
  .nb-section-block { padding: 60px 0; }
  .nb-section-header h2 { font-size: 1.9rem; }
  .nb-hero-banner { padding: 80px 24px; }
  .nb-hero-title { font-size: 2.7rem; }
  .nb-hero-sub { font-size: 1.05rem; }
  .nb-hero-buttons { flex-direction: row; max-width: 480px; }
  .nb-hero-buttons a { flex: 1; }
  .nb-grid-2 { grid-template-columns: 1fr 1fr; gap: 24px; }
  .nb-grid-3 { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .nb-grid-4 { grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .nb-family-banner { flex-direction: row; padding: 40px; }
  .nb-family-media { width: 350px; flex-shrink: 0; }
  .nb-final-cta-wrap { padding: 70px 24px; }
  .nb-final-box h2 { font-size: 2.3rem; }
}
</style>

