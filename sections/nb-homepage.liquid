{% comment %}
  NIAMAT BIRYANI — Behrouz-Inspired Royal Mobile-First Restaurant Homepage
  100% HTML Validated & Fully Customizable in Shopify Theme Editor
{% endcomment %}
{% render 'food-card-styles' %}

<section class="nb-behrouz-home" style="--nb-bg: {{ section.settings.color_page_bg | default: '#FFFAF4' }}; --nb-dark: {{ section.settings.color_dark_bg | default: '#1E100A' }}; --nb-gold: {{ section.settings.color_accent_gold | default: '#C8922A' }};">

  <!-- ① KITCHEN STATUS BAR -->
  {% if section.settings.show_status != false %}
  <div class="nb-b-status">
    <div class="nb-b-status__inner">
      <div class="nb-b-status__live">
        <span class="nb-b-pulse"></span>
        <span>Kitchen Status: <strong>{{ section.settings.status_title | default: "Open" }}</strong></span>
      </div>
      <span class="nb-b-status__prep">{{ section.settings.status_prep | default: "⏱️ Est. Prep: 30–60 Mins" }}</span>
    </div>
  </div>
  {% endif %}

  <!-- ② ROYAL HERO BANNER -->
  {% if section.settings.show_hero != false %}
  <div class="nb-b-hero">
    {% if section.settings.hero_video_url != blank %}
      <video autoplay muted loop playsinline class="nb-b-hero__video">
        <source src="{{ section.settings.hero_video_url }}" type="video/mp4" />
      </video>
      <div class="nb-b-hero__overlay"></div>
    {% elsif section.settings.hero_image != blank %}
      <div class="nb-b-hero__img" style="background-image: url('{{ section.settings.hero_image | image_url: width: 1400 }}');"></div>
      <div class="nb-b-hero__overlay"></div>
    {% else %}
      <div class="nb-b-hero__glow"></div>
    {% endif %}

    <div class="nb-b-container nb-b-hero__content">
      <div class="nb-b-hero__badge-wrap">
        <span class="nb-b-hero__badge">{{ section.settings.hero_badge | default: "⚡ Authentic Hyderabadi Dum Biryani" }}</span>
      </div>
      <h1 class="nb-b-hero__headline">{{ section.settings.hero_title | default: "Premium Dum Biryani, Freshly Prepared for Every Occasion" }}</h1>
      <p class="nb-b-hero__subheading">{{ section.settings.hero_subtitle | default: "Whether you're craving a quick meal or planning a family gathering, enjoy freshly prepared biryani made with carefully selected ingredients and delivered across Kalyan and nearby areas." }}</p>

      <div class="nb-b-hero__actions">
        <a href="{{ section.settings.hero_btn1_link | default: '/collections/instant-delivery' }}" class="nb-b-btn-gold">
          <span>{{ section.settings.hero_btn1_text | default: "⚡ Order Instant Delivery" }}</span>
        </a>
        <a href="{{ section.settings.hero_btn2_link | default: '/pages/family-feast' }}" class="nb-b-btn-glass">
          <span>{{ section.settings.hero_btn2_text | default: "👑 Plan a Family Order" }}</span>
        </a>
      </div>

      <div class="nb-b-hero__trust">
        {{ section.settings.hero_trust_text | default: "✓ Freshly Prepared &nbsp;•&nbsp; ✓ 100% Halal &nbsp;•&nbsp; ✓ Secure Online Payments" }}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ③ CHOOSE YOUR DINING EXPERIENCE (DUAL BEHAVIOR GATE) -->
  {% if section.settings.show_exp != false %}
  <div class="nb-b-section">
    <div class="nb-b-container">
      <div class="nb-b-head text-center">
        <span class="nb-b-subhead">Tailored Dining</span>
        <h2 class="nb-b-title">{{ section.settings.exp_title | default: "How Would You Like to Order?" }}</h2>
      </div>

      <div class="nb-b-exp-grid">
        <!-- Instant Delivery Card -->
        <div class="nb-b-exp-card nb-b-exp-card--instant">
          <div class="nb-b-exp-card__header">
            <span class="nb-b-tag">⚡ Today's Craving</span>
            <div class="nb-b-exp-icon">🍛</div>
          </div>
          <h3 class="nb-b-exp-card__title">{{ section.settings.instant_card_title | default: "Instant Delivery" }}</h3>
          <p class="nb-b-exp-card__desc">{{ section.settings.instant_card_desc | default: "Freshly prepared portions available today. Ready in approximately 30–60 minutes." }}</p>
          <div class="nb-b-exp-card__meta">
            <span>🚀 30–60 Min Delivery</span>
            <span>📍 Kalyan & Nearby</span>
          </div>
          <a href="{{ section.settings.instant_card_link | default: '/collections/instant-delivery' }}" class="nb-b-btn-gold nb-b-btn-full">
            {{ section.settings.instant_card_cta | default: "Order Now" }}
          </a>
        </div>

        <!-- Family Orders Card -->
        <div class="nb-b-exp-card nb-b-exp-card--family">
          <div class="nb-b-exp-card__header">
            <span class="nb-b-tag gold">👑 Gatherings & Parties</span>
            <div class="nb-b-exp-icon">👨‍👩‍👧‍👦</div>
          </div>
          <h3 class="nb-b-exp-card__title">{{ section.settings.family_card_title | default: "Family Orders" }}</h3>
          <p class="nb-b-exp-card__desc">{{ section.settings.family_card_desc | default: "Planning a gathering? Pre-order 1 Kg and above with your preferred delivery schedule." }}</p>
          <div class="nb-b-exp-card__meta">
            <span>📦 1 Kg – 10 Kg+ Quantities</span>
            <span>📅 Scheduled Delivery</span>
          </div>
          <a href="{{ section.settings.family_card_link | default: '/pages/family-feast' }}" class="nb-b-btn-glass nb-b-btn-full">
            {{ section.settings.family_card_cta | default: "Plan Family Order" }}
          </a>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ④ TODAY'S AVAILABLE (INSTANT DELIVERY FOOD CARDS) -->
  {% if section.settings.show_today != false %}
  <div class="nb-b-section nb-b-section--alt">
    <div class="nb-b-container">
      <div class="nb-b-head flex-between">
        <div>
          <span class="nb-b-subhead">Fresh Dum Batches</span>
          <h2 class="nb-b-title">{{ section.settings.today_title | default: "Available Today" }}</h2>
          <p class="nb-b-desc">{{ section.settings.today_desc | default: "Freshly prepared items currently available for instant delivery." }}</p>
        </div>
        <a href="/collections/instant-delivery" class="nb-b-link desktop-only">View All Available →</a>
      </div>

      {% assign instant_coll = collections[section.settings.today_collection] | default: collections['instant-delivery'] %}
      <div class="nb-food-grid">
        {% if instant_coll != blank and instant_coll.products.size > 0 %}
          {% for product in instant_coll.products limit: section.settings.products_to_show | default: 6 %}
            {% liquid
              assign first_variant = product.selected_or_first_available_variant
              assign is_available = first_variant.available
            %}
            <div class="nb-food-card {% unless is_available %}nb-food-card--soldout{% endunless %}">
              <div class="nb-food-card__image">
                {% if product.featured_media %}
                  <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="130" height="130" />
                {% else %}
                  <div class="nb-food-card__image-placeholder">🍛</div>
                {% endif %}
                {% if is_available %}
                  <span class="nb-badge nb-badge--available">⚡ Available Now</span>
                {% else %}
                  <span class="nb-badge nb-badge--soldout">Sold Out</span>
                {% endif %}
              </div>

              <div class="nb-food-card__body">
                <div>
                  <h3 class="nb-food-card__title">{{ product.title }}</h3>
                  {% if product.description != blank %}
                    <p class="nb-food-card__desc">{{ product.description | strip_html | truncate: 65 }}</p>
                  {% endif %}
                </div>

                {% if product.variants.size > 1 %}
                  <div class="nb-variant-selector" data-product-id="{{ product.id }}">
                    {% for variant in product.variants %}
                      <span class="nb-variant-pill {% if forloop.first %}active{% endif %}"
                            data-variant-id="{{ variant.id }}"
                            data-price="{{ variant.price | money }}"
                            data-available="{{ variant.available }}">
                        {{ variant.title }}
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="nb-food-card__bottom">
                  <div>
                    <span class="nb-food-card__price" data-price-display="{{ product.id }}">
                      {{ first_variant.price | money }}
                    </span>
                    <span class="nb-prep-time">⏱️ 30-60m</span>
                  </div>

                  {% if is_available %}
                    <form action="/cart/add" method="post" class="nb-quick-form" data-form="{{ product.id }}">
                      <input type="hidden" name="id" value="{{ first_variant.id }}" class="nb-variant-input" data-product="{{ product.id }}" />
                      <input type="hidden" name="quantity" value="1" />
                      <button type="submit" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</button>
                    </form>
                  {% else %}
                    <button type="button" class="nb-btn nb-btn--disabled nb-btn--sm" disabled>Sold Out</button>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Demo Food Card -->
          <div class="nb-food-card">
            <div class="nb-food-card__image">
              <div class="nb-food-card__image-placeholder">🍗</div>
              <span class="nb-badge nb-badge--available">⚡ Available Now</span>
            </div>
            <div class="nb-food-card__body">
              <div>
                <h3 class="nb-food-card__title">Chicken Dum Biryani</h3>
                <p class="nb-food-card__desc">Tender chicken marinated in aromatic spices and layered with premium basmati rice.</p>
              </div>
              <div class="nb-food-card__bottom">
                <div>
                  <span class="nb-food-card__price">₹280</span>
                  <span class="nb-prep-time">⏱️ 30-60m</span>
                </div>
                <a href="/collections/instant-delivery" class="nb-btn nb-btn--gold nb-btn--sm">Order Now</a>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="text-center mobile-only mt-16">
        <a href="/collections/instant-delivery" class="nb-b-btn-gold">View Full Instant Menu →</a>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑤ WHY CHOOSE US (4 PILLARS) -->
  {% if section.settings.show_reasons != false %}
  <div class="nb-b-section">
    <div class="nb-b-container">
      <div class="nb-b-head text-center">
        <span class="nb-b-subhead">Our Commitment</span>
        <h2 class="nb-b-title">{{ section.settings.reasons_title | default: "Why Customers Choose Biryani Palace by Niamat" }}</h2>
      </div>

      <div class="nb-b-reasons-grid">
        <div class="nb-b-reason-card">
          <div class="nb-b-reason-icon">🍲</div>
          <h4>Freshly Prepared</h4>
          <p>Prepared for every service using carefully selected ingredients.</p>
        </div>

        <div class="nb-b-reason-card">
          <div class="nb-b-reason-icon">🌙</div>
          <h4>100% Halal</h4>
          <p>Prepared following halal practices.</p>
        </div>

        <div class="nb-b-reason-card">
          <div class="nb-b-reason-icon">🔒</div>
          <h4>Secure Online Ordering</h4>
          <p>Fast and secure online checkout.</p>
        </div>

        <div class="nb-b-reason-card">
          <div class="nb-b-reason-icon">👨‍👩‍👧‍👦</div>
          <h4>Family Focused</h4>
          <p>Perfect for everyday meals and family gatherings.</p>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑥ SIGNATURE COLLECTION BANNER -->
  {% if section.settings.show_signature != false %}
  <div class="nb-b-section nb-b-section--dark-banner">
    <div class="nb-b-container">
      <div class="nb-b-banner-box">
        <span class="nb-b-subhead gold">Full Culinary Range</span>
        <h2>{{ section.settings.sig_title | default: "Explore Our Signature Menu" }}</h2>
        <p>{{ section.settings.sig_desc | default: "Discover our complete range of biryanis, starters and sides." }}</p>
        <a href="{{ section.settings.sig_btn_link | default: '/collections/all' }}" class="nb-b-btn-gold">
          {{ section.settings.sig_btn_text | default: "View Full Menu" }}
        </a>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑦ FAMILY GATHERINGS & EVENTS -->
  {% if section.settings.show_family != false %}
  <div class="nb-b-section nb-b-section--alt">
    <div class="nb-b-container">
      <div class="nb-b-family-card">
        <div class="nb-b-family-content">
          <span class="nb-b-subhead">Advance Catering</span>
          <h2 class="nb-b-title">{{ section.settings.family_title | default: "Made for Family Gatherings" }}</h2>
          <p class="nb-b-desc">{{ section.settings.family_desc | default: "Planning a celebration, office lunch or weekend family meal? Pre-order your preferred quantity and delivery time." }}</p>

          <ul class="nb-b-family-list">
            <li>✓ Custom Portioning (1 Kg Serves 4–5 People)</li>
            <li>✓ Timed Slots Guaranteed Fresh from Handi</li>
            <li>✓ Special Handi Packaging Included</li>
          </ul>

          <a href="{{ section.settings.family_btn_link | default: '/pages/family-feast' }}" class="nb-b-btn-glass">
            {{ section.settings.family_btn_text | default: "Book Family Order" }}
          </a>
        </div>
        <div class="nb-b-family-visual">
          <div class="nb-b-crown-icon">👑</div>
          <h3>Handi Family Feast</h3>
          <p>1 Kg, 2 Kg & Bulk Packs</p>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑧ WHERE WE DELIVER (DELIVERY AREAS) -->
  {% if section.settings.show_delivery != false %}
  <div class="nb-b-section">
    <div class="nb-b-container">
      <div class="nb-b-delivery-box">
        <div class="nb-b-del-icon">📍</div>
        <h2 class="nb-b-title">{{ section.settings.delivery_title | default: "Where We Deliver" }}</h2>
        <p class="nb-b-desc">{{ section.settings.delivery_desc | default: "Serving Kalyan and selected nearby areas. Delivery availability and charges are confirmed during checkout based on your location." }}</p>

        <div class="nb-b-area-pills">
          <span class="nb-b-area-pill">Kalyan West</span>
          <span class="nb-b-area-pill">Kalyan East</span>
          <span class="nb-b-area-pill">Khadakpada</span>
          <span class="nb-b-area-pill">Adharwadi</span>
          <span class="nb-b-area-pill">Shahad</span>
          <span class="nb-b-area-pill">Dombivli (Select Areas)</span>
        </div>

        <button type="button" class="nb-b-btn-gold" onclick="nbOpenDeliveryModal()">Check Delivery Availability</button>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑨ CUSTOMER REVIEWS (GOOGLE VERIFIED) -->
  {% if section.settings.show_reviews != false %}
  <div class="nb-b-section nb-b-section--alt">
    <div class="nb-b-container">
      <div class="nb-b-head text-center">
        <span class="nb-b-subhead">Verified Reviews</span>
        <h2 class="nb-b-title">{{ section.settings.reviews_title | default: "Loved by Our Customers" }}</h2>
        <p class="nb-b-desc">Read genuine Google Reviews from customers who have enjoyed our food.</p>
      </div>

      <div class="nb-b-reviews-grid">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="nb-b-review-card" {{ block.shopify_attributes }}>
              <div class="nb-b-review-stars">★★★★★</div>
              <p class="nb-b-review-text">"{{ block.settings.text }}"</p>
              <div class="nb-b-review-author">
                <strong>{{ block.settings.author }}</strong>
                <span>Google Verified Review</span>
              </div>
            </div>
          {% endif %}
        {% else %}
          <div class="nb-b-review-card">
            <div class="nb-b-review-stars">★★★★★</div>
            <p class="nb-b-review-text">"The Chicken Dum Biryani from Niamat Biryani is authentic and rich in flavor! Meat was super tender, rice perfectly spiced. Best in Kalyan!"</p>
            <div class="nb-b-review-author">
              <strong>Sumaiya N.</strong>
              <span>Google Verified Review</span>
            </div>
          </div>
          <div class="nb-b-review-card">
            <div class="nb-b-review-stars">★★★★★</div>
            <p class="nb-b-review-text">"Ordered 2 Kg Mutton Biryani for a family weekend lunch. It arrived piping hot right on schedule. Everyone loved the taste!"</p>
            <div class="nb-b-review-author">
              <strong>Rahul M.</strong>
              <span>Google Verified Review</span>
            </div>
          </div>
          <div class="nb-b-review-card">
            <div class="nb-b-review-stars">★★★★★</div>
            <p class="nb-b-review-text">"Clean, 100% halal, and extremely hygienic packaging. Fast instant delivery within 35 minutes."</p>
            <div class="nb-b-review-author">
              <strong>Imran K.</strong>
              <span>Google Verified Review</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑩ FREQUENTLY ASKED QUESTIONS (ACCORDION) -->
  {% if section.settings.show_faq != false %}
  <div class="nb-b-section">
    <div class="nb-b-container">
      <div class="nb-b-head text-center">
        <span class="nb-b-subhead">Help & Info</span>
        <h2 class="nb-b-title">{{ section.settings.faq_title | default: "Frequently Asked Questions" }}</h2>
      </div>

      <div class="nb-b-faq-accordion">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details class="nb-b-faq-item" {{ block.shopify_attributes }}>
              <summary class="nb-b-faq-question">
                <span>{{ block.settings.question }}</span>
                <span class="nb-b-faq-icon">+</span>
              </summary>
              <div class="nb-b-faq-answer">
                <p>{{ block.settings.answer }}</p>
              </div>
            </details>
          {% endif %}
        {% else %}
          <details class="nb-b-faq-item">
            <summary class="nb-b-faq-question">
              <span>How fast is Instant Delivery?</span>
              <span class="nb-b-faq-icon">+</span>
            </summary>
            <div class="nb-b-faq-answer">
              <p>Instant Delivery orders are prepared fresh and dispatched promptly. Most orders arrive within 30 to 60 minutes depending on your location in Kalyan.</p>
            </div>
          </details>
          <details class="nb-b-faq-item">
            <summary class="nb-b-faq-question">
              <span>Which areas do you deliver to?</span>
              <span class="nb-b-faq-icon">+</span>
            </summary>
            <div class="nb-b-faq-answer">
              <p>We deliver across Kalyan West, Kalyan East, Khadakpada, Adharwadi, Shahad, and surrounding locations.</p>
            </div>
          </details>
          <details class="nb-b-faq-item">
            <summary class="nb-b-faq-question">
              <span>What payment methods are supported?</span>
              <span class="nb-b-faq-icon">+</span>
            </summary>
            <div class="nb-b-faq-answer">
              <p>We support all major online payment options including Google Pay, PhonePe, Paytm, Credit/Debit Cards, Net Banking, and Cash on Delivery.</p>
            </div>
          </details>
          <details class="nb-b-faq-item">
            <summary class="nb-b-faq-question">
              <span>Is the food prepared fresh for every order?</span>
              <span class="nb-b-faq-icon">+</span>
            </summary>
            <div class="nb-b-faq-answer">
              <p>Yes, absolutely. We prepare our biryanis in fresh dum batches throughout the day to ensure authentic aroma, moisture, and flavor in every portion.</p>
            </div>
          </details>
          <details class="nb-b-faq-item">
            <summary class="nb-b-faq-question">
              <span>Is the meat 100% Halal certified?</span>
              <span class="nb-b-faq-icon">+</span>
            </summary>
            <div class="nb-b-faq-answer">
              <p>Yes. All meats used at Biryani Palace by Niamat are 100% halal certified and handled following strict hygiene protocols.</p>
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ⑪ FINAL CALL TO ACTION -->
  {% if section.settings.show_final_cta != false %}
  <div class="nb-b-section nb-b-section--final-cta">
    <div class="nb-b-container">
      <div class="nb-b-final-box">
        <h2>{{ section.settings.final_cta_title | default: "Ready to Enjoy Freshly Prepared Biryani?" }}</h2>
        <p>{{ section.settings.final_cta_desc | default: "Choose Instant Delivery for today's cravings or plan your next family gathering with our advance ordering service." }}</p>
        <div class="nb-b-final-actions">
          <a href="{{ section.settings.final_btn1_link | default: '/collections/instant-delivery' }}" class="nb-b-btn-gold">
            {{ section.settings.final_btn1_text | default: "Order Instant Delivery" }}
          </a>
          <a href="{{ section.settings.final_btn2_link | default: '/pages/family-feast' }}" class="nb-b-btn-glass">
            {{ section.settings.final_btn2_text | default: "Plan Family Order" }}
          </a>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- DELIVERY AVAILABILITY MODAL -->
  <div id="nb-b-delivery-modal" class="nb-b-modal-overlay">
    <div class="nb-b-modal-box">
      <button type="button" class="nb-b-modal-close" onclick="nbCloseDeliveryModal()">×</button>
      <h3>📍 Delivery Coverage</h3>
      <p>We deliver freshly prepared Dum Biryani across:</p>
      <ul class="nb-b-modal-list">
        <li>✓ Kalyan West (30–45 mins)</li>
        <li>✓ Kalyan East (35–50 mins)</li>
        <li>✓ Khadakpada & Adharwadi (30–40 mins)</li>
        <li>✓ Shahad & Titwala Road (40–60 mins)</li>
        <li>✓ Dombivli (Select Pincodes)</li>
      </ul>
      <p class="nb-b-modal-note">Exact delivery time & fee confirmed automatically at checkout.</p>
      <button type="button" class="nb-b-btn-gold nb-b-btn-full" onclick="nbCloseDeliveryModal()">Got it!</button>
    </div>
  </div>

  <style>
  .nb-behrouz-home { background: var(--nb-bg, #FFFAF4); color: #2C1810; display: block; overflow-x: hidden; font-family: inherit; }
  .nb-b-container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .text-center { text-align: center; }
  .flex-between { display: flex; justify-content: space-between; align-items: flex-end; }
  .desktop-only { display: none; }
  .mobile-only { display: block; }
  .mt-16 { margin-top: 16px; }

  @media (min-width: 768px) {
    .nb-b-container { padding: 0 24px; }
    .desktop-only { display: inline-block; }
    .mobile-only { display: none; }
  }

  /* KITCHEN STATUS */
  .nb-b-status { background: #1E100A; color: #FDF6EC; padding: 12px 16px; border-bottom: 1px solid rgba(200, 146, 42, 0.3); }
  .nb-b-status__inner { max-width: 1040px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 0.82rem; }
  .nb-b-status__live { display: flex; align-items: center; gap: 8px; }
  .nb-b-pulse { width: 9px; height: 9px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); animation: nbPulseGreen 1.8s infinite; }
