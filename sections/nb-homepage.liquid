{% comment %} NIAMAT BIRYANI — Original Homepage Section {% endcomment %}

<section class="nb-home">
  <!-- ① KITCHEN STATUS -->
  {% if section.settings.show_status != false %}
    <div class="nb-status-bar">
      <div class="nb-status-bar__inner">
        <span class="nb-status-dot"></span>
        <span class="nb-status-text">
          {{ section.settings.status_text | default: "⚡ Kitchen Open — Fresh Batches Ready for Instant Delivery & Pre-Order" }}
        </span>
      </div>
    </div>
  {% endif %}

  <!-- ② HERO MEDIA -->
  {% if section.settings.show_hero != false %}
    <div class="nb-hero-media">
      {% if section.settings.hero_video != blank %}
        <video autoplay muted loop playsinline class="nb-hero-media__video">
          <source src="{{ section.settings.hero_video }}" type="video/mp4" />
        </video>
      {% elsif section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1400 }}"
             alt="{{ section.settings.hero_title | escape }}"
             class="nb-hero-media__img"
             loading="lazy"
             width="1400"
             height="600" />
      {% endif %}
      <div class="nb-hero-media__overlay">
        <h2 class="nb-hero-media__title">
          {{ section.settings.hero_title | default: "Authentic Hyderabadi Dum Biryani" }}
        </h2>
        <p class="nb-hero-media__sub">
          {{ section.settings.hero_subtitle | default: "Freshly prepared for every service with premium ingredients, delivered across Kalyan & nearby areas." }}
        </p>
        <a href="{{ section.settings.hero_btn_link | default: '/collections/instant-delivery' }}" class="nb-btn nb-btn--gold nb-btn--lg">
          {{ section.settings.hero_btn_text | default: "Order Instant Delivery" }}
        </a>
      </div>
    </div>
  {% endif %}

  <!-- ③ ORDER YOUR WAY -->
  {% if section.settings.show_ways != false %}
    <div class="nb-order-ways">
      <h2 class="nb-section-title">
        {{ section.settings.ways_title | default: "How Would You Like to Order?" }}
      </h2>
      <p class="nb-section-sub">{{ section.settings.ways_subtitle | default: "Choose instant delivery for today's cravings or advance booking for family gatherings." }}</p>
      <div class="nb-ways-grid">
        <a href="{{ section.settings.instant_link | default: '/collections/instant-delivery' }}" class="nb-way-card">
          <div class="nb-way-card__icon">⚡</div>
          <div class="nb-way-card__body">
            <h3>{{ section.settings.instant_title | default: "Instant Delivery" }}</h3>
            <p>{{ section.settings.instant_desc | default: "Ready in 30–60 minutes for today's lunch & dinner." }}</p>
            <span class="nb-way-card__cta">
              {{ section.settings.instant_cta | default: "Order Now →" }}
            </span>
          </div>
        </a>
        <a href="{{ section.settings.family_link | default: '/pages/family-feast' }}" class="nb-way-card">
          <div class="nb-way-card__icon">👑</div>
          <div class="nb-way-card__body">
            <h3>{{ section.settings.family_title | default: "Family Feast (1 Kg+)" }}</h3>
            <p>{{ section.settings.family_desc | default: "Pre-order 1 Kg and above for weekend family meals & events." }}</p>
            <span class="nb-way-card__cta nb-way-card__cta--outline">
              {{ section.settings.family_cta | default: "Plan Family Order →" }}
            </span>
          </div>
        </a>
      </div>
    </div>
  {% endif %}

  <!-- ④ TODAY'S KITCHEN -->
  {% if section.settings.show_today != false %}
    <div class="nb-today">
      <div class="nb-today__inner">
        <div class="nb-today__text">
          <span class="nb-today__label">Fresh Dum Batches</span>
          <h2>{{ section.settings.today_title | default: "Available Today" }}</h2>
          <p>{{ section.settings.today_desc | default: "Freshly prepared portions available right now for instant delivery across Kalyan." }}</p>
          <a href="{{ section.settings.today_btn_link | default: '/collections/instant-delivery' }}" class="nb-btn nb-btn--gold">
            {{ section.settings.today_btn_text | default: "Explore Instant Menu" }}
          </a>
        </div>
      </div>
    </div>
  {% endif %}
</section>

<style>
.nb-home { background: #FFFAF4; color: #2C1810; padding-bottom: 60px; display: block; }
.nb-status-bar { background: #2C1810; padding: 12px 20px; text-align: center; }
.nb-status-bar__inner { display: inline-flex; align-items: center; gap: 8px; }
.nb-status-dot { width: 8px; height: 8px; background: #2e7d32; border-radius: 50%; display: inline-block; }
.nb-status-text { color: #FDF6EC; font-size: 0.85rem; font-weight: 600; }

.nb-hero-media { position: relative; background: #1E100A; min-height: 380px; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; padding: 40px 20px; }
.nb-hero-media__video, .nb-hero-media__img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
.nb-hero-media__overlay { position: relative; z-index: 2; max-width: 650px; margin: 0 auto; }
.nb-hero-media__title { font-size: 2rem; font-weight: 800; color: #FFFDF7; margin: 0 0 12px; }
.nb-hero-media__sub { font-size: 0.95rem; color: #E2D5C5; margin: 0 0 24px; line-height: 1.5; }

.nb-order-ways { padding: 40px 20px; max-width: 900px; margin: 0 auto; }
.nb-section-title { font-size: 1.5rem; font-weight: 800; color: #2C1810; margin: 0 0 6px; text-align: center; }
.nb-section-sub { font-size: 0.88rem; color: #7A5C4A; margin: 0 0 24px; text-align: center; }
.nb-ways-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 768px) {
  .nb-ways-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
}
.nb-way-card { background: #FFFDF7; border: 1.5px solid rgba(200,146,42,0.3); border-radius: 16px; padding: 24px; text-decoration: none; color: #2C1810; display: flex; gap: 16px; align-items: flex-start; transition: transform 0.2s; }
.nb-way-card:hover { transform: translateY(-3px); }
.nb-way-card__icon { font-size: 2rem; }
.nb-way-card__body h3 { font-size: 1.15rem; font-weight: 800; margin: 0 0 6px; }
.nb-way-card__body p { font-size: 0.84rem; color: #7A5C4A; margin: 0 0 14px; line-height: 1.4; }
.nb-way-card__cta { font-size: 0.84rem; font-weight: 700; color: #C8922A; }

.nb-today { padding: 36px 20px; background: #FDF6EC; }
.nb-today__inner { max-width: 700px; margin: 0 auto; text-align: center; }
.nb-today__label { font-size: 0.75rem; font-weight: 700; color: #C8922A; text-transform: uppercase; letter-spacing: 1px; }
.nb-today__text h2 { font-size: 1.5rem; font-weight: 800; color: #2C1810; margin: 6px 0 10px; }
.nb-today__text p { font-size: 0.88rem; color: #7A5C4A; margin: 0 0 20px; }

.nb-btn { font-size: 0.82rem; font-weight: 700; padding: 8px 16px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; display: inline-block; white-space: nowrap; transition: background 0.15s ease; }
.nb-btn--gold { background: #C8922A; color: #fff; }
.nb-btn--gold:hover { background: #A67520; color: #fff; }
.nb-btn--lg { padding: 12px 24px; font-size: 0.95rem; }
</style>

{% schema %}
{
  "name": "Niamat Homepage",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show Kitchen Status Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Kitchen Status Text",
      "default": "⚡ Kitchen Open — Fresh Batches Ready for Instant Delivery & Pre-Order"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show Hero Section",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Authentic Hyderabadi Dum Biryani"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Freshly prepared for every service with premium ingredients, delivered across Kalyan & nearby areas."
    },
    {
      "type": "text",
      "id": "hero_btn_text",
      "label": "Hero Button Label",
      "default": "Order Instant Delivery"
    },
    {
      "type": "url",
      "id": "hero_btn_link",
      "label": "Hero Button Link",
      "default": "/collections/instant-delivery"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "hero_video",
      "label": "Hero Video URL (MP4)"
    },
    {
      "type": "checkbox",
      "id": "show_ways",
      "label": "Show Ordering Ways",
      "default": true
    },
    {
      "type": "text",
      "id": "ways_title",
      "label": "Ordering Ways Title",
      "default": "How Would You Like to Order?"
    },
    {
      "type": "checkbox",
      "id": "show_today",
      "label": "Show Today's Kitchen",
      "default": true
    },
    {
      "type": "text",
      "id": "today_title",
      "label": "Today Section Title",
      "default": "Available Today"
    }
  ],
  "presets": [
    {
      "name": "Niamat Homepage"
    }
  ]
}
{% endschema %}
