@media (min-width: 768px) {
  .nb-reviews-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
}

/* SECTION 10: FAQ ACCORDION */
.nb-faq-accordion {
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.nb-faq-item {
  background: #FFF;
  border: 1px solid var(--nb-border);
  border-radius: 12px;
  overflow: hidden;
}
.nb-faq-question {
  padding: 16px 20px;
  font-size: 0.92rem;
  font-weight: 700;
