{% comment %} NIAMAT BIRYANI — Mobile-First Food Restaurant Homepage {% endcomment %}
{% render 'food-card-styles' %}

<section class="nb-home">
  <!-- ① LIVE KITCHEN STATUS DOCK -->
  {% if section.settings.show_status != false %}
  <div class="nb-status-header">
    <div class="nb-status-header__inner">
      <span class="nb-pulse-live"></span>
      <span class="nb-status-title">Kitchen Open & Fresh Batches Ready</span>
    </div>
    <span class="nb-prep-time-tag">⏱️ 30–45 Mins</span>
  </div>
  {% endif %}

  <!-- ② RESTAURANT BRAND HERO -->
  {% if section.settings.show_hero != false %}
  <div class="nb-food-hero">
    {% if section.settings.hero_video != blank %}
      <video autoplay muted loop playsinline class="nb-food-hero__video">
        <source src="{{ section.settings.hero_video }}" type="video/mp4" />
      </video>
    {% elsif section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | image_url: width: 1200 }}"
           alt="{{ section.settings.hero_title | escape }}"
           class="nb-food-hero__img"
           loading="lazy"
           width="1200"
           height="600" />
    {% endif %}
    <div class="nb-food-hero__overlay">
      <span class="nb-food-hero__badge">⚡ Kalyan & Nearby Delivery</span>
      <h1 class="nb-food-hero__title">{{ section.settings.hero_title | default: "Biryani Palace by Niamat" }}</h1>
      <p class="nb-food-hero__subtitle">{{ section.settings.hero_subtitle | default: "Freshly prepared dum biryani cooked in authentic handis for every service." }}</p>
      
      <div class="nb-food-hero__ctas">
        <a href="{{ section.settings.hero_btn_link | default: '/collections/instant-delivery' }}" class="nb-btn-gold">
          <span>⚡ Order Instant Delivery</span>
        </a>
        <a href="/pages/family-feast" class="nb-btn-glass">
          <span>👑 Plan Family Feast (1 Kg+)</span>
        </a>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ③ MOBILE DINING EXPERIENCE SWITCHER -->
  {% if section.settings.show_ways != false %}
  <div class="nb-exp-container">
    <div class="nb-exp-switcher">
      <a href="/collections/instant-delivery" class="nb-exp-tab active">
        <span class="nb-exp-tab__icon">⚡</span>
        <span class="nb-exp-tab__text">
          <strong>Instant Delivery</strong>
          <small>Ready in 30-45m</small>
        </span>
      </a>
      <a href="/pages/family-feast" class="nb-exp-tab">
        <span class="nb-exp-tab__icon">👑</span>
        <span class="nb-exp-tab__text">
          <strong>Family Feast</strong>
          <small>1 Kg & Bulk Pre-Orders</small>
        </span>
      </a>
    </div>
  </div>
  {% endif %}

  <!-- ④ TODAY'S FRESH Dum BATCHES (FOOD APP STYLE CARDS) -->
  {% if section.settings.show_today != false %}
  <div class="nb-menu-section">
    <div class="nb-menu-section__head">
      <div>
        <span class="nb-menu-badge">Available Today</span>
        <h2 class="nb-menu-title">{{ section.settings.today_title | default: "Signature Fresh Batches" }}</h2>
      </div>
      <a href="/collections/instant-delivery" class="nb-menu-link">View Menu →</a>
    </div>

    {% assign instant_coll = collections[section.settings.today_collection] | default: collections['instant-delivery'] %}
    <div class="nb-food-cards-list">
      {% if instant_coll != blank and instant_coll.products.size > 0 %}
        {% for product in instant_coll.products limit: 6 %}
          {% liquid
            assign first_variant = product.selected_or_first_available_variant
            assign is_available = first_variant.available
          %}
          <div class="nb-food-card-row">
            <div class="nb-food-card-row__img">
              {% if product.featured_media %}
                <img src="{{ product.featured_media | image_url: width: 250 }}" alt="{{ product.title | escape }}" loading="lazy" width="100" height="100" />
              {% else %}
                <div class="nb-food-card-row__placeholder">🍛</div>
              {% endif %}
              <span class="nb-veg-nonveg-badge">🍗 Non-Veg</span>
            </div>
            <div class="nb-food-card-row__content">
              <h3 class="nb-food-card-row__title">{{ product.title }}</h3>
              <p class="nb-food-card-row__desc">{{ product.description | strip_html | truncate: 60 }}</p>
              
              <div class="nb-food-card-row__bottom">
                <span class="nb-food-card-row__price">{{ first_variant.price | money }}</span>
                
                {% if is_available %}
                  <form action="/cart/add" method="post" class="nb-quick-form">
                    <input type="hidden" name="id" value="{{ first_variant.id }}" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="nb-add-btn">ADD +</button>
                  </form>
                {% else %}
                  <span class="nb-sold-tag">Sold Out</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Demo Food Card 1 -->
        <div class="nb-food-card-row">
          <div class="nb-food-card-row__img">
            <div class="nb-food-card-row__placeholder">🍗</div>
            <span class="nb-veg-nonveg-badge">🍗 Non-Veg</span>
          </div>
          <div class="nb-food-card-row__content">
            <h3 class="nb-food-card-row__title">Chicken Dum Biryani</h3>
            <p class="nb-food-card-row__desc">Tender chicken pieces marinated in aromatic spices and slow-cooked with basmati rice.</p>
            <div class="nb-food-card-row__bottom">
              <span class="nb-food-card-row__price">₹280</span>
              <a href="/collections/instant-delivery" class="nb-add-btn">ORDER +</a>
            </div>
          </div>
        </div>

        <!-- Demo Food Card 2 -->
        <div class="nb-food-card-row">
          <div class="nb-food-card-row__img">
            <div class="nb-food-card-row__placeholder">🥩</div>
            <span class="nb-veg-nonveg-badge">🥩 Non-Veg</span>
          </div>
          <div class="nb-food-card-row__content">
            <h3 class="nb-food-card-row__title">Mutton Dum Biryani</h3>
            <p class="nb-food-card-row__desc">Rich, tender mutton chunks dum-cooked with layered saffron basmati rice.</p>
            <div class="nb-food-card-row__bottom">
              <span class="nb-food-card-row__price">₹360</span>
              <a href="/collections/instant-delivery" class="nb-add-btn">ORDER +</a>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ⑤ RESTAURANT TRUST & REASONS -->
  <div class="nb-trust-strip">
    <div class="nb-trust-item">
      <span>🔥</span>
      <strong>Fresh Dum Prep</strong>
    </div>
    <div class="nb-trust-item">
      <span>🌙</span>
      <strong>100% Halal</strong>
    </div>
    <div class="nb-trust-item">
      <span>🚀</span>
      <strong>30-45m Express</strong>
    </div>
  </div>

  <style>
  .nb-home { background: #FFFAF4; color: #2C1810; padding-bottom: 40px; display: block; overflow-x: hidden; }
  
  .nb-status-header { background: #1E100A; color: #FDF6EC; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; border-bottom: 1px solid rgba(200,146,42,0.3); }
  .nb-status-header__inner { display: flex; align-items: center; gap: 8px; font-weight: 700; }
  .nb-pulse-live { width: 8px; height: 8px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2); }
  .nb-prep-time-tag { background: rgba(200,146,42,0.2); color: #C8922A; font-weight: 700; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; }

  .nb-food-hero { position: relative; background: linear-gradient(135deg, #1E100A 0%, #2C1810 100%); color: #fff; padding: 32px 16px 36px; text-align: center; overflow: hidden; }
  .nb-food-hero__video, .nb-food-hero__img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; }
  .nb-food-hero__overlay { position: relative; z-index: 2; max-width: 540px; margin: 0 auto; }
  .nb-food-hero__badge { display: inline-block; background: rgba(200,146,42,0.25); border: 1px solid rgba(200,146,42,0.4); color: #FDF6EC; font-size: 0.72rem; font-weight: 700; padding: 3px 12px; border-radius: 20px; margin-bottom: 10px; }
  .nb-food-hero__title { font-size: 1.8rem; font-weight: 800; color: #FFFDF7; margin: 0 0 8px; line-height: 1.2; }
  .nb-food-hero__subtitle { font-size: 0.85rem; color: #E2D5C5; margin: 0 0 20px; line-height: 1.4; }
  .nb-food-hero__ctas { display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 600px) { .nb-food-hero__ctas { flex-direction: row; } .nb-food-hero__ctas a { flex: 1; } }

  .nb-btn-gold { background: #C8922A; color: #fff !important; font-weight: 700; font-size: 0.88rem; padding: 12px 18px; border-radius: 10px; text-decoration: none; text-align: center; display: block; border: none; }
  .nb-btn-glass { background: rgba(255,250,244,0.1); border: 1.5px solid rgba(200,146,42,0.4); color: #FDF6EC !important; font-weight: 700; font-size: 0.88rem; padding: 12px 18px; border-radius: 10px; text-decoration: none; text-align: center; display: block; }

  .nb-exp-container { padding: 16px; max-width: 650px; margin: 0 auto; }
  .nb-exp-switcher { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: #FDF6EC; border: 1px solid rgba(200,146,42,0.25); padding: 6px; border-radius: 14px; }
  .nb-exp-tab { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 10px; text-decoration: none; color: #2C1810; background: transparent; transition: all 0.2s; }
  .nb-exp-tab.active { background: #FFF; box-shadow: 0 2px 10px rgba(44,24,16,0.08); border: 1px solid rgba(200,146,42,0.3); }
  .nb-exp-tab__icon { font-size: 1.4rem; }
  .nb-exp-tab__text strong { display: block; font-size: 0.82rem; line-height: 1.1; color: #2C1810; }
  .nb-exp-tab__text small { font-size: 0.68rem; color: #7A5C4A; }

  .nb-menu-section { padding: 16px; max-width: 650px; margin: 0 auto; }
  .nb-menu-section__head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 14px; }
  .nb-menu-badge { font-size: 0.7rem; font-weight: 700; color: #C8922A; text-transform: uppercase; letter-spacing: 0.5px; }
  .nb-menu-title { font-size: 1.25rem; font-weight: 800; color: #2C1810; margin: 2px 0 0; }
  .nb-menu-link { font-size: 0.8rem; font-weight: 700; color: #C8922A; text-decoration: none; }

  .nb-food-cards-list { display: flex; flex-direction: column; gap: 12px; }
  .nb-food-card-row { display: flex; gap: 12px; background: #FFFDF7; border: 1px solid rgba(200,146,42,0.22); border-radius: 14px; padding: 12px; align-items: center; box-shadow: 0 2px 8px rgba(44,24,16,0.04); }
  .nb-food-card-row__img { position: relative; width: 90px; height: 90px; flex-shrink: 0; border-radius: 10px; overflow: hidden; background: #F5ECD7; }
  .nb-food-card-row__img img { width: 100%; height: 100%; object-fit: cover; }
  .nb-food-card-row__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
  .nb-veg-nonveg-badge { position: absolute; bottom: 4px; left: 4px; font-size: 8px; font-weight: 700; background: rgba(30,16,10,0.85); color: #FFFDF7; padding: 1px 4px; border-radius: 4px; }
  .nb-food-card-row__content { flex: 1; min-width: 0; }
  .nb-food-card-row__title { font-size: 0.92rem; font-weight: 800; color: #2C1810; margin: 0 0 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nb-food-card-row__desc { font-size: 0.74rem; color: #7A5C4A; margin: 0 0 8px; line-height: 1.3; }
  .nb-food-card-row__bottom { display: flex; justify-content: space-between; align-items: center; }
  .nb-food-card-row__price { font-size: 0.95rem; font-weight: 800; color: #2C1810; }
  .nb-add-btn { background: #C8922A; color: #FFF !important; font-weight: 800; font-size: 0.75rem; padding: 6px 14px; border-radius: 6px; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
  .nb-sold-tag { font-size: 0.72rem; color: #888; font-weight: 700; }

  .nb-trust-strip { display: flex; justify-content: space-around; background: #FDF6EC; border-top: 1px solid rgba(200,146,42,0.15); border-bottom: 1px solid rgba(200,146,42,0.15); padding: 14px 10px; max-width: 650px; margin: 20px auto 0; }
  .nb-trust-item { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: #2C1810; }
  .nb-trust-item span { font-size: 1rem; }
  </style>
</section>

{% schema %}
{
  "name": "Niamat Restaurant Homepage",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show Live Kitchen Status Header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show Hero Banner",
      "default": true
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Biryani Palace by Niamat"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Freshly prepared dum biryani cooked in authentic handis for every service."
    },
    {
      "type": "text",
      "id": "hero_btn_link",
      "label": "Instant Delivery Link",
      "default": "/collections/instant-delivery"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_video",
      "label": "Hero Video (MP4)"
    },
    {
      "type": "checkbox",
      "id": "show_ways",
      "label": "Show Experience Switcher",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_today",
      "label": "Show Available Today Food Cards",
      "default": true
    },
    {
      "type": "text",
      "id": "today_title",
      "label": "Food Cards Heading",
      "default": "Signature Fresh Batches"
    },
    {
      "type": "collection",
      "id": "today_collection",
      "label": "Instant Delivery Collection"
    }
  ],
  "presets": [
    {
      "name": "Niamat Restaurant Homepage"
    }
  ]
}
{% endschema %}
