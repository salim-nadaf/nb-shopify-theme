}
.nb-review-stars { color: #f59e0b; font-size: 1.1rem; margin-bottom: 8px; letter-spacing: 2px; }
.nb-review-text { font-size: 0.85rem; color: var(--nb-dark); line-height: 1.5; margin: 0 0 14px; font-style: italic; }
