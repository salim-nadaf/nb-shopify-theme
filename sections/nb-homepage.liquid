{% comment %}
  NIAMAT BIRYANI — Behrouz-Inspired Royal Mobile-First Restaurant Homepage
  Ultra-Premium Glossy Royal Aesthetic & Real-Time Theme Controls
{% endcomment %}

{% liquid
  assign page_bg = section.settings.color_page_bg
  if page_bg == blank or page_bg == 'rgba(0,0,0,0)'
    assign page_bg = '#FFFAF4'
  endif

  assign dark_bg = section.settings.color_dark_bg
  if dark_bg == blank or dark_bg == 'rgba(0,0,0,0)'
    assign dark_bg = '#1E100A'
  endif

  assign card_bg = section.settings.color_card_bg
  if card_bg == blank or card_bg == 'rgba(0,0,0,0)'
    assign card_bg = '#FFFFFF'
  endif

  assign alt_bg = section.settings.color_alt_bg
  if alt_bg == blank or alt_bg == 'rgba(0,0,0,0)'
    assign alt_bg = '#FDF6EC'
  endif

  assign gold_color = section.settings.color_accent_gold
  if gold_color == blank or gold_color == 'rgba(0,0,0,0)'
    assign gold_color = '#C8922A'
  endif

  assign text_dark = section.settings.color_text_dark
  if text_dark == blank or text_dark == 'rgba(0,0,0,0)'
    assign text_dark = '#2C1810'
  endif

  assign text_muted = section.settings.color_text_muted
  if text_muted == blank or text_muted == 'rgba(0,0,0,0)'
    assign text_muted = '#7A5C4A'
  endif

  assign status_bg = section.settings.color_status_bg
  if status_bg == blank or status_bg == 'rgba(0,0,0,0)'
    assign status_bg = '#1E100A'
  endif

  assign btn1_bg = section.settings.color_btn1_bg
  if btn1_bg == blank or btn1_bg == 'rgba(0,0,0,0)'
    assign btn1_bg = '#C8922A'
  endif

  assign btn1_text = section.settings.color_btn1_text
  if btn1_text == blank or btn1_text == 'rgba(0,0,0,0)'
    assign btn1_text = '#FFFFFF'
  endif

  assign pad_val = section.settings.section_padding | default: 40
  assign hero_h_val = section.settings.hero_min_height | default: 400
  assign opac_raw = section.settings.hero_overlay_opacity | default: 75
  assign opac_val = opac_raw | divided_by: 100.0

  assign status_text = section.settings.status_text
  if status_text == blank
    assign status_text = 'Kitchen Open - Lunch 12-3 PM, Dinner 6-9 PM'
  endif

  assign hero_heading = section.settings.hero_heading
  if hero_heading == blank
    assign hero_heading = 'Real Biryani. Made Fresh. Delivered to Your Door.'
  endif

  assign hero_subheading = section.settings.hero_subheading
  if hero_subheading == blank
    assign hero_subheading = 'Slow-cooked dum biryani from our cloud kitchen. Order now for delivery in 45-60 minutes.'
  endif

  assign hero_btn1_text = section.settings.hero_btn1_text
  if hero_btn1_text == blank
    assign hero_btn1_text = 'Order Now'
  endif

  assign hero_btn1_url = section.settings.hero_btn1_url
  if hero_btn1_url == blank
    assign hero_btn1_url = '/pages/start-your-order'
  endif

  assign hero_btn2_text = section.settings.hero_btn2_text
  if hero_btn2_text == blank
    assign hero_btn2_text = 'See Full Menu'
  endif

  assign hero_btn2_url = section.settings.hero_btn2_url
  if hero_btn2_url == blank
    assign hero_btn2_url = '/collections/instant-delivery'
  endif

  assign today_heading = section.settings.today_heading
  if today_heading == blank
    assign today_heading = "What's Ready Today"
  endif

  assign today_subheading = section.settings.today_subheading
  if today_subheading == blank
    assign today_subheading = 'Fresh batches coming hot out of the handi for fast dispatch.'
  endif

  assign today_cta_text = section.settings.today_cta_text
  if today_cta_text == blank
    assign today_cta_text = 'Order Instant Items'
  endif

  assign today_cta_url = section.settings.today_cta_url
  if today_cta_url == blank
    assign today_cta_url = '/collections/instant-delivery'
  endif

  assign family_heading = section.settings.family_heading
  if family_heading == blank
    assign family_heading = 'Feeding a Crowd?'
  endif

  assign family_subheading = section.settings.family_subheading
  if family_subheading == blank
    assign family_subheading = 'Planning a party, family gathering or office lunch? Pre-order 1 Kg to 10 Kg handis with scheduled delivery.'
  endif

  assign family_cta_text = section.settings.family_cta_text
  if family_cta_text == blank
    assign family_cta_text = 'Plan Family Order'
  endif

  assign family_cta_url = section.settings.family_cta_url
  if family_cta_url == blank
    assign family_cta_url = '/pages/family-feast'
  endif

  assign final_heading = section.settings.final_heading
  if final_heading == blank
    assign final_heading = 'Ready to Order?'
  endif

  assign final_subheading = section.settings.final_subheading
  if final_subheading == blank
    assign final_subheading = 'Experience rich dum biryani freshly prepared for your appetite.'
  endif

  assign final_cta_text = section.settings.final_cta_text
  if final_cta_text == blank
    assign final_cta_text = 'Start Your Order'
  endif

  assign final_cta_url = section.settings.final_cta_url
  if final_cta_url == blank
    assign final_cta_url = '/pages/start-your-order'
  endif
%}

<div class="nb-homepage-wrapper" style="
  --nb-page-bg: {{ page_bg }};
  --nb-dark-bg: {{ dark_bg }};
  --nb-card-bg: {{ card_bg }};
  --nb-alt-bg: {{ alt_bg }};
  --nb-gold: {{ gold_color }};
  --nb-text-dark: {{ text_dark }};
  --nb-text-muted: {{ text_muted }};
  --nb-status-bg: {{ status_bg }};
  --nb-btn1-bg: {{ btn1_bg }};
  --nb-btn1-text: {{ btn1_text }};
  --nb-padding: {{ pad_val }}px;
  --nb-hero-height: {{ hero_h_val }}px;
  --nb-overlay-opac: {{ opac_val }};
">

  <!-- 1. STATUS BAR -->
  {% unless section.settings.show_status == false %}
    <div class="nb-status-bar">
      <div class="nb-status-inner">
        <span class="nb-pulse-dot"></span>
        <span>{{ status_text }}</span>
      </div>
    </div>
  {% endunless %}

  <!-- 2. HERO BANNER -->
  {% unless section.settings.show_hero == false %}
    <div class="nb-hero-banner">
      {% assign hero_img = section.settings.hero_image %}
      {% if hero_img == blank %}
        {% assign hero_img = "https://cdn.shopify.com/s/files/1/0722/3410/6954/files/hero-biryani-optimized.webp" %}
      {% endif %}
      <img src="{{ hero_img }}" alt="Biryani Palace" class="nb-hero-bg-img" width="1400" height="700" loading="eager" fetchpriority="high" decoding="async" />
      <div class="nb-hero-overlay"></div>
      
      {% if section.settings.hero_video_url != blank %}
        <video muted loop playsinline class="nb-hero-bg nb-hero-video-desktop nb-lazy-video" data-src="{{ section.settings.hero_video_url }}"></video>
      {% endif %}

      <div class="nb-hero-content">
        <h1 class="nb-hero-title">{{ hero_heading }}</h1>
        <p class="nb-hero-sub">{{ hero_subheading }}</p>

        <div class="nb-hero-buttons">
          <a href="{{ hero_btn1_url }}" class="nb-btn-gold">{{ hero_btn1_text }}</a>
          <a href="{{ hero_btn2_url }}" class="nb-btn-outline">{{ hero_btn2_text }}</a>
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- 2.5 ₹99 TRIAL BIRYANI SHOWCASE (DYNAMICALLY SYNCED WITH INSTANT DELIVERY) -->
  {% liquid
    assign trial_prod = all_products[section.settings.trial_product]
    if trial_prod == blank
      assign trial_prod = all_products['99-new-customer-trial-biryani']
    endif
    if trial_prod == blank
      assign trial_prod = all_products['new-customer-trial-biryani']
    endif
    if trial_prod == blank
      assign trial_prod = all_products['trial-biryani']
    endif

    assign trial_available = false
    if trial_prod != blank and trial_prod.available
      assign trial_available = true
    endif

    assign trial_target_url = '/collections/instant-delivery'
    if trial_prod != blank and trial_prod.url != blank
      assign trial_target_url = '/collections/instant-delivery'
    endif
  %}

  {% if trial_available %}
    <section class="nb-home-trial-section" aria-labelledby="nb-home-trial-heading">
      <div class="nb-container">
        <div class="nb-home-trial-card">
          <div class="nb-diet-corner-badge" aria-hidden="true" style="display: inline-flex; gap: 4px;">
            {% render 'nb-diet-icon', diet: 'veg' %}
            {% render 'nb-diet-icon', diet: 'nonveg' %}
          </div>
          <div class="nb-home-trial-content">
            <div class="nb-home-trial-badge">
              <span>TRY NIAMAT</span>
            </div>

            <h2 id="nb-home-trial-heading" class="nb-home-trial-title">
              Your First Taste for <span class="nb-home-trial-price-highlight">₹99</span>
            </h2>

            <p class="nb-home-trial-sub">
              Experience the royal taste of authentic Biryani by Niamat — available in Veg & Non-Veg.
            </p>

            <div class="nb-home-trial-details">
              <div class="nb-home-trial-price-box">
                <span class="nb-home-trial-amount">₹99</span>
                <span class="nb-home-trial-portion" style="display: inline-flex; align-items: center; gap: 4px;">
                  <span>Veg or Non-Veg · Mention on WhatsApp</span>
                </span>
              </div>
            </div>

            <div class="nb-home-trial-cta-wrap">
              <a href="{{ trial_target_url }}" class="nb-home-trial-btn">
                TRY FOR ₹99 →
              </a>
            </div>
          </div>

          <div class="nb-home-trial-visual">
            <div class="nb-home-trial-img-wrap">
              <img
                src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=600"
                alt="Biryani Palace by Niamat ₹99 Special Trial Biryani"
                width="340"
                height="230"
                loading="lazy"
                decoding="async"
                class="nb-home-trial-img"
              />
              <span class="nb-home-trial-tag">Dum Cooked Fresh</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- 3. ORDER YOUR WAY (2 CARDS) -->
  <div class="nb-section-block">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Delivery Options</span>
        <h2>Order Your Way</h2>
      </div>

      <div class="nb-grid-2">
        {% for block in section.blocks %}
          {% if block.type == 'order_way' %}
            <div class="nb-card nb-card-exp" {{ block.shopify_attributes }}>
              <div class="nb-card-top">
                <span class="nb-chip">{{ block.settings.badge }}</span>
              </div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.description }}</p>
              <a href="{{ block.settings.cta_url | default: '/collections/instant-delivery' }}" class="nb-btn-gold nb-w-full">
                {{ block.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 4. TODAY'S KITCHEN -->
  {% unless section.settings.show_today == false %}
    <div class="nb-section-block nb-bg-alt">
      <div class="nb-container">
        <div class="nb-section-header flex-between">
          <div>
            <span class="nb-tag-badge">Fresh Batches</span>
            <h2>{{ today_heading }}</h2>
            <p>{{ today_subheading }}</p>
          </div>
          <a href="{{ today_cta_url }}" class="nb-btn-gold">{{ today_cta_text }}</a>
        </div>

        <div class="nb-badges-row">
          {% liquid
            assign instant_col = collections['instant-delivery']
            if instant_col == blank or instant_col.products.size == 0
              assign instant_col = collections['all']
            endif
            assign available_count = 0
          %}
          {% if instant_col != blank and instant_col.products.size > 0 %}
            {% for product in instant_col.products %}
              {% if product.available %}
                {% assign available_count = available_count | plus: 1 %}
                {% assign prod_title_lower = product.title | downcase %}
                {% assign icon = '🍗' %}
                {% if prod_title_lower contains 'paneer' or prod_title_lower contains 'veg' or prod_title_lower contains 'sabz' %}
                  {% assign icon = '🌿' %}
                {% elsif prod_title_lower contains 'mutton' or prod_title_lower contains 'gosht' %}
                  {% assign icon = '🥩' %}
                {% elsif prod_title_lower contains 'tikka' or prod_title_lower contains 'kebab' or prod_title_lower contains 'starter' %}
                  {% assign icon = '🍢' %}
                {% endif %}
                <a href="{{ today_cta_url }}#product-{{ product.id }}" class="nb-badge-pill" style="text-decoration: none; color: inherit;">
                  {% render 'nb-diet-icon', product: product %}
                  <strong>{{ product.title }} Ready</strong>
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}

          {% if available_count == 0 %}
            <div class="nb-badge-pill" style="opacity: 0.9;">
              <strong>Fresh Batches In Preparation</strong>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endunless %}

  <!-- 5. WHY CHOOSE US (4 POINTS) -->
  <div class="nb-section-block">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Our Quality</span>
        <h2>Why Customers Choose Biryani Palace</h2>
      </div>

      <div class="nb-grid-4">
        {% for block in section.blocks %}
          {% if block.type == 'why_point' %}
            <div class="nb-why-box" {{ block.shopify_attributes }}>
              <div class="nb-why-icon">{{ block.settings.icon }}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.body }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 5.5. SIGNATURE BUCKET BIRYANIS -->
  <div class="nb-section-block nb-bucket-biryani-section">
    <div class="nb-container" style="max-width: 1060px; margin: 0 auto; padding: 0 16px;">
      <div class="nb-section-header" style="text-align: center; margin-bottom: 28px;">
        <span class="nb-tag-badge">🪣 EASY TO CARRY & REUSABLE</span>
        <h2>Signature Bucket Biryanis</h2>
        <p style="font-size: 0.9rem; color: #7A5C4A; margin-top: 4px;">100% Food-Grade, Reusable & Recyclable Bucket Containers — Easy to carry & keeps biryani piping hot!</p>
      </div>

      <div class="nb-food-grid">
        <!-- CARD 1: Half Kg Dum Bucket -->
        <div class="nb-food-card nb-food-card--preorder">
          <div class="nb-diet-corner-badge" aria-hidden="true">
            {% render 'nb-diet-icon', title: 'Ustaadi Murgh Dum Biryani', diet: 'nonveg' %}
          </div>
          <div class="nb-food-card__image">
            <img
              src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=200"
              srcset="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=100 100w, https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=200 200w"
              sizes="(max-width: 768px) 85px, 110px"
              alt="Ustaadi Murgh Dum Biryani Bucket (Half Kg)"
              width="85"
              height="85"
              loading="lazy"
              decoding="async"
            />
            <span class="nb-badge nb-tag--musttry">⭐ Must try</span>
          </div>
          <div class="nb-food-card__body">
            <div class="nb-food-card__top">
              <h3 class="nb-food-card__title">Ustaadi Murgh Dum Bucket</h3>
              <p class="nb-food-card__desc">½ Kg portion = 500 g tender chicken + 500 g fragrant Basmati rice (serves 3–4). Reusable food-grade bucket.</p>
              <div class="nb-food-card__meta">
                <span class="nb-meta-tag">½ Kg (500g Meat + 500g Rice)</span>
                <span class="nb-meta-tag">♻️ Reusable Bucket</span>
              </div>
            </div>
            <div class="nb-food-card__bottom">
              <span class="nb-food-card__price">₹599</span>
              <a href="https://wa.me/919167682582?text=Hi%20Niamat%20Biryani,%20I%20want%20to%20order%20Ustaadi%20Murgh%20Dum%20Biryani%20Bucket%20(Half%20Kg%20-%20%E2%82%B9599)" target="_blank" class="nb-btn nb-btn--outline">Pre-Order →</a>
            </div>
          </div>
        </div>

        <!-- CARD 2: Half Kg Tandoori Bucket -->
        <div class="nb-food-card nb-food-card--preorder">
          <div class="nb-diet-corner-badge" aria-hidden="true">
            {% render 'nb-diet-icon', title: 'Alishaan Tandoori Biryani', diet: 'nonveg' %}
          </div>
          <div class="nb-food-card__image">
            <img
              src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoori-bucket-optimized.webp?v=1785619720&width=200"
              srcset="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoori-bucket-optimized.webp?v=1785619720&width=100 100w, https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoori-bucket-optimized.webp?v=1785619720&width=200 200w"
              sizes="(max-width: 768px) 85px, 110px"
              alt="Alishaan Tandoori Biryani Bucket (Half Kg)"
              width="85"
              height="85"
              loading="lazy"
              decoding="async"
            />
            <span class="nb-badge nb-tag--bestseller">🏆 Bestseller</span>
          </div>
          <div class="nb-food-card__body">
            <div class="nb-food-card__top">
              <h3 class="nb-food-card__title">Alishaan Tandoori Bucket</h3>
              <p class="nb-food-card__desc">½ Kg portion = 500 g tandoori chicken + 500 g fragrant Basmati rice (serves 3–4). Reusable food-grade bucket.</p>
              <div class="nb-food-card__meta">
                <span class="nb-meta-tag">½ Kg (500g Meat + 500g Rice)</span>
                <span class="nb-meta-tag">♻️ Reusable Bucket</span>
              </div>
            </div>
            <div class="nb-food-card__bottom">
              <span class="nb-food-card__price">₹599</span>
              <a href="https://wa.me/919167682582?text=Hi%20Niamat%20Biryani,%20I%20want%20to%20order%20Alishaan%20Tandoori%20Biryani%20Bucket%20(Half%20Kg%20-%20%E2%82%B9599)" target="_blank" class="nb-btn nb-btn--outline">Pre-Order →</a>
            </div>
          </div>
        </div>

        <!-- CARD 3: 1 Kg Dum Bucket -->
        <div class="nb-food-card nb-food-card--preorder">
          <div class="nb-diet-corner-badge" aria-hidden="true">
            {% render 'nb-diet-icon', title: 'Ustaadi Murgh Dum Biryani', diet: 'nonveg' %}
          </div>
          <div class="nb-food-card__image">
            <img
              src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-1kg-optimized.webp?v=1785619720&width=200"
              srcset="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-1kg-optimized.webp?v=1785619720&width=100 100w, https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-1kg-optimized.webp?v=1785619720&width=200 200w"
              sizes="(max-width: 768px) 85px, 110px"
              alt="Ustaadi Murgh Dum Biryani Bucket (1 Kg)"
              width="85"
              height="85"
              loading="lazy"
              decoding="async"
            />
            <span class="nb-badge nb-tag--popular">🔥 Popular</span>
          </div>
          <div class="nb-food-card__body">
            <div class="nb-food-card__top">
              <h3 class="nb-food-card__title">Ustaadi Murgh Dum Bucket</h3>
              <p class="nb-food-card__desc">1 Kg portion = 1 Kg tender chicken + 1 Kg fragrant Basmati rice (serves 6–7). Reusable food-grade bucket.</p>
              <div class="nb-food-card__meta">
                <span class="nb-meta-tag">1 Kg (1Kg Meat + 1Kg Rice)</span>
                <span class="nb-meta-tag">♻️ Reusable Bucket</span>
              </div>
            </div>
            <div class="nb-food-card__bottom">
              <span class="nb-food-card__price">₹1,028</span>
              <a href="https://wa.me/919167682582?text=Hi%20Niamat%20Biryani,%20I%20want%20to%20order%20Ustaadi%20Murgh%20Dum%20Biryani%20Bucket%20(1%20Kg%20-%20%E2%82%B91028)" target="_blank" class="nb-btn nb-btn--outline">Pre-Order →</a>
            </div>
          </div>
        </div>

        <!-- CARD 4: 1 Kg Tandoori Bucket -->
        <div class="nb-food-card nb-food-card--preorder">
          <div class="nb-diet-corner-badge" aria-hidden="true">
            {% render 'nb-diet-icon', title: 'Alishaan Tandoori Biryani', diet: 'nonveg' %}
          </div>
          <div class="nb-food-card__image">
            <img
              src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoor-bucket-1kg-optimized.webp?v=1785619720&width=200"
              srcset="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoor-bucket-1kg-optimized.webp?v=1785619720&width=100 100w, https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-tandoor-bucket-1kg-optimized.webp?v=1785619720&width=200 200w"
              sizes="(max-width: 768px) 85px, 110px"
              alt="Alishaan Tandoori Biryani Bucket (1 Kg)"
              width="85"
              height="85"
              loading="lazy"
              decoding="async"
            />
            <span class="nb-badge nb-tag--chef">👑 Classic</span>
          </div>
          <div class="nb-food-card__body">
            <div class="nb-food-card__top">
              <h3 class="nb-food-card__title">Alishaan Tandoori Bucket</h3>
              <p class="nb-food-card__desc">1 Kg portion = 1 Kg tandoori chicken + 1 Kg fragrant Basmati rice (serves 6–7). Reusable food-grade bucket.</p>
              <div class="nb-food-card__meta">
                <span class="nb-meta-tag">1 Kg (1Kg Meat + 1Kg Rice)</span>
                <span class="nb-meta-tag">♻️ Reusable Bucket</span>
              </div>
            </div>
            <div class="nb-food-card__bottom">
              <span class="nb-food-card__price">₹1,128</span>
              <a href="https://wa.me/919167682582?text=Hi%20Niamat%20Biryani,%20I%20want%20to%20order%20Alishaan%20Tandoori%20Biryani%20Bucket%20(1%20Kg%20-%20%E2%82%B91128)" target="_blank" class="nb-btn nb-btn--outline">Pre-Order →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. FAMILY ORDERS -->
  {% unless section.settings.show_family == false %}
    <div class="nb-section-block nb-bg-alt">
      <div class="nb-container">
