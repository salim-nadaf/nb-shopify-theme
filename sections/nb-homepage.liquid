.nb-modal-list { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-direction: column; gap: 8px; font-size: 0.84rem; font-weight: 600; color: var(--nb-dark); }
.nb-modal-note { font-size: 0.78rem !important; font-style: italic; color: var(--nb-gold) !important; }
</style>

<script>
function nbCheckDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.add('active');
}
function nbCloseDeliveryModal() {
  var modal = document.getElementById('nb-delivery-modal');
  if (modal) modal.classList.remove('active');
}
</script>

