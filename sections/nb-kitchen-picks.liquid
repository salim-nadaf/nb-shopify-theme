<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Category Metadata & Idea List URLs
  var categoryMeta = {
    'all': {
      title: 'All Kitchen Picks',
      desc: 'Discover practical kitchen essentials curated by Niamat.',
      url: {{ storefront_url | json }}
    },
    'biryani_indian': {
      title: 'Biryani & Indian Cooking',
      desc: 'Hand-picked handis, strainers, kadhais, and cookware crafted for rich authentic dum cooking.',
      url: {{ section.settings.url_idealist_biryani_indian | default: storefront_url | json }}
    },
    'kitchen_tools': {
      title: 'Kitchen Tools',
      desc: 'Precision scales, thermometers, and heavy-duty mortar & pestles for flawless meal prep.',
      url: {{ section.settings.url_idealist_kitchen_tools | default: storefront_url | json }}
    },
    'storage_org': {
      title: 'Storage & Organization',
      desc: 'Airtight glass jars and stackable steel containers to keep your pantry fresh and organized.',
      url: {{ section.settings.url_idealist_storage_org | default: storefront_url | json }}
    },
    'spice_masala': {
      title: 'Spice & Masala Storage',
      desc: 'Traditional brass masala dabbas and UV-protected jars that seal in potent aromatics.',
      url: {{ section.settings.url_idealist_spice_masala | default: storefront_url | json }}
    },
    'everyday_essentials': {
      title: 'Everyday Kitchen Essentials',
      desc: 'Daily prep boards, heat-resistant spatulas, and durable utensils used in busy kitchens.',
      url: {{ section.settings.url_idealist_everyday_essentials | default: storefront_url | json }}
    }
  };

  var catBanner = document.getElementById('nb-kp-category-banner');
  var catTitle = document.getElementById('cat-banner-title');
  var catDesc = document.getElementById('cat-banner-desc');
  var catBtn = document.getElementById('cat-banner-btn');

  function filterPicks(selectedCat) {
    var visibleCount = 0;

    cards.forEach(function(card) {
      var itemCat = card.getAttribute('data-category');
      if (selectedCat === 'all' || itemCat === selectedCat) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = (visibleCount === 0) ? 'block' : 'none';
    }

    if (catBanner && categoryMeta[selectedCat]) {
      if (selectedCat === 'all') {
        catBanner.style.display = 'none';
      } else {
        var meta = categoryMeta[selectedCat];
        if (catTitle) catTitle.textContent = meta.title;
        if (catDesc) catDesc.textContent = meta.desc;
        if (catBtn) {
          catBtn.href = meta.url || {{ storefront_url | json }};
          catBtn.setAttribute('data-category', meta.title);
        }
        catBanner.style.display = 'block';
      }
    }
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { 
        t.classList.remove('active'); 
        t.setAttribute('aria-pressed', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-pressed', 'true');

      var cat = tab.getAttribute('data-category');
      filterPicks(cat);
    });
  });

  // 2. Safe GA4 Click Tracking for Storefront & Product CTAs
  function trackAmazonClick(eventName, params) {
    try {
      if (typeof window.gtag === 'function') {
        window.gtag('event', eventName, params);
      }
      if (window.dataLayer && Array.isArray(window.dataLayer)) {
        window.dataLayer.push(Object.assign({ event: eventName }, params));
      }
    } catch(e) {
      // Silently fail without impacting user navigation
    }
  }

  // Storefront Triggers (Hero & Bottom Banner)
  var storefrontButtons = document.querySelectorAll('.nb-kp-storefront-trigger');
  storefrontButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var loc = btn.getAttribute('data-tracking-location') || 'general';
      trackAmazonClick('amazon_storefront_click', {
        destination_type: 'amazon_influencer_storefront',
        click_location: loc,
        source_page: 'kitchen_picks'
      });
    });
  });

  // Individual Product Triggers
  var productButtons = document.querySelectorAll('.nb-kp-product-trigger');
  productButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var prodName = btn.getAttribute('data-product-name') || '';
      var prodCat = btn.getAttribute('data-category') || '';
      trackAmazonClick('amazon_product_click', {
        product_name: prodName,
        category: prodCat,
        destination_type: 'amazon_product_affiliate',
        source_page: 'kitchen_picks'
      });
    });
  });
});
</script>

