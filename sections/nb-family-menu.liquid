{% comment %} NIAMAT BIRYANI — Categorized & Price-Sorted Menu Page {% endcomment %}
{% render 'food-card-styles' %}

<div class="nb-family-menu-wrapper">

  <!-- CATEGORY QUICK NAV SCROLLER -->
  <div class="nb-cat-nav-scroll">
    <a href="#cat-bestsellers" class="nb-cat-pill active">🏆 Best Sellers</a>
    <a href="#cat-dum" class="nb-cat-pill">👑 Traditional Dum</a>
    <a href="#cat-reimagined" class="nb-cat-pill">✨ Biryani Reimagined</a>
    <a href="#cat-crowned" class="nb-cat-pill">🏰 Crowned Flavours</a>
    <a href="#cat-veg" class="nb-cat-pill">🌿 Vegetarian Royalty</a>
    <a href="#cat-curries" class="nb-cat-pill">🥘 Curries & Gravies</a>
    <a href="#cat-palace-veg" class="nb-cat-pill">🥗 Palace Veg Delights</a>
    <a href="#cat-starters" class="nb-cat-pill">🍢 Starters & Kebabs</a>
  </div>

  {% liquid
    assign menu_collection = collection
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections[section.settings.collection]
    endif
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections['family-orders']
    endif
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections['all']
    endif

    # Sort all collection products by price descending (High to Low)
    assign all_prods_sorted = menu_collection.products | sort: 'price' | reverse
  %}

  <!-- 1. BEST SELLERS SECTION (TOP HIGHLIGHTED) -->
  <div id="cat-bestsellers" class="nb-menu-category-section nb-bestseller-highlight-section">
    <div class="nb-category-header">
      <h2>🏆 Best Sellers</h2>
      <p class="nb-cat-subtitle">Our most ordered and iconic signature dishes loved across Kalyan</p>
    </div>
    <div class="nb-food-grid">
      {% assign count = 0 %}
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'makhmali malai' or title_lower contains 'boneless lazzat' or title_lower contains 'lababdaar seekh' or title_lower contains 'lazzat-e-tikka' or title_lower contains 'lazzat e tikka' or title_lower contains 'sabz tikka' %}
          {% render 'food-card-horizontal', product: product %}
          {% assign count = count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if count == 0 %}
        {% for product in all_prods_sorted limit: 4 %}
          {% render 'food-card-horizontal', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <!-- 2. TRADITIONAL DUM BIRYANIS -->
  <div id="cat-dum" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>👑 Traditional Dum Biryanis</h2>
      <p class="nb-cat-subtitle">Slow-cooked in copper handis with 25+ years Ustaad heritage</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'hyderabadi mutton' or title_lower contains 'gosht-e-dum' or title_lower contains 'gosht e dum' or title_lower contains 'hyderabadi murgh' or title_lower contains 'ustaadi murgh' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 3. BIRYANI REIMAGINED -->
  <div id="cat-reimagined" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>✨ Biryani Reimagined</h2>
      <p class="nb-cat-subtitle">Innovative royal fusion recipes crafted for biryani connoisseurs</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'zam-zam' or title_lower contains 'zam zam' or title_lower contains 'zamzam' or title_lower contains 'nayaabi italiano' or title_lower contains 'makhmali malai' or title_lower contains 'banjara' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 4. CROWNED FLAVOURS -->
  <div id="cat-crowned" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>🏰 Crowned Flavours</h2>
      <p class="nb-cat-subtitle">Smoky tandoori tikka & seekh kebab infused biryanis</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'boneless lazzat' or title_lower contains 'lababdaar seekh' or title_lower contains 'lazzat-e-tikka' or title_lower contains 'lazzat e tikka' or title_lower contains 'alishaan tandoori' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 5. VEGETARIAN ROYALTY -->
  <div id="cat-veg" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>🌿 Vegetarian Royalty</h2>
      <p class="nb-cat-subtitle">Rich paneer & seasonal vegetable biryanis dum-cooked with saffron</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'paneer-e-tikka' or title_lower contains 'paneer tikka' or title_lower contains 'sabz tikka' or title_lower contains 'nawabi veg' or title_lower contains 'nazaakat' or title_lower contains 'makhmali sabz' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 6. CURRIES & GRAVIES -->
  <div id="cat-curries" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>🥘 Curries & Gravies</h2>
      <p class="nb-cat-subtitle">Rich, authentic Mughlai & Kolhapuri gravies prepared fresh</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'dhan-e-shikori' or title_lower contains 'dhan e shikori' or title_lower contains 'masaledar gosht' or title_lower contains 'boneless tikka masala' or title_lower contains 'murgh angaara' or title_lower contains 'shahi murgh korma' or title_lower contains 'masaledar murgh' or title_lower contains 'murgh tikka masala' or title_lower contains 'murgh kolhapuri' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 7. PALACE VEG DELIGHTS -->
  <div id="cat-palace-veg" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>🥗 Palace Veg Delights</h2>
      <p class="nb-cat-subtitle">Sumptuous cottage cheese and rich vegetable gravies</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'paneer-e-tikka masala' or title_lower contains 'kadhai paneer' or title_lower contains 'paneer-e-firangi' or title_lower contains 'paneer firangi' or title_lower contains 'sabziyon ka zaika' or title_lower contains 'sabziyon' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 8. STARTERS & KEBABS -->
  <div id="cat-starters" class="nb-menu-category-section">
    <div class="nb-category-header">
      <h2>🍢 Starters & Kebabs</h2>
      <p class="nb-cat-subtitle">Charcoal grilled starters, seekh kebabs & royal rolls</p>
    </div>
    <div class="nb-food-grid">
      {% for product in all_prods_sorted %}
        {% assign title_lower = product.title | downcase %}
        {% if title_lower contains 'kebab royale' or title_lower contains 'kebab-e-firangi' or title_lower contains 'kebab firangi' or title_lower contains 'shahi murgh roll' or title_lower contains 'tandoori taaj' %}
          {% render 'food-card-horizontal', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

</div>

<style>
.nb-family-menu-wrapper {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 auto;
  padding: 20px 16px 80px;
  box-sizing: border-box !important;
  overflow-x: hidden !important;
}

/* Sticky Category Navigation Scroller */
.nb-cat-nav-scroll {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  padding: 12px 4px 16px;
  margin-bottom: 30px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  position: sticky;
  top: 70px;
  z-index: 40;
  background: rgba(255, 250, 244, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(200, 146, 42, 0.2);
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}
.nb-cat-nav-scroll::-webkit-scrollbar { display: none; }

.nb-cat-pill {
  flex-shrink: 0;
  background: #FFFDF7;
  color: #2C1810;
  font-size: 0.82rem;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: 20px;
  border: 1px solid rgba(200, 146, 42, 0.3);
  text-decoration: none;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.nb-cat-pill:hover,
.nb-cat-pill.active {
  background: #C8922A;
  color: #FFFFFF !important;
  border-color: #C8922A;
  box-shadow: 0 4px 12px rgba(200, 146, 42, 0.3);
}

.nb-menu-category-section {
  margin-bottom: 48px;
  scroll-margin-top: 130px;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

.nb-bestseller-highlight-section {
  background: linear-gradient(180deg, rgba(200, 146, 42, 0.08) 0%, rgba(255, 250, 244, 0) 100%);
  border-radius: 20px;
  padding: 24px 16px;
  border: 1px solid rgba(200, 146, 42, 0.25);
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

.nb-category-header {
  margin-bottom: 20px;
  text-align: left;
  border-bottom: 2px solid rgba(200, 146, 42, 0.2);
  padding-bottom: 10px;
  width: 100% !important;
  box-sizing: border-box !important;
}

.nb-category-header h2 {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 1.6rem !important;
  font-weight: 800 !important;
  color: #2C1810 !important;
  margin: 0 0 6px;
}

.nb-cat-subtitle {
  font-size: 0.88rem;
  color: #7A5C4A;
  margin: 0;
  word-break: break-word;
}

@media (max-width: 767px) {
  .nb-family-menu-wrapper { padding: 12px 8px 60px !important; }
  .nb-cat-nav-scroll { top: 55px; }
  .nb-category-header h2 { font-size: 1.3rem !important; }
  .nb-bestseller-highlight-section { padding: 14px 8px !important; border-radius: 14px !important; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var pills = document.querySelectorAll('.nb-cat-pill');
  pills.forEach(function(pill) {
    pill.addEventListener('click', function(e) {
      pills.forEach(function(p) { p.classList.remove('active'); });
      this.classList.add('active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Family Menu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Family Menu"
    }
  ]
}
{% endschema %}