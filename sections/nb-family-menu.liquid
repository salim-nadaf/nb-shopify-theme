{% comment %} NIAMAT BIRYANI — Family Orders / Menu Section {% endcomment %}
{% render 'food-card-styles' %}

<div class="nb-instant-section">
  <div class="nb-section-header">
    <h2>👑 Family Orders — 1 Kg & Bulk Pre-Orders</h2>
    <p>1 Kg+ portions · Prepared fresh in copper handis · Scheduled delivery</p>
  </div>

  {% liquid
    assign menu_collection = collection
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections[section.settings.collection]
    endif
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections['family-orders']
    endif
    if menu_collection == blank or menu_collection.products.size == 0
      assign menu_collection = collections['all']
    endif
  %}

  <div class="nb-food-grid">
    {% if menu_collection != blank and menu_collection.products.size > 0 %}
      {% for product in menu_collection.products limit: 48 %}
        {% liquid
          assign title_lower = product.title | downcase
          assign item_badge = ''
          assign badge_class = ''
          assign badge_icon = ''

          if title_lower contains 'hyderabadi mutton dum'
            assign item_badge = 'Popular'
            assign badge_class = 'nb-tag--popular'
            assign badge_icon = '🔥'
          elsif title_lower contains 'gosht-e-dum' or title_lower contains 'gosht e dum'
            assign item_badge = 'Must try'
            assign badge_class = 'nb-tag--musttry'
            assign badge_icon = '⭐'
          elsif title_lower contains 'hyderabadi murgh dum'
            assign item_badge = 'Popular'
            assign badge_class = 'nb-tag--popular'
            assign badge_icon = '🔥'
          elsif title_lower contains 'ustaadi murgh dum'
            assign item_badge = "Chef's special"
            assign badge_class = 'nb-tag--chef'
            assign badge_icon = '👨‍🍳'
          elsif title_lower contains 'zam-zam' or title_lower contains 'zam zam' or title_lower contains 'zamzam'
            assign item_badge = 'Must try'
            assign badge_class = 'nb-tag--musttry'
            assign badge_icon = '⭐'
          elsif title_lower contains 'nayaabi italiano'
            assign item_badge = 'Must try'
            assign badge_class = 'nb-tag--musttry'
            assign badge_icon = '⭐'
          elsif title_lower contains 'makhmali malai' or title_lower contains 'makhmali'
            assign item_badge = 'Best seller'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '🏆'
          elsif title_lower contains 'banjara'
            assign item_badge = 'New'
            assign badge_class = 'nb-tag--new'
            assign badge_icon = '✨'
          elsif title_lower contains 'boneless lazzat'
            assign item_badge = 'Best seller'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '🏆'
          elsif title_lower contains 'lababdaar seekh'
            assign item_badge = 'Best seller'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '🏆'
          elsif title_lower contains 'lazzat-e-tikka' or title_lower contains 'lazzat e tikka'
            assign item_badge = 'Best seller'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '🏆'
          elsif title_lower contains 'alishaan tandoori'
            assign item_badge = 'Popular'
            assign badge_class = 'nb-tag--popular'
            assign badge_icon = '🔥'
          elsif title_lower contains 'paneer'
            assign item_badge = 'Must try'
            assign badge_class = 'nb-tag--musttry'
            assign badge_icon = '⭐'
          elsif title_lower contains 'sabz tikka'
            assign item_badge = 'Best seller'
            assign badge_class = 'nb-tag--bestseller'
            assign badge_icon = '🏆'
          elsif title_lower contains 'nawabi veg'
            assign item_badge = "Chef's special"
            assign badge_class = 'nb-tag--chef'
            assign badge_icon = '👨‍🍳'
          elsif title_lower contains 'nazaakat'
            assign item_badge = 'New'
            assign badge_class = 'nb-tag--new'
            assign badge_icon = '✨'
          elsif title_lower contains 'dhan-e-shikori' or title_lower contains 'dhan e shikori'
            assign item_badge = 'New'
            assign badge_class = 'nb-tag--new'
            assign badge_icon = '✨'
          elsif title_lower contains 'sabziyon'
            assign item_badge = 'New'
            assign badge_class = 'nb-tag--new'
            assign badge_icon = '✨'
          endif
        %}

        <div class="nb-food-card nb-food-card--preorder">
          <div class="nb-food-card__image">
            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 260 }}"
                   alt="{{ product.featured_media.alt | escape }}"
                   width="130" height="130" loading="lazy" />
            {% else %}
              <div class="nb-food-card__image-placeholder">👑</div>
            {% endif %}
            {% if item_badge != blank %}
              <span class="nb-badge {{ badge_class }}">{{ badge_icon }} {{ item_badge }}</span>
            {% endif %}
          </div>

          <div class="nb-food-card__body">
            <div>
              <h3 class="nb-food-card__title">{{ product.title }}</h3>
              {% if product.description != blank %}
                <p class="nb-food-card__desc">{{ product.description | strip_html | truncate: 60 }}</p>
              {% endif %}
              <div class="nb-food-card__meta">
                <span class="nb-meta-tag">🕐 Timed Slot</span>
                <span class="nb-meta-tag">Serves 4-5</span>
              </div>
            </div>
            <div class="nb-food-card__bottom">
              <span class="nb-food-card__price">
                {% if product.price_varies %}
                  From {{ product.price_min | money }}
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </span>
              <a href="/pages/family-orders" class="nb-btn nb-btn--outline nb-btn--sm">
                Pre-Order →
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Fallback Demo Family Handi Cards -->
      <div class="nb-food-card nb-food-card--preorder">
        <div class="nb-food-card__image">
          <div class="nb-food-card__image-placeholder">👑</div>
          <span class="nb-badge nb-badge--preorder">1 Kg Handi</span>
        </div>
        <div class="nb-food-card__body">
          <div>
            <h3 class="nb-food-card__title">1 Kg Chicken Dum Biryani Handi</h3>
            <p class="nb-food-card__desc">Serves 4–5 people. Prepared fresh for your specified delivery slot in traditional copper handi.</p>
            <div class="nb-food-card__meta">
              <span class="nb-meta-tag">🕐 Timed Slot</span>
              <span class="nb-meta-tag">Serves 4-5</span>
            </div>
          </div>
          <div class="nb-food-card__bottom">
            <span class="nb-food-card__price">₹1,100</span>
            <a href="/pages/family-orders" class="nb-btn nb-btn--outline nb-btn--sm">Pre-Order →</a>
          </div>
        </div>
      </div>

      <div class="nb-food-card nb-food-card--preorder">
        <div class="nb-food-card__image">
          <div class="nb-food-card__image-placeholder">👑</div>
          <span class="nb-badge nb-badge--preorder">1 Kg Handi</span>
        </div>
        <div class="nb-food-card__body">
          <div>
            <h3 class="nb-food-card__title">1 Kg Mutton Dum Biryani Handi</h3>
            <p class="nb-food-card__desc">Serves 4–5 people. Tender mutton chunks dum-cooked in saffron basmati rice.</p>
            <div class="nb-food-card__meta">
              <span class="nb-meta-tag">🕐 Timed Slot</span>
              <span class="nb-meta-tag">Serves 4-5</span>
            </div>
          </div>
          <div class="nb-food-card__bottom">
            <span class="nb-food-card__price">₹1,450</span>
            <a href="/pages/family-orders" class="nb-btn nb-btn--outline nb-btn--sm">Pre-Order →</a>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Family Menu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Family Menu"
    }
  ]
}
{% endschema %}