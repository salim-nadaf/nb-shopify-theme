{% comment %} NIAMAT BIRYANI — Hero Section {% endcomment %}

<section class="nb-hero" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.video_url != blank -%}
    <video autoplay muted loop playsinline class="nb-hero__video">
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
    <div class="nb-hero__overlay"></div>
  {%- elsif section.settings.bg_image != blank -%}
    <div class="nb-hero__img-bg" style="background-image: url('{{ section.settings.bg_image | image_url: width: 1600 }}');"></div>
    <div class="nb-hero__overlay"></div>
  {%- else -%}
    <div class="nb-hero__bg-glow"></div>
  {%- endif -%}

  <div class="nb-container nb-hero__content">
    {%- if section.settings.badge_text != blank -%}
      <span class="nb-hero__badge">{{ section.settings.badge_text }}</span>
    {%- endif -%}
    <h1 class="nb-hero__headline">{{ section.settings.headline | default: "Premium Dum Biryani, Freshly Prepared for Every Occasion" }}</h1>
    <p class="nb-hero__subheading">{{ section.settings.subheading | default: "Whether you're craving a quick meal or planning a family gathering, enjoy freshly prepared biryani made with carefully selected ingredients and delivered across Kalyan and nearby areas." }}</p>
    
    <div class="nb-hero__actions">
      <a href="{{ section.settings.btn1_link | default: '/collections/instant-delivery' }}" class="nb-btn-gold">
        <span>{{ section.settings.btn1_text | default: "⚡ Order Instant Delivery" }}</span>
      </a>
      <a href="{{ section.settings.btn2_link | default: '/pages/family-feast' }}" class="nb-btn-glass">
        <span>{{ section.settings.btn2_text | default: "👑 Plan a Family Order" }}</span>
      </a>
    </div>

    <div class="nb-hero__trust">
      {{ section.settings.trust_text | default: "✓ Freshly Prepared &nbsp;•&nbsp; ✓ 100% Halal &nbsp;•&nbsp; ✓ Secure Online Payments" }}
    </div>
  </div>
</section>

<style>
.nb-hero {
  position: relative;
  background: linear-gradient(135deg, #1E100A 0%, #2C1810 60%, #3D2015 100%);
  color: #fff;
  padding: 48px 16px 56px;
  text-align: center;
  overflow: hidden;
}
.nb-hero__img-bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background-size: cover; background-position: center; z-index: 1;
}
.nb-hero__video {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover; z-index: 1;
}
.nb-hero__overlay {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(30, 16, 10, 0.75); z-index: 2;
}
.nb-hero__bg-glow {
  position: absolute; top: -50px; left: 50%;
  transform: translateX(-50%);
  width: 340px; height: 340px;
  background: radial-gradient(circle, rgba(200, 146, 42, 0.32) 0%, transparent 70%);
  pointer-events: none; z-index: 1;
}
.nb-hero__content { position: relative; z-index: 3; }
.nb-hero__badge {
  display: inline-block;
  background: rgba(200, 146, 42, 0.2);
  border: 1px solid rgba(200, 146, 42, 0.45);
  color: #FDF6EC;
  font-size: 0.78rem; font-weight: 700;
  padding: 5px 14px; border-radius: 20px;
  margin-bottom: 16px; letter-spacing: 0.3px;
}
.nb-hero__headline {
  font-size: 1.75rem; font-weight: 800; line-height: 1.25;
  color: #FFFDF7; margin: 0 0 14px; letter-spacing: -0.3px;
}
.nb-hero__subheading {
  font-size: 0.9rem; line-height: 1.5; color: #E2D5C5;
  max-width: 680px; margin: 0 auto 28px;
}
.nb-hero__actions {
  display: flex; flex-direction: column; gap: 12px;
  max-width: 380px; margin: 0 auto 24px;
}
.nb-hero__trust {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; font-size: 0.78rem; color: #C8922A; font-weight: 600; flex-wrap: wrap;
}

.nb-btn-gold {
  background: #C8922A; color: #fff !important; font-weight: 700; font-size: 0.92rem;
  padding: 14px 22px; border-radius: 12px; text-decoration: none;
  border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(200, 146, 42, 0.25);
}
.nb-btn-gold:hover { background: #A67520; transform: translateY(-2px); }

.nb-btn-glass {
  background: rgba(255, 250, 244, 0.08);
  border: 1.5px solid rgba(200, 146, 42, 0.4);
  color: #FDF6EC !important; font-weight: 700; font-size: 0.92rem;
  padding: 14px 22px; border-radius: 12px; text-decoration: none;
  cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  transition: all 0.2s ease;
}
.nb-btn-glass:hover { background: rgba(200, 146, 42, 0.2); border-color: #C8922A; color: #fff !important; }

@media (min-width: 768px) {
  .nb-hero { padding: 80px 24px 88px; }
  .nb-hero__headline { font-size: 2.75rem; }
  .nb-hero__subheading { font-size: 1.05rem; }
  .nb-hero__actions { flex-direction: row; max-width: 500px; justify-content: center; }
  .nb-hero__actions a { flex: 1; }
}
</style>

{% schema %}
{
  "name": "⚡ Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "⚡ Authentic Hyderabadi Dum Biryani"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Premium Dum Biryani, Freshly Prepared for Every Occasion"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Whether you're craving a quick meal or planning a family gathering, enjoy freshly prepared biryani made with carefully selected ingredients and delivered across Kalyan and nearby areas."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "⚡ Order Instant Delivery"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link",
      "default": "/collections/instant-delivery"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Button Text",
      "default": "👑 Plan a Family Order"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link",
      "default": "/pages/family-feast"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Line Text",
      "default": "✓ Freshly Prepared • ✓ 100% Halal • ✓ Secure Online Payments"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background Video URL (MP4)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "⚡ Hero Banner"
    }
  ]
}
{% endschema %}
