{% comment %}
  NIAMAT BIRYANI — Bulk Catering Page Section with Package Cards
{% comment %}

<div class="nb-bulk-container">
  <!-- PAGE INTRO HEADER -->
  <div class="nb-bulk-header">
    <span class="nb-pill-badge">🎉 BULK & EVENT CATERING</span>
    <h1>Bulk Catering Packages</h1>
    <p class="nb-bulk-sub">
      Host grand celebrations, family gatherings, and corporate events with authentic dum biryani prepared fresh in traditional handis by our 25+ year Ustaad. Select a package below to order directly via WhatsApp!
    </p>

    <div class="nb-notice-box">
      <span>⏰ Advance booking notice required for bulk catering orders.</span>
      <span>🚚 Delivery available across Kalyan, Ulhasnagar, Dombivli, Ambernath, Thane & nearby areas.</span>
    </div>
  </div>

  <!-- 3 OFFICIAL BULK CATERING PACKAGES -->
  <div class="nb-bulk-packages-grid">

    <!-- 1. The Mehmaan Plan [5 Kg] -->
    <div class="nb-bulk-package-card">
      <div class="nb-pkg-icon">🍛</div>
      <h3>The Mehmaan Plan [5 Kg]</h3>
      <div class="nb-pkg-price">₹4,499.00</div>
      <p class="nb-pkg-desc">Choose any 1 Biryani, 1 Starter, and 1 Gravy.</p>
      
      <div class="nb-pkg-includes">
        <span class="nb-free-bonus">✨ Includes a complimentary dessert</span>
      </div>

      <a href="https://wa.me/919167682582?text=Hi%20Niamat%20Biryani!%20I%20would%20like%20to%20book%20The%20Mehmaan%20Plan%20%5B5%20Kg%5D%20%40%20%E2%82%B94%2C499.%20Please%20confirm%20availability." 
