{% comment %} NIAMAT BIRYANI — Final CTA Section {% endcomment %}

<section class="nb-section nb-section--final-cta">
  <div class="nb-container">
    <div class="nb-final-cta-card">
      <h2>{{ section.settings.heading | default: "Ready to Enjoy Freshly Prepared Biryani?" }}</h2>
      <p>{{ section.settings.subheading | default: "Choose Instant Delivery for today's cravings or plan your next family gathering with our advance ordering service." }}</p>
      <div class="nb-final-actions">
        <a href="{{ section.settings.btn1_link | default: '/collections/instant-delivery' }}" class="nb-btn-gold">{{ section.settings.btn1_text | default: "Order Instant Delivery" }}</a>
        <a href="{{ section.settings.btn2_link | default: '/pages/family-feast' }}" class="nb-btn-glass">{{ section.settings.btn2_text | default: "Plan Family Order" }}</a>
      </div>
    </div>
  </div>
</section>

<style>
.nb-final-cta-card { background: linear-gradient(135deg, #1E100A 0%, #2C1810 100%); border-radius: 20px; padding: 40px 20px; text-align: center; color: #fff; max-width: 800px; margin: 0 auto; }
.nb-final-cta-card h2 { font-size: 1.6rem; font-weight: 800; color: #FFFDF7; margin: 0 0 10px; }
.nb-final-cta-card p { font-size: 0.88rem; color: #E2D5C5; max-width: 550px; margin: 0 auto 24px; }
.nb-final-actions { display: flex; flex-direction: column; gap: 12px; max-width: 400px; margin: 0 auto; }
@media (min-width: 768px) {
  .nb-final-cta-card { padding: 56px 40px; }
  .nb-final-cta-card h2 { font-size: 2.2rem; }
  .nb-final-actions { flex-direction: row; max-width: 480px; }
  .nb-final-actions a { flex: 1; }
}
</style>

{% schema %}
{
  "name": "🚀 Final Call To Action",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Enjoy Freshly Prepared Biryani?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose Instant Delivery for today's cravings or plan your next family gathering with our advance ordering service."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Primary Button Text",
      "default": "Order Instant Delivery"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Primary Button Link",
      "default": "/collections/instant-delivery"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Secondary Button Text",
      "default": "Plan Family Order"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Secondary Button Link",
      "default": "/pages/family-feast"
    }
  ],
  "presets": [
    {
      "name": "🚀 Final Call To Action"
    }
  ]
}
{% endschema %}
