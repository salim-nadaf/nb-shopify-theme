<!-- ═════════════════════════════════════════════════════════
     LIGHTWEIGHT JAVASCRIPT & ANALYTICS
     ========================================================= -->
<script>
(function() {
  'use strict';

  document.addEventListener('DOMContentLoaded', function() {
    
    /* 2. Variant selection in cards */
    document.querySelectorAll('.nb-qr-variant-pills').forEach(function(pillContainer) {
      pillContainer.addEventListener('click', function(e) {
        var pill = e.target.closest('.nb-qr-v-pill');
        if (!pill) return;
        pillContainer.querySelectorAll('.nb-qr-v-pill').forEach(function(p) { p.classList.remove('active'); });
        pill.classList.add('active');

        var card = pillContainer.closest('.nb-qr-product-card');
        if (!card) return;
        var variantId = pill.getAttribute('data-variant-id');
        var variantPrice = pill.getAttribute('data-variant-price');
        
        var hiddenInput = card.querySelector('.nb-qr-selected-variant-id');
        if (hiddenInput && variantId) hiddenInput.value = variantId;
        
        var priceEl = card.querySelector('.nb-qr-card-price');
        if (priceEl && variantPrice) priceEl.textContent = variantPrice;
      });
    });

    /* 3. AJAX Quick Add to Cart */
    document.querySelectorAll('.nb-qr-add-form').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = form.querySelector('[data-qr-add]');
        if (!btn || btn.classList.contains('added')) return;

        var origText = btn.textContent;
        btn.textContent = 'Adding…';
        btn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          body: new FormData(form)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          btn.textContent = '✓ Added';
          btn.classList.add('added');
          
          /* Update theme cart counter & open cart drawer */
          if (typeof window.nbOpenDrawer === 'function') {
            window.nbOpenDrawer();
          } else if (typeof nbOpenDrawer === 'function') {
            nbOpenDrawer();
          } else {
            var drawerEl = document.getElementById('nb-cart-drawer');
            var overlayEl = document.getElementById('nb-drawer-overlay');
            if (drawerEl) drawerEl.classList.add('active');
            if (overlayEl) overlayEl.classList.add('active');
            document.body.style.overflow = 'hidden';
            if (typeof window.nbRefreshCart === 'function') window.nbRefreshCart();
          }

          if (typeof fetch !== 'undefined') {
            fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
              document.querySelectorAll('[data-cart-count], .cart-count-badge, .cart-count').forEach(function(el) {
                el.textContent = cart.item_count;
              });
            });
          }

          setTimeout(function() {
            btn.textContent = origText;
            btn.classList.remove('added');
            btn.disabled = false;
          }, 2500);
        })
        .catch(function(err) {
          btn.textContent = 'Error';
          btn.disabled = false;
          setTimeout(function() { btn.textContent = origText; }, 2000);
        });
      });
    });

    /* 4. Smooth scrolling for internal anchor links */
    document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
      anchor.addEventListener('click', function(e) {
        var targetId = this.getAttribute('href');
        if (targetId.length > 1) {
          var targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    /* 5. Sticky Bottom Bar Visibility on Scroll */
    var stickyBar = document.getElementById('nb-qr-sticky-bar');
    if (stickyBar && window.innerWidth <= 768) {
      var hero = document.querySelector('.nb-qr-hero');
      if (hero && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            stickyBar.style.display = entry.isIntersecting ? 'none' : 'block';
          });
        }, { threshold: 0.1 });
        observer.observe(hero);
      }
    }

    /* 6. Event Analytics tracking */
    function trackEvent(eventName, label) {
      if (typeof gtag === 'function') {
        gtag('event', eventName, { event_category: 'qr_landing_page', event_label: label });
      }
      if (typeof fbq === 'function') {
        fbq('trackCustom', eventName, { label: label });
      }
    }

    var eventMappings = [
      { id: 'qr-hero-order-btn', event: 'qr_hero_order_again' },
      { id: 'qr-hero-menu-btn', event: 'qr_hero_explore_menu' },
      { id: 'qr-review-positive', event: 'qr_review_loved_it' },
      { id: 'qr-review-feedback', event: 'qr_review_improve_feedback' },
      { id: 'qr-whatsapp-btn', event: 'qr_whatsapp_click' },
      { id: 'qr-bottom-order-btn', event: 'qr_bottom_order_again' },
      { id: 'qr-sticky-order-btn', event: 'qr_sticky_order_again' }
    ];

    eventMappings.forEach(function(item) {
      var el = document.getElementById(item.id);
      if (el) {
        el.addEventListener('click', function() {
          trackEvent(item.event, 'packaging_qr');
        });
      }
    });

    /* 7. Hide default storewide header, footer & mobile dock on this dedicated landing page */
    (function hideThemeHeaderFooter() {
      function applyHide() {
        var selectors = [
          '#header-group',
          '.header-wrapper',
          'header-component',
          '.header-section',
          '.header',
          '#footer-group',
          '.footer-section',
          'footer:not(.nb-qr-footer)',
          '.nb-footer-section',
          '.nb-footer',
          '#nb-mobile-dock'
        ];
        selectors.forEach(function(sel) {
          document.querySelectorAll(sel).forEach(function(el) {
            if (el && !el.classList.contains('nb-qr-footer')) {
              el.style.setProperty('display', 'none', 'important');
            }
          });
        });
      }
      applyHide();
      setTimeout(applyHide, 100);
      setTimeout(applyHide, 500);
    })();

  });
})();
</script>

