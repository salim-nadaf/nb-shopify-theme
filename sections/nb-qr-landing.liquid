{% comment %}
  NIAMAT BIRYANI — Dedicated QR Landing & Reorder Page
  Mobile-First experience for customers scanning QR packaging sticker.
  URL: /pages/reorder?source=packaging_qr or /pages/qr?source=packaging_qr
{% endcomment %}

{% liquid
  assign wa_number = '919167682582'
  assign review_url = 'https://g.page/r/CdyJgLbadF31EBM/review'
  assign menu_url = '/collections/instant-delivery'
  
  assign logo_url = 'https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837'
  if settings.logo != blank
    assign logo_url = settings.logo | image_url: width: 360
  endif
%}

<div class="nb-qr-page-container">

  <!-- ═══════ 1. HERO / WELCOME ═══════ -->
  <section class="nb-qr-hero">
    <div class="nb-qr-inner">
      <div class="nb-qr-logo-wrap">
        <img
          src="{{ logo_url }}"
          alt="Biryani Palace by Niamat"
          class="nb-qr-logo"
          width="160" height="55"
          fetchpriority="high"
        >
      </div>
      <h1 class="nb-qr-hero-headline">Ready for your next biryani?</h1>
      <p class="nb-qr-hero-sub">Freshly prepared, just the way you like it.</p>
      
      <div class="nb-qr-hero-ctas">
        <a href="{{ menu_url }}" class="nb-qr-btn nb-qr-btn-primary nb-qr-btn-lg" id="qr-hero-order-btn">
          🍽️ Order Again
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ 2. REORDER-FIRST EXPERIENCE ═══════ -->
  <section class="nb-qr-section nb-qr-reorder-wrap" id="reorder-container">
    <div class="nb-qr-inner">
      <div class="nb-qr-section-header">
        <span class="nb-qr-badge-pill">⚡ QUICK REORDER</span>
        <h2 class="nb-qr-section-title">Your next meal is just a few taps away.</h2>
      </div>

      {% comment %} DYNAMIC CUSTOMER REORDER RECOGNITION {% endcomment %}
      {% if customer and customer.orders.size > 0 %}
        {% assign last_order = customer.orders.first %}
        <div class="nb-qr-customer-banner">
          <div class="nb-qr-customer-info">
            <span class="nb-qr-welcome-tag">WELCOME BACK, {{ customer.first_name | default: customer.name | upcase }}</span>
            <p class="nb-qr-last-order-text">Repeat your last order (#{{ last_order.name }}) from {{ last_order.created_at | date: "%b %d" }}:</p>
          </div>
          <div class="nb-qr-last-order-items">
            {% for line_item in last_order.line_items limit: 3 %}
              <div class="nb-qr-last-item">
                <span class="nb-qr-last-item-qty">{{ line_item.quantity }}x</span>
                <span class="nb-qr-last-item-name">{{ line_item.title }}</span>
                <span class="nb-qr-last-item-price">{{ line_item.final_price | money }}</span>
              </div>
            {% endfor %}
          </div>
          <a href="{{ last_order.reorder_url | default: menu_url }}" class="nb-qr-btn nb-qr-btn-primary nb-qr-btn-block margin-top-sm">
            ↻ Repeat Last Order
          </a>
        </div>
      {% endif %}

      {% comment %} POPULAR / CURRENT BIRYANI OPTIONS {% endcomment %}
      <div class="nb-qr-products-grid">
        {% liquid
          assign instant_coll = collections['instant-delivery']
          if instant_coll == blank or instant_coll.products.size == 0
            assign instant_coll = collections['all']
          endif
        %}

        {% if instant_coll != blank and instant_coll.products.size > 0 %}
          {% assign count = 0 %}
          {% for product in instant_coll.products %}
            {% liquid
              assign p_title = product.title | downcase
              assign is_target = false
              if p_title contains 'biryani' or p_title contains 'dum' or p_title contains 'bucket' or p_title contains 'tandoori'
                assign is_target = true
              endif
            %}
            {% if is_target and count < 4 %}
              {% assign count = count | plus: 1 %}
              {% assign first_var = product.selected_or_first_available_variant %}
              
              <div class="nb-qr-product-card">
                <div class="nb-qr-card-img-wrap">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 220 }}"
                      alt="{{ product.title | escape }}"
                      class="nb-qr-card-img"
                      loading="lazy"
                      width="90" height="90"
                    >
                  {% else %}
                    <div class="nb-qr-img-placeholder">🍛</div>
                  {% endif %}
                  
                  {% if p_title contains 'mutton' or p_title contains 'gosht' %}
                    <span class="nb-qr-card-badge nb-badge-musttry">⭐ Must Try</span>
                  {% elsif p_title contains 'murgh' or p_title contains 'chicken' %}
                    <span class="nb-qr-card-badge nb-badge-popular">🔥 Popular</span>
                  {% elsif p_title contains 'bucket' %}
                    <span class="nb-qr-card-badge nb-badge-bestseller">🏆 Family</span>
                  {% else %}
                    <span class="nb-qr-card-badge nb-badge-chef">👑 Chef Special</span>
                  {% endif %}
                </div>

                <div class="nb-qr-card-content">
                  <h3 class="nb-qr-card-title">{{ product.title }}</h3>
                  {% if product.description != blank %}
                    <p class="nb-qr-card-desc">{{ product.description | strip_html | truncate: 75 }}</p>
                  {% endif %}
                  
                  <div class="nb-qr-card-price-row">
                    <span class="nb-qr-card-price">{{ first_var.price | money }}</span>
                    {% if product.variants.size > 1 %}
                      <span class="nb-qr-variant-count">{{ product.variants.size }} sizes available</span>
                    {% endif %}
                  </div>

                  {% if product.variants.size > 1 %}
                    <div class="nb-qr-variant-pills" data-product-id="{{ product.id }}">
                      {% for variant in product.variants limit: 3 %}
                        <button
                          type="button"
                          class="nb-qr-v-pill {% if forloop.first %}active{% endif %}"
                          data-variant-id="{{ variant.id }}"
                          data-variant-price="{{ variant.price | money }}"
                        >
                          {{ variant.title }}
                        </button>
                      {% endfor %}
                    </div>
                  {% endif %}

                  <form method="post" action="/cart/add" class="nb-qr-add-form">
                    <input type="hidden" name="id" class="nb-qr-selected-variant-id" value="{{ first_var.id }}">
                    <button type="submit" class="nb-qr-btn nb-qr-btn-primary nb-qr-btn-sm nb-qr-add-btn" data-qr-add>
                      + Quick Add
                    </button>
                  </form>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      
      <div class="nb-qr-view-all-wrap">
        <a href="{{ menu_url }}" class="nb-qr-link-btn">View Full Menu & Pricing →</a>
      </div>
    </div>
  </section>

  <!-- ═══════ 3. BRAND MOMENT ═══════ -->
  <section class="nb-qr-section nb-qr-brand-wrap">
    <div class="nb-qr-inner">
      <div class="nb-qr-brand-card">
        <h2 class="nb-qr-section-title">Thank you for choosing Niamat.</h2>
        <p class="nb-qr-brand-text">
          We started this journey with a simple idea — to prepare biryani with care,
          keep learning, and become better with every order.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════ 4. SIGNATURE RAITA / FOOD DETAIL ═══════ -->
  <section class="nb-qr-section nb-qr-raita-wrap">
    <div class="nb-qr-inner">
      <div class="nb-qr-raita-card">
        <span class="nb-qr-raita-icon">🥣</span>
        <h3 class="nb-qr-raita-title">Niamat Signature Raita</h3>
        <p class="nb-qr-raita-desc">
          Cool, creamy and lightly spiced — crafted thoughtfully to balance every bite of rich dum biryani.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════ 5. REVIEW / FEEDBACK ═══════ -->
  <section class="nb-qr-section nb-qr-feedback-wrap">
    <div class="nb-qr-inner">
      <div class="nb-qr-section-header">
        <span class="nb-qr-badge-pill">⭐ VERIFIED REVIEWS & FEEDBACK</span>
        <h2 class="nb-qr-section-title">Loved Your Meal? We'd Love Your Review!</h2>
        <p class="nb-qr-section-desc">Your genuine rating helps our local kitchen in Kalyan grow and serve you better.</p>
      </div>

      <!-- GOOGLE REVIEW PRIMARY ACTION CARD -->
      <div class="nb-qr-review-showcase-card">
        <div class="nb-qr-review-header-row">
          <div class="nb-qr-google-badge">
            <svg class="nb-google-icon" width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Google Reviews</span>
          </div>
          <div class="nb-qr-stars-rating">
            <span class="nb-qr-star-symbols">★★★★★</span>
            <span class="nb-qr-rating-score">4.9 / 5.0</span>
          </div>
        </div>

        <h3 class="nb-qr-review-card-title">Share your love on Google</h3>
        <p class="nb-qr-review-card-text">
          Enjoyed the authentic coal dum aroma, tender meat, and signature raita? Tap below to drop a quick rating on Google — takes less than 30 seconds!
        </p>

        <!-- PROMINENT CLICKABLE BUTTON LINK -->
        <a href="{{ review_url }}" target="_blank" rel="noopener" class="nb-qr-btn nb-qr-btn-review-gold" id="qr-review-positive">
          <span>⭐ Rate 5 Stars on Google</span>
          <span class="nb-btn-arrow">↗</span>
        </a>
      </div>

      <!-- WHATSAPP DIRECT FEEDBACK CARD -->
      <div class="nb-qr-feedback-subgrid">
        <a href="https://wa.me/{{ wa_number }}?text=Hi%20Niamat%2C%20I%20have%20feedback%20or%20suggestions%20about%20my%20recent%20order." target="_blank" rel="noopener" class="nb-qr-feedback-action-card nb-qr-feedback-whatsapp" id="qr-review-feedback">
          <div class="nb-qr-feedback-action-icon">💬</div>
          <div class="nb-qr-feedback-action-body">
            <strong class="nb-qr-feedback-action-title">Suggestions or Need Help?</strong>
            <span class="nb-qr-feedback-action-sub">Chat directly with kitchen managers</span>
          </div>
          <span class="nb-qr-action-pill">WhatsApp ↗</span>
        </a>
      </div>

      <!-- CUSTOMER PRAISE CARDS -->
      <div class="nb-qr-review-quotes-grid">
        <div class="nb-qr-quote-card">
          <div class="nb-qr-quote-stars">★★★★★</div>
          <p class="nb-qr-quote-text">"Authentic Dum Biryani taste! Meat was super tender, perfectly spiced, and the included raita was exceptional."</p>
          <span class="nb-qr-quote-author">— Rahul M., Kalyan West</span>
        </div>
        <div class="nb-qr-quote-card">
          <div class="nb-qr-quote-stars">★★★★★</div>
          <p class="nb-qr-quote-text">"Ordered for our family dinner. The 2 KG Handi arrived piping hot and fresh. Loved every bite!"</p>
          <span class="nb-qr-quote-author">— Sneha K., Kalyan East</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ 6. WHATSAPP SUPPORT ═══════ -->
  <section class="nb-qr-section nb-qr-whatsapp-wrap">
    <div class="nb-qr-inner">
      <div class="nb-qr-whatsapp-card">
        <h2 class="nb-qr-section-title">Need anything?</h2>
        <p class="nb-qr-whatsapp-text">
          Questions, feedback or help with your order?<br>We're just a WhatsApp message away.
        </p>
        <a href="https://wa.me/{{ wa_number }}?text=Hi%20Niamat%20Biryani%2C%20I%20scanned%20the%20QR%20code%20on%20my%20packaging." target="_blank" rel="noopener" class="nb-qr-btn nb-qr-btn-whatsapp nb-qr-btn-lg" id="qr-whatsapp-btn">
          💬 Chat on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ 7. REORDER CTA ═══════ -->
  <section class="nb-qr-section nb-qr-bottom-cta-wrap">
    <div class="nb-qr-inner">
      <h2 class="nb-qr-section-title">Craving it again?</h2>
      <a href="{{ menu_url }}" class="nb-qr-btn nb-qr-btn-primary nb-qr-btn-lg" id="qr-bottom-order-btn">
        Order Again
      </a>
    </div>
  </section>

  <!-- ═══════ 8. MINIMAL FOOTER ═══════ -->
  <footer class="nb-qr-footer">
    <div class="nb-qr-inner">
      <p class="nb-qr-footer-brand">Biryani Palace by Niamat</p>
      <p class="nb-qr-footer-tagline">Freshly Prepared Dum Biryani</p>
      <nav class="nb-qr-footer-links">
        <a href="{{ menu_url }}">Menu</a>
        <a href="/pages/about-us">About Us</a>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/delivery-areas">Delivery Areas</a>
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms</a>
      </nav>
    </div>
  </footer>

</div>

<!-- ═══════ STICKY BOTTOM MOBILE ORDER BAR ═══════ -->
<div class="nb-qr-sticky-bar" id="nb-qr-sticky-bar">
  <a href="{{ menu_url }}" class="nb-qr-btn nb-qr-btn-primary nb-qr-btn-block" id="qr-sticky-order-btn">
    🍽️ Order Again
  </a>
</div>

<!-- ═════════════════════════════════════════════════════════
     STYLES: EXACT NIAMAT DESIGN SYSTEM INTEGRATION
     ========================================================= -->
<style>
/* === OVERRIDE THEME PAGE CONTAINER RESTRICTIONS FOR THIS PAGE === */
[data-template="page.qr"] .main-page,
[data-template="page.reorder"] .main-page,
.template-page-qr #MainContent,
.template-page-reorder #MainContent,
.template-page-qr .page-width,
.template-page-reorder .page-width {
  padding-left: 0 !important;
  padding-right: 0 !important;
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 !important;
}

/* Hide default page title on page.qr / page.reorder if present */
.template-page-qr .main-page-title,
.template-page-reorder .main-page-title,
.template-page-qr .page-header,
.template-page-reorder .page-header {
  display: none !important;
}

/* === HIDE STOREWIDE DEFAULT HEADER, FOOTER & MOBILE DOCK ON QR / REORDER PAGE === */
#header-group,
.header-wrapper,
header-component,
.header-section,
.header,
#footer-group,
.footer-section,
footer:not(.nb-qr-footer),
.nb-footer-section,
.nb-footer,
#nb-mobile-dock {
  display: none !important;
}

/* Ensure no top margin/padding above the hero on QR page */
#MainContent,
.content-for-layout,
.page-wrapper {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

/* === MASTER PAGE WRAPPER === */
.nb-qr-page-container {
  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
  background-color: #FFFAF4 !important;
  color: #2C1810 !important;
  width: 100% !important;
  min-height: 100vh;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
  padding-bottom: 70px; /* Space for sticky bar on mobile */
}

.nb-qr-page-container *,
.nb-qr-page-container *::before,
.nb-qr-page-container *::after {
  box-sizing: border-box;
}

/* === INNER CONTAINER (PREVENTS SQUISHED MIDDLE / BLANK GAPS) === */
.nb-qr-inner {
  max-width: 680px;
  margin: 0 auto;
  padding: 0 16px;
  width: 100%;
}

/* === HERO SECTION WITH ORIGINAL DARK STORE HEADER BACKGROUND === */
.nb-qr-hero {
  background: linear-gradient(135deg, #1E100A 0%, #2C1810 100%) !important;
  background-color: #1E100A !important;
  padding: 32px 0 36px !important;
  text-align: center !important;
  border-bottom: 2.5px solid #C8922A !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
}
.nb-qr-logo-wrap {
  margin-bottom: 16px;
  display: flex;
  justify-content: center;
}
.nb-qr-logo {
  height: 56px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
}
.nb-qr-hero-headline {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: clamp(1.55rem, 5vw, 2.2rem) !important;
  font-weight: 700 !important;
  color: #FDF6EC !important;
  margin: 0 0 8px 0 !important;
  line-height: 1.25 !important;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}
.nb-qr-hero-sub {
  font-size: 0.95rem !important;
  color: rgba(253, 246, 236, 0.82) !important;
  margin: 0 0 22px 0 !important;
}
.nb-qr-hero .nb-qr-btn-outline {
  background: transparent !important;
  color: #FDF6EC !important;
  border: 1.5px solid rgba(253, 246, 236, 0.4) !important;
}
.nb-qr-hero .nb-qr-btn-outline:hover,
.nb-qr-hero .nb-qr-btn-outline:active {
  background: rgba(253, 246, 236, 0.1) !important;
  border-color: rgba(253, 246, 236, 0.8) !important;
}
.nb-qr-hero-ctas {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 360px;
  margin: 0 auto;
}

/* === BUTTON SYSTEM === */
.nb-qr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: 'Inter', system-ui, sans-serif !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  border-radius: 12px !important;
  padding: 13px 20px;
  min-height: 48px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  text-align: center;
  box-sizing: border-box;
}
.nb-qr-btn-primary {
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
  color: #FFFFFF !important;
  box-shadow: 0 4px 16px rgba(200, 146, 42, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;
}
.nb-qr-btn-primary:hover,
.nb-qr-btn-primary:active {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(200, 146, 42, 0.45) !important;
}
.nb-qr-btn-outline {
  background: transparent !important;
  color: #C8922A !important;
  border: 1.5px solid #C8922A !important;
}
.nb-qr-btn-outline:hover,
.nb-qr-btn-outline:active {
  background: rgba(200, 146, 42, 0.08) !important;
}
.nb-qr-btn-whatsapp {
  background: #25D366 !important;
  color: #FFFFFF !important;
  box-shadow: 0 4px 16px rgba(37, 211, 102, 0.3) !important;
}
.nb-qr-btn-whatsapp:hover,
.nb-qr-btn-whatsapp:active {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45) !important;
}
.nb-qr-btn-lg {
  font-size: 1rem !important;
  padding: 15px 24px !important;
  min-height: 52px !important;
}
.nb-qr-btn-sm {
  font-size: 0.82rem !important;
  padding: 9px 16px !important;
  min-height: 38px !important;
  border-radius: 8px !important;
}
.nb-qr-btn-block {
  width: 100% !important;
}
.margin-top-sm {
  margin-top: 10px;
}

/* === SECTION GENERAL === */
.nb-qr-section {
  padding: 24px 0;
}
.nb-qr-section-header {
  text-align: center;
  margin-bottom: 16px;
}
.nb-qr-badge-pill {
  display: inline-block;
  font-size: 0.68rem !important;
  font-weight: 800 !important;
  letter-spacing: 0.1em !important;
  color: #C8922A !important;
  background: rgba(200, 146, 42, 0.1) !important;
  border: 1px solid rgba(200, 146, 42, 0.25) !important;
  padding: 4px 12px !important;
  border-radius: 20px !important;
  margin-bottom: 8px;
}
.nb-qr-section-title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: clamp(1.2rem, 4vw, 1.5rem) !important;
  font-weight: 700 !important;
  color: #2C1810 !important;
  margin: 0 0 6px 0 !important;
  line-height: 1.3 !important;
}

/* === CUSTOMER BANNER (LOGGED IN REORDER) === */
.nb-qr-customer-banner {
  background: #FFFDF7;
  border: 1.5px solid rgba(200, 146, 42, 0.35);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 20px;
}
.nb-qr-welcome-tag {
  font-size: 0.72rem;
  font-weight: 800;
  color: #C8922A;
  letter-spacing: 0.08em;
}
.nb-qr-last-order-text {
  font-size: 0.88rem;
  color: #2C1810;
  margin: 4px 0 10px;
}
.nb-qr-last-order-items {
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: #FFFAF4;
  padding: 10px;
  border-radius: 8px;
}
.nb-qr-last-item {
  display: flex;
  justify-content: space-between;
  font-size: 0.84rem;
  color: #2C1810;
}
.nb-qr-last-item-qty {
  font-weight: 700;
  color: #C8922A;
}

/* === PRODUCT CARDS GRID === */
.nb-qr-products-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.nb-qr-product-card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12px;
  background: #FFFAF4;
  border: 1px solid rgba(200, 146, 42, 0.2);
  border-radius: 14px;
  padding: 12px;
  transition: box-shadow 0.2s ease;
}
.nb-qr-product-card:hover {
  box-shadow: 0 4px 16px rgba(44, 24, 16, 0.08);
}
.nb-qr-card-img-wrap {
  position: relative;
  flex-shrink: 0;
  width: 90px;
  height: 90px;
  border-radius: 10px;
  overflow: hidden;
