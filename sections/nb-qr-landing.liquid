{% comment %}
  NIAMAT BIRYANI — QR Reorder Landing Page
  Mobile-first page for customers scanning packaging QR codes.
  Full-width, uses existing Niamat design system.
  URL: /pages/reorder?source=packaging_qr
{% endcomment %}

{% liquid
  assign wa_number = settings.nb_whatsapp_number | default: '919082910863'
  assign review_url = settings.nb_review_url | default: 'https://g.page/r/YOUR_GOOGLE_REVIEW_LINK/review'
  assign menu_url = '/collections/instant-delivery'
  assign logo_url = 'https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837'
%}

<div class="nb-qr-page">

  <!-- ═══════ 1. HERO ═══════ -->
  <section class="nb-qr-hero">
    <div class="nb-qr-wrap">
      <img
        src="{{ logo_url }}"
        alt="Biryani Palace by Niamat"
        class="nb-qr-hero__logo"
        width="160" height="52"
        fetchpriority="high"
      >
      <h1 class="nb-qr-hero__title">Ready for your next biryani?</h1>
      <p class="nb-qr-hero__sub">Freshly prepared, just the way you like it.</p>
      <div class="nb-qr-hero__ctas">
        <a href="{{ menu_url }}?source=packaging_qr" class="nb-qr-btn nb-qr-btn--gold nb-qr-btn--lg" id="qr-hero-order">
          🍽️ Order Again
        </a>
        <a href="{{ menu_url }}?source=packaging_qr" class="nb-qr-btn nb-qr-btn--outline-light" id="qr-hero-menu">
          Explore Our Menu →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ 2. REORDER PRODUCTS ═══════ -->
  <section class="nb-qr-sec">
    <div class="nb-qr-wrap">
      <div class="nb-qr-sec__header">
        <span class="nb-qr-badge">QUICK REORDER</span>
        <h2 class="nb-qr-sec__title">Your next meal is just a few taps away.</h2>
      </div>
      <div class="nb-qr-products">
        {% assign qr_handles = 'dum-biryani,tandoori-biryani,signature-bucket-biryani' | split: ',' %}
        {% for handle in qr_handles %}
          {% assign p = all_products[handle] %}
          {% if p %}
            <div class="nb-qr-card">
              <div class="nb-qr-card__img-wrap">
                <img
                  src="{{ p.featured_image | image_url: width: 240 }}"
                  alt="{{ p.title | escape }}"
                  class="nb-qr-card__img"
                  loading="lazy"
                  width="100" height="100"
                >
              </div>
              <div class="nb-qr-card__body">
                <h3 class="nb-qr-card__name">{{ p.title }}</h3>
                {% if p.description != blank %}
                  <p class="nb-qr-card__desc">{{ p.description | strip_html | truncate: 80 }}</p>
                {% endif %}
                {% if p.variants.size > 1 %}
                  <div class="nb-qr-card__variants">
                    {% for v in p.variants limit: 3 %}
                      <span class="nb-qr-variant-pill">{{ v.title }} · {{ v.price | money }}</span>
                    {% endfor %}
                  </div>
                {% else %}
                  <p class="nb-qr-card__price">{{ p.price | money }}</p>
                {% endif %}
                <form method="post" action="/cart/add" class="nb-qr-add-form">
                  <input type="hidden" name="id" value="{{ p.variants.first.id }}">
                  <input type="hidden" name="properties[source]" value="packaging_qr">
                  <button type="submit" class="nb-qr-btn nb-qr-btn--gold nb-qr-btn--sm" data-qr-add>
                    + Quick Add
                  </button>
                </form>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ═══════ 3. BRAND MOMENT ═══════ -->
  <section class="nb-qr-sec nb-qr-sec--dark">
    <div class="nb-qr-wrap">
      <h2 class="nb-qr-sec__title nb-qr-sec__title--light">Thank you for choosing Niamat.</h2>
      <p class="nb-qr-sec__body nb-qr-sec__body--light">
        We started this journey with a simple idea — to prepare biryani with care,
        keep learning, and become better with every order.
      </p>
    </div>
  </section>

  <!-- ═══════ 4. SIGNATURE RAITA ═══════ -->
  <section class="nb-qr-sec nb-qr-sec--alt">
    <div class="nb-qr-wrap">
      <div class="nb-qr-raita">
        <span class="nb-qr-raita__icon">🥣</span>
        <h3 class="nb-qr-raita__title">Niamat Signature Raita</h3>
        <p class="nb-qr-raita__text">
          Cool, creamy and lightly spiced — made to balance every bite of biryani.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════ 5. REVIEW / FEEDBACK ═══════ -->
  <section class="nb-qr-sec">
    <div class="nb-qr-wrap">
      <div class="nb-qr-sec__header">
        <span class="nb-qr-badge">YOUR FEEDBACK</span>
        <h2 class="nb-qr-sec__title">How was your Niamat experience?</h2>
      </div>
      <div class="nb-qr-feedback">
        <a href="{{ review_url }}" target="_blank" rel="noopener" class="nb-qr-feedback__card nb-qr-feedback__card--positive" id="qr-review-positive">
          <span class="nb-qr-feedback__stars">★★★★★</span>
          <span class="nb-qr-feedback__label">Loved it!</span>
          <span class="nb-qr-feedback__hint">Leave a quick review</span>
        </a>
        <a href="https://wa.me/{{ wa_number }}?text=Hi%20Niamat%2C%20I%20have%20feedback%20about%20my%20recent%20order." target="_blank" rel="noopener" class="nb-qr-feedback__card nb-qr-feedback__card--improve" id="qr-review-feedback">
          <span class="nb-qr-feedback__icon">💬</span>
          <span class="nb-qr-feedback__label">Tell us how we can improve</span>
          <span class="nb-qr-feedback__hint">Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ 6. WHATSAPP ═══════ -->
  <section class="nb-qr-sec nb-qr-sec--alt">
    <div class="nb-qr-wrap">
      <h2 class="nb-qr-sec__title">Need anything?</h2>
      <p class="nb-qr-sec__body">
        Questions, feedback or help with your order?<br>We're just a WhatsApp message away.
      </p>
      <a href="https://wa.me/{{ wa_number }}?text=Hi%20Niamat%20Biryani%2C%20I%20scanned%20the%20QR%20on%20my%20order." class="nb-qr-btn nb-qr-btn--whatsapp nb-qr-btn--lg" id="qr-whatsapp" target="_blank" rel="noopener">
        💬 Chat on WhatsApp
      </a>
    </div>
  </section>

  <!-- ═══════ 7. BOTTOM REORDER CTA ═══════ -->
  <section class="nb-qr-sec nb-qr-sec--dark nb-qr-sec--cta">
    <div class="nb-qr-wrap">
      <h2 class="nb-qr-sec__title nb-qr-sec__title--light">Craving it again?</h2>
      <a href="{{ menu_url }}?source=packaging_qr" class="nb-qr-btn nb-qr-btn--gold nb-qr-btn--lg" id="qr-bottom-order">
        🍽️ Order Again
      </a>
    </div>
  </section>

  <!-- ═══════ 8. FOOTER ═══════ -->
  <footer class="nb-qr-footer">
    <div class="nb-qr-wrap">
      <p class="nb-qr-footer__brand">Biryani Palace by Niamat</p>
      <p class="nb-qr-footer__tag">Freshly Prepared Dum Biryani</p>
      <nav class="nb-qr-footer__nav">
        <a href="/collections/instant-delivery">Menu</a>
        <a href="/pages/about-us">About Us</a>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/delivery-areas">Delivery Areas</a>
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Terms</a>
      </nav>
    </div>
  </footer>

</div>

<!-- ═══════ STICKY MOBILE REORDER BAR ═══════ -->
<div class="nb-qr-sticky" id="nb-qr-sticky">
  <a href="{{ menu_url }}?source=packaging_qr" class="nb-qr-btn nb-qr-btn--gold nb-qr-btn--sticky" id="qr-sticky-order">
    🍽️ Order Again
  </a>
</div>

<style>
/* =========================================================
   NIAMAT QR LANDING PAGE — FULL-WIDTH, MOBILE-FIRST
   ========================================================= */

/* --- BREAKOUT: fill the entire viewport width --- */
.nb-qr-page {
  font-family: 'Inter', system-ui, sans-serif !important;
  color: #2C1810 !important;
  -webkit-font-smoothing: antialiased;
  line-height: 1.5;
  width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
  margin-left: -50vw !important;
  margin-right: -50vw !important;
  overflow-x: hidden;
}
.nb-qr-page *, .nb-qr-page *::before, .nb-qr-page *::after {
  box-sizing: border-box;
}

/* --- Inner wrap: constrains text content --- */
.nb-qr-wrap {
  max-width: 640px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
}

/* ===== HERO ===== */
.nb-qr-hero {
  background: linear-gradient(145deg, #2C1810 0%, #1E100A 100%);
  padding: 36px 0 40px;
  text-align: center;
  border-bottom: 3px solid #C8922A;
}
.nb-qr-hero__logo {
  height: 48px;
  width: auto;
  max-width: 180px;
  object-fit: contain;
  margin-bottom: 20px;
}
.nb-qr-hero__title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-weight: 700 !important;
  font-size: clamp(1.5rem, 5vw, 2rem);
  line-height: 1.2;
  color: #FDF6EC !important;
  margin: 0 0 10px !important;
}
.nb-qr-hero__sub {
  font-size: 0.95rem;
  color: rgba(253,246,236,0.75) !important;
  margin: 0 0 24px;
  line-height: 1.45;
}
.nb-qr-hero__ctas {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 340px;
  margin: 0 auto;
}

/* ===== BUTTONS ===== */
.nb-qr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: 'Inter', sans-serif !important;
  font-weight: 700 !important;
  font-size: 0.95rem;
  text-decoration: none !important;
  border-radius: 12px;
  padding: 14px 24px;
  min-height: 50px;
  cursor: pointer;
  transition: all 0.2s ease;
  -webkit-tap-highlight-color: transparent;
  border: none;
  text-align: center;
  line-height: 1.2;
}
.nb-qr-btn--gold {
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
  color: #FFFFFF !important;
  box-shadow: 0 4px 16px rgba(200,146,42,0.35), inset 0 1px 0 rgba(255,255,255,0.25);
}
.nb-qr-btn--gold:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(200,146,42,0.45);
}
.nb-qr-btn--outline-light {
  background: transparent !important;
  color: #FDF6EC !important;
  border: 1.5px solid rgba(253,246,236,0.4);
}
.nb-qr-btn--outline-light:hover {
  background: rgba(253,246,236,0.08) !important;
  border-color: rgba(253,246,236,0.7);
}
.nb-qr-btn--whatsapp {
  background: #25D366 !important;
  color: #FFFFFF !important;
  box-shadow: 0 4px 16px rgba(37,211,102,0.3);
}
.nb-qr-btn--whatsapp:hover {
  box-shadow: 0 8px 24px rgba(37,211,102,0.45);
  transform: translateY(-2px);
}
.nb-qr-btn--sm {
  font-size: 0.82rem;
  font-weight: 800 !important;
  padding: 9px 16px;
  min-height: 38px;
  border-radius: 8px;
}
.nb-qr-btn--lg {
  font-size: 1.05rem;
  padding: 16px 28px;
  min-height: 54px;
}
.nb-qr-btn--sm.added {
  background: #2E7D32 !important;
  pointer-events: none;
}

/* ===== SECTIONS ===== */
.nb-qr-sec {
  padding: 32px 0;
  background: #FFFAF4;
  text-align: center;
}
.nb-qr-sec--alt {
  background: #FDF6EC;
}
.nb-qr-sec--dark {
  background: linear-gradient(145deg, #2C1810 0%, #1E100A 100%);
}
.nb-qr-sec--cta {
  padding: 36px 0;
}

/* ===== SECTION HEADERS ===== */
.nb-qr-sec__header {
  margin-bottom: 20px;
}
.nb-qr-badge {
  display: inline-block;
  font-family: 'Inter', sans-serif !important;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #C8922A !important;
  background: rgba(200,146,42,0.1);
  border: 1px solid rgba(200,146,42,0.2);
  padding: 4px 14px;
  border-radius: 20px;
  margin-bottom: 10px;
}
.nb-qr-sec__title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-weight: 700 !important;
  font-size: clamp(1.2rem, 4vw, 1.6rem);
  line-height: 1.25;
  color: #2C1810 !important;
  margin: 0 0 12px !important;
}
.nb-qr-sec__title--light {
  color: #FDF6EC !important;
}
.nb-qr-sec__body {
  font-size: 0.92rem;
  line-height: 1.55;
  color: #7A5C4A !important;
  max-width: 400px;
  margin: 0 auto 20px;
}
.nb-qr-sec__body--light {
  color: rgba(253,246,236,0.75) !important;
}

/* ===== PRODUCT CARDS ===== */
.nb-qr-products {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.nb-qr-card {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  background: #FFFFFF;
  border: 1px solid rgba(200,146,42,0.18);
  border-radius: 14px;
  padding: 14px;
  box-shadow: 0 2px 10px rgba(44,24,16,0.04);
  text-align: left;
  transition: box-shadow 0.2s;
}
.nb-qr-card:hover {
  box-shadow: 0 4px 20px rgba(44,24,16,0.1);
}
.nb-qr-card__img-wrap {
  flex-shrink: 0;
  width: 100px;
  height: 100px;
  border-radius: 10px;
  overflow: hidden;
  background: #F5ECD7;
}
.nb-qr-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.nb-qr-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.nb-qr-card__name {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 1rem;
  font-weight: 700 !important;
  color: #2C1810 !important;
  line-height: 1.25;
  margin: 0 !important;
}
.nb-qr-card__desc {
  font-size: 0.78rem;
  color: #7A5C4A !important;
  line-height: 1.4;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nb-qr-card__price {
  font-size: 1rem;
  font-weight: 800 !important;
  color: #C8922A !important;
  margin: 2px 0 6px;
}
.nb-qr-card__variants {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin: 4px 0 8px;
}
.nb-qr-variant-pill {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  background: #FDF6EC;
  color: #2C1810;
  padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid rgba(200,146,42,0.25);
}
.nb-qr-add-form {
  margin: 0;
}

/* ===== RAITA HIGHLIGHT ===== */
.nb-qr-raita {
  background: linear-gradient(135deg, #FFFDF7 0%, #F5ECD7 100%);
  border: 1px solid rgba(200,146,42,0.25);
  border-radius: 16px;
  padding: 28px 24px;
  text-align: center;
}
.nb-qr-raita__icon {
  font-size: 2.2rem;
  display: block;
  margin-bottom: 10px;
}
.nb-qr-raita__title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-weight: 700 !important;
  font-size: 1.15rem;
  color: #2C1810 !important;
  margin: 0 0 8px !important;
}
.nb-qr-raita__text {
  font-size: 0.9rem;
  color: #7A5C4A !important;
  line-height: 1.5;
  margin: 0;
  max-width: 340px;
  margin: 0 auto;
}

/* ===== FEEDBACK CARDS ===== */
.nb-qr-feedback {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  max-width: 440px;
  margin: 0 auto;
}
.nb-qr-feedback__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 20px 12px;
  border-radius: 14px;
  text-decoration: none !important;
  text-align: center;
  transition: all 0.2s;
  min-height: 120px;
}
.nb-qr-feedback__card--positive {
  background: #FFFFFF;
  border: 2px solid rgba(200,146,42,0.3);
}
.nb-qr-feedback__card--positive:hover {
  border-color: #C8922A;
  box-shadow: 0 4px 16px rgba(200,146,42,0.15);
  transform: translateY(-2px);
}
.nb-qr-feedback__card--improve {
  background: #FFFFFF;
  border: 2px solid rgba(200,146,42,0.15);
}
.nb-qr-feedback__card--improve:hover {
  border-color: #25D366;
  box-shadow: 0 4px 16px rgba(37,211,102,0.12);
  transform: translateY(-2px);
}
.nb-qr-feedback__stars {
  font-size: 1.3rem;
  color: #C8922A !important;
  letter-spacing: 2px;
}
.nb-qr-feedback__icon {
  font-size: 1.5rem;
}
.nb-qr-feedback__label {
  font-size: 0.85rem;
  font-weight: 700 !important;
  color: #2C1810 !important;
  line-height: 1.3;
}
.nb-qr-feedback__hint {
  font-size: 0.72rem;
  color: #7A5C4A !important;
}

/* ===== FOOTER ===== */
.nb-qr-footer {
  background: #1E100A !important;
  padding: 28px 0 100px; /* extra for sticky bar */
  text-align: center;
  border-top: 2px solid #C8922A;
}
.nb-qr-footer__brand {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-weight: 700;
  font-size: 0.95rem;
  color: #FDF6EC !important;
  margin: 0 0 2px;
}
.nb-qr-footer__tag {
  font-size: 0.78rem;
  color: rgba(253,246,236,0.6) !important;
  margin: 0 0 16px;
}
.nb-qr-footer__nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 16px;
}
.nb-qr-footer__nav a {
  font-size: 0.78rem;
  color: rgba(253,246,236,0.7) !important;
  text-decoration: none !important;
  transition: color 0.15s;
}
.nb-qr-footer__nav a:hover {
  color: #C8922A !important;
}

/* ===== STICKY MOBILE BAR ===== */
.nb-qr-sticky {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  background: rgba(255,250,244,0.97);
  border-top: 1px solid rgba(200,146,42,0.25);
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
  box-shadow: 0 -4px 20px rgba(44,24,16,0.1);
  display: none;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.nb-qr-btn--sticky {
  width: 100%;
  font-size: 1rem;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 430px) {
  .nb-qr-hero { padding: 28px 0 32px; }
  .nb-qr-sec { padding: 24px 0; }
  .nb-qr-wrap { padding-left: 16px; padding-right: 16px; }
  .nb-qr-card__img-wrap { width: 88px; height: 88px; }
  .nb-qr-feedback { grid-template-columns: 1fr 1fr; gap: 10px; }
  .nb-qr-feedback__card { padding: 16px 10px; min-height: 110px; }
}
@media (min-width: 641px) {
  .nb-qr-products {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .nb-qr-card {
    flex-direction: column;
    text-align: center;
    align-items: center;
  }
  .nb-qr-card__img-wrap { width: 140px; height: 140px; }
  .nb-qr-card__body { align-items: center; }
  .nb-qr-hero__ctas {
    flex-direction: row;
    justify-content: center;
  }
  .nb-qr-btn--lg { min-width: 200px; }
}
@media (min-width: 769px) {
  .nb-qr-sticky { display: none !important; }
  .nb-qr-footer { padding-bottom: 28px; }
  .nb-qr-wrap { max-width: 720px; }
}
</style>

<!-- ═══════ MINIMAL JS ═══════ -->
<script>
(function() {
  'use strict';

  /* Campaign source tracking */
  (function() {
    if (window.location.search.indexOf('source=') === -1) {
      var sep = window.location.search ? '&' : '?';
      var newUrl = window.location.pathname + window.location.search + sep + 'source=packaging_qr' + window.location.hash;
      if (history.replaceState) history.replaceState(null, '', newUrl);
    }
  })();

  document.addEventListener('DOMContentLoaded', function() {

    /* AJAX add-to-cart */
    document.querySelectorAll('.nb-qr-add-form').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = form.querySelector('[data-qr-add]');
        if (!btn || btn.classList.contains('added')) return;
        var origText = btn.textContent;
        btn.textContent = 'Adding…';
        btn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          body: new FormData(form)
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          btn.textContent = '✓ Added';
          btn.classList.add('added');
          setTimeout(function() {
            btn.textContent = origText;
            btn.classList.remove('added');
            btn.disabled = false;
          }, 2500);
          /* Update cart badges */
          fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
            document.querySelectorAll('[data-cart-count], .cart-count-badge').forEach(function(el) {
              el.textContent = cart.item_count;
            });
          });
        })
        .catch(function() {
          btn.textContent = 'Error';
          btn.disabled = false;
          setTimeout(function() { btn.textContent = origText; }, 2000);
        });
      });
    });

    /* Sticky bar visibility */
    var sticky = document.getElementById('nb-qr-sticky');
    if (sticky && window.innerWidth <= 768) {
      sticky.style.display = 'none';
      var hero = document.querySelector('.nb-qr-hero');
      if (hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            sticky.style.display = entry.isIntersecting ? 'none' : 'block';
          });
        }, { threshold: 0.05 }).observe(hero);
      }
    }

    /* Analytics events */
    function trackClick(id, label) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('click', function() {
          if (typeof gtag === 'function') {
            gtag('event', label, { event_category: 'qr_landing', event_label: 'packaging_qr' });
          }
          if (typeof fbq === 'function') {
            fbq('trackCustom', label);
          }
        });
      }
    }
    trackClick('qr-hero-order', 'qr_order_again_hero');
    trackClick('qr-hero-menu', 'qr_explore_menu');
    trackClick('qr-review-positive', 'qr_review_positive');
    trackClick('qr-review-feedback', 'qr_review_feedback');
    trackClick('qr-whatsapp', 'qr_whatsapp_click');
    trackClick('qr-bottom-order', 'qr_order_again_bottom');
    trackClick('qr-sticky-order', 'qr_order_again_sticky');
  });
})();
</script>

