{% comment %}
  NIAMAT BIRYANI — Google Reviews Header & Judge.me Review Widget Container (Tight Spacing)
{% endcomment %}

<div class="nb-reviews-header-section">
  <div class="nb-container">
    <div class="nb-section-header">
      <span class="nb-tag-badge">{{ section.settings.tag_badge | default: 'GOOGLE REVIEWS' }}</span>
      <h2>{{ section.settings.title | default: 'Loved by Biryani Enthusiasts Across Kalyan' }}</h2>
    </div>

    <!-- JUDGE.ME NATIVE REVIEW WIDGET CONTAINER -->
    <div class="nb-judgeme-container">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

<style>
.nb-reviews-header-section { background-color: #FDF6EC; padding: 36px 0 0; text-align: center; }
.nb-container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
.nb-section-header { margin-bottom: 8px; }
.nb-tag-badge { display: inline-block; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #C8922A !important; margin-bottom: 4px; }
.nb-section-header h2 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 1.8rem; font-weight: 800; color: #2C1810 !important; margin: 0; }

.nb-judgeme-container { margin-top: 6px; margin-bottom: 0; }
.nb-judgeme-container .jdgm-widget,
.nb-judgeme-container .jdgm-rev-widg,
.nb-judgeme-container .jdgm-carousel-wrapper { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; }
.nb-judgeme-container .jdgm-star { color: #C8922A !important; }

@media (min-width: 768px) {
  .nb-section-header h2 { font-size: 2.2rem; }
}
</style>

{% schema %}
{
  "name": "Reviews Header & Widget",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "tag_badge",
      "label": "Tag Badge",
      "default": "GOOGLE REVIEWS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Loved by Biryani Enthusiasts Across Kalyan"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Reviews Header & Widget"
    }
  ]
}
{% endschema %}
