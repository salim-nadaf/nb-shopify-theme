{% comment %} NIAMAT BIRYANI — Customer Reviews Section {% endcomment %}

<section class="nb-section nb-section--bg-alt">
  <div class="nb-container">
    <div class="nb-section-head text-center">
      <span class="nb-subhead-badge">Verified Reviews</span>
      <h2 class="nb-section-title">{{ section.settings.heading | default: "Loved by Our Customers" }}</h2>
      <p class="nb-section-desc">Read genuine Google Reviews from customers who have enjoyed our food.</p>
    </div>

    <div class="nb-reviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="nb-review-card" {{ block.shopify_attributes }}>
            <div class="nb-review-stars">★★★★★</div>
            <p class="nb-review-text">"{{ block.settings.text }}"</p>
            <div class="nb-review-author">
              <strong>{{ block.settings.author }}</strong>
              <span>Google Verified Review</span>
            </div>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"The Chicken Dum Biryani from Niamat Biryani is authentic and rich in flavor! Meat was super tender, rice perfectly spiced. Best in Kalyan!"</p>
          <div class="nb-review-author">
            <strong>Sumaiya N.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>
        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"Ordered 2 Kg Mutton Biryani for a family weekend lunch. It arrived piping hot right on schedule. Everyone loved the taste!"</p>
          <div class="nb-review-author">
            <strong>Rahul M.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>
        <div class="nb-review-card">
          <div class="nb-review-stars">★★★★★</div>
          <p class="nb-review-text">"Clean, 100% halal, and extremely hygienic packaging. Fast instant delivery within 35 minutes."</p>
          <div class="nb-review-author">
            <strong>Imran K.</strong>
            <span>Google Verified Review</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.nb-reviews-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
.nb-review-card { background: #FFF; border: 1px solid rgba(200, 146, 42, 0.2); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
.nb-review-stars { color: #f59e0b; font-size: 1.1rem; margin-bottom: 8px; letter-spacing: 2px; }
.nb-review-text { font-size: 0.85rem; color: #2C1810; line-height: 1.5; margin: 0 0 14px; font-style: italic; }
.nb-review-author strong { display: block; font-size: 0.85rem; color: #2C1810; }
.nb-review-author span { font-size: 0.72rem; color: #16a34a; font-weight: 600; }

@media (min-width: 768px) {
  .nb-reviews-grid { grid-template-columns: repeat(3, 1fr); gap: 20px; }
}
</style>

{% schema %}
{
  "name": "⭐ Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Our Customers"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sumaiya N."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "The Chicken Dum Biryani from Niamat Biryani is authentic and rich in flavor! Meat was super tender, rice perfectly spiced."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⭐ Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Sumaiya N.",
            "text": "The Chicken Dum Biryani from Niamat Biryani is authentic and rich in flavor! Meat was super tender, rice perfectly spiced. Best in Kalyan!"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Rahul M.",
            "text": "Ordered 2 Kg Mutton Biryani for a family weekend lunch. It arrived piping hot right on schedule. Everyone loved the taste!"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Imran K.",
            "text": "Clean, 100% halal, and extremely hygienic packaging. Fast instant delivery within 35 minutes."
          }
        }
      ]
    }
  ]
}
{% endschema %}
