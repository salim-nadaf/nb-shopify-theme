{% comment %}
  NIAMAT BIRYANI — Homepage Bottom Section (FAQ & Final CTA)
{% endcomment %}

{% liquid
  assign page_bg = section.settings.color_page_bg
  if page_bg == blank or page_bg == 'rgba(0,0,0,0)'
    assign page_bg = '#FFFAF4'
  endif

  assign alt_bg = section.settings.color_alt_bg
  if alt_bg == blank or alt_bg == 'rgba(0,0,0,0)'
    assign alt_bg = '#FDF6EC'
  endif

  assign gold_color = section.settings.color_accent_gold
  if gold_color == blank or gold_color == 'rgba(0,0,0,0)'
    assign gold_color = '#C8922A'
  endif

  assign text_dark = section.settings.color_text_dark
  if text_dark == blank or text_dark == 'rgba(0,0,0,0)'
    assign text_dark = '#2C1810'
  endif

  assign text_muted = section.settings.color_text_muted
  if text_muted == blank or text_muted == 'rgba(0,0,0,0)'
    assign text_muted = '#7A5C4A'
  endif

  assign pad_val = section.settings.section_padding | default: 40

  assign final_heading = section.settings.final_heading
  if final_heading == blank
    assign final_heading = 'Ready to Order?'
  endif

  assign final_subheading = section.settings.final_subheading
  if final_subheading == blank
    assign final_subheading = 'Experience rich dum biryani freshly prepared for your appetite.'
  endif

  assign final_cta_text = section.settings.final_cta_text
  if final_cta_text == blank
    assign final_cta_text = 'Start Your Order'
  endif

  assign final_cta_url = section.settings.final_cta_url
  if final_cta_url == blank
    assign final_cta_url = '/pages/start-your-order'
  endif
%}

<div class="nb-homepage-wrapper-bot" style="
  --nb-page-bg: {{ page_bg }};
  --nb-alt-bg: {{ alt_bg }};
  --nb-gold: {{ gold_color }};
  --nb-text-dark: {{ text_dark }};
  --nb-text-muted: {{ text_muted }};
  --nb-padding: {{ pad_val }}px;
">

  <!-- 10. FAQ ACCORDION -->
  <div class="nb-section-block nb-bg-alt">
    <div class="nb-container">
      <div class="nb-section-header">
        <span class="nb-tag-badge">Help & FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="nb-faq-list">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <details class="nb-faq-box" {{ block.shopify_attributes }}>
              <summary class="nb-faq-sum">
                <span>{{ block.settings.question }}</span>
                <span class="nb-faq-plus">+</span>
              </summary>
              <div class="nb-faq-body">
                <p>{{ block.settings.answer }}</p>
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- 11. FINAL CTA -->
  {% unless section.settings.show_cta == false %}
    <div class="nb-final-cta-wrap">
      <div class="nb-container">
        <div class="nb-final-box">
          {% assign final_title_rendered = final_heading %}
          {% if final_heading contains 'Order?' %}
            {% assign final_title_rendered = final_heading | replace: 'Order?', '<span class="nb-gold-highlight">Order?</span>' %}
          {% endif %}
          <h2>{{ final_title_rendered }}</h2>
          <p>{{ final_subheading }}</p>
          <div class="nb-final-btn-wrap">
            <a href="{{ final_cta_url }}" class="nb-btn-gold nb-btn-lg">{{ final_cta_text }}</a>
          </div>
        </div>
      </div>
    </div>
  {% endunless %}

</div>

<style>
.nb-homepage-wrapper-bot { background-color: var(--nb-page-bg) !important; color: var(--nb-text-dark) !important; width: 100%; overflow-x: hidden; }
.nb-container { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
.nb-section-block { padding: var(--nb-padding) 0 !important; }
.nb-bg-alt { background-color: var(--nb-alt-bg) !important; }

.nb-section-header { margin-bottom: 28px; text-align: center; }
.nb-tag-badge { display: inline-block; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--nb-gold) !important; margin-bottom: 6px; }
.nb-section-header h2 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 1.7rem; font-weight: 800; color: var(--nb-text-dark) !important; margin: 0 0 6px; }

.nb-faq-list { max-width: 750px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
.nb-faq-box { background: #FFFFFF !important; border: 1px solid rgba(200,146,42,0.22) !important; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important; }
.nb-faq-sum { padding: 18px 20px; font-weight: 700; font-size: 0.96rem; color: var(--nb-text-dark) !important; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
.nb-faq-sum::-webkit-details-marker { display: none; }
.nb-faq-plus { color: var(--nb-gold) !important; font-size: 1.3rem; font-weight: 800; }
.nb-faq-body { padding: 0 20px 18px; font-size: 0.88rem; color: var(--nb-text-muted) !important; line-height: 1.55; }

.nb-gold-highlight {
  background: linear-gradient(135deg, #E6AC3C 0%, #C8922A 60%, #9E6B10 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  color: transparent !important;
  font-weight: 800 !important;
  display: inline;
}

.nb-final-box .nb-gold-highlight {
  background: linear-gradient(135deg, #FFF5CC 0%, #F8D675 30%, #E6B33D 65%, #C88E1C 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  color: transparent !important;
  filter: drop-shadow(0 2px 12px rgba(230, 179, 61, 0.45));
}

.nb-final-cta-wrap { background: linear-gradient(135deg, #1E100A 0%, #361C10 100%) !important; color: #FFF; padding: 48px 16px; text-align: center; border-top: 2px solid var(--nb-gold); }
.nb-final-box { max-width: 600px; margin: 0 auto; text-align: center; }
.nb-final-box h2 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 2rem; font-weight: 800; color: #FFFDF7 !important; margin: 0 0 10px; text-align: center; }
.nb-final-box p { font-size: 0.95rem; color: #E2D5C5 !important; margin: 0 0 24px; text-align: center; }
.nb-final-btn-wrap { display: flex; justify-content: center; align-items: center; width: 100%; text-align: center; }

.nb-btn-gold { background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important; color: #FFFFFF !important; font-weight: 700; font-size: 0.92rem; padding: 14px 24px; border-radius: 12px; text-decoration: none; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; text-align: center; }
.nb-btn-lg { font-size: 1.05rem; padding: 16px 32px; }

@media (min-width: 768px) {
  .nb-section-header h2 { font-size: 2.2rem; }
}
</style>

{% schema %}
{
  "name": "Homepage (FAQ & CTA)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "color_page_bg",
      "label": "Page Background Color",
      "default": "#FFFAF4"
    },
    {
      "type": "color",
      "id": "color_alt_bg",
      "label": "Alternate Section Background",
      "default": "#FDF6EC"
    },
    {
      "type": "color",
      "id": "color_accent_gold",
      "label": "Accent Gold Color",
      "default": "#C8922A"
    },
    {
      "type": "color",
      "id": "color_text_dark",
      "label": "Primary Text Color",
      "default": "#2C1810"
    },
    {
      "type": "color",
      "id": "color_text_muted",
      "label": "Muted Text Color",
      "default": "#7A5C4A"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Vertical Padding",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Final CTA Banner",
      "default": true
    },
    {
      "type": "text",
      "id": "final_heading",
      "label": "Final CTA Heading",
      "default": "Ready to Order?"
    },
    {
      "type": "textarea",
      "id": "final_subheading",
      "label": "Final CTA Subheading",
      "default": "Experience rich dum biryani freshly prepared for your appetite."
    },
    {
      "type": "text",
      "id": "final_cta_text",
      "label": "Final CTA Button Text",
      "default": "Start Your Order"
    },
    {
      "type": "url",
      "id": "final_cta_url",
      "label": "Final CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How fast is delivery?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Instant delivery orders arrive within 45 to 60 minutes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Homepage (FAQ & CTA)",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you provide disposable plates and cutlery with your Biryani orders?",
            "answer": "We can provide a serving spoon with your order on request; however, disposable plates are not provided."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What are the portion sizes and how does your 1:1 quantity convention work?",
            "answer": "Our portions follow an honest 1:1 convention: when we state ½ Kg (500 g) or 1 Kg, it refers to the meat portion and the rice portion separately! ½ Kg = 500 g meat + 500 g Basmati rice (serves 3–4 people, ~1 Kg total). 1 Kg = 1 Kg meat + 1 Kg Basmati rice (serves 6–7 people, ~2 Kg total)."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How many varieties of biryani and kebabs do you have, and what is the minimum order for kebabs?",
            "answer": "We offer around 10 varieties of biryani and 4 varieties of kebabs. The minimum order for kebabs is 12 pieces."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How many portions are there in 1 kg Biryani?",
            "answer": "1 Kg Biryani contains 1 Kg meat + 1 Kg long-grain Basmati rice (~2 Kg total prepared dish), giving you 6–7 generous, hearty portions."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer any special deals for family orders?",
            "answer": "Our popular 2 KG Family Biryani @ ₹2099 includes 2 Kg tender meat + 2 Kg fragrant Basmati rice (serves 10–12 people) & FREE raita."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your pricing?",
            "answer": "Our pricing starts at ₹849/Kg for Veg Biryani, ₹999/Kg for Chicken Dum Biryani, and ₹1,599/Kg for Mutton Dum Biryani (each 1 Kg order contains 1 Kg meat + 1 Kg rice, includes FREE raita and serves 6–7 people). We also offer 2 Kg Family Deals @ ₹2,099 (2 Kg meat + 2 Kg rice, serves 10–12), and Kebabs starting at ₹549 for 12 pieces."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What are the recommended quantities for large groups?",
            "answer": "For large events and family gatherings, with our 1:1 meat-to-rice portions, we recommend 7 kg for 40–45 people and 9 kg for 50–55 people."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the exact location of Biryani Palace?",
            "answer": "Biryani Palace is a delivery-only kitchen operated in Kalyan-West, Maharashtra 421301."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer dine-in services?",
            "answer": "We offer delivery services only. Our minimum pre-order quantity starts from 1 kg (1 Kg meat + 1 Kg rice)."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you charge for delivery?",
            "answer": "Free delivery on orders above ₹799. Orders below ₹799 are charged ₹49 delivery fee. Hot biryani delivered within 5 km of our kitchen."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How is the biryani made and what are the portion proportions?",
            "answer": "Our biryani is slow dum cooked with experienced Ustaad expertise using a generous 1:1 proportion — 1 Kg tender, juicy meat + 1 Kg aged Basmati rice for 1 Kg orders (serves 6–7), and 500 g meat + 500 g rice for ½ Kg orders (serves 3–4)."
          }
        }
      ]
    }
  ]
}
{% endschema %}
