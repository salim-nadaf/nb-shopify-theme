{% comment %}
  NIAMAT BIRYANI — Reset Password Page Template
{% endcomment %}

<div class="nb-auth-page-section">
  <div class="nb-auth-container">
    
    <div class="nb-auth-card">
      <div class="nb-auth-badge">🔐 RESET PASSWORD</div>
      <h2>Reset Password</h2>
      <p class="nb-auth-sub">Enter a new password for {{ email }}</p>

      {% form 'reset_customer_password', class: 'nb-auth-form' %}
        {% if form.errors %}
          <div class="nb-auth-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="nb-auth-group">
          <label for="ResetPassword">New Password</label>
          <input
            type="password"
            name="customer[password]"
            id="ResetPassword"
            autocomplete="new-password"
            placeholder="••••••••"
            required
            class="nb-auth-input"
          >
        </div>

        <div class="nb-auth-group">
          <label for="PasswordConfirmation">Confirm New Password</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="PasswordConfirmation"
            autocomplete="new-password"
            placeholder="••••••••"
            required
            class="nb-auth-input"
          >
        </div>

        <button type="submit" class="nb-auth-btn-gold">
          Set New Password →
        </button>
      {% endform %}
    </div>

  </div>
</div>

<style>
.nb-auth-page-section { padding: 60px 20px 100px; background: #FFFAF4; min-height: 75vh; display: flex; align-items: center; justify-content: center; }
.nb-auth-container { width: 100%; max-width: 480px; margin: 0 auto; }
.nb-auth-card { background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%); border: 1px solid rgba(200, 146, 42, 0.32); border-top: 4px solid #C8922A; border-radius: 24px; padding: 40px 32px; box-shadow: 0 16px 40px -10px rgba(44, 24, 16, 0.12); text-align: center; }
.nb-auth-badge { display: inline-block; font-size: 0.72rem; font-weight: 800; color: #C8922A; background: #FFFDF7; border: 1px solid rgba(200, 146, 42, 0.3); padding: 4px 14px; border-radius: 20px; margin-bottom: 12px; letter-spacing: 1px; }
.nb-auth-card h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 800; color: #2C1810; margin: 0 0 8px; }
.nb-auth-sub { font-size: 0.92rem; color: #7A5C4A; margin: 0 0 28px; line-height: 1.5; }
.nb-auth-form { display: flex; flex-direction: column; gap: 16px; text-align: left; }
.nb-auth-group { display: flex; flex-direction: column; gap: 6px; }
.nb-auth-group label { font-size: 0.82rem; font-weight: 700; color: #2C1810; text-transform: uppercase; letter-spacing: 0.5px; }
.nb-auth-input { width: 100%; padding: 14px 16px; border: 1px solid rgba(200, 146, 42, 0.32) !important; border-radius: 12px; background-color: #FFFFFF !important; color: #2C1810 !important; font-size: 0.95rem; outline: none; box-sizing: border-box; }
.nb-auth-btn-gold { background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important; color: #FFFFFF !important; font-weight: 800; font-size: 1.02rem; padding: 15px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 6px 20px rgba(200, 146, 42, 0.35) !important; margin-top: 8px; }
</style>
