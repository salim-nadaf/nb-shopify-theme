{% comment %}
  NIAMAT BIRYANI — Customer Delivery Addresses Page Template
{% endcomment %}

<div class="nb-account-page-section">
  <div class="nb-account-container">

    <!-- ADDRESSES HEADER -->
    <div class="nb-account-header-card">
      <div class="nb-user-details">
        <span class="nb-account-badge">📍 DELIVERY ADDRESSES</span>
        <h2>Manage Delivery Addresses</h2>
        <p class="nb-user-email">Add or update your delivery locations in Kalyan & surrounding areas.</p>
      </div>

      <div class="nb-account-actions">
        <a href="{{ routes.account_url }}" class="nb-logout-btn" style="color: #2C1810; border-color: rgba(200,146,42,0.3);">
          ← Back to Account
        </a>
      </div>
    </div>

    <!-- ADDRESS LIST & ADD FORM -->
    <div class="nb-section-card">
      <div class="nb-card-title-wrap">
        <h3>Your Saved Delivery Locations</h3>
        <button class="nb-btn-gold nb-btn-sm" onclick="nbToggleAddAddress(true)">
          + Add New Address
        </button>
      </div>

      <!-- NEW ADDRESS FORM (HIDDEN BY DEFAULT) -->
      <div id="nb-add-address-form" style="display: none; margin-bottom: 28px; padding: 24px; background: #FFFDF7; border: 1px solid rgba(200,146,42,0.3); border-radius: 16px;">
        <h4 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; color: #2C1810; margin: 0 0 16px;">Add a New Delivery Address</h4>
        
        {% form 'customer_address', customer.new_address, class: 'nb-address-form-inner' %}
          <div class="nb-form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
              <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">First Name</label>
              <input type="text" name="address[first_name]" value="{{ form.first_name }}" class="nb-auth-input" required>
            </div>
            <div>
              <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">Last Name</label>
              <input type="text" name="address[last_name]" value="{{ form.last_name }}" class="nb-auth-input" required>
            </div>
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">Address Line 1 (House/Flat No, Building, Street)</label>
            <input type="text" name="address[address1]" value="{{ form.address1 }}" class="nb-auth-input" required>
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">Address Line 2 (Area, Landmark)</label>
            <input type="text" name="address[address2]" value="{{ form.address2 }}" class="nb-auth-input">
          </div>

          <div class="nb-form-grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
              <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">City</label>
              <input type="text" name="address[city]" value="Kalyan" class="nb-auth-input" required>
            </div>
            <div>
              <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">State / Province</label>
              <input type="text" name="address[province]" value="Maharashtra" class="nb-auth-input" required>
            </div>
            <div>
              <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">PIN Code</label>
              <input type="text" name="address[zip]" value="{{ form.zip }}" class="nb-auth-input" required>
            </div>
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #2C1810; margin-bottom: 4px;">Phone / WhatsApp Number</label>
            <input type="tel" name="address[phone]" value="{{ form.phone }}" placeholder="WhatsApp Number" class="nb-auth-input" required>
          </div>

          <div style="display: flex; gap: 12px;">
            <button type="submit" class="nb-btn-gold">Save Delivery Address</button>
            <button type="button" class="nb-logout-btn" onclick="nbToggleAddAddress(false)">Cancel</button>
          </div>
        {% endform %}
      </div>

      {% if customer and customer.addresses.size > 0 %}
        <div class="nb-addresses-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
          {% for address in customer.addresses %}
            <div class="nb-address-box">
              {% if address == customer.default_address %}
                <span class="nb-address-badge">DEFAULT ADDRESS</span>
              {% endif %}
              <p class="nb-address-name"><strong>{{ address.name }}</strong></p>
              <p class="nb-address-text">
                {{ address.address1 }}<br>
                {% if address.address2 != blank %}{{ address.address2 }}<br>{% endif %}
                {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
                📞 {{ address.phone }}
              </p>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="nb-empty-address">
          <p>No saved delivery address found.</p>
          <button class="nb-btn-gold" onclick="nbToggleAddAddress(true)">Add Your Delivery Address +</button>
        </div>
      {% endif %}

    </div>

  </div>
</div>

<script>
  function nbToggleAddAddress(show) {
    var form = document.getElementById('nb-add-address-form');
    if (form) {
      form.style.display = show ? 'block' : 'none';
      if (show) form.scrollIntoView({ behavior: 'smooth' });
    }
  }
</script>

<style>
.nb-account-page-section {
  padding: 40px 0 80px;
  background: #FFFAF4;
  min-height: 75vh;
}
.nb-account-container {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 20px;
}
.nb-account-header-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%);
  border: 1px solid rgba(200, 146, 42, 0.28);
  border-top: 4px solid #C8922A;
  border-radius: 22px;
  padding: 28px 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  flex-wrap: wrap;
  gap: 16px;
}
.nb-account-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 800;
  color: #C8922A;
  background: #FFFDF7;
  border: 1px solid rgba(200, 146, 42, 0.3);
  padding: 3px 12px;
  border-radius: 20px;
  margin-bottom: 6px;
}
.nb-user-details h2 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.8rem;
  font-weight: 800;
  color: #2C1810;
  margin: 0 0 4px;
}
.nb-user-email { font-size: 0.92rem; color: #7A5C4A; margin: 0; }
.nb-logout-btn {
  background: #FFFDF7;
  color: #2C1810;
  border: 1px solid rgba(200, 146, 42, 0.3);
  padding: 10px 20px;
  border-radius: 12px;
  font-size: 0.88rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}
.nb-section-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%);
  border: 1px solid rgba(200, 146, 42, 0.28);
  border-radius: 20px;
  padding: 28px;
  box-shadow: 0 10px 30px -10px rgba(44, 24, 16, 0.08);
}
.nb-card-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  border-bottom: 1px solid rgba(200, 146, 42, 0.18);
  padding-bottom: 12px;
}
.nb-card-title-wrap h3 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.4rem;
  font-weight: 800;
  color: #2C1810;
  margin: 0;
}
.nb-address-box {
  background: #FFFFFF;
  border: 1px solid rgba(200, 146, 42, 0.25);
  border-radius: 14px;
  padding: 18px;
  position: relative;
}
.nb-address-badge {
  font-size: 0.68rem;
  font-weight: 800;
  color: #C8922A;
  background: #FFFDF7;
  border: 1px solid rgba(200, 146, 42, 0.3);
  padding: 2px 8px;
  border-radius: 10px;
  display: inline-block;
  margin-bottom: 8px;
}
.nb-address-name { font-size: 0.98rem; color: #2C1810; margin: 0 0 6px; }
.nb-address-text { font-size: 0.88rem; color: #7A5C4A; line-height: 1.5; margin: 0; }

.nb-auth-input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid rgba(200, 146, 42, 0.32) !important;
  border-radius: 10px;
  background-color: #FFFFFF !important;
  color: #2C1810 !important;
  font-size: 0.92rem;
  outline: none;
  box-sizing: border-box;
}
.nb-btn-gold {
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: 700;
  font-size: 0.9rem;
  padding: 10px 20px;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(200, 146, 42, 0.3);
}
</style>
