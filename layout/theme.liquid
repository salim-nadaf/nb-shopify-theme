    <!-- Google tag (gtag.js) - Niamat Biryani (Non-blocking Async DataLayer Queue) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'GT-T9KR5T2Q');

      (function() {
        var gtmLoaded = false;
        function loadGtag() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=GT-T9KR5T2Q';
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGtag, { timeout: 6000 });
        } else {
          window.addEventListener('load', function() { setTimeout(loadGtag, 3500); });
        }
        ['click', 'scroll', 'touchstart', 'mousemove'].forEach(function(e) {
          document.addEventListener(e, loadGtag, { passive: true, once: true });
        });
      })();
    </script>

    <!-- CRITICAL RESOURCE PRELOADS FOR LCP SPEED OPTIMIZATION -->
    {%- if template.name == 'index' -%}
      <!-- Preload Mobile and Desktop LCP Hero Banner Images Responsively -->
      <link rel="preload" href="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/hero-biryani-optimized.webp?v=1785619720&width=750" as="image" type="image/webp" media="(max-width: 767px)" fetchpriority="high">
      <link rel="preload" href="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/hero-biryani-optimized.webp?v=1785619720&width=1600" as="image" type="image/webp" media="(min-width: 768px)" fetchpriority="high">
    {%- elsif collection.handle == 'instant-delivery' or request.path contains 'instant-delivery' -%}
      <!-- Preload Instant Delivery Hero Bucket Image for Instant LCP -->
      <link rel="preload" href="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/chicken-dum-bucket-optimized.webp?v=1785619720&width=600" as="image" type="image/webp" fetchpriority="high">
    {%- elsif collection.handle == 'our-menu' or collection.handle == 'family-orders' or request.path contains 'our-menu' or request.path contains 'family-orders' -%}
