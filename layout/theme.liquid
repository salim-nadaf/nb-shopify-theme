</div>
<script>
  (function() {
    function mountMobileDock() {
      var dock = document.getElementById('nb-mobile-dock');
      if (dock) {
        if (dock.parentElement !== document.body) {
          document.body.appendChild(dock);
        }
        if (window.innerWidth <= 768) {
          dock.style.setProperty('display', 'flex', 'important');
        } else {
          dock.style.setProperty('display', 'none', 'important');
        }
        dock.style.setProperty('position', 'fixed', 'important');
        dock.style.setProperty('bottom', '0px', 'important');
        dock.style.setProperty('left', '0px', 'important');
        dock.style.setProperty('right', '0px', 'important');
        dock.style.setProperty('z-index', '2147483640', 'important');
        dock.style.setProperty('transform', 'none', 'important');
        dock.style.setProperty('-webkit-transform', 'none', 'important');
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountMobileDock);
    } else {
      mountMobileDock();
    }
    window.addEventListener('resize', mountMobileDock);
  })();
</script>

  <!-- SHOPIFY FORMS CUSTOM ELEMENT & APP EMBED SUPPORT -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (window.Shopify && window.Shopify.loadFeatures) {
        window.Shopify.loadFeatures([{ name: 'shopify-forms', version: '1.0' }]);
      }
    });

    (function nbOrderConfirmationEnhancer() {
      function captureOrderSession() {
        try {
          // 1. Read from Shopify checkout JS object if present
          if (window.Shopify && window.Shopify.checkout) {
            var co = window.Shopify.checkout;
            var phone = co.phone || (co.shipping_address && co.shipping_address.phone) || (co.billing_address && co.billing_address.phone) || '';
            var name = (co.shipping_address && co.shipping_address.first_name) ? (co.shipping_address.first_name + ' ' + (co.shipping_address.last_name || '')) : '';
            
            if (phone) {
              var phone10 = phone.replace(/\D/g, '').slice(-10);
              if (phone10.length === 10) {
                localStorage.setItem('nb_phone', '+91' + phone10);
                if (name) localStorage.setItem('nb_name', name.trim());
              }
            }
          }

          // 2. Read from URL search params or referrer
          var urlParams = new URLSearchParams(window.location.search);
          var urlPhone = urlParams.get('phone') || urlParams.get('checkout[phone]') || '';
          if (urlPhone) {
            var urlPhone10 = urlPhone.replace(/\D/g, '').slice(-10);
            if (urlPhone10.length === 10) {
              localStorage.setItem('nb_phone', '+91' + urlPhone10);
            }
          }
        } catch(e) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', captureOrderSession, { passive: true });
      } else {
        captureOrderSession();
      }
    })();
  </script>

