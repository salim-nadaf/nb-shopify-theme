}
  /* Full, responsive text display in food cards on mobile */
.nb-food-card__body {
  min-width: 0 !important;
  overflow: visible !important;
}
.nb-food-card__desc {
  overflow: visible !important;
  display: block !important;
  -webkit-line-clamp: unset !important;
  -webkit-box-orient: unset !important;
  word-break: break-word !important;
  line-height: 1.4 !important;
  font-size: 0.78rem !important;
  color: #66554B !important;
}
.nb-food-card__title {
  overflow: visible !important;
  text-overflow: unset !important;
  white-space: normal !important;
  max-width: 100% !important;
  line-height: 1.25 !important;
}
.nb-food-card__meta {
  overflow: visible !important;
  flex-wrap: wrap !important;
}
.nb-meta-tag {
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
.nb-food-card__bottom {
  flex-wrap: nowrap !important;
  min-width: 0 !important;
}
.nb-food-card__price {
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}
.nb-btn {
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}

/* Mobile specific — tighter image to give text more room */
@media (max-width: 768px) {
  .nb-food-card__image {
    width: 85px !important;
    height: 85px !important;
  }
  .nb-food-card {
    gap: 10px !important;
    align-items: flex-start !important;
  }
  .nb-food-card__body {
    min-height: unset !important;
  }
}
/* ===== BUTTON SIZE FIX — prevent overflow on mobile ===== */
.nb-btn--sm {
  padding: 7px 10px !important;
  font-size: 0.76rem !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
/* Hide hamburger menu on mobile — bottom dock handles navigation */
@media (max-width: 768px) {
  .header__menu-toggle,
  .header-drawer__toggle,
  button[aria-controls="header-drawer"],
  button[aria-label="Menu"],
  .header__icon--menu,
  [data-testid="header-drawer-toggle"] {
    display: none !important;
  }
}

/* Hide decimal zeros in prices */
.nb-food-card__price .money::after,
.nb-food-card__price sup { display: none !important; }

/* Card bottom row — never wrap, price takes remaining space */
.nb-food-card__bottom {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 6px !important;
  flex-wrap: nowrap !important;
  min-width: 0 !important;
  width: 100% !important;
}
.nb-food-card__price {
  flex: 0 0 auto !important;        /* Don't stretch — take only what's needed */
  min-width: 0 !important;
  white-space: nowrap !important;
  overflow: visible !important;      /* Never truncate the price */
  text-overflow: unset !important;
  font-size: 0.92rem !important;
  font-weight: 800 !important;
  color: #2C1810 !important;
}

/* Card body — must not overflow its container */
.nb-food-card__body {
  flex: 1 1 0 !important;
  min-width: 0 !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
}

/* Variant pills — wrap cleanly */
.nb-variant-selector {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 4px !important;
  margin-bottom: 6px !important;
}
.nb-variant-pill {
  font-size: 0.7rem !important;
  padding: 4px 8px !important;
  white-space: nowrap !important;
}

/* Form inside card — no extra width */
.nb-quick-form {
  flex-shrink: 0 !important;
  display: flex !important;
}


