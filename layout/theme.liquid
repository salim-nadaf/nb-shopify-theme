    {% endunless %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        (function setHeaderHeighCustomProperties() {
          function calculateHeaderHeights() {
            var header = document.querySelector('header-component');
            var headerGroup = document.querySelector('#header-group');
            if (!header || !headerGroup) return;
            var headerTopRow = header.querySelector('.header__row--top');
            var headerHeight = header.offsetHeight;
            var headerGroupHeight = 0;
            var children = headerGroup.children;
            for (var i = 0; i < children.length; i++) {
              var element = children[i];
              if (element === header || !(element instanceof HTMLElement)) continue;
              headerGroupHeight += element.offsetHeight;
            }
            if (header.hasAttribute('transparent') && header.parentElement && header.parentElement.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }
            var topRowHeight = headerTopRow ? headerTopRow.offsetHeight : 0;

            // Batch style writes after reads to prevent forced synchronous reflow
            window.requestAnimationFrame(function() {
              document.body.style.setProperty('--header-height', headerHeight + 'px');
              document.body.style.setProperty('--header-group-height', headerGroupHeight + 'px');
              if (topRowHeight > 0) {
                document.body.style.setProperty('--top-row-height', topRowHeight + 'px');
              }
              document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', calculateHeaderHeights, { passive: true });
          } else {
            if (window.requestAnimationFrame) {
              window.requestAnimationFrame(calculateHeaderHeights);
            } else {
              calculateHeaderHeights();
            }
          }
        })();

        (function setHeaderMenuStyle() {
          function initMenuStyle() {
            var headerComponent = document.querySelector('#header-component');
            if (headerComponent) {
              var isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
              var overflowList = headerComponent.querySelector('overflow-list');
              var hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
              headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
            }
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMenuStyle, { passive: true });
          } else {
            initMenuStyle();
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
      >
        {%- assign p_lower = request.path | downcase -%}
        {%- if p_lower contains 'bulk' or p_lower contains 'catering' -%}
          <div id="nb-custom-mount-bulk">
            {% render 'nb-bulk-orders-snippet' %}
          </div>
        {%- elsif p_lower contains 'calculator' -%}
          <div id="nb-custom-mount-calculator">
            {% render 'nb-biryani-calculator-snippet' %}
          </div>
        {%- elsif p_lower contains 'family' or p_lower contains 'feast' or p_lower contains 'pre-order' -%}
          <div id="nb-custom-mount-family">
            {% render 'nb-family-orders-snippet' %}
          </div>
        {%- elsif p_lower contains 'shipping' or p_lower contains 'delivery-policy' -%}
          <div id="nb-custom-mount-shipping">
            {% render 'nb-shipping-snippet' %}
          </div>
        {%- else -%}
          <div id="nb-default-layout-content">
            {{ content_for_layout }}
          </div>
        {%- endif -%}
      </main>

      <!-- GLOBAL PRODUCT LINK INTERCEPTOR -->
      <script>
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a[href*="/products/"]');
          if (a && !a.classList.contains('nb-allow-product-page')) {
            var href = (a.getAttribute('href') || '').toLowerCase();
            var text = (a.innerText || a.textContent || '').toLowerCase();
            if (href.includes('single') || href.includes('half') || href.includes('double') || href.includes('instant') || text.includes('single') || text.includes('half') || text.includes('instant')) {
              a.href = '/collections/instant-delivery';
            } else {
              a.href = '/pages/family-orders';
            }
          }
        }, true);
      </script>

      <!-- SHOPIFY FORMS APP ENGINE & CUSTOM ELEMENT LOADER -->
      <script>
        (function initShopifyFormsEngine() {
          if (window.Shopify && window.Shopify.loadFeatures) {
            window.Shopify.loadFeatures([
              { name: 'shopify-forms', version: '1.0' },
              { name: 'consent-tracking-api', version: '0.1' }
            ]);
          }
          if (typeof window.customElements !== 'undefined' && !window.customElements.get('shopify-form')) {
            try {
              class ShopifyFormElement extends HTMLElement {
                connectedCallback() {
                  this.style.display = 'block';
                  this.style.visibility = 'visible';
                  this.style.minHeight = '100px';
                }
              }
              window.customElements.define('shopify-form', ShopifyFormElement);
            } catch(e) {}
          }
        })();
      </script>

      <!-- OFFICIAL NIAMAT BIRYANI LUXURY FOOTER -->
