        color: #66554B !important;
        word-break: break-word !important;
      }
      .nb-food-card__meta {
        gap: 4px !important;
        margin-bottom: 6px !important;
      }
      .nb-meta-tag {
        font-size: 0.68rem !important;
        padding: 2px 6px !important;
        border-radius: 8px !important;
      }
      .nb-food-card__bottom {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 6px !important;
        width: 100% !important;
        margin-top: 6px !important;
      }

      /* MOBILE SPECIFIC: FEATURED FULL-WIDTH MEAL CARD */
      .nb-food-card--meal {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        padding: 12px !important;
        gap: 10px !important;
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        background: linear-gradient(135deg, #FFFDF9 0%, #FDF7EC 100%) !important;
        border: 1.5px solid rgba(200, 146, 42, 0.45) !important;
        box-shadow: 0 4px 16px rgba(200, 146, 42, 0.12) !important;
        border-radius: 14px !important;
      }
      .nb-food-card--meal .nb-food-card__header-row {
        display: flex !important;
        flex-direction: row !important;
        align-items: flex-start !important;
        gap: 12px !important;
        width: 100% !important;
      }
      .nb-food-card--meal .nb-food-card__image {
        width: 100px !important;
        height: 100px !important;
        min-width: 100px !important;
        max-width: 100px !important;
        border-radius: 10px !important;
        margin: 0 !important;
        flex-shrink: 0 !important;
        position: relative !important;
        overflow: hidden !important;
      }
      .nb-food-card--meal .nb-food-card__image img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
      }
      .nb-food-card--meal .nb-food-card__intro {
        flex: 1 1 0 !important;
        min-width: 0 !important;
      }
      .nb-food-card--meal .nb-food-card__title {
        font-size: 1.05rem !important;
        font-weight: 800 !important;
        color: #2C1810 !important;
        margin-bottom: 4px !important;
        line-height: 1.25 !important;
      }
      .nb-food-card--meal .nb-food-card__desc {
        font-size: 0.78rem !important;
        line-height: 1.35 !important;
        color: #66554B !important;
        margin: 0 !important;
        display: block !important;
      }
      .nb-food-card--meal .nb-food-card__actions {
        width: 100% !important;
      }
      .nb-food-card--meal .nb-variant-selector {
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: 6px !important;
        width: 100% !important;
        margin: 6px 0 !important;
      }
      .nb-food-card--meal .nb-variant-pill {
        width: 100% !important;
        box-sizing: border-box !important;
        padding: 8px 12px !important;
        font-size: 0.78rem !important;
        line-height: 1.3 !important;
        border-radius: 8px !important;
        white-space: normal !important;
        text-align: left !important;
      }
      .nb-food-card--meal .nb-food-card__bottom {
        margin-top: 8px !important;
        padding-top: 8px !important;
        border-top: 1px solid rgba(200, 146, 42, 0.2) !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
      }
      .nb-mobile-only-intro { display: block !important; }
      .nb-desktop-only-intro { display: none !important; }
      .nb-food-card__price {
        font-size: 0.95rem !important;
        font-weight: 800 !important;
        color: #C8922A !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
      }
      .nb-food-card .nb-btn,
      .nb-food-card .nb-btn--outline,
      .nb-btn--outline {
        padding: 5px 10px !important;
        font-size: 0.72rem !important;
        font-weight: 800 !important;
        border-radius: 6px !important;
        white-space: nowrap !important;
        flex-shrink: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        min-height: 28px !important;
        box-sizing: border-box !important;
      }
    }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}
    {% render 'nb-cart-drawer' %}
    {% unless template.name == 'index' %}
      {% render 'nb-form-styles' %}
    {% endunless %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        (function setHeaderHeighCustomProperties() {
          function calculateHeaderHeights() {
            var header = document.querySelector('header-component');
            var headerGroup = document.querySelector('#header-group');
            if (!header || !headerGroup) return;
            var headerTopRow = header.querySelector('.header__row--top');
            var headerHeight = header.offsetHeight;
            var headerGroupHeight = 0;
            var children = headerGroup.children;
            for (var i = 0; i < children.length; i++) {
              var element = children[i];
              if (element === header || !(element instanceof HTMLElement)) continue;
              headerGroupHeight += element.offsetHeight;
            }
            if (header.hasAttribute('transparent') && header.parentElement && header.parentElement.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }
            var topRowHeight = headerTopRow ? headerTopRow.offsetHeight : 0;

            // Batch style writes after reads to prevent forced synchronous reflow
            window.requestAnimationFrame(function() {
              document.body.style.setProperty('--header-height', headerHeight + 'px');
              document.body.style.setProperty('--header-group-height', headerGroupHeight + 'px');
              if (topRowHeight > 0) {
                document.body.style.setProperty('--top-row-height', topRowHeight + 'px');
              }
              document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', calculateHeaderHeights, { passive: true });
          } else {
            if (window.requestAnimationFrame) {
              window.requestAnimationFrame(calculateHeaderHeights);
            } else {
              calculateHeaderHeights();
            }
          }
        })();

        (function setHeaderMenuStyle() {
          function initMenuStyle() {
            var headerComponent = document.querySelector('#header-component');
            if (headerComponent) {
              var isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
              var overflowList = headerComponent.querySelector('overflow-list');
              var hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
              headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
            }
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMenuStyle, { passive: true });
          } else {
            initMenuStyle();
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      {% unless template.name == 'index' %}
        <div id="nb-bulk-orders-template" style="display:none !important;" aria-hidden="true">
          {% render 'nb-bulk-orders-snippet' %}
        </div>
        <div id="nb-biryani-calculator-template" style="display:none !important;" aria-hidden="true">
          {% render 'nb-biryani-calculator-snippet' %}
        </div>
        <div id="nb-family-orders-template" style="display:none !important;" aria-hidden="true">
          {% render 'nb-family-orders-snippet' %}
        </div>
      {% endunless %}

      <script>
        (function nbPageFallbackEngine() {
          function nbExecuteScripts(container) {
            var scripts = container.querySelectorAll('script');
            scripts.forEach(function(oldScript) {
              var newScript = document.createElement('script');
              Array.from(oldScript.attributes).forEach(function(attr) {
                newScript.setAttribute(attr.name, attr.value);
              });
              newScript.appendChild(document.createTextNode(oldScript.innerHTML));
              oldScript.parentNode.replaceChild(newScript, oldScript);
            });
          }

          function checkAndExecute() {
            var path = window.location.pathname.toLowerCase();
            var mainContent = document.getElementById('MainContent');
            if (!mainContent) return;

            if (path.includes('bulk') || path.includes('catering')) {
              var template = document.getElementById('nb-bulk-orders-template');
              if (template) {
                mainContent.innerHTML = template.innerHTML;
                document.title = "Bulk Catering Packages — Biryani Palace by Niamat";
                nbExecuteScripts(mainContent);
              }
            } else if (path.includes('calculator')) {
              var template = document.getElementById('nb-biryani-calculator-template');
              if (template) {
                mainContent.innerHTML = template.innerHTML;
                document.title = "Biryani Quantity Calculator — Biryani Palace by Niamat";
                nbExecuteScripts(mainContent);
              }
            } else if (path.includes('family') || path.includes('feast') || path.includes('pre-order') || path.includes('family-order')) {
              var template = document.getElementById('nb-family-orders-template');
              if (template) {
                mainContent.innerHTML = template.innerHTML;
                document.title = "Family Orders — Biryani Palace by Niamat";
                nbExecuteScripts(mainContent);
              }
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', checkAndExecute);
          } else {
            checkAndExecute();
          }
        })();
      </script>

      <!-- GLOBAL PRODUCT LINK INTERCEPTOR -->
      <script>
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a[href*="/products/"]');
          if (a && !a.classList.contains('nb-allow-product-page')) {
            var href = (a.getAttribute('href') || '').toLowerCase();
            var text = (a.innerText || a.textContent || '').toLowerCase();
            if (href.includes('single') || href.includes('half') || href.includes('double') || href.includes('instant') || text.includes('single') || text.includes('half') || text.includes('instant')) {
              a.href = '/collections/instant-delivery';
            } else {
              a.href = '/pages/family-orders';
            }
          }
        }, true);
      </script>

      <!-- SHOPIFY FORMS APP ENGINE & CUSTOM ELEMENT LOADER -->
      <script>
        (function initShopifyFormsEngine() {
          if (window.Shopify && window.Shopify.loadFeatures) {
            window.Shopify.loadFeatures([
              { name: 'shopify-forms', version: '1.0' },
              { name: 'consent-tracking-api', version: '0.1' }
            ]);
          }
          if (typeof window.customElements !== 'undefined' && !window.customElements.get('shopify-form')) {
            try {
              class ShopifyFormElement extends HTMLElement {
                connectedCallback() {
                  this.style.display = 'block';
                  this.style.visibility = 'visible';
                  this.style.minHeight = '100px';
                }
              }
              window.customElements.define('shopify-form', ShopifyFormElement);
            } catch(e) {}
          }
        })();
      </script>

      <!-- OFFICIAL NIAMAT BIRYANI LUXURY FOOTER -->
      {% render 'nb-footer-snippet' %}
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}
    {% render 'search-modal' %}

    {%- for block in settings.blocks -%}
      {%- if block.disabled == false -%}
        {%- render block -%}
      {%- endif -%}
    {%- endfor -%}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <!-- NIAMAT BIRYANI: Mobile Bottom Dock -->
<div id="nb-mobile-dock">
  <a href="{{ routes.root_url }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>Home</span>
  </a>
  <a href="{{ routes.collections_url }}/family-orders">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    <span>Menu</span>
  </a>
  <a href="{{ routes.collections_url }}/instant-delivery">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    <span>Instant</span>
  </a>
  <a href="{{ pages['family-orders'].url | default: '/pages/family-orders' }}">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <span>Family</span>
  </a>
  <a href="{{ routes.cart_url }}" onclick="event.preventDefault(); nbOpenDrawer();">
    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
    <span>Cart</span>
  </a>
</div>

  <!-- SHOPIFY FORMS CUSTOM ELEMENT & APP EMBED SUPPORT -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (window.Shopify && window.Shopify.loadFeatures) {
        window.Shopify.loadFeatures([{ name: 'shopify-forms', version: '1.0' }]);
      }
    });

    (function nbOrderConfirmationEnhancer() {
      function captureOrderSession() {
        try {
          // 1. Read from Shopify checkout JS object if present
          if (window.Shopify && window.Shopify.checkout) {
            var co = window.Shopify.checkout;
            var phone = co.phone || (co.shipping_address && co.shipping_address.phone) || (co.billing_address && co.billing_address.phone) || '';
            var name = (co.shipping_address && co.shipping_address.first_name) ? (co.shipping_address.first_name + ' ' + (co.shipping_address.last_name || '')) : '';
            
            if (phone) {
              var phone10 = phone.replace(/\D/g, '').slice(-10);
              if (phone10.length === 10) {
                localStorage.setItem('nb_phone', '+91' + phone10);
                if (name) localStorage.setItem('nb_name', name.trim());
              }
            }
          }

          // 2. Read from URL search params or referrer
          var urlParams = new URLSearchParams(window.location.search);
          var urlPhone = urlParams.get('phone') || urlParams.get('checkout[phone]') || '';
          if (urlPhone) {
            var urlPhone10 = urlPhone.replace(/\D/g, '').slice(-10);
            if (urlPhone10.length === 10) {
              localStorage.setItem('nb_phone', '+91' + urlPhone10);
            }
          }
        } catch(e) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', captureOrderSession, { passive: true });
      } else {
        captureOrderSession();
      }
    })();
  </script>

  {% render 'order-gate-popup' %}
  </body>
</html>
