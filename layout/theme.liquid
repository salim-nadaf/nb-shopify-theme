      <link rel="preload" href="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/hero-biryani-optimized.webp?v=1785619720&width=750" as="image" type="image/webp" fetchpriority="high">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    <!-- HIGH-SPEED PRECONNECTS (< 4 CONNECTIONS) -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">

    <!-- ASYNC GOOGLE FONTS (ZERO RENDER BLOCKING) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;600;700;800&display=swap"></noscript>
    {%- # theme-check-enable RemoteAsset, AssetPreload -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style>
    /* ===== NIAMAT BIRYANI PALACE — ULTRA-PREMIUM STOREWIDE MASTER STYLES ===== */

    h1, h2, h3, h4, h5, h6,
    .heading, .title, .card__title,
    .product__title, .collection__title,
    .page-title, .header__heading-text,
    .header__menu-item, .nb-section-header h2 {
      font-family: 'Playfair Display', Georgia, serif !important;
      letter-spacing: -0.01em !important;
    }

    body, p, span, a, input, select, textarea, button, label, td, th {
      font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    }

    body {
      background-color: #FFFAF4 !important;
      color: #2C1810 !important;
    }

    header, .header, .header-wrapper, header-component,
    #header-group, .header-section, .header__row, .header__row--top, .header__row--bottom,
    .header__column, .header__row-inner {
      background: linear-gradient(135deg, #1E100A 0%, #2C1810 100%) !important;
      background-color: #1E100A !important;
    }
    header, .header, .header-wrapper, header-component {
      border-bottom: 2px solid #C8922A !important;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25) !important;
      position: relative !important;
    }
    .header a, .header__heading-link, nav a,
    .header__menu-item, header-component a,
    .header__row a, .header__row span {
      color: #FDF6EC !important;
    }
    :root {
      --transparent-header-offset-boolean: 0 !important;
    }

    .page-wrapper, main, #MainContent,
    .color-background-1, .color-background-2,
    .gradient {
      background-color: #FFFAF4 !important;
    }

    /* STOREWIDE GLOSSY SHIMMER BUTTONS */
    .button--primary,
    .product-form__submit,
    .btn-primary,
    .nb-btn-gold,
    .cart__checkout-button {
      background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
      color: #FFFFFF !important;
      font-weight: 700 !important;
      border-radius: 12px !important;
      border: none !important;
      box-shadow: 0 6px 20px rgba(200,146,42,0.35), inset 0 1px 0 rgba(255,255,255,0.3) !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .button--primary:hover,
    .product-form__submit:hover,
    .btn-primary:hover,
    .nb-btn-gold:hover,
    .cart__checkout-button:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 10px 25px rgba(200,146,42,0.45) !important;
    }

    .product-form__submit[name="add"] { font-size: 0 !important; }
    .product-form__submit[name="add"]::after {
      content: "Order Now" !important;
      font-size: 16px !important;
      font-weight: 700 !important;
    }

    /* Hide header cart icon on mobile — use bottom dock Cart tab instead */
@media (max-width: 768px) {
  .nb-cart-trigger {
    display: none !important;
  }
}
  /* Full, responsive text display in food cards on mobile */
.nb-food-card__body {
  min-width: 0 !important;
  overflow: visible !important;
}
.nb-food-card__desc {
  overflow: visible !important;
  display: block !important;
  -webkit-line-clamp: unset !important;
  -webkit-box-orient: unset !important;
  word-break: break-word !important;
  line-height: 1.4 !important;
  font-size: 0.78rem !important;
  color: #66554B !important;
}
.nb-food-card__title {
  overflow: visible !important;
  text-overflow: unset !important;
  white-space: normal !important;
  max-width: 100% !important;
  line-height: 1.25 !important;
}
.nb-food-card__meta {
  overflow: visible !important;
  flex-wrap: wrap !important;
}
.nb-meta-tag {
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
.nb-food-card__bottom {
  flex-wrap: nowrap !important;
  min-width: 0 !important;
}
.nb-food-card__price {
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}
.nb-btn {
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}

/* Mobile specific — tighter image to give text more room */
@media (max-width: 768px) {
  .nb-food-card__image {
    width: 85px !important;
    height: 85px !important;
  }
  .nb-food-card {
    gap: 10px !important;
    align-items: flex-start !important;
  }
  .nb-food-card__body {
    min-height: unset !important;
  }
}
/* ===== BUTTON SIZE FIX — prevent overflow on mobile ===== */
.nb-btn--sm {
  padding: 7px 10px !important;
  font-size: 0.76rem !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
}
/* Hide hamburger menu on mobile — bottom dock handles navigation */
@media (max-width: 768px) {
  .header__menu-toggle,
  .header-drawer__toggle,
  button[aria-controls="header-drawer"],
  button[aria-label="Menu"],
  .header__icon--menu,
  [data-testid="header-drawer-toggle"] {
    display: none !important;
  }
}

/* Hide decimal zeros in prices */
.nb-food-card__price .money::after,
.nb-food-card__price sup { display: none !important; }

/* Card bottom row — never wrap, price takes remaining space */
.nb-food-card__bottom {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 6px !important;
  flex-wrap: nowrap !important;
  min-width: 0 !important;
  width: 100% !important;
}
.nb-food-card__price {
  flex: 0 0 auto !important;        /* Don't stretch — take only what's needed */
  min-width: 0 !important;
  white-space: nowrap !important;
  overflow: visible !important;      /* Never truncate the price */
  text-overflow: unset !important;
  font-size: 0.92rem !important;
  font-weight: 800 !important;
  color: #2C1810 !important;
}

/* Card body — must not overflow its container */
.nb-food-card__body {
  flex: 1 1 0 !important;
  min-width: 0 !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
}

/* Variant pills — wrap cleanly */
.nb-variant-selector {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 4px !important;
  margin-bottom: 6px !important;
}
.nb-variant-pill {
  font-size: 0.7rem !important;
  padding: 4px 8px !important;
  white-space: nowrap !important;
}

/* Form inside card — no extra width */
.nb-quick-form {
  flex-shrink: 0 !important;
  display: flex !important;
}


    .button--secondary {
      background: transparent !important;
      border: 2px solid #C8922A !important;
      color: #C8922A !important;
      border-radius: 10px !important;
    }

    /* Hide ecommerce clutter */
    .shopify-payment-button,
    .product__payment-button,
    [data-shopify="payment-button"] { display: none !important; }

    .product-recommendations,
    .complementary-products,
    .recently-viewed,
    .product__text--vendor,
    .product__sku,
    nav.breadcrumb,
    .breadcrumbs,
    .breadcrumb { display: none !important; }

    /* Hide "Products" title on custom food menu pages */
    [data-template="collection.family-orders"] .collection__title,
    [data-template="collection.family-orders"] .collection-hero,
    [data-template="collection.family-orders"] .page-header,
    [data-template="collection.instant-delivery"] .collection__title,
    [data-template="collection.instant-delivery"] .collection-hero,
    [data-template="collection.instant-delivery"] .page-header { display: none !important; }

    .price, .price-item,
    .price__regular .price-item,
    .price__sale .price-item--sale,
    [class*="price"] {
      color: #C8922A !important;
      font-weight: 800 !important;
    }

    .product-card__content,
    .card, .card-wrapper .card,
    .card__inner {
      background-color: #FFFAF4 !important;
      border: 1px solid rgba(200,146,42,0.2) !important;
      border-radius: 14px !important;
    }

    h1, h2, h3, h4 { color: #2C1810 !important; }

    footer, .footer, #footer-group {
      background: #1E100A !important;
      color: #FDF6EC !important;
      border-top: 2px solid #C8922A !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }
    footer a, .footer a,
    footer p, .footer p { color: #FDF6EC !important; }

    @media (max-width: 768px) {
      html, body {
        background-color: #1E100A !important;
      }
      .page-wrapper {
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
      }
    }

    .variant-pills__input:checked + .variant-pills__label {
      background: #C8922A !important;
      color: #fff !important;
      border-color: #C8922A !important;
    }
    .variant-pills__label {
      border: 1.5px solid rgba(200,146,42,0.4) !important;
      color: #2C1810 !important;
      background: #FDF6EC !important;
      border-radius: 8px !important;
    }

    /* ===== MOBILE BOTTOM DOCK ===== */
    #nb-mobile-dock {
      display: none;
      position: fixed !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 99999 !important;
      background: #2C1810;
      border-top: 2px solid #C8922A;
      padding: 8px 0 env(safe-area-inset-bottom, 12px);
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
      will-change: transform;
    }
    #nb-mobile-dock a {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #FDF6EC;
      text-decoration: none;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      gap: 3px;
      padding: 4px 0;
    }
    #nb-mobile-dock a:hover,
    #nb-mobile-dock a:active { color: #C8922A; }
    #nb-mobile-dock svg { stroke: #FDF6EC; transition: stroke 0.2s; }
    #nb-mobile-dock a:hover svg,
    #nb-mobile-dock a:active svg { stroke: #C8922A; }

    /* ===== FOOD CARD SYSTEM ===== */
    .nb-instant-section { padding: 20px 16px 100px; max-width: 900px; margin: 0 auto; }
    .nb-section-header { margin-bottom: 20px; }
    .nb-section-header h2 { font-size: 1.4rem; font-weight: 800; color: #2C1810; margin: 0 0 4px; }
    .nb-section-header p { font-size: 0.85rem; color: #7A5C4A; margin: 0; }

    .nb-food-card {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 14px;
      background: #FFFAF4;
      border: 1px solid rgba(200,146,42,0.18);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 12px;
      transition: box-shadow 0.2s ease;
    }
    .nb-food-card:hover { box-shadow: 0 4px 20px rgba(44,24,16,0.1); }

    .nb-food-card__image {
      position: relative;
      flex-shrink: 0;
      width: 110px; height: 110px;
      border-radius: 10px;
      overflow: hidden;
      background: #F5ECD7;
    }
    .nb-food-card__image img { width: 100%; height: 100%; object-fit: cover; }
    .nb-food-card__image-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem;
    }
    .nb-badge,
    span.nb-badge,
    .nb-food-card .nb-badge {
      position: absolute !important;
      top: 6px !important;
      left: 6px !important;
      z-index: 10 !important;
      font-size: 0.68rem !important;
      font-weight: 800 !important;
      padding: 3px 9px !important;
      border-radius: 10px !important;
      letter-spacing: 0.4px !important;
      text-transform: uppercase !important;
      white-space: nowrap !important;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35) !important;
      line-height: 1.2 !important;
      color: #FFFFFF !important;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4) !important;
    }
    .nb-badge--available { background: #C8922A !important; color: #ffffff !important; }
    .nb-badge--preorder { background: #2C1810 !important; color: #FDF6EC !important; }
    .nb-badge--soldout { background: #757575 !important; color: #ffffff !important; }

    .nb-tag--musttry, .nb-badge-musttry, span.nb-tag--musttry {
      background: linear-gradient(135deg, #FF6B00 0%, #D35400 100%) !important;
      color: #FFFFFF !important;
      border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }
    .nb-tag--bestseller, .nb-badge-bestseller, span.nb-tag--bestseller {
      background: linear-gradient(135deg, #D49E35 0%, #996B13 100%) !important;
      color: #FFFFFF !important;
      border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }
    .nb-tag--popular, .nb-badge-popular, span.nb-tag--popular {
      background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%) !important;
      color: #FFFFFF !important;
      border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }
    .nb-tag--chef, .nb-badge-royal, span.nb-tag--chef {
      background: linear-gradient(135deg, #8E44AD 0%, #6C3483 100%) !important;
      color: #FFFFFF !important;
      border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }
    .nb-tag--new, span.nb-tag--new {
      background: linear-gradient(135deg, #27AE60 0%, #1E8449 100%) !important;
      color: #FFFFFF !important;
      border: 1px solid rgba(255, 255, 255, 0.5) !important;
    }

    .nb-food-card__body {
      flex: 1; display: flex; flex-direction: column;
      justify-content: space-between; min-height: 110px;
    }
    .nb-food-card__title {
      font-size: 0.95rem; font-weight: 700;
      color: #2C1810 !important; margin: 0 0 4px; line-height: 1.3;
    }
    .nb-food-card__desc {
      font-size: 0.78rem; color: #7A5C4A;
      margin: 0 0 6px; line-height: 1.4;
    }
    .nb-food-card__meta { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
    .nb-meta-tag {
      font-size: 0.72rem; color: #C8922A;
      background: rgba(200,146,42,0.1);
      padding: 2px 8px; border-radius: 20px; font-weight: 600;
    }
    .nb-food-card__bottom {
      display: flex; align-items: center;
      justify-content: space-between; gap: 8px;
    }
    .nb-food-card__price { font-size: 1.05rem; font-weight: 800; color: #2C1810; }

    .nb-variant-selector { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
    .nb-variant-pill {
      font-size: 0.75rem; font-weight: 600;
      padding: 5px 10px; border-radius: 20px;
      border: 1.5px solid rgba(200,146,42,0.4);
      background: #FDF6EC; color: #2C1810;
      cursor: pointer; transition: all 0.15s;
    }
    .nb-variant-pill.active, .nb-variant-pill:hover {
      background: #C8922A; color: #fff; border-color: #C8922A;
    }

    .nb-btn {
      font-size: 0.82rem; font-weight: 700;
      padding: 8px 16px; border-radius: 8px;
      border: none; cursor: pointer;
      text-decoration: none; display: inline-block;
      white-space: nowrap; transition: background 0.15s ease;
    }
    .nb-btn--gold { background: #C8922A; color: #fff; }
    .nb-btn--gold:hover { background: #A67520; color: #fff; }
    .nb-btn--outline {
      background: transparent;
      border: 1.5px solid #C8922A; color: #C8922A;
    }
    .nb-btn--outline:hover { background: #C8922A; color: #fff; }
    .nb-btn--disabled { background: #E0D5C8; color: #999; cursor: not-allowed; }

