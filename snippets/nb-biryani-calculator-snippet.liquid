<script>
(function initBiryaniCalculator() {
  function setupCalculator() {
    var guestInput = document.getElementById('nb-guest-input');
    var guestSlider = document.getElementById('nb-guest-slider');
    var minusBtn = document.getElementById('nb-guest-minus');
    var plusBtn = document.getElementById('nb-guest-plus');
    var appetiteRadios = document.getElementsByName('nb_appetite');
    var dietRadios = document.getElementsByName('nb_diet');
    var includeKebabsCheckbox = document.getElementById('nb-include-kebabs');

    if (!guestInput) return;

    function calculate() {
      var guests = parseInt(guestInput.value) || 25;
      if (guests < 1) guests = 1;

      // Appetite Ratio (Guests per Kg)
      var guestsPerKg = 6; // Standard
      var appetiteType = 'Standard';
      for (var i = 0; i < appetiteRadios.length; i++) {
        if (appetiteRadios[i].checked) {
          if (appetiteRadios[i].value === 'light') { guestsPerKg = 7; appetiteType = 'Light'; }
          if (appetiteRadios[i].value === 'standard') { guestsPerKg = 6; appetiteType = 'Standard'; }
          if (appetiteRadios[i].value === 'heavy') { guestsPerKg = 5; appetiteType = 'Heavy'; }
          appetiteRadios[i].closest('.nb-radio-card').classList.add('active');
        } else {
          appetiteRadios[i].closest('.nb-radio-card').classList.remove('active');
        }
      }

      // Total Raw Kg Needed
      var rawKg = guests / guestsPerKg;
      // Round up to nearest 0.5 Kg
      var totalKg = Math.ceil(rawKg * 2) / 2;
      if (totalKg < 1) totalKg = 1;

      // Dietary Preference
      var dietType = '100% Non-Veg';
      var nonVegKg = totalKg;
      var vegKg = 0;

      for (var j = 0; j < dietRadios.length; j++) {
        if (dietRadios[j].checked) {
          var val = dietRadios[j].value;
          dietRadios[j].closest('.nb-radio-card').classList.add('active');
          if (val === 'nonveg') {
            dietType = '100% Non-Veg';
            nonVegKg = totalKg;
            vegKg = 0;
          } else if (val === 'veg') {
            dietType = '100% Veg';
            nonVegKg = 0;
            vegKg = totalKg;
          } else if (val === 'mixed') {
            dietType = 'Mixed (70% Non-Veg / 30% Veg)';
            nonVegKg = Math.ceil(totalKg * 0.7 * 2) / 2;
            vegKg = Math.max(1, totalKg - nonVegKg);
          }
        } else {
          dietRadios[j].closest('.nb-radio-card').classList.remove('active');
        }
      }

      // Update Displays
      document.getElementById('nb-calc-total-kg').innerText = totalKg;
      document.getElementById('nb-calc-servings-text').innerText = "Serves ~" + guests + " Guests (" + appetiteType + " Portion)";

      var nonvegRow = document.getElementById('nb-row-nonveg');
      var vegRow = document.getElementById('nb-row-veg');
      
      if (nonVegKg > 0) {
        nonvegRow.style.display = 'flex';
        document.getElementById('nb-calc-nonveg-kg').innerText = nonVegKg + ' Kg';
      } else {
        nonvegRow.style.display = 'none';
      }

      if (vegKg > 0) {
        vegRow.style.display = 'flex';
        document.getElementById('nb-calc-veg-kg').innerText = vegKg + ' Kg';
      } else {
        vegRow.style.display = 'none';
      }

      // Kebabs calculation (2 pcs per guest)
      var kebabsRow = document.getElementById('nb-row-kebabs');
      var totalKebabs = guests * 2;
      var kebabPacks = Math.ceil(totalKebabs / 12);
      if (includeKebabsCheckbox && includeKebabsCheckbox.checked) {
        kebabsRow.style.display = 'flex';
        document.getElementById('nb-calc-kebabs').innerText = (kebabPacks * 12) + " Pcs (" + kebabPacks + " Packs)";
      } else {
        kebabsRow.style.display = 'none';
      }

      // Recommended Catering Package logic
      var pkgNameEl = document.getElementById('nb-rec-pkg-name');
      var pkgDescEl = document.getElementById('nb-rec-pkg-desc');

      if (totalKg <= 5) {
        pkgNameEl.innerText = "The Mehmaan Plan [5 Kg]";
        pkgDescEl.innerText = "1 Biryani + 1 Starter + 1 Gravy + Complimentary Dessert @ ₹4,499";
      } else if (totalKg <= 10) {
        pkgNameEl.innerText = "The Shaahi Dawat [10 Kg]";
        pkgDescEl.innerText = "2 Biryani Flavors + 1 Gravy + 1 Starter + Free Gulab Jamun/Drinks @ ₹8,999";
      } else if (totalKg <= 15) {
        pkgNameEl.innerText = "The Royal Baithak [15 Kg]";
        pkgDescEl.innerText = "3 Biryanis + 1 Gravy + 2 Starters + Free Dessert & Drinks @ ₹13,999";
      } else {
        pkgNameEl.innerText = "Custom Grand Event Feast [" + totalKg + " Kg]";
        pkgDescEl.innerText = "Tailored menu, live counter options & dedicated coordinator for large gatherings";
      }

      // WhatsApp Pre-filled URL
      var waMsg = "Hi Niamat Biryani! I calculated my biryani requirement on your website calculator:%0A" +
                  "👥 Guests: " + guests + "%0A" +
                  "🍚 Appetite: " + appetiteType + "%0A" +
                  "🍗 Diet: " + dietType + "%0A" +
                  "📦 Total Biryani Needed: " + totalKg + " Kg";

      if (nonVegKg > 0 && vegKg > 0) {
        waMsg += " (" + nonVegKg + " Kg Non-Veg + " + vegKg + " Kg Veg)";
      }
      if (includeKebabsCheckbox && includeKebabsCheckbox.checked) {
        waMsg += "%0A🍢 Kebabs: " + (kebabPacks * 12) + " Pcs";
      }
      waMsg += "%0A%0APlease confirm pricing and availability for my event date.";

      var waBtn = document.getElementById('nb-calc-wa-btn');
      if (waBtn) {
        waBtn.href = "https://wa.me/919167682582?text=" + waMsg;
      }
    }

    // Event Listeners
    guestInput.addEventListener('input', function() {
      guestSlider.value = guestInput.value;
      calculate();
    });
    guestSlider.addEventListener('input', function() {
      guestInput.value = guestSlider.value;
      calculate();
    });
    minusBtn.addEventListener('click', function() {
      var v = parseInt(guestInput.value) || 25;
      if (v > 5) {
        guestInput.value = v - 5;
        guestSlider.value = guestInput.value;
        calculate();
      }
    });
    plusBtn.addEventListener('click', function() {
      var v = parseInt(guestInput.value) || 25;
      guestInput.value = v + 5;
      guestSlider.value = guestInput.value;
      calculate();
    });

    for (var i = 0; i < appetiteRadios.length; i++) {
      appetiteRadios[i].addEventListener('change', calculate);
    }
    for (var j = 0; j < dietRadios.length; j++) {
      dietRadios[j].addEventListener('change', calculate);
    }
    if (includeKebabsCheckbox) {
      includeKebabsCheckbox.addEventListener('change', calculate);
    }

    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCalculator);
  } else {
    setupCalculator();
  }
})();
</script>
