{% comment %}
  NIAMAT BIRYANI — Interactive Biryani Quantity Calculator Snippet
{% endcomment %}

<div class="nb-calc-container">
  <div class="nb-calc-header">
    <span class="nb-pill-badge">🧮 BIRYANI QUANTITY CALCULATOR</span>
    <h1>How Much Biryani Do You Need?</h1>
    <p class="nb-calc-sub">
      Planning a family gathering, house party, or corporate event? Use our interactive calculator to estimate the exact quantity of biryani and starters needed for your guests.
    </p>
  </div>

  <div class="nb-calc-layout">
    <!-- INPUT CONTROLS CARD -->
    <div class="nb-calc-card nb-calc-inputs-card">
      <div class="nb-card-header">
        <span class="nb-step-num">1</span>
        <h2>Enter Event Details</h2>
      </div>

      <!-- 1. GUEST COUNT -->
      <div class="nb-calc-group">
        <label for="nb-guest-input">Number of Guests</label>
        <div class="nb-guest-control">
          <button type="button" id="nb-guest-minus" class="nb-guest-btn">−</button>
          <input type="number" id="nb-guest-input" min="5" max="500" value="25" />
          <button type="button" id="nb-guest-plus" class="nb-guest-btn">+</button>
        </div>
        <input type="range" id="nb-guest-slider" min="5" max="200" value="25" step="5" class="nb-range-slider" />
        <div class="nb-slider-labels">
          <span>5 Guests</span>
          <span>50 Guests</span>
          <span>100 Guests</span>
          <span>200+ Guests</span>
        </div>
      </div>

      <!-- 2. APPETITE LEVEL -->
      <div class="nb-calc-group">
        <label>Appetite Level</label>
        <div class="nb-radio-grid nb-grid-3">
          <label class="nb-radio-card">
            <input type="radio" name="nb_appetite" value="light" />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🍲</span>
              <strong>Light</strong>
              <small>1 Kg = 7 Guests</small>
            </div>
          </label>
          <label class="nb-radio-card active">
            <input type="radio" name="nb_appetite" value="standard" checked />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🍚</span>
              <strong>Standard</strong>
              <small>1 Kg = 6 Guests</small>
            </div>
          </label>
          <label class="nb-radio-card">
            <input type="radio" name="nb_appetite" value="heavy" />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🍗</span>
              <strong>Heavy</strong>
              <small>1 Kg = 5 Guests</small>
            </div>
          </label>
        </div>
      </div>

      <!-- 3. DIETARY PREFERENCE -->
      <div class="nb-calc-group">
        <label>Dietary Preference</label>
        <div class="nb-radio-grid nb-grid-3">
          <label class="nb-radio-card active">
            <input type="radio" name="nb_diet" value="nonveg" checked />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🍖</span>
              <strong>100% Non-Veg</strong>
              <small>Chicken / Mutton</small>
            </div>
          </label>
          <label class="nb-radio-card">
            <input type="radio" name="nb_diet" value="mixed" />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🍱</span>
              <strong>Mixed Feast</strong>
              <small>70% Non-Veg / 30% Veg</small>
            </div>
          </label>
          <label class="nb-radio-card">
            <input type="radio" name="nb_diet" value="veg" />
            <div class="nb-radio-content">
              <span class="nb-radio-icon">🥗</span>
              <strong>100% Veg</strong>
              <small>Veg Dum Biryani</small>
            </div>
          </label>
        </div>
      </div>

      <!-- 4. INCLUDE STARTERS/KEBABS -->
      <div class="nb-calc-group">
        <label class="nb-checkbox-label">
          <input type="checkbox" id="nb-include-kebabs" checked />
          <span>Include recommended Kebab Starters calculation</span>
        </label>
      </div>
    </div>

    <!-- RESULT DISPLAY CARD -->
    <div class="nb-calc-card nb-calc-results-card">
      <div class="nb-card-header">
        <span class="nb-step-num">2</span>
        <h2>Estimated Portion Requirement</h2>
      </div>

      <div class="nb-result-hero">
        <span class="nb-result-label">TOTAL BIRYANI NEEDED</span>
        <div class="nb-result-kg-display">
          <span id="nb-calc-total-kg">4.5</span> <small>KG</small>
        </div>
        <div class="nb-result-servings-tag" id="nb-calc-servings-text">
          Serves ~25 Guests (Standard Portion)
        </div>
      </div>

      <!-- PORTION BREAKDOWN GRID -->
      <div class="nb-breakdown-box">
        <h3>Itemized Breakdown</h3>
        <div class="nb-breakdown-row" id="nb-row-nonveg">
          <span>🍗 Non-Veg Biryani (Chicken/Mutton):</span>
          <strong id="nb-calc-nonveg-kg">4.5 Kg</strong>
        </div>
        <div class="nb-breakdown-row" id="nb-row-veg" style="display:none;">
          <span>🥗 Veg Dum Biryani:</span>
          <strong id="nb-calc-veg-kg">0 Kg</strong>
        </div>
        <div class="nb-breakdown-row">
          <span>🥣 Complimentary Raita:</span>
          <strong id="nb-calc-raita">Included Free</strong>
        </div>
        <div class="nb-breakdown-row" id="nb-row-kebabs">
          <span>🍢 Recommended Kebabs:</span>
          <strong id="nb-calc-kebabs">48 Pieces (4 Packs)</strong>
        </div>
      </div>

      <!-- RECOMMENDED PACKAGE SUGGESTION -->
      <div class="nb-rec-package" id="nb-rec-package-box">
        <span class="nb-rec-badge">RECOMMENDED CATERING PLAN</span>
        <h4 id="nb-rec-pkg-name">The Mehmaan Plan [5 Kg]</h4>
        <p id="nb-rec-pkg-desc">Includes 1 Biryani + 1 Starter + 1 Gravy + Complimentary Dessert @ ₹4,499</p>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="nb-calc-actions">
        <a href="#" id="nb-calc-wa-btn" target="_blank" rel="noopener" class="nb-wa-calc-btn">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          Book Calculated Quantity on WhatsApp
        </a>
        <a href="/pages/bulk-orders" class="nb-outline-calc-btn">
          Explore All Catering Packages →
        </a>
      </div>
    </div>
  </div>
</div>

