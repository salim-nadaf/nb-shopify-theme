{% comment %}
  NIAMAT BIRYANI — Order Gate Popup Snippet
  Saves gate_phone & gate_name to localStorage, updates /cart/update.js attributes via async/await,
  logs cart attribute response to console, and auto-fills fields across pages.
{% endcomment %}

{% render 'nb-auth-gate' %}

<script>
(function() {
  function nbAutoFillGateFields() {
    var storedPhone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone');
    var storedName  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name');
    var storedEmail = localStorage.getItem('gate_email') || localStorage.getItem('nb_email');

    if (storedPhone) {
      var cleanPhone = storedPhone.replace(/\D/g, '').slice(-10);
      var phoneValue = cleanPhone || storedPhone;

      // 1. Auto-fill any input[type="tel"], input[name*="phone"], and input[id*="phone"] fields found in the DOM
      var phoneInputs = document.querySelectorAll('input[type="tel"], input[name*="phone"], input[id*="phone"]');
      phoneInputs.forEach(function(input) {
        if (input && !input.value && input.id !== 'nb-phone-input') {
          input.value = phoneValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });

      // 2. Auto-fill any visible name inputs
      if (storedName) {
        var nameInputs = document.querySelectorAll('input[name*="name"], input[id*="name"]');
        nameInputs.forEach(function(input) {
          if (input && !input.value && input.id !== 'nb-name-input') {
            input.value = storedName;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      }

      // 3. Auto-fill any visible email inputs (if present)
      if (storedEmail) {
        var emailInputs = document.querySelectorAll('input[type="email"], input[name*="email"], input[id*="email"]');
        emailInputs.forEach(function(input) {
          if (input && !input.value && input.id !== 'nb-email-input') {
            input.value = storedEmail;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      }
    }
  }

  function scheduleIdleFill() {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(nbAutoFillGateFields, { timeout: 2000 });
    } else {
      setTimeout(nbAutoFillGateFields, 250);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleIdleFill, { passive: true });
  } else {
    scheduleIdleFill();
  }
})();
</script>

