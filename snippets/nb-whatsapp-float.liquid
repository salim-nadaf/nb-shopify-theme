{% comment %}
  NIAMAT BIRYANI — 3D Glossy Floating WhatsApp Button
  Matches the official glossy sphere style:
  - 3D glossy emerald-green sphere with top light shine
  - White WhatsApp bubble outline with handset inside
  - Fixed floating on all pages (Desktop & Mobile)
  - Direct connection to +919167682582 with automated order greeting
{% endcomment %}

{% liquid
  assign wa_number = '919167682582'
  assign greeting_msg = 'Hi Niamat Biryani! I need quick help with placing an order.' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: greeting_msg
%}

<div id="nb-wa-root"></div>

<script>
(function() {
  function initGlossyWhatsAppFloat() {
    if (document.getElementById('nbWhatsAppGlossyBtn')) return;

    var waNumber = '919167682582';
    var greeting = encodeURIComponent('Hi Niamat Biryani! I need quick help with placing an order.');
    var waUrl = 'https://wa.me/' + waNumber + '?text=' + greeting;

    var isMobile = window.innerWidth < 768;

    var container = document.createElement('div');
    container.id = 'nbWhatsAppGlossyBtn';
    container.setAttribute('aria-label', 'WhatsApp Support');
    
    // Position fixed container
    container.style.cssText = [
      'position: fixed !important',
      (isMobile ? 'bottom: 76px !important' : 'bottom: 42px !important'),
      (isMobile ? 'right: 18px !important' : 'right: 28px !important'),
      'z-index: 2147483647 !important',
      'display: flex !important',
      'align-items: center !important',
      'pointer-events: auto !important',
      'visibility: visible !important',
      'opacity: 1 !important',
      'margin: 0 !important',
      'padding: 0 !important'
    ].join(';');

    var btn = document.createElement('a');
    btn.href = waUrl;
    btn.target = '_blank';
    btn.rel = 'noopener noreferrer';
    btn.setAttribute('aria-label', 'Chat on WhatsApp');
    btn.style.cssText = [
      'position: relative !important',
      'display: flex !important',
      'align-items: center !important',
      'justify-content: center !important',
      'width: 60px !important',
      'height: 60px !important',
      'border-radius: 50% !important',
      'background: radial-gradient(circle at 35% 28%, #4EFA94 0%, #00E676 38%, #00C853 72%, #008E36 100%) !important',
      'box-shadow: 0 10px 24px rgba(0, 200, 83, 0.48), 0 4px 10px rgba(0, 0, 0, 0.22), inset 0 2px 4px rgba(255, 255, 255, 0.75), inset 0 -3px 5px rgba(0, 0, 0, 0.25) !important',
      'border: 2px solid rgba(255, 255, 255, 0.85) !important',
      'text-decoration: none !important',
      'cursor: pointer !important',
      'transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease !important',
      'overflow: visible !important'
    ].join(';');

    // Top Glossy Shine Highlight Layer
    var glossShine = document.createElement('span');
    glossShine.style.cssText = [
      'position: absolute !important',
      'top: 2px !important',
      'left: 8px !important',
      'right: 8px !important',
      'height: 24px !important',
      'border-radius: 50% / 100% 100% 0 0 !important',
      'background: linear-gradient(180deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0.05) 90%, transparent 100%) !important',
      'pointer-events: none !important',
      'z-index: 1 !important'
    ].join(';');

    // Pulsing Soft Glow Ring
    var pulseRing = document.createElement('span');
    pulseRing.className = 'nb-glossy-wa-pulse';
    pulseRing.style.cssText = [
      'position: absolute !important',
      'top: -6px !important',
      'left: -6px !important',
      'width: 68px !important',
      'height: 68px !important',
      'border-radius: 50% !important',
      'background: rgba(0, 230, 118, 0.4) !important',
      'z-index: -1 !important',
      'pointer-events: none !important'
    ].join(';');

    // WhatsApp Iconic White Outline + Handset SVG
    var svgBox = document.createElement('div');
    svgBox.style.cssText = 'position: relative; z-index: 2; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;';
    svgBox.innerHTML = '<svg width="34" height="34" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.18));"><path fill-rule="evenodd" clip-rule="evenodd" d="M16 3C8.82 3 3 8.82 3 16c0 2.5.7 4.84 1.92 6.84L3 29l6.34-1.88C11.28 28.28 13.56 29 16 29c7.18 0 13-5.82 13-13S23.18 3 16 3zm0 23.6c-2.18 0-4.22-.64-5.94-1.74l-.42-.28-4.26 1.26 1.28-4.14-.3-.46C5.18 19.5 4.6 17.8 4.6 16c0-6.3 5.1-11.4 11.4-11.4 6.3 0 11.4 5.1 11.4 11.4 0 6.3-5.1 11.4-11.4 11.4zm6.26-8.52c-.34-.18-2.04-1.02-2.36-1.14-.32-.12-.56-.18-.78.18-.24.36-.9 1.14-1.1 1.38-.2.24-.4.26-.74.1-.34-.18-1.46-.54-2.78-1.72-1.04-.92-1.74-2.06-1.94-2.4-.2-.36-.02-.54.16-.72.16-.16.34-.4.52-.6.18-.2.24-.36.36-.6.12-.24.06-.44-.04-.62-.1-.18-.78-1.88-1.08-2.58-.28-.68-.56-.58-.78-.6-.2-.02-.44-.02-.68-.02-.24 0-.62.1-.94.44-.32.36-1.22 1.2-1.22 2.92 0 1.72 1.26 3.38 1.44 3.62.18.24 2.46 3.76 5.96 5.28.84.36 1.48.58 1.98.74.84.26 1.6.22 2.2.14.68-.1 2.06-.84 2.36-1.66.3-.82.3-1.52.2-1.66-.1-.14-.32-.24-.66-.42z" fill="#FFFFFF"/></svg>';

    btn.appendChild(glossShine);
    btn.appendChild(pulseRing);
    btn.appendChild(svgBox);

    btn.onmouseenter = function() {
      btn.style.transform = 'translateY(-4px) scale(1.08)';
      btn.style.boxShadow = '0 14px 30px rgba(0, 200, 83, 0.6), 0 6px 14px rgba(0, 0, 0, 0.28), inset 0 2px 4px rgba(255, 255, 255, 0.85), inset 0 -3px 5px rgba(0, 0, 0, 0.3)';
    };
    btn.onmouseleave = function() {
      btn.style.transform = 'translateY(0) scale(1)';
      btn.style.boxShadow = '0 10px 24px rgba(0, 200, 83, 0.48), 0 4px 10px rgba(0, 0, 0, 0.22), inset 0 2px 4px rgba(255, 255, 255, 0.75), inset 0 -3px 5px rgba(0, 0, 0, 0.25)';
    };

    container.appendChild(btn);
    document.body.appendChild(container);
  }

  // Add keyframe animation for gentle pulse and hide when auth modal is open
  if (!document.getElementById('nbGlossyWaStyle')) {
    var style = document.createElement('style');
    style.id = 'nbGlossyWaStyle';
    style.textContent = '@keyframes nbGlossyPulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.3); opacity: 0; } 100% { transform: scale(1.4); opacity: 0; } } .nb-glossy-wa-pulse { animation: nbGlossyPulse 2.4s infinite cubic-bezier(0.24, 0, 0.38, 1) !important; } body.nb-auth-open #nbWhatsAppGlossyBtn, body:has(#nb-auth-modal.active) #nbWhatsAppGlossyBtn { display: none !important; opacity: 0 !important; pointer-events: none !important; visibility: hidden !important; }';
    document.head.appendChild(style);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlossyWhatsAppFloat);
  } else {
    initGlossyWhatsAppFloat();
  }
  window.addEventListener('load', initGlossyWhatsAppFloat);
})();
</script>
