{% comment %} NIAMAT BIRYANI — Production-Grade Refined Cart Drawer {% endcomment %}

<div id="nb-drawer-overlay" onclick="nbCloseDrawer()"></div>

<div id="nb-cart-drawer" role="dialog" aria-modal="true" aria-label="Your Order Cart">
  <!-- TOAST NOTIFICATION FOR ERRORS -->
  <div id="nb-cart-toast" class="nb-cart-toast" style="display:none;"></div>

  <!-- HEADER WITH LOGO & CLOSE BUTTON -->
  <div class="nb-drawer__header">
    <div class="nb-drawer__header-logo-wrap">
      <img src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837"
           alt="Biryani Palace by Niamat"
           class="nb-drawer__logo">
    </div>
    <button class="nb-drawer__close" onclick="nbCloseDrawer()" aria-label="Close Cart">✕</button>
  </div>

  <!-- FREE DELIVERY PROGRESS BAR BANNER & ETA -->
  <div class="nb-drawer__delivery-progress" id="nb-delivery-progress-banner">
    <div class="nb-progress-text-wrap">
      <span class="nb-progress-icon">🚚</span>
      <span id="nb-progress-msg">Tap 🎯 <strong>Use My Location</strong> to calculate exact delivery fee</span>
    </div>
    <div class="nb-progress-bar-bg">
      <div class="nb-progress-bar-fill" id="nb-progress-fill" style="width: 0%;"></div>
    </div>
    <div class="nb-eta-wrap" id="nb-eta-wrap">
      ⏱️ Estimated delivery: <strong>{{ settings.nb_eta_min | default: 45 }}–{{ settings.nb_eta_max | default: 60 }} min</strong>
    </div>
  </div>

  <!-- MAIN DRAWER BODY -->
  <div class="nb-drawer__body">
    <!-- CART ITEMS CONTAINER -->
    <div id="nb-cart-items" class="nb-drawer__items"></div>

    <!-- COMPLETE YOUR ORDER (EXTRA RAITA & COKE) -->
    <div class="nb-drawer__upsell-section">
      <div class="nb-upsell-header">
        <span>🍽️</span>
        <h4>Complete your order</h4>
      </div>
      <div class="nb-upsell-grid">
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Extra Niamat Raita</span>
            <span class="nb-upsell-pill-price">₹29</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-raita-btn" onclick="nbAddUpsell(this, 'extra-raita', 'Extra Niamat Raita', 2900)">+ Add</button>
        </div>
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Coke</span>
            <span class="nb-upsell-pill-price">₹39</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-coke-btn" onclick="nbAddUpsell(this, 'coke', 'Coke', 3900)">+ Add</button>
        </div>
      </div>
    </div>

    <!-- INFORMATIONAL STORE DELIVERY POLICY DROPDOWN & GPS BUTTON -->
    <div class="nb-drawer__location-box">
      <div class="nb-location-header">
        <label for="nb-delivery-zone-select">📍 Delivery Policy</label>
        <div class="nb-loc-btn-group">
          <button type="button" class="nb-use-location-btn" id="nb-use-location-btn" onclick="nbDetectLiveLocation()">
            🎯 Use My Location
          </button>
          <button type="button" class="nb-clear-location-btn" id="nb-clear-location-btn" onclick="nbClearLocation()" style="display:none;">
            ✕ Clear
          </button>
        </div>
      </div>

      <!-- INFORMATIONAL STORE POLICY SELECTOR -->
      <div class="nb-select-wrap">
        <select id="nb-delivery-zone-select" onchange="nbSelectDeliveryZone(this.value)">
          <option value="LOCATION_UNKNOWN">-- Delivery policy --</option>
          <option value="ZONE_0_5_KM">Kalyan / Nearby Area (0–5 km) • ₹39 Delivery (Free > ₹799)</option>
          <option value="ZONE_5_8_KM">Extended Area (5–8 km) • ₹89 Delivery (Free > ₹1,299)</option>
          <option value="OUTSIDE_SERVICE_AREA">Outside Delivery Radius (>8 km) • Delivery Unavailable</option>
        </select>
        <span class="nb-select-arrow">›</span>
      </div>

      <div id="nb-location-status-badge" class="nb-location-status" style="display: none;"></div>
    </div>

    <!-- ORDER & DELIVERY INSTRUCTIONS -->
    <div class="nb-drawer__instructions-box">
      <label for="nb-cooking-instructions">📝 Order & Delivery Instructions</label>
      <textarea id="nb-cooking-instructions"
                placeholder="Example: Less spicy, no green chilli, call on arrival..."
                rows="2"
                onchange="nbSaveInstructions()"></textarea>
      <p class="nb-instructions-hint">💡 Saved to your order for our kitchen & delivery team</p>
    </div>
  </div>

  <!-- DRAWER FOOTER WITH LIVE SUMMARY & CHECKOUT -->
  <div class="nb-drawer__footer">
    <div class="nb-summary-rows">
      <div class="nb-summary-row">
        <span>Subtotal</span>
        <span id="nb-subtotal-val">₹0</span>
      </div>
      <div class="nb-summary-row">
        <span>Delivery</span>
        <span id="nb-delivery-val" class="nb-delivery-highlight">₹0</span>
      </div>
      <div class="nb-summary-row nb-total-row">
        <span>TOTAL</span>
        <span id="nb-grand-total-val">₹0</span>
      </div>
    </div>

    <div class="nb-secure-badge">
      <span>🔒 100% Secure Checkout</span>
    </div>

    <button class="nb-drawer__checkout-btn" id="nb-checkout-submit-btn" onclick="nbGoToCheckout()">
      <span class="nb-checkout-btn-text" id="nb-checkout-btn-text">Proceed to Checkout</span>
      <span id="nb-btn-total-val" class="nb-checkout-btn-price">₹0</span>
    </button>

    <button class="nb-drawer__continue-btn" onclick="nbContinueOrdering()">
      ← Continue Ordering
    </button>
  </div>
</div>

<style>
/* ===== REFINED COMPACT CART DRAWER STYLES ===== */
#nb-drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(44,24,16,0.6);
  z-index: 99990;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
#nb-drawer-overlay.active { display: block; }

#nb-cart-drawer {
  position: fixed;
  top: 0; right: 0;
