{% comment %} NIAMAT BIRYANI — Premium Cart Drawer {% endcomment %}

<div id="nb-drawer-overlay" onclick="nbCloseDrawer()"></div>

<div id="nb-cart-drawer">
  <div class="nb-drawer__header">
    <div class="nb-drawer__header-left">
      <span class="nb-drawer__icon">🛒</span>
      <div>
        <h3>Your Order</h3>
        <p class="nb-drawer__subtitle">Biryani Palace by Niamat</p>
      </div>
    </div>
    <button class="nb-drawer__close" onclick="nbCloseDrawer()">✕</button>
  </div>

  <div class="nb-drawer__prep-banner">
    <span>⚡</span>
    <span>Ready in <strong>30–60 mins</strong> · Kalyan West delivery</span>
  </div>

  <div class="nb-drawer__body">
    <div id="nb-cart-items" class="nb-drawer__items"></div>

    <div class="nb-drawer__notes">
      <label for="nb-order-note">📝 Special Instructions</label>
      <textarea id="nb-order-note" placeholder="Spice level, allergies, delivery instructions..." rows="2"></textarea>
    </div>

    <div class="nb-drawer__upsell">
      <p class="nb-drawer__upsell-title">🍽️ Complete Your Meal</p>
      <div class="nb-drawer__upsell-items" id="nb-upsell-items">
        <div class="nb-upsell-card" data-handle="extra-raita">
          <span class="nb-upsell-emoji">🥛</span>
          <div class="nb-upsell-info">
            <span class="nb-upsell-name">Extra Raita</span>
            <span class="nb-upsell-price">₹49</span>
          </div>
          <button class="nb-upsell-add" onclick="nbAddUpsell(this, 'extra-raita')">+</button>
        </div>
        <div class="nb-upsell-card" data-handle="cold-drink">
          <span class="nb-upsell-emoji">🥤</span>
          <div class="nb-upsell-info">
            <span class="nb-upsell-name">Cold Drink</span>
            <span class="nb-upsell-price">₹39</span>
          </div>
          <button class="nb-upsell-add" onclick="nbAddUpsell(this, 'cold-drink')">+</button>
        </div>
        <div class="nb-upsell-card" data-handle="gulab-jamun">
          <span class="nb-upsell-emoji">🍮</span>
          <div class="nb-upsell-info">
            <span class="nb-upsell-name">Gulab Jamun</span>
            <span class="nb-upsell-price">₹59</span>
          </div>
          <button class="nb-upsell-add" onclick="nbAddUpsell(this, 'gulab-jamun')">+</button>
        </div>
      </div>
    </div>
  </div>

  <div class="nb-drawer__footer">
    <div class="nb-drawer__total">
      <span>Total</span>
      <span id="nb-total-price">₹0</span>
    </div>
    <button class="nb-drawer__checkout-btn" onclick="nbGoToCheckout()">
  🔒 Proceed to Secure Checkout
    </button>

    <a href="/collections/instant-delivery" class="nb-drawer__continue-btn" onclick="nbCloseDrawer()">
  ← Continue Ordering
</a>

  </div>
</div>

<style>
/* ===== NB CART DRAWER ===== */
#nb-drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(44,24,16,0.5);
  z-index: 99990;
  backdrop-filter: blur(2px);
}
#nb-drawer-overlay.active { display: block; }

#nb-cart-drawer {
  position: fixed;
  top: 0; right: 0;
  width: 100%;
  max-width: 420px;
  height: 100%;
  background: #FFFAF4;
  z-index: 99991;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
  box-shadow: -4px 0 32px rgba(44,24,16,0.15);
}
#nb-cart-drawer.active { transform: translateX(0); }

/* On mobile, account for bottom dock */
@media (max-width: 768px) {
  #nb-cart-drawer {
    max-width: 100%;
    height: calc(100% - 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
}

.nb-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #2C1810;
  color: #FDF6EC;
  flex-shrink: 0;
}
.nb-drawer__header-left { display: flex; align-items: center; gap: 10px; }
.nb-drawer__icon { font-size: 1.4rem; }
.nb-drawer__header h3 { margin: 0; font-size: 1rem; font-weight: 700; color: #FDF6EC; }
.nb-drawer__subtitle { margin: 0; font-size: 0.72rem; color: rgba(253,246,236,0.7); }
.nb-drawer__close {
  background: none; border: none; color: #FDF6EC;
  font-size: 1.2rem; cursor: pointer; padding: 8px 12px;
  border-radius: 6px; transition: background 0.15s;
  min-width: 44px; min-height: 44px;
  display: flex; align-items: center; justify-content: center;
}
.nb-drawer__close:hover { background: rgba(255,255,255,0.1); }

.nb-drawer__prep-banner {
  display: flex; align-items: center; gap: 8px;
  background: rgba(200,146,42,0.12);
  border-bottom: 1px solid rgba(200,146,42,0.2);
  padding: 10px 20px;
  font-size: 0.82rem; color: #2C1810;
  flex-shrink: 0;
}

.nb-drawer__body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Cart items */
.nb-drawer__items { display: flex; flex-direction: column; gap: 12px; }
.nb-cart-item {
  display: flex; gap: 12px; align-items: center;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.15);
  border-radius: 12px;
  padding: 12px;
}
.nb-cart-item__img {
  width: 64px; height: 64px;
  border-radius: 8px; object-fit: cover;
  flex-shrink: 0; background: #F5ECD7;
}
.nb-cart-item__info { flex: 1; min-width: 0; }
.nb-cart-item__name {
  font-size: 0.88rem; font-weight: 700;
  color: #2C1810; margin: 0 0 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.nb-cart-item__variant {
  font-size: 0.75rem; color: #7A5C4A; margin: 0 0 8px;
}
.nb-cart-item__bottom {
  display: flex; align-items: center;
  justify-content: space-between; gap: 8px;
}
.nb-cart-item__price {
  font-size: 0.95rem; font-weight: 800; color: #C8922A;
}
.nb-qty-control {
  display: flex; align-items: center; gap: 6px;
}
.nb-qty-btn {
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1.5px solid #C8922A;
  background: #FDF6EC;
  color: #C8922A;
  font-size: 1rem; font-weight: 700;
  cursor: pointer; display: flex;
  align-items: center; justify-content: center;
  transition: all 0.15s;
  /* Large touch target */
  min-width: 32px; min-height: 32px;
}
.nb-qty-btn:hover, .nb-qty-btn:active { background: #C8922A; color: #fff; }
.nb-qty-num { font-size: 0.9rem; font-weight: 700; color: #2C1810; min-width: 20px; text-align: center; }

/* Notes */
.nb-drawer__notes label {
  display: block; font-size: 0.8rem;
  font-weight: 600; color: #2C1810; margin-bottom: 6px;
}
.nb-drawer__notes textarea {
  width: 100%; border: 1.5px solid rgba(200,146,42,0.3);
  border-radius: 10px; padding: 10px 12px;
  font-size: 0.82rem; color: #2C1810;
  background: #fff; resize: none;
  font-family: inherit; box-sizing: border-box;
}
.nb-drawer__notes textarea:focus {
  outline: none; border-color: #C8922A;
}

/* Upsell */
.nb-drawer__upsell-title {
  font-size: 0.85rem; font-weight: 700;
  color: #2C1810; margin: 0 0 10px;
}
.nb-drawer__upsell-items { display: flex; flex-direction: column; gap: 8px; }
.nb-upsell-card {
  display: flex; align-items: center; gap: 10px;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.15);
  border-radius: 10px; padding: 10px 12px;
}
.nb-upsell-emoji { font-size: 1.4rem; }
.nb-upsell-info { flex: 1; }
.nb-upsell-name { display: block; font-size: 0.82rem; font-weight: 600; color: #2C1810; }
.nb-upsell-price { display: block; font-size: 0.78rem; color: #C8922A; font-weight: 700; }
.nb-upsell-add {
  width: 34px; height: 34px;
  border-radius: 50%;
  background: #C8922A; color: #fff;
  border: none; font-size: 1.2rem;
  cursor: pointer; display: flex;
  align-items: center; justify-content: center;
  transition: background 0.15s; flex-shrink: 0;
}
.nb-upsell-add:hover, .nb-upsell-add:active { background: #A67520; }
.nb-upsell-add.added { background: #2C1810; }

/* Footer — always visible, never hidden on mobile */
.nb-drawer__footer {
  padding: 14px 20px 20px;
  border-top: 1px solid rgba(200,146,42,0.2);
  background: #FFFAF4;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  z-index: 1;
}

/* ADD THIS — pushes footer above mobile dock */
@media (max-width: 768px) {
  .nb-drawer__footer {
    padding-bottom: 84px !important;
  }
  #nb-cart-drawer {
    max-width: 100%;
    /* Full height minus dock height */
    height: calc(100dvh) !important;
    overflow: hidden;
  }
  .nb-drawer__body {
    /* Ensure body scrolls and footer stays visible */
    padding-bottom: 8px !important;
  }
}
  
.nb-drawer__total {
  display: flex; justify-content: space-between;
  align-items: center;
  font-size: 1rem; font-weight: 800; color: #2C1810;
  padding-bottom: 4px;
}
.nb-drawer__checkout-btn {
  display: block; text-align: center;
  background: #C8922A; color: #fff !important;
  font-weight: 700; font-size: 0.95rem;
  padding: 15px; border-radius: 12px;
  text-decoration: none;
  transition: background 0.15s;
  min-height: 50px;
  line-height: 1.2;
}
.nb-drawer__checkout-btn:hover,
.nb-drawer__checkout-btn:active { background: #A67520; color: #fff !important; }

/* Continue Ordering — ALWAYS visible on all screen sizes */
.nb-drawer__continue-btn {
  display: block !important;
  width: 100%;
  background: transparent;
  border: 1.5px solid rgba(44,24,16,0.25);
  color: #2C1810;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
  text-align: center;
  min-height: 44px;
  box-sizing: border-box;
}
.nb-drawer__continue-btn:hover,
.nb-drawer__continue-btn:active {
  border-color: #C8922A; color: #C8922A;
}

/* Empty state */
.nb-drawer__empty {
  text-align: center; padding: 40px 20px;
  color: #7A5C4A;
}
.nb-drawer__empty-icon { font-size: 3rem; margin-bottom: 12px; }
.nb-drawer__empty p { font-size: 0.9rem; margin: 0; }

/* Hide theme's default cart icon on mobile — use dock instead */
@media (max-width: 768px) {
  .header__icon--cart,
  a[href="/cart"].header__icon,
  .header__icons .header__icon:last-child {
    display: none !important;
  }
}
</style>

<script>
// ===== NB CART DRAWER SYSTEM =====

function nbOpenDrawer() {
  document.getElementById('nb-cart-drawer').classList.add('active');
  document.getElementById('nb-drawer-overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
  nbRefreshCart();
}

function nbGoToCheckout() {
  var phone = localStorage.getItem('nb_phone') || '';
  var name = localStorage.getItem('nb_name') || '';

  // Save to cart attributes first, then redirect
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: {
        'Customer Phone': phone,
        'Customer Name': name,
        'WhatsApp Consent': localStorage.getItem('nb_promo_consent') || 'no'
      }
    })
  }).then(function() {
    window.location.href = '/checkout';
  }).catch(function() {
    window.location.href = '/checkout';
  });
}

function nbContinueOrdering() {
  nbCloseDrawer();
  // On desktop, navigate to Instant Delivery
  if (window.innerWidth > 768) {
    window.location.href = '/collections/instant-delivery';
  }
  // On mobile, just close drawer — customer is already on the page
}

function nbCloseDrawer() {
  document.getElementById('nb-cart-drawer').classList.remove('active');
  document.getElementById('nb-drawer-overlay').classList.remove('active');
  document.body.style.overflow = '';
}

function nbFormatMoney(cents) {
  return '₹' + (cents / 100).toFixed(0);
}

function nbRefreshCart() {
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => {
      const container = document.getElementById('nb-cart-items');
      const totalEl = document.getElementById('nb-total-price');

      if (cart.item_count === 0) {
        container.innerHTML = `
          <div class="nb-drawer__empty">
            <div class="nb-drawer__empty-icon">🍛</div>
            <p>Your order is empty.<br>Add something delicious!</p>
          </div>`;
        totalEl.textContent = '₹0';
        return;
      }

      totalEl.textContent = nbFormatMoney(cart.total_price);

      container.innerHTML = cart.items.map(item => `
        <div class="nb-cart-item" data-key="${item.key}">
          <img class="nb-cart-item__img"
               src="${item.image ? item.image : ''}"
               alt="${item.product_title}"
               onerror="this.style.display='none'">
          <div class="nb-cart-item__info">
            <p class="nb-cart-item__name">${item.product_title}</p>
            ${item.variant_title && item.variant_title !== 'Default Title'
              ? `<p class="nb-cart-item__variant">${item.variant_title}</p>` : ''}
            <div class="nb-cart-item__bottom">
              <span class="nb-cart-item__price">${nbFormatMoney(item.final_line_price)}</span>
              <div class="nb-qty-control">
                <button class="nb-qty-btn" onclick="nbUpdateQty('${item.key}', ${item.quantity - 1})">−</button>
                <span class="nb-qty-num">${item.quantity}</span>
                <button class="nb-qty-btn" onclick="nbUpdateQty('${item.key}', ${item.quantity + 1})">+</button>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    });
}

function nbUpdateQty(key, qty) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: key, quantity: qty })
  }).then(() => nbRefreshCart());
}

function nbAddUpsell(btn, handle) {
  fetch('/products/' + handle + '.js')
    .then(r => r.json())
    .then(product => {
      const variantId = product.variants[0].id;
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      });
    })
    .then(() => {
      btn.textContent = '✓';
      btn.classList.add('added');
      nbRefreshCart();
    })
    .catch(() => {
      btn.textContent = '✓';
      btn.style.background = '#999';
    });
}

document.addEventListener('DOMContentLoaded', function() {

  // Intercept nb-quick-form → open drawer
  document.addEventListener('submit', function(e) {
    const form = e.target;
    if (!form.classList.contains('nb-quick-form')) return;
    e.preventDefault();
    const id = form.querySelector('[name="id"]').value;
    if (!id) return;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(id), quantity: 1 })
    })
    .then(r => r.json())
    .then(() => nbOpenDrawer())
    .catch(() => window.location.href = '/cart');
  });

  // Intercept /cart link clicks → open drawer instead
  document.addEventListener('click', function(e) {
    const link = e.target.closest('a[href="/cart"]');
    if (!link) return;
    // Don't intercept if it's the checkout button inside our drawer
    if (link.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    nbOpenDrawer();
  });

  // Intercept cart icon button clicks (theme's cart drawer trigger)
  document.addEventListener('click', function(e) {
    const cartBtn = e.target.closest('[data-cart-toggle], .header__icon--cart, [aria-label="Cart"]');
    if (!cartBtn) return;
    if (cartBtn.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    e.stopPropagation();
    nbOpenDrawer();
  });

});
</script>
