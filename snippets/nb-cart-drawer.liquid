{% comment %} NIAMAT BIRYANI — Ideal Ultra-Luxury Cart Drawer {% endcomment %}

<div id="nb-drawer-overlay" onclick="nbCloseDrawer()"></div>

<div id="nb-cart-drawer">
  <!-- HEADER WITH LOGO ONLY (CLEAN & CENTERED) -->
  <div class="nb-drawer__header">
    <div class="nb-drawer__header-logo-wrap">
      <img src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837"
           alt="Biryani Palace by Niamat"
           class="nb-drawer__logo">
    </div>
    <button class="nb-drawer__close" onclick="nbCloseDrawer()" aria-label="Close Cart">✕</button>
  </div>

  <!-- FREE DELIVERY PROGRESS BAR BANNER -->
  <div class="nb-drawer__delivery-progress" id="nb-delivery-progress-banner">
    <div class="nb-progress-text-wrap">
      <span class="nb-progress-icon">🚚</span>
      <span id="nb-progress-msg">Add <strong>₹360</strong> more for <strong>FREE DELIVERY</strong></span>
    </div>
    <div class="nb-progress-bar-bg">
      <div class="nb-progress-bar-fill" id="nb-progress-fill" style="width: 55%;"></div>
    </div>
  </div>

  <!-- MAIN DRAWER BODY -->
  <div class="nb-drawer__body">
    <!-- CART ITEMS CONTAINER -->
    <div id="nb-cart-items" class="nb-drawer__items"></div>

    <!-- COMPLETE YOUR ORDER (KEEP ONLY COKE & EXTRA RAITA) -->
    <div class="nb-drawer__upsell-section">
      <div class="nb-upsell-header">
        <span>🍽️</span>
        <h4>Complete your order</h4>
      </div>
      <div class="nb-upsell-grid">
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Extra Raita</span>
            <span class="nb-upsell-pill-price">₹29</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-raita-btn" onclick="nbAddUpsell(this, 'extra-raita', 'Extra Raita', 2900)">+ Add</button>
        </div>
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Coke</span>
            <span class="nb-upsell-pill-price">₹39</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-coke-btn" onclick="nbAddUpsell(this, 'coke', 'Coke', 3900)">+ Add</button>
        </div>
      </div>
    </div>

    <!-- LOCATION INPUT & GPS DETECTION (LIVE KEYWORD MATCHING) -->
    <div class="nb-drawer__location-box">
      <div class="nb-location-header">
        <label for="nb-manual-location-input">📍 Delivery Location</label>
        <div class="nb-loc-btn-group">
          <button type="button" class="nb-use-location-btn" id="nb-use-location-btn" onclick="nbDetectLiveLocation()">
            🎯 Use My Location
          </button>
          <button type="button" class="nb-clear-location-btn" id="nb-clear-location-btn" onclick="nbClearLocation()" style="display:none;">
            ✕ Clear
          </button>
        </div>
      </div>

      <div class="nb-location-input-wrap">
        <input type="text" id="nb-manual-location-input"
               placeholder="Type area or landmark (e.g. Raunak City, Kalyan West...)"
               oninput="nbSaveManualLocation(this.value)"
               onchange="nbSaveManualLocation(this.value)">
      </div>

      <div id="nb-location-status-badge" class="nb-location-status" style="display: none;"></div>
    </div>

    <!-- COOKING INSTRUCTIONS (SAVED TO SHOPIFY ADMIN ORDERS) -->
    <div class="nb-drawer__instructions-box">
      <label for="nb-cooking-instructions">👨‍🍳 Cooking Instructions</label>
      <textarea id="nb-cooking-instructions"
                placeholder="Spice level, less oil, extra raita preference, allergies..."
                rows="2"
                onchange="nbSaveCookingInstructions()"></textarea>
      <p class="nb-instructions-hint">💡 Visible to kitchen team in Shopify Admin Orders</p>
    </div>
  </div>

  <!-- DRAWER FOOTER WITH LIVE SUMMARY & CHECKOUT -->
  <div class="nb-drawer__footer">
    <div class="nb-summary-rows">
      <div class="nb-summary-row">
        <span>Subtotal</span>
        <span id="nb-subtotal-val">₹0</span>
      </div>
      <div class="nb-summary-row">
        <span>Delivery</span>
        <span id="nb-delivery-val" class="nb-delivery-highlight">₹39</span>
      </div>
      <div class="nb-summary-row nb-total-row">
        <span>TOTAL</span>
        <span id="nb-grand-total-val">₹0</span>
      </div>
    </div>

    <div class="nb-secure-badge">
      <span>🔒 100% Secure Checkout</span>
    </div>

    <button class="nb-drawer__checkout-btn" onclick="nbGoToCheckout()">
      <span class="nb-checkout-btn-text">Proceed to Checkout</span>
      <span id="nb-btn-total-val" class="nb-checkout-btn-price">₹0</span>
    </button>

    <button class="nb-drawer__continue-btn" onclick="nbContinueOrdering()">
      ← Continue Ordering
    </button>
  </div>
</div>

<style>
