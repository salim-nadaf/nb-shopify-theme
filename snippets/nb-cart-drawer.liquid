{% comment %} NIAMAT BIRYANI — Production-Grade Refined Cart Drawer {% endcomment %}

{% liquid
  assign is_instant_enabled = settings.nb_instant_delivery_enabled
  if shop.metafields.niamat.instant_delivery_enabled != blank
    if shop.metafields.niamat.instant_delivery_enabled == false or shop.metafields.niamat.instant_delivery_enabled == 'false'
      assign is_instant_enabled = false
    else
      assign is_instant_enabled = true
    endif
  endif
%}

<div id="nb-drawer-overlay" onclick="nbCloseDrawer()"></div>

<div id="nb-cart-drawer" role="dialog" aria-modal="true" aria-label="Your Order Cart">
  <!-- TOAST NOTIFICATION FOR ERRORS -->
  <div id="nb-cart-toast" class="nb-cart-toast" style="display:none;"></div>

  <!-- HEADER WITH LOGO & CLOSE BUTTON -->
  <div class="nb-drawer__header">
    <div class="nb-drawer__header-logo-wrap">
      <img src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837"
           alt="Biryani Palace by Niamat"
           class="nb-drawer__logo">
    </div>
    <button class="nb-drawer__close" onclick="nbCloseDrawer()" aria-label="Close Cart">✕</button>
  </div>

  <!-- FREE DELIVERY PROGRESS BAR BANNER & ETA -->
  <div class="nb-drawer__delivery-progress" id="nb-delivery-progress-banner">
    <div class="nb-progress-text-wrap">
      <span class="nb-progress-icon">🚚</span>
      <span id="nb-progress-msg">Add items to unlock <strong>FREE DELIVERY</strong></span>
    </div>
    <div class="nb-progress-bar-bg">
      <div class="nb-progress-bar-fill" id="nb-progress-fill" style="width: 0%;"></div>
    </div>
    <div class="nb-eta-wrap" id="nb-eta-wrap">
      ⏱️ Estimated delivery: <strong>{{ settings.nb_eta_min | default: 45 }}–{{ settings.nb_eta_max | default: 60 }} min</strong>
    </div>
  </div>

  <!-- MAIN DRAWER BODY -->
  <div class="nb-drawer__body">
    {% unless is_instant_enabled %}
      <div id="nb-instant-disabled-cart-notice" class="nb-instant-disabled-cart-notice" style="margin: 12px 16px 4px; padding: 14px 16px; background: #FFEBEE; border: 1px solid #EF9A9A; border-left: 4px solid #C62828; border-radius: 12px; font-size: 0.85rem;">
        <div style="font-weight: 800; color: #C62828; margin-bottom: 4px;">🔴 Instant Delivery Currently Unavailable</div>
        <p style="color: #5C4033; margin: 0 0 10px; font-size: 0.82rem; line-height: 1.35;">
          {{ settings.nb_instant_delivery_off_msg | default: 'We are currently handling a high volume of orders. Instant Delivery will resume shortly.' }}
        </p>
        <a href="{{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' }}" class="nb-btn nb-btn--gold nb-btn--sm" style="display: block; text-align: center; text-decoration: none;">
          📅 Choose a Scheduled / Pre-Order
        </a>
      </div>
    {% endunless %}

    <!-- DYNAMIC FREE DELIVERY NOTICE BANNER JUST ABOVE ITEMS -->
    <div class="nb-drawer__items-fd-notice" id="nb-items-fd-notice">
      <div class="nb-fd-notice-content">
        <span class="nb-fd-notice-icon">🚚</span>
        <span id="nb-items-fd-text">Add <strong>₹799</strong> more to get <strong>FREE Delivery</strong></span>
      </div>
      <div class="nb-fd-notice-bar-bg">
        <div class="nb-fd-notice-bar-fill" id="nb-items-fd-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- CART ITEMS CONTAINER -->
    <div id="nb-cart-items" class="nb-drawer__items"></div>

    <!-- COMPLETE YOUR ORDER (EXTRA RAITA ONLY) -->
    <div class="nb-drawer__upsell-section">
      <div class="nb-upsell-header">
        <span>🥣</span>
        <h4>Complete your order</h4>
      </div>
      <div class="nb-upsell-grid nb-upsell-grid--single">
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Niamat Extra Raita</span>
            <span class="nb-upsell-pill-price">₹29</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-raita-btn" onclick="nbAddUpsell(this, 'extra-raita', 'Extra Raita', 2900)">+ Add</button>
        </div>
      </div>
    </div>

    <!-- INFORMATIONAL STORE DELIVERY POLICY CARD (POINTERS ONLY) -->
    <div class="nb-drawer__policy-card">
      <div class="nb-policy-header">
        <span>📜</span> <strong>Store Delivery Policy</strong>
      </div>
      <ul class="nb-policy-list">
        <li>🚚 <strong>0–5 km (Kalyan / Nearby)</strong>: ₹39 Delivery · <strong>FREE</strong> > ₹799</li>
        <li>🚀 <strong>5–8 km (Extended Zone)</strong>: ₹89 Delivery · <strong>FREE</strong> > ₹1,299</li>
        <li>⛔ <strong>> 8 km</strong>: Outside direct delivery radius</li>
      </ul>
    </div>

    <!-- LIVE ZOMATO/SWIGGY/ZEPTO UNRESTRICTED LOCATION SEARCH & GPS DETECTOR -->
    <div class="nb-drawer__location-box">
      <div class="nb-location-header">
        <label for="nb-location-search-input">📍 Delivery Location</label>
        <div class="nb-loc-btn-group">
          <button type="button" class="nb-use-location-btn" id="nb-use-location-btn" onclick="nbDetectLiveLocation()">
            🎯 Use Live Location
          </button>
          <button type="button" class="nb-clear-location-btn" id="nb-clear-location-btn" onclick="nbClearLocation()" style="display:none;">
            ✕ Clear
          </button>
        </div>
      </div>

      <div class="nb-search-input-wrap">
        <input type="text" id="nb-location-search-input"
               placeholder="Search any area, society, building or city..."
               onkeyup="nbDebounceSearch(this.value)">
        <div id="nb-location-suggestions" class="nb-suggestions-dropdown" style="display:none;"></div>
      </div>

      <div id="nb-location-status-badge" class="nb-location-status" style="display: none;"></div>
    </div>

    <!-- PRE-FILLED CUSTOMER CONTACT DETAILS CARD (AUTO-POPULATED BEFORE ORDERING) -->
    <div class="nb-drawer__customer-card" id="nb-customer-contact-card" style="margin: 12px 16px; padding: 14px 16px; background: linear-gradient(135deg, #FFFDF7 0%, #FDF5E6 100%); border: 1px solid rgba(200, 146, 42, 0.28); border-left: 4px solid #C8922A; border-radius: 14px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <span style="font-weight: 800; font-size: 0.88rem; color: #2C1810;">📱 Verified Contact Details</span>
        <button type="button" onclick="nbEditCustomerDetails()" style="background: none; border: none; color: #C8922A; font-size: 0.8rem; font-weight: 700; cursor: pointer; text-decoration: underline;">✏️ Change</button>
      </div>
      <div style="font-size: 0.85rem; color: #5C4033; line-height: 1.4;">
        <div><strong>Phone:</strong> <span id="nb-cart-contact-phone">+919876543210</span></div>
        <div id="nb-cart-contact-name-row"><strong>Name:</strong> <span id="nb-cart-contact-name">Rahul</span></div>
        <div id="nb-cart-contact-email-row" style="display:none;"><strong>Email:</strong> <span id="nb-cart-contact-email"></span></div>
      </div>
    </div>

    <!-- ORDER & DELIVERY INSTRUCTIONS -->
    <div class="nb-drawer__instructions-box">
      <label for="nb-cooking-instructions">📝 Order & Delivery Instructions</label>
      <textarea id="nb-cooking-instructions"
                placeholder="Example: Less spicy, no green chilli, call on arrival..."
                rows="2"
                onchange="nbSaveInstructions()"></textarea>
      <p class="nb-instructions-hint">💡 Saved to your order for our kitchen & delivery team</p>
    </div>
  </div>

  <!-- DRAWER FOOTER WITH LIVE SUMMARY & CHECKOUT -->
  <div class="nb-drawer__footer">
    <div class="nb-summary-rows">
      <div class="nb-summary-row">
        <span>Subtotal</span>
        <span id="nb-subtotal-val">₹0</span>
      </div>
      <div class="nb-summary-row">
        <span>Delivery</span>
        <span id="nb-delivery-val" class="nb-delivery-highlight">₹0</span>
      </div>
      <div class="nb-summary-row nb-total-row">
        <span>TOTAL</span>
        <span id="nb-grand-total-val">₹0</span>
      </div>
    </div>

    <div class="nb-secure-badge">
      <span>🔒 100% Secure Checkout</span>
    </div>

    <button class="nb-drawer__checkout-btn" id="nb-checkout-submit-btn" onclick="nbGoToCheckout()">
      <span class="nb-checkout-btn-text" id="nb-checkout-btn-text">Proceed to Checkout</span>
      <span id="nb-btn-total-val" class="nb-checkout-btn-price">₹0</span>
    </button>

    <button class="nb-drawer__continue-btn" onclick="nbContinueOrdering()">
      ← Continue Ordering
    </button>
  </div>
</div>

<style>
/* ===== REFINED COMPACT CART DRAWER STYLES ===== */
#nb-drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(44,24,16,0.6);
  z-index: 99990;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
#nb-drawer-overlay.active { display: block; }

#nb-cart-drawer {
  position: fixed;
  top: 0; right: 0;
  width: 100%;
  max-width: 440px;
  height: 100%;
  background: #FFFAF4;
  z-index: 99991;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: -8px 0 36px rgba(44,24,16,0.22);
}
#nb-cart-drawer.active { transform: translateX(0); }

/* TOAST NOTIFICATION */
.nb-cart-toast {
  position: absolute;
  top: 60px; left: 16px; right: 16px;
  background: #C62828;
  color: #fff;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 700;
  text-align: center;
  z-index: 99999;
  box-shadow: 0 4px 14px rgba(0,0,0,0.2);
}

/* HEADER LOGO ONLY */
.nb-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: #2C1810;
  color: #FDF6EC;
  flex-shrink: 0;
  border-bottom: 2px solid #C8922A;
}
.nb-drawer__header-logo-wrap { display: flex; align-items: center; }
.nb-drawer__logo {
  height: 38px;
  width: auto;
  max-width: 150px;
  object-fit: contain;
}
.nb-drawer__close {
  background: none; border: none; color: #FDF6EC;
  font-size: 1.3rem; cursor: pointer; padding: 4px 8px;
  border-radius: 8px; transition: background 0.15s;
  min-width: 44px; min-height: 44px;
  display: flex; align-items: center; justify-content: center;
}
.nb-drawer__close:hover { background: rgba(255,255,255,0.12); }

/* FREE DELIVERY PROGRESS BANNER & ETA */
.nb-drawer__delivery-progress {
  background: linear-gradient(135deg, #FFFDF7 0%, #F8EED8 100%);
  border-bottom: 1px solid rgba(200,146,42,0.25);
  padding: 8px 16px;
  flex-shrink: 0;
}
.nb-progress-text-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: #2C1810;
  margin-bottom: 6px;
}
.nb-progress-icon { font-size: 1rem; }
.nb-progress-bar-bg {
  width: 100%;
  height: 6px;
  background: rgba(200,146,42,0.2);
  border-radius: 99px;
  overflow: hidden;
}
.nb-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C8922A 0%, #25D366 100%);
  border-radius: 99px;
  transition: width 0.4s ease;
}
.nb-eta-wrap {
  font-size: 0.76rem;
  color: #5C4033;
  margin-top: 4px;
}

/* DRAWER BODY */
.nb-drawer__body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* CART ITEMS */
.nb-drawer__items { display: flex; flex-direction: column; gap: 8px; }
.nb-cart-item {
  display: flex; gap: 10px; align-items: flex-start;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
  box-shadow: 0 2px 6px rgba(44,24,16,0.03);
}
.nb-cart-item__img {
  width: 56px; height: 56px;
  border-radius: 8px; object-fit: cover;
  flex-shrink: 0; background: #F5ECD7;
}
.nb-cart-item__info { flex: 1; min-width: 0; }
.nb-cart-item__name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 0.9rem; font-weight: 700;
  color: #2C1810; margin: 0 0 2px;
  line-height: 1.2;
}
.nb-cart-item__variant { font-size: 0.74rem; color: #7A5C4A; margin: 0 0 4px; }

/* RAITA INCLUDED DISPLAY ATTRIBUTE */
.nb-raita-tag {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: #E8F5E9;
  color: #2E7D32;
  border: 1px solid #A5D6A7;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
  margin-bottom: 6px;
}

.nb-cart-item__bottom {
  display: flex; align-items: center;
  justify-content: space-between; gap: 8px;
}
.nb-cart-item__price { font-size: 0.98rem; font-weight: 800; color: #C8922A; }
.nb-qty-control { display: flex; align-items: center; gap: 6px; }
.nb-qty-btn {
  width: 36px; height: 36px;
  min-width: 36px; min-height: 36px;
  border-radius: 50%;
  border: 1.5px solid #C8922A;
  background: #FDF6EC;
  color: #C8922A;
  font-size: 1.1rem; font-weight: 800;
  cursor: pointer; display: flex;
  align-items: center; justify-content: center;
  transition: all 0.15s;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.nb-qty-btn:hover, .nb-qty-btn:active { background: #C8922A; color: #fff; }
.nb-qty-num { font-size: 0.92rem; font-weight: 800; color: #2C1810; min-width: 20px; text-align: center; }

/* SYMMETRICAL UPSELL PILL CARDS */
.nb-drawer__upsell-section {
  background: #FFFDF7;
  border: 1px dashed rgba(200,146,42,0.35);
  border-radius: 12px;
  padding: 10px;
}
.nb-upsell-header {
  display: flex; align-items: center; gap: 6px; margin-bottom: 8px;
}
.nb-upsell-header h4 {
  margin: 0; font-family: 'Playfair Display', Georgia, serif;
  font-size: 0.88rem; font-weight: 700; color: #2C1810;
}
.nb-upsell-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.nb-upsell-pill-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 10px;
  padding: 8px 10px;
  min-height: 56px;
  box-sizing: border-box;
}
.nb-upsell-pill-info {
   display: flex;
   flex-direction: row;
   align-items: center;
   gap: 4px;
   flex: 1;
   min-width: 0;
   padding-right: 6px;
 }
.nb-upsell-pill-name {
       font-size: 0.8rem;
       font-weight: 700;
       color: #2C1810;
       line-height: 1.2;
       white-space: normal;
       overflow: visible;
       text-overflow: clip;
       flex: 1;
     }
.nb-upsell-pill-price {
      font-size: 0.76rem;
      font-weight: 800;
      color: #C8922A;
      margin-left: auto;
    }
.nb-upsell-pill-add {
  background: #C8922A;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  min-width: 64px;
  height: 34px;
  font-size: 0.74rem;
  font-weight: 800;
  cursor: pointer;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.nb-upsell-pill-add:hover { background: #A67520; }

/* STORE POLICY CARD (POINTERS ONLY) */
.nb-drawer__policy-card {
  background: #FFFDF7;
  border: 1px solid rgba(200,146,42,0.25);
  border-radius: 10px;
  padding: 8px 12px;
}
.nb-policy-header {
  font-size: 0.8rem;
  color: #2C1810;
  margin-bottom: 4px;
  display: flex; align-items: center; gap: 4px;
}
.nb-policy-list {
  margin: 0; padding-left: 16px;
  font-size: 0.74rem; color: #5C4033;
  line-height: 1.4;
}
.nb-policy-list li { margin-bottom: 2px; }

/* LOCATION BOX & SEARCH SUGGESTIONS */
.nb-drawer__location-box {
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
  position: relative;
}
.nb-location-header {
  display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;
}
.nb-location-header label {
  font-size: 0.8rem; font-weight: 700; color: #2C1810; margin: 0;
}
.nb-loc-btn-group { display: flex; gap: 6px; align-items: center; }
.nb-use-location-btn {
  background: rgba(200,146,42,0.12);
  color: #C8922A;
  border: 1px solid rgba(200,146,42,0.4);
  font-size: 0.72rem;
  font-weight: 800;
  padding: 4px 10px;
  min-height: 32px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s;
}
.nb-use-location-btn:hover { background: #C8922A; color: #fff; }

.nb-clear-location-btn {
  background: rgba(229,62,62,0.1);
  color: #E53E3E;
  border: 1px solid rgba(229,62,62,0.3);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 8px;
  min-height: 32px;
  border-radius: 6px;
  cursor: pointer;
}

.nb-search-input-wrap {
  position: relative;
}
.nb-search-input-wrap input {
  width: 100%;
  background: #FFFDF7;
  border: 1px solid rgba(200,146,42,0.3);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 0.82rem;
  font-weight: 600;
  color: #2C1810;
  outline: none;
  box-sizing: border-box;
}
.nb-suggestions-dropdown {
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: #fff;
      border: 1px solid rgba(200,146,42,0.3);
      border-radius: 8px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
      z-index: 99;
      max-height: 400px;
      overflow-y: auto;
      margin-top: 4px;
    }
.nb-suggestion-item {
  padding: 8px 10px;
  font-size: 0.78rem;
  color: #2C1810;
  cursor: pointer;
  border-bottom: 1px solid rgba(200,146,42,0.1);
}
.nb-suggestion-item:hover {
  background: #FDF6EC;
  color: #C8922A;
}

.nb-location-status {
  margin-top: 6px;
  font-size: 0.74rem;
  font-weight: 700;
  padding: 5px 8px;
  border-radius: 6px;
  background: #E8F5E9;
  color: #2E7D32;
  border: 1px solid #A5D6A7;
  line-height: 1.3;
}

/* DYNAMIC FREE DELIVERY BANNER ABOVE CART ITEMS */
.nb-drawer__items-fd-notice {
  background: #FFFDF7;
  border: 1.5px solid rgba(200, 146, 42, 0.35);
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(44, 24, 16, 0.04);
}
.nb-fd-notice-content {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  color: #2C1810;
  margin-bottom: 6px;
  line-height: 1.3;
}
.nb-fd-notice-icon {
  font-size: 1.15rem;
  flex-shrink: 0;
}
.nb-fd-notice-bar-bg {
  width: 100%;
  height: 6px;
  background: rgba(200, 146, 42, 0.15);
  border-radius: 10px;
  overflow: hidden;
}
.nb-fd-notice-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #D49E35 0%, #C8922A 100%);
  border-radius: 10px;
  transition: width 0.3s ease;
}

/* COOKING INSTRUCTIONS BOX */
.nb-drawer__instructions-box {
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
}
.nb-drawer__instructions-box label {
  display: block; font-size: 0.8rem;
  font-weight: 700; color: #2C1810; margin-bottom: 4px;
}
.nb-drawer__instructions-box textarea {
  width: 100%; border: 1px solid rgba(200,146,42,0.3);
  border-radius: 8px; padding: 8px 10px;
  font-size: 0.8rem; color: #2C1810;
  background: #FFFDF7; resize: none;
  font-family: inherit; box-sizing: border-box;
}
.nb-drawer__instructions-box textarea:focus {
  outline: none; border-color: #C8922A;
}
.nb-instructions-hint {
  margin: 3px 0 0; font-size: 0.7rem; color: #7A5C4A; font-style: italic;
}

/* FOOTER */
.nb-drawer__footer {
  padding: 10px 16px 16px;
  border-top: 2px solid rgba(200,146,42,0.25);
  background: #FFFAF4;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  z-index: 1;
}

.nb-summary-rows { display: flex; flex-direction: column; gap: 4px; margin-bottom: 2px; }
.nb-summary-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.86rem; color: #5C4033;
}
.nb-summary-row.nb-total-row {
  font-size: 1.02rem; font-weight: 900; color: #2C1810;
  border-top: 1px solid rgba(200,146,42,0.2);
  padding-top: 6px; margin-top: 2px;
}
