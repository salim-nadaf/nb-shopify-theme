<script>
// ===== NB IDEAL CART DRAWER CONTROLLER =====

var nbSelectedArea = '5km_kalyan_west';

// Niamat Biryani Central Store Coordinates (Kalyan West)
var NB_KITCHEN_LAT = 19.2402;
var NB_KITCHEN_LNG = 73.1305;

function nbOpenDrawer() {
  document.getElementById('nb-cart-drawer').classList.add('active');
  document.getElementById('nb-drawer-overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
  nbRefreshCart();
}

function nbCloseDrawer() {
  document.getElementById('nb-cart-drawer').classList.remove('active');
  document.getElementById('nb-drawer-overlay').classList.remove('active');
  document.body.style.overflow = '';
}

function nbFormatMoney(cents) {
  return '₹' + (cents / 100).toFixed(0);
}

// ===== SMART MANUAL LOCATION KEYWORD MATCHING =====
function nbSaveManualLocation(val) {
  var inputVal = (val || '').trim();
  var badge = document.getElementById('nb-location-status-badge');
  var clearBtn = document.getElementById('nb-clear-location-btn');

  if (!inputVal) {
    if (badge) badge.style.display = 'none';
    if (clearBtn) clearBtn.style.display = 'none';
    return;
  }

  localStorage.setItem('nb_manual_location', inputVal);
  if (clearBtn) clearBtn.style.display = 'inline-block';

  var lower = inputVal.toLowerCase();
  var isExtended = lower.includes('beyond') || lower.includes('badlapur') || lower.includes('thane') || lower.includes('mumbra') || lower.includes('mumbai') || lower.includes('8km');

  if (isExtended) {
    nbSelectedArea = '8km_beyond';
    if (badge) {
      badge.style.display = 'block';
      badge.style.background = '#FFF3E0';
      badge.style.color = '#E65100';
      badge.style.borderColor = '#FFE0B2';
      badge.innerHTML = '📍 Location Set: <strong>' + inputVal + '</strong> (Extended Zone ₹69 Delivery · Free > ₹1,299)';
    }
  } else {
    nbSelectedArea = '5km_kalyan_west';
    if (badge) {
      badge.style.display = 'block';
      badge.style.background = '#E8F5E9';
      badge.style.color = '#2E7D32';
      badge.style.borderColor = '#A5D6A7';
      badge.innerHTML = '📍 Location Set: <strong>' + inputVal + '</strong> (Standard Zone ₹39 Delivery · Free > ₹799)';
    }
  }

  localStorage.setItem('nb_delivery_area', nbSelectedArea);
  nbRefreshCart();
}

function nbClearLocation() {
  localStorage.removeItem('nb_manual_location');
  localStorage.removeItem('nb_user_lat');
  localStorage.removeItem('nb_user_lng');
  localStorage.removeItem('nb_delivery_area');
  nbSelectedArea = '5km_kalyan_west';

  var input = document.getElementById('nb-manual-location-input');
  var badge = document.getElementById('nb-location-status-badge');
  var btn = document.getElementById('nb-use-location-btn');
  var clearBtn = document.getElementById('nb-clear-location-btn');

  if (input) input.value = '';
  if (badge) badge.style.display = 'none';
  if (btn) btn.textContent = '🎯 Use My Location';
  if (clearBtn) clearBtn.style.display = 'none';

  nbRefreshCart();
}

function nbCalculateDistanceKm(lat1, lon1, lat2, lon2) {
  var R = 6371; // Earth radius in km
  var dLat = (lat2 - lat1) * Math.PI / 180;
  var dLon = (lon2 - lon1) * Math.PI / 180;
  var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
          Math.sin(dLon/2) * Math.sin(dLon/2);
  var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}

function nbDetectLiveLocation() {
  var btn = document.getElementById('nb-use-location-btn');
  var badge = document.getElementById('nb-location-status-badge');
  var clearBtn = document.getElementById('nb-clear-location-btn');
  var input = document.getElementById('nb-manual-location-input');

  if (!navigator.geolocation) {
    alert('Geolocation is not supported by your browser.');
    return;
  }

  if (btn) btn.textContent = '⌛ Locating...';

  navigator.geolocation.getCurrentPosition(
    function(position) {
      var userLat = position.coords.latitude;
      var userLng = position.coords.longitude;
      var distKm = nbCalculateDistanceKm(NB_KITCHEN_LAT, NB_KITCHEN_LNG, userLat, userLng);

      if (btn) btn.textContent = '🎯 Location Set';
      if (clearBtn) clearBtn.style.display = 'inline-block';

      // If within 1.5 km of store, treat as Store Vicinity (0 km)
      if (distKm <= 1.5) {
        nbSelectedArea = '5km_kalyan_west';
        if (input) input.value = 'Store Vicinity / Kalyan Central';
        if (badge) {
          badge.style.display = 'block';
          badge.style.background = '#E8F5E9';
          badge.style.color = '#2E7D32';
          badge.style.borderColor = '#A5D6A7';
          badge.innerHTML = '📍 Location: <strong>At Store / Central Kalyan (0 km)</strong> (Standard ₹39 Delivery · Free > ₹799)';
        }
      } else if (distKm <= 5.2) {
        nbSelectedArea = '5km_kalyan_west';
        if (input) input.value = 'Kalyan / Nearby Area (~' + distKm.toFixed(1) + ' km)';
        if (badge) {
          badge.style.display = 'block';
          badge.style.background = '#E8F5E9';
          badge.style.color = '#2E7D32';
          badge.style.borderColor = '#A5D6A7';
          badge.innerHTML = '📍 Location: <strong>~' + distKm.toFixed(1) + ' km away</strong> (Standard ₹39 Delivery · Free > ₹799)';
        }
      } else {
        nbSelectedArea = '8km_beyond';
        if (input) input.value = 'Extended Delivery Zone (~' + distKm.toFixed(1) + ' km)';
        if (badge) {
          badge.style.display = 'block';
          badge.style.background = '#FFF3E0';
          badge.style.color = '#E65100';
          badge.style.borderColor = '#FFE0B2';
          badge.innerHTML = '📍 Location: <strong>~' + distKm.toFixed(1) + ' km away</strong> (Extended Zone ₹69 Delivery · Free > ₹1,299)';
        }
      }

      localStorage.setItem('nb_delivery_area', nbSelectedArea);
      localStorage.setItem('nb_user_lat', userLat);
      localStorage.setItem('nb_user_lng', userLng);
      nbRefreshCart();
    },
    function(error) {
      if (btn) btn.textContent = '🎯 Use My Location';
      alert('Could not detect location. Please type your location manually in the input box.');
    },
    { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
  );
}

function nbSaveCookingInstructions() {
  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';
  if (instructions) {
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: { 'Cooking Instructions': instructions },
        note: 'COOKING INSTRUCTIONS: ' + instructions
      })
    }).catch(function(e) {});
  }
}

function nbGoToCheckout() {
  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';
  var locInput = document.getElementById('nb-manual-location-input');
  var locationText = locInput ? locInput.value.trim() : '';

  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 
        'Cooking Instructions': instructions,
        'Delivery Location': locationText,
        'Delivery Area': nbSelectedArea
      },
      note: instructions ? ('COOKING INSTRUCTIONS: ' + instructions) : ''
    })
  }).then(function() {
    window.location.href = '/checkout';
  }).catch(function() {
    window.location.href = '/checkout';
  });
}

function nbContinueOrdering() {
  nbCloseDrawer();
  if (window.innerWidth > 768) {
    window.location.href = '/collections/instant-delivery';
  }
}

function nbRenderCart(cart) {
  var container = document.getElementById('nb-cart-items');
  var subtotalEl = document.getElementById('nb-subtotal-val');
  var deliveryEl = document.getElementById('nb-delivery-val');
  var grandTotalEl = document.getElementById('nb-grand-total-val');
  var btnTotalEl = document.getElementById('nb-btn-total-val');
  var progressMsgEl = document.getElementById('nb-progress-msg');
  var progressFillEl = document.getElementById('nb-progress-fill');

  if (!cart || cart.item_count === 0) {
    container.innerHTML = [
      '<div class="nb-drawer__empty" style="text-align: center; padding: 30px 16px;">',
        '<div style="font-size: 2.8rem; margin-bottom: 8px;">🍛</div>',
        '<p style="color: #7A5C4A; font-weight: 600;">Your order is empty.<br>Add delicious Biryani to get started!</p>',
      '</div>'
    ].join('');

    subtotalEl.textContent = '₹0';
    deliveryEl.textContent = '₹0';
    grandTotalEl.textContent = '₹0';
    btnTotalEl.textContent = '₹0';
    progressFillEl.style.width = '0%';
    progressMsgEl.innerHTML = 'Add <strong>₹799</strong> for <strong>FREE DELIVERY</strong>';
    return;
  }

  var subtotalCents = cart.total_price;
  var subtotalRupees = Math.round(subtotalCents / 100);

  var isBeyond5km = (nbSelectedArea === '8km_beyond');
  var freeThresholdRupees = isBeyond5km ? 1299 : 799;
  var baseDeliveryRupees = isBeyond5km ? 69 : 39;

  var deliveryRupees = 0;
  if (subtotalRupees >= freeThresholdRupees) {
    deliveryRupees = 0;
    deliveryEl.textContent = 'FREE 🎉';
    deliveryEl.style.color = '#25D366';
    progressFillEl.style.width = '100%';
    progressMsgEl.innerHTML = '🎉 You\'ve unlocked <strong>FREE DELIVERY</strong>!';
  } else {
    deliveryRupees = baseDeliveryRupees;
    deliveryEl.textContent = '₹' + deliveryRupees;
    deliveryEl.style.color = '#C8922A';

    var neededRupees = freeThresholdRupees - subtotalRupees;
    var percentage = Math.min(100, Math.round((subtotalRupees / freeThresholdRupees) * 100));
    progressFillEl.style.width = percentage + '%';
    progressMsgEl.innerHTML = '🚚 Add <strong>₹' + neededRupees + '</strong> more for <strong>FREE DELIVERY</strong>';
  }

  var grandTotalRupees = subtotalRupees + deliveryRupees;

  subtotalEl.textContent = '₹' + subtotalRupees;
  grandTotalEl.textContent = '₹' + grandTotalRupees;
  btnTotalEl.textContent = '₹' + grandTotalRupees;

  // Render cart items with line index for guaranteed qty update
  container.innerHTML = cart.items.map(function(item, idx) {
    var lineNum = idx + 1;
    var isBiryani = item.product_title.toLowerCase().includes('biryani') || item.product_type.toLowerCase().includes('biryani');
    var raitaHtml = isBiryani ? '<div class="nb-raita-tag"><span>✓</span> Raita included</div>' : '';

    return [
      '<div class="nb-cart-item" data-key="' + item.key + '">',
        '<img class="nb-cart-item__img" src="' + (item.image || '') + '" alt="' + item.product_title + '" onerror="this.style.display=\'none\'">',
        '<div class="nb-cart-item__info">',
          '<p class="nb-cart-item__name">' + item.product_title + '</p>',
          (item.variant_title && item.variant_title !== 'Default Title' ? '<p class="nb-cart-item__variant">' + item.variant_title + '</p>' : ''),
          raitaHtml,
          '<div class="nb-cart-item__bottom">',
            '<span class="nb-cart-item__price">' + nbFormatMoney(item.final_line_price) + '</span>',
            '<div class="nb-qty-control">',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity - 1) + ', ' + lineNum + ')">−</button>',
              '<span class="nb-qty-num">' + item.quantity + '</span>',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity + 1) + ', ' + lineNum + ')">+</button>',
            '</div>',
          '</div>',
        '</div>',
      '</div>'
    ].join('');
  }).join('');
}

function nbRefreshCart() {
  fetch('/cart.js')
    .then(r => r.json())
    .then(cart => nbRenderCart(cart));
}

function nbUpdateQty(key, qty, lineNum) {
  if (qty < 0) qty = 0;
  
  var payload = lineNum ? { line: lineNum, quantity: qty } : { id: key, quantity: qty };

  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(r => r.json())
  .then(cart => nbRenderCart(cart))
  .catch(function(e) {
    nbRefreshCart();
  });
}

// ===== MULTI-TIER ADDON LOOKUP (BY HANDLE, TITLE, SEARCH) =====
function nbAddUpsell(btn, handle, titleQuery, fallbackPriceCents) {
  btn.textContent = 'Adding...';

  function tryAddToCart(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(r => r.json())
    .then(item => {
      btn.textContent = '✓ Added';
      btn.style.background = '#2E7D32';
      nbRefreshCart();
    });
  }

  // Tier 1: Try handle JS endpoint
  fetch('/products/' + handle + '.js')
    .then(r => r.json())
    .then(product => {
      if (product && product.variants && product.variants.length > 0) {
        return tryAddToCart(product.variants[0].id);
      }
      throw new Error('Handle not found');
    })
    .catch(() => {
      // Tier 2: Search by title query
      fetch('/search/suggest.json?q=' + encodeURIComponent(titleQuery || handle) + '&resources[type]=product')
        .then(r => r.json())
        .then(res => {
          var products = (res.resources && res.resources.results && res.resources.results.products) ? res.resources.results.products : [];
          if (products.length > 0) {
            return tryAddToCart(products[0].variants[0].id);
          }
          throw new Error('Suggest not found');
        })
        .catch(() => {
          // Tier 3: Fetch all products catalog
          fetch('/collections/all/products.json')
            .then(r => r.json())
            .then(data => {
              var prods = data.products || [];
              var matched = prods.find(p => p.title.toLowerCase().includes((titleQuery || handle).toLowerCase()));
              if (matched && matched.variants && matched.variants.length > 0) {
                return tryAddToCart(matched.variants[0].id);
              }
              throw new Error('Product not found in catalog');
            })
            .catch(() => {
              btn.textContent = '+ Add';
              alert('Addon product "' + titleQuery + '" not found. Please verify product name in Shopify Admin.');
            });
        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
  var savedLoc = localStorage.getItem('nb_manual_location');
  if (savedLoc) {
    var input = document.getElementById('nb-manual-location-input');
    if (input) {
      input.value = savedLoc;
      nbSaveManualLocation(savedLoc);
    }
  }

  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (!form.classList.contains('nb-quick-form')) return;
    e.preventDefault();
    var id = form.querySelector('[name="id"]').value;
    if (!id) return;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(id), quantity: 1 })
    })
    .then(r => r.json())
    .then(() => nbOpenDrawer())
    .catch(() => window.location.href = '/cart');
  });

  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href="/cart"]');
    if (!link) return;
    if (link.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    nbOpenDrawer();
  });

  document.addEventListener('click', function(e) {
    var cartBtn = e.target.closest('[data-cart-toggle], .header__icon--cart, [aria-label="Cart"]');
    if (!cartBtn) return;
    if (cartBtn.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    e.stopPropagation();
    nbOpenDrawer();
  });
});
</script>
