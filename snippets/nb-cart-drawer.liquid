  color: #2E7D32;
  border: 1px solid #A5D6A7;
  line-height: 1.3;
}

/* COOKING INSTRUCTIONS BOX */
.nb-drawer__instructions-box {
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
}
.nb-drawer__instructions-box label {
