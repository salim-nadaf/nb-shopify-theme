function nbFormatMoney(cents) {
  return '₹' + (cents / 100).toFixed(0);
}

function nbCalculateDistanceKm(lat1, lon1, lat2, lon2) {
  var R = 6371;
  var dLat = (lat2 - lat1) * Math.PI / 180;
  var dLon = (lon2 - lon1) * Math.PI / 180;
  var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
          Math.sin(dLon/2) * Math.sin(dLon/2);
  var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
}

var googlePlacesService = null;
var googleGeocoder = null;
var googleDistanceMatrixService = null;
var googlePlacesHasError = false;

// CATCH GOOGLE MAPS API AUTH / SERVICE ERRORS
window.gm_authFailure = function() {
  googlePlacesHasError = true;
  googlePlacesService = null;
  googleGeocoder = null;
  googleDistanceMatrixService = null;
};

function nbInitGooglePlaces() {
  if (!window.google || !window.google.maps || !window.google.maps.places) return;
  try {
    googlePlacesService = new google.maps.places.AutocompleteService();
    googleGeocoder = new google.maps.Geocoder();
    googleDistanceMatrixService = new google.maps.DistanceMatrixService();
  } catch(e) {
    googlePlacesHasError = true;
    googlePlacesService = null;
  }
}

// ZOMATO/SWIGGY / GOOGLE MAPS HYBRID SEARCH DEBOUNCE
function nbDebounceSearch(val) {
  clearTimeout(searchTimer);
  var dropdown = document.getElementById('nb-location-suggestions');
  
  if (!val || val.trim().length < 2) {
    if (dropdown) dropdown.style.display = 'none';
    return;
  }

  searchTimer = setTimeout(function() {
    nbPerformLocationSearch(val.trim());
  }, 250);
}

// PROGRAMMATIC GOOGLE PLACES & LOCAL HYBRID SEARCH
function nbPerformLocationSearch(query) {
  var dropdown = document.getElementById('nb-location-suggestions');
  if (!dropdown) return;

  var qLower = query.toLowerCase();
  var tokens = qLower.split(/\s+/).filter(Boolean);

  // 1. Instant Multi-Token Fuzzy Match from Local Landmarks
  var localMatches = LOCAL_LANDMARKS.filter(function(item) {
    var nameLower = item.name.toLowerCase();
    return tokens.every(function(t) { return nameLower.includes(t); });
  });

  dropdown.style.display = 'block';

  var html = '';
  if (localMatches.length > 0) {
    html += localMatches.slice(0, 4).map(function(item) {
      return '<div class="nb-suggestion-item" onclick="nbSelectLocationResult(' + item.lat + ', ' + item.lon + ', \'' + item.name.replace(/'/g, "\\'") + '\')">📍 <strong>' + item.name + '</strong></div>';
    }).join('');
  }

  // 2. Try Google Places AutocompleteService (Programmatic)
  if (googlePlacesService && !googlePlacesHasError) {
    try {
      var storeCenter = new google.maps.LatLng(NB_CONFIG.storeLat, NB_CONFIG.storeLng);
      var req = {
        input: query,
        componentRestrictions: { country: 'in' },
        location: storeCenter,
        radius: 15000
      };

      googlePlacesService.getPlacePredictions(req, function(predictions, status) {
        if (status === google.maps.places.PlacesServiceStatus.OK && predictions && predictions.length > 0) {
          var gHtml = predictions.slice(0, 6).map(function(p) {
            var parts = p.description.split(',').map(s => s.trim());
            var cleanName = parts.slice(0, Math.min(2, parts.length)).join(', ');
            return '<div class="nb-suggestion-item" onclick="nbSelectGooglePlace(\'' + p.place_id + '\', \'' + cleanName.replace(/'/g, "\\'") + '\')">📍 <strong>' + cleanName + '</strong></div>';
          }).join('');

          dropdown.innerHTML = (localMatches.length > 0 ? html : '') + gHtml;
          return;
        }

        nbPerformNominatimFallback(query, localMatches, html);
      });
      return;
    } catch(err) {
      googlePlacesHasError = true;
    }
  }

  nbPerformNominatimFallback(query, localMatches, html);
}

function nbSelectGooglePlace(placeId, placeName) {
  var dropdown = document.getElementById('nb-location-suggestions');
  var input = document.getElementById('nb-location-search-input');
  var clearBtn = document.getElementById('nb-clear-location-btn');

  if (dropdown) dropdown.style.display = 'none';
  if (input) input.value = placeName;
  if (clearBtn) clearBtn.style.display = 'inline-block';

  if (googleGeocoder) {
    googleGeocoder.geocode({ placeId: placeId }, function(results, status) {
      if (status === 'OK' && results && results[0] && results[0].geometry) {
        var lat = results[0].geometry.location.lat();
        var lng = results[0].geometry.location.lng();
        var rawAddr = results[0].formatted_address || placeName;
        var parts = rawAddr.split(',').map(s => s.trim());
        var cleanLabel = parts.slice(0, Math.min(2, parts.length)).join(', ');

        if (input) input.value = cleanLabel;
        nbCalculateDrivingDistance(lat, lng, cleanLabel);
      } else {
        nbPerformNominatimFallback(placeName, [], '');
      }
    });
  } else {
    nbPerformNominatimFallback(placeName, [], '');
  }
}

function nbCalculateDrivingDistance(destLat, destLng, placeName) {
  var origin = new google.maps.LatLng(NB_CONFIG.storeLat, NB_CONFIG.storeLng);
  var destination = new google.maps.LatLng(parseFloat(destLat), parseFloat(destLng));

  if (googleDistanceMatrixService) {
    googleDistanceMatrixService.getDistanceMatrix({
      origins: [origin],
      destinations: [destination],
      travelMode: google.maps.TravelMode.DRIVING,
      unitSystem: google.maps.UnitSystem.METRIC
    }, function(response, status) {
      if (status === 'OK' && response && response.rows && response.rows[0] && response.rows[0].elements && response.rows[0].elements[0].status === 'OK') {
        var drivingDistKm = response.rows[0].elements[0].distance.value / 1000.0;
        nbApplyLocationCalculation(drivingDistKm, placeName);
      } else {
        var straightKm = nbCalculateDistanceKm(NB_CONFIG.storeLat, NB_CONFIG.storeLng, destLat, destLng);
        nbApplyLocationCalculation(straightKm * 1.38, placeName);
      }
    });
  } else {
    var straightKm = nbCalculateDistanceKm(NB_CONFIG.storeLat, NB_CONFIG.storeLng, destLat, destLng);
    nbApplyLocationCalculation(straightKm * 1.38, placeName);
  }
}

function nbPerformNominatimFallback(query, localMatches, html) {
  var dropdown = document.getElementById('nb-location-suggestions');
  if (!dropdown) return;

  dropdown.innerHTML = html + '<div class="nb-suggestion-item" style="color:#7A5C4A;">🔍 Searching location...</div>';

  var searchUrl = 'https://nominatim.openstreetmap.org/search?format=json&countrycodes=in&q=' + encodeURIComponent(query) + '&limit=15';

  fetch(searchUrl)
    .then(r => r.json())
    .then(data => {
      var apiResults = data || [];
      if (apiResults.length === 0 && localMatches.length === 0) {
        return fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query + ', Maharashtra, India') + '&limit=15')
          .then(r => r.json());
      }
      return apiResults;
    })
    .then(results => {
      if ((!results || results.length === 0) && localMatches.length === 0) {
        dropdown.innerHTML = '<div class="nb-suggestion-item" style="color:#7A5C4A;">No matching location found. Please type area or landmark name.</div>';
        return;
      }

      var apiHtml = (results || []).map(function(item) {
        var parts = item.display_name.split(',').map(s => s.trim());
        var cleanName = parts.slice(0, Math.min(2, parts.length)).join(', ');
        return '<div class="nb-suggestion-item" onclick="nbSelectLocationResult(' + item.lat + ', ' + item.lon + ', \'' + cleanName.replace(/'/g, "\\'") + '\')">📍 ' + cleanName + '</div>';
      }).join('');

      dropdown.innerHTML = (localMatches.length > 0 ? html : '') + apiHtml;
    })
    .catch(() => {
      if (localMatches.length === 0) {
        dropdown.style.display = 'none';
      }
    });
}

function nbSelectLocationResult(lat, lon, nameText) {
  var dropdown = document.getElementById('nb-location-suggestions');
  var input = document.getElementById('nb-location-search-input');
  var clearBtn = document.getElementById('nb-clear-location-btn');

  var parts = nameText.split(',').map(s => s.trim());
  var cleanLabel = parts.slice(0, Math.min(2, parts.length)).join(', ');

  if (dropdown) dropdown.style.display = 'none';
  if (input) input.value = cleanLabel;
  if (clearBtn) clearBtn.style.display = 'inline-block';

  nbCalculateDrivingDistance(parseFloat(lat), parseFloat(lon), cleanLabel);
}

function nbFormatKmText(distKm) {
  if (distKm < 0.05) return '0.1';
  return distKm.toFixed(1);
}

function nbApplyLocationCalculation(distKm, placeName) {
  isLocationDetected = true;
  localStorage.setItem('nb_gps_detected', 'true');
  var badge = document.getElementById('nb-location-status-badge');
  var distStr = nbFormatKmText(distKm);

  if (distKm <= NB_CONFIG.zone1MaxKm) {
    currentDeliveryZone = ZONES.ZONE_0_5_KM;
    if (badge) {
      badge.style.display = 'block';
      badge.style.background = '#E8F5E9';
      badge.style.color = '#2E7D32';
      badge.style.borderColor = '#A5D6A7';
      badge.innerHTML = '🎯 Detected: <strong>' + (placeName || 'Your Location') + ' (~' + distStr + ' km)</strong> • ₹' + NB_CONFIG.zone1Fee + ' Delivery (Free > ₹' + NB_CONFIG.zone1Threshold + ')';
    }
  } else if (distKm <= NB_CONFIG.zone2MaxKm) {
    currentDeliveryZone = ZONES.ZONE_5_8_KM;
    if (badge) {
      badge.style.display = 'block';
      badge.style.background = '#FFF3E0';
      badge.style.color = '#E65100';
      badge.style.borderColor = '#FFE0B2';
      badge.innerHTML = '🎯 Detected: <strong>' + (placeName || 'Your Location') + ' (~' + distStr + ' km)</strong> • Extended ₹' + NB_CONFIG.zone2Fee + ' Delivery (Free > ₹' + NB_CONFIG.zone2Threshold + ')';
    }
  } else {
    currentDeliveryZone = ZONES.OUTSIDE_SERVICE_AREA;
    if (badge) {
      badge.style.display = 'block';
      badge.style.background = '#FFEBEE';
      badge.style.color = '#C62828';
      badge.style.borderColor = '#EF9A9A';
      badge.innerHTML = '⚠️ Detected: <strong>' + (placeName || 'Your Location') + ' (~' + distStr + ' km)</strong> • Outside direct delivery service area.';
    }
  }

  localStorage.setItem('nb_delivery_zone', currentDeliveryZone);
  nbRefreshCart();
}

function nbDetectLiveLocation() {
  var btn = document.getElementById('nb-use-location-btn');
  var clearBtn = document.getElementById('nb-clear-location-btn');

  if (!navigator.geolocation) {
    nbShowToast('Geolocation is not supported by your browser.');
    return;
  }

  if (btn) btn.textContent = '⌛ Locating...';

  navigator.geolocation.getCurrentPosition(
    function(position) {
      var userLat = position.coords.latitude;
      var userLng = position.coords.longitude;

      if (btn) btn.textContent = '🎯 Location Set';
      if (clearBtn) clearBtn.style.display = 'inline-block';

      if (googleGeocoder) {
        googleGeocoder.geocode({ location: { lat: userLat, lng: userLng } }, function(results, status) {
          var cleanName = 'Live GPS Position';
          if (status === 'OK' && results && results[0] && results[0].formatted_address) {
            var parts = results[0].formatted_address.split(',').map(s => s.trim());
            cleanName = parts.slice(0, Math.min(2, parts.length)).join(', ');
          }
          var input = document.getElementById('nb-location-search-input');
          if (input) input.value = cleanName;

          nbCalculateDrivingDistance(userLat, userLng, cleanName);
        });
      } else {
        var input = document.getElementById('nb-location-search-input');
        if (input) input.value = 'Live GPS Position';
        nbCalculateDrivingDistance(userLat, userLng, 'Live GPS Position');
      }

      localStorage.setItem('nb_user_lat', userLat);
      localStorage.setItem('nb_user_lng', userLng);
    },
    function(error) {
      if (btn) btn.textContent = '🎯 Use Live Location';
      nbShowToast('Location access was unavailable. Type your area in the search box.');
    },
    { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
  );
}

function nbClearLocation() {
  localStorage.removeItem('nb_user_lat');
  localStorage.removeItem('nb_user_lng');
  localStorage.removeItem('nb_gps_detected');
  localStorage.removeItem('nb_delivery_zone');
  
  isLocationDetected = false;
  currentDeliveryZone = ZONES.LOCATION_UNKNOWN;

  var input = document.getElementById('nb-location-search-input');
  var btn = document.getElementById('nb-use-location-btn');
  var clearBtn = document.getElementById('nb-clear-location-btn');
  var badge = document.getElementById('nb-location-status-badge');
  var dropdown = document.getElementById('nb-location-suggestions');

  if (input) input.value = '';
  if (btn) btn.textContent = '🎯 Use Live Location';
  if (clearBtn) clearBtn.style.display = 'none';
  if (badge) badge.style.display = 'none';
  if (dropdown) dropdown.style.display = 'none';

  nbRefreshCart();
}

function nbSaveInstructions() {
  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 'Order & Delivery Instructions': instructions },
      note: instructions ? ('ORDER & DELIVERY INSTRUCTIONS: ' + instructions) : ''
    })
  }).catch(function(e) {
    nbShowToast('Could not save instructions. Please check network.');
  });
}

function nbGoToCheckout() {
  if (NB_CONFIG.instantDeliveryEnabled === false) {
    nbShowToast('🔴 Instant Delivery is temporarily paused.');
    var offNotice = document.getElementById('nb-instant-disabled-cart-notice');
    if (offNotice) offNotice.scrollIntoView({ behavior: 'smooth' });
    return;
  }

  if (isLocationDetected && currentDeliveryZone === ZONES.OUTSIDE_SERVICE_AREA) {
    nbShowToast('Delivery is currently unavailable for your detected area.');
    return;
  }

  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';
  var input = document.getElementById('nb-location-search-input');
  var locText = input ? input.value.trim() : '';

  var phone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone') || '';
  var name  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name')  || '';
  var email = localStorage.getItem('gate_email') || localStorage.getItem('nb_email') || '';

  var cleanPhone = phone.replace(/\D/g, '').slice(-10);
  var targetUrl = typeof nbBuildCheckoutUrl === 'function' ? nbBuildCheckoutUrl(cleanPhone, name, email) : '/checkout';

  var noteText = 'WhatsApp/Delivery Phone: ' + (cleanPhone ? ('+91' + cleanPhone) : 'Not provided');
  if (name) noteText += ' | Name: ' + name;
  if (email) noteText += ' | Email: ' + email;
  if (instructions) noteText += ' | Instructions: ' + instructions;

  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 
        'Phone': cleanPhone ? ('+91' + cleanPhone) : '',
        'Customer Phone': cleanPhone ? ('+91' + cleanPhone) : '',
        'Mobile Number': cleanPhone ? ('+91' + cleanPhone) : '',
        'WhatsApp Number': cleanPhone ? ('+91' + cleanPhone) : '',
        'Customer Name': name,
        'Customer Email': email,
        'Email': email,
        'Instant Delivery Status': NB_CONFIG.instantDeliveryEnabled ? 'Available' : 'Paused',
        'Order & Delivery Instructions': instructions,
        'Delivery Location': locText,
        'Delivery Zone': currentDeliveryZone
      },
      note: noteText
    })
  }).then(function() {
    window.location.href = targetUrl;
  }).catch(function() {
    window.location.href = targetUrl;
  });
}

function nbUpdateCartCustomerCard() {
  var phone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone') || '';
  var name  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name')  || '';
  var email = localStorage.getItem('gate_email') || localStorage.getItem('nb_email') || '';

  var card = document.getElementById('nb-customer-contact-card');
  var phoneEl = document.getElementById('nb-cart-contact-phone');
  var nameEl = document.getElementById('nb-cart-contact-name');
  var nameRow = document.getElementById('nb-cart-contact-name-row');
  var emailEl = document.getElementById('nb-cart-contact-email');
  var emailRow = document.getElementById('nb-cart-contact-email-row');

  if (phone) {
    if (card) card.style.display = 'block';
    if (phoneEl) phoneEl.textContent = phone;
    if (name) {
      if (nameEl) nameEl.textContent = name;
      if (nameRow) nameRow.style.display = 'block';
    } else if (nameRow) {
      nameRow.style.display = 'none';
    }

    if (email) {
      if (emailEl) emailEl.textContent = email;
      if (emailRow) emailRow.style.display = 'block';
    } else if (emailRow) {
      emailRow.style.display = 'none';
    }
  } else if (card) {
    card.style.display = 'none';
  }
}

function nbEditCustomerDetails() {
  localStorage.removeItem('gate_phone');
  localStorage.removeItem('nb_phone');
  if (typeof nbShowAuthGate === 'function') {
    nbShowAuthGate('cart', null);
  }
}

function nbContinueOrdering() {
  nbCloseDrawer();
  if (window.innerWidth > 768) {
    window.location.href = '/collections/instant-delivery';
  }
}

function nbRenderCart(cart) {
  nbUpdateCartCustomerCard();
  var container = document.getElementById('nb-cart-items');
  var subtotalEl = document.getElementById('nb-subtotal-val');
  var deliveryEl = document.getElementById('nb-delivery-val');
  var grandTotalEl = document.getElementById('nb-grand-total-val');
  var btnTotalEl = document.getElementById('nb-btn-total-val');
  var btnTextEl = document.getElementById('nb-checkout-btn-text');
  var checkoutBtn = document.getElementById('nb-checkout-submit-btn');

  if (NB_CONFIG.instantDeliveryEnabled === false) {
    if (btnTextEl) btnTextEl.textContent = '📅 Switch to Scheduled / Pre-Order';
    if (checkoutBtn) {
      checkoutBtn.onclick = function() {
        window.location.href = NB_CONFIG.scheduledOrderingUrl;
      };
    }
  } else {
    if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';
    if (checkoutBtn) {
      checkoutBtn.onclick = function() {
        nbGoToCheckout();
      };
    }
  }
  var progressMsgEl = document.getElementById('nb-progress-msg');
  var progressFillEl = document.getElementById('nb-progress-fill');
  var itemsFdNotice = document.getElementById('nb-items-fd-notice');
  var itemsFdText = document.getElementById('nb-items-fd-text');
  var itemsFdFill = document.getElementById('nb-items-fd-fill');

  // UPDATE UPSELL BUTTON STATES BASED ON ACTUAL CART CONTENT (EXTRA RAITA ONLY)
  var hasRaitaInCart = false;
  if (cart && cart.items) {
    hasRaitaInCart = cart.items.some(function(item) {
      return item.product_title.toLowerCase().includes('raita');
    });
  }

  var raitaBtn = document.getElementById('nb-add-raita-btn');
  if (raitaBtn) {
    if (hasRaitaInCart) {
      raitaBtn.textContent = '✓ Added';
      raitaBtn.style.background = '#2E7D32';
    } else {
      raitaBtn.textContent = '+ Add';
      raitaBtn.style.background = '#C8922A';
    }
  }

  if (!cart || cart.item_count === 0) {
    container.innerHTML = [
      '<div class="nb-drawer__empty" style="text-align: center; padding: 30px 16px;">',
        '<div style="font-size: 2.8rem; margin-bottom: 8px;">🍛</div>',
        '<p style="color: #7A5C4A; font-weight: 600;">Your order is empty.<br>Add delicious Biryani to get started!</p>',
      '</div>'
    ].join('');

    subtotalEl.textContent = '₹0';
    deliveryEl.textContent = '₹0';
    grandTotalEl.textContent = '₹0';
    if (btnTotalEl) btnTotalEl.textContent = '₹0';
    if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';
    if (checkoutBtn) {
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add('disabled');
    }
    progressFillEl.style.width = '0%';
    progressMsgEl.innerHTML = 'Add items to unlock <strong>FREE DELIVERY</strong>';
    if (itemsFdNotice) itemsFdNotice.style.display = 'none';
    return;
  }

  var subtotalCents = cart.total_price;
  var subtotalRupees = Math.round(subtotalCents / 100);
  subtotalEl.textContent = '₹' + subtotalRupees;

  // DETERMINE ACTIVE FREE DELIVERY THRESHOLD (₹799 FOR ZONE 1 / UNKNOWN, ₹1299 FOR ZONE 2)
  var targetThreshold = (currentDeliveryZone === ZONES.ZONE_5_8_KM) ? NB_CONFIG.zone2Threshold : NB_CONFIG.zone1Threshold;

  if (itemsFdNotice && itemsFdText && itemsFdFill) {
    itemsFdNotice.style.display = 'block';
    if (subtotalRupees >= targetThreshold) {
      itemsFdText.innerHTML = '🎉 <strong style="color:#2E7D32;">You\'ve unlocked FREE Delivery!</strong>';
      itemsFdFill.style.width = '100%';
      itemsFdFill.style.background = '#2E7D32';
    } else {
      var neededAmount = targetThreshold - subtotalRupees;
      var fillPct = Math.min(100, Math.round((subtotalRupees / targetThreshold) * 100));
      itemsFdText.innerHTML = 'Add <strong>₹' + neededAmount + '</strong> more to get <strong style="color:#C8922A;">FREE Delivery</strong> (Free above ₹' + targetThreshold + ')';
      itemsFdFill.style.width = fillPct + '%';
      itemsFdFill.style.background = 'linear-gradient(90deg, #D49E35 0%, #C8922A 100%)';
    }
  }

  // DELIVERY CALCULATION: IF LOCATION NOT DETECTED -> DEFAULT DELIVERY IS ₹0
  var feeRupees = 0;

  if (!isLocationDetected) {
    feeRupees = 0;
    deliveryEl.textContent = '₹0';
    deliveryEl.style.color = '#2E7D32';
    progressFillEl.style.width = '0%';
    progressMsgEl.innerHTML = 'Search area or tap 🎯 <strong>Use Live Location</strong> to verify delivery fee';

    if (checkoutBtn) { checkoutBtn.disabled = false; checkoutBtn.classList.remove('disabled'); }
    if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';

  } else {
    // LOCATION DETECTED
    if (currentDeliveryZone === ZONES.ZONE_0_5_KM) {
      var thresholdRupees = NB_CONFIG.zone1Threshold;
      if (subtotalRupees >= thresholdRupees) {
        feeRupees = 0;
        deliveryEl.textContent = 'FREE 🎉';
        deliveryEl.style.color = '#25D366';
        progressFillEl.style.width = '100%';
        progressMsgEl.innerHTML = '🎉 You\'ve unlocked <strong>FREE DELIVERY</strong>!';
      } else {
        feeRupees = NB_CONFIG.zone1Fee;
        deliveryEl.textContent = '₹' + feeRupees;
        deliveryEl.style.color = '#C8922A';
        var needed = thresholdRupees - subtotalRupees;
        var pct = Math.min(100, Math.round((subtotalRupees / thresholdRupees) * 100));
        progressFillEl.style.width = pct + '%';
        progressMsgEl.innerHTML = '🚚 Add <strong>₹' + needed + '</strong> more for <strong>FREE DELIVERY</strong>';
      }

      if (checkoutBtn) { checkoutBtn.disabled = false; checkoutBtn.classList.remove('disabled'); }
      if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';

    } else if (currentDeliveryZone === ZONES.ZONE_5_8_KM) {
      var thresholdRupees2 = NB_CONFIG.zone2Threshold;
      if (subtotalRupees >= thresholdRupees2) {
        feeRupees = 0;
        deliveryEl.textContent = 'FREE 🎉';
        deliveryEl.style.color = '#25D366';
        progressFillEl.style.width = '100%';
        progressMsgEl.innerHTML = '🎉 You\'ve unlocked <strong>FREE DELIVERY</strong>!';
      } else {
        feeRupees = NB_CONFIG.zone2Fee;
        deliveryEl.textContent = '₹' + feeRupees;
        deliveryEl.style.color = '#C8922A';
        var needed2 = thresholdRupees2 - subtotalRupees;
        var pct2 = Math.min(100, Math.round((subtotalRupees / thresholdRupees2) * 100));
        progressFillEl.style.width = pct2 + '%';
        progressMsgEl.innerHTML = '🚚 Add <strong>₹' + needed2 + '</strong> more for <strong>FREE DELIVERY</strong>';
      }

      if (checkoutBtn) { checkoutBtn.disabled = false; checkoutBtn.classList.remove('disabled'); }
      if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';

    } else if (currentDeliveryZone === ZONES.OUTSIDE_SERVICE_AREA) {
      feeRupees = 0;
      deliveryEl.textContent = 'Unavailable';
      deliveryEl.style.color = '#C62828';
      progressFillEl.style.width = '0%';
      progressMsgEl.innerHTML = '⚠️ Delivery is currently unavailable for your area';

      if (checkoutBtn) { checkoutBtn.disabled = true; checkoutBtn.classList.add('disabled'); }
      if (btnTextEl) btnTextEl.textContent = 'Delivery Unavailable';
    }
  }

  var grandTotalRupees = subtotalRupees + feeRupees;
  grandTotalEl.textContent = '₹' + grandTotalRupees;

  if (btnTotalEl) {
    btnTotalEl.style.display = 'inline-block';
    btnTotalEl.textContent = '₹' + grandTotalRupees;
  }

  // PARTITION CART ITEMS: MAIN FOOD ITEMS FIRST, ADDONS AT THE VERY BOTTOM
  var indexedItems = cart.items.map(function(item, idx) {
    return { item: item, originalLineNum: idx + 1 };
  });

  indexedItems.sort(function(a, b) {
    var aTitle = a.item.product_title.toLowerCase();
    var bTitle = b.item.product_title.toLowerCase();
    var aIsAddon = aTitle.includes('raita') || aTitle.includes('coke') || aTitle.includes('drink');
    var bIsAddon = bTitle.includes('raita') || bTitle.includes('coke') || bTitle.includes('drink');

    if (aIsAddon && !bIsAddon) return 1;
    if (!aIsAddon && bIsAddon) return -1;
    return a.originalLineNum - b.originalLineNum;
  });

  // RENDER SORTED CART ITEMS
  container.innerHTML = indexedItems.map(function(entry) {
    var item = entry.item;
    var lineNum = entry.originalLineNum;
    var isBiryani = item.product_title.toLowerCase().includes('biryani') || (item.product_type && item.product_type.toLowerCase().includes('biryani'));
    var raitaHtml = isBiryani ? '<div class="nb-raita-tag"><span>✓</span> Raita included</div>' : '';

    return [
      '<div class="nb-cart-item" data-key="' + item.key + '">',
        '<img class="nb-cart-item__img" src="' + (item.image || '') + '" alt="' + item.product_title + '" onerror="this.style.display=\'none\'">',
        '<div class="nb-cart-item__info">',
          '<p class="nb-cart-item__name">' + item.product_title + '</p>',
          (item.variant_title && item.variant_title !== 'Default Title' ? '<p class="nb-cart-item__variant">' + item.variant_title + '</p>' : ''),
          raitaHtml,
          '<div class="nb-cart-item__bottom">',
            '<span class="nb-cart-item__price">' + nbFormatMoney(item.final_line_price) + '</span>',
            '<div class="nb-qty-control">',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity - 1) + ', ' + lineNum + ')" aria-label="Decrease quantity">−</button>',
              '<span class="nb-qty-num">' + item.quantity + '</span>',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity + 1) + ', ' + lineNum + ')" aria-label="Increase quantity">+</button>',
            '</div>',
          '</div>',
        '</div>',
      '</div>'
    ].join('');
  }).join('');
}

function nbRefreshCart() {
  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) { nbRenderCart(cart); })
    .catch(function(e) {
      nbShowToast('Unable to update cart. Please check your network connection.');
    });
}

function nbUpdateQty(key, qty, lineNum) {
  if (qty < 0) qty = 0;
  var payload = lineNum ? { line: lineNum, quantity: qty } : { id: key, quantity: qty };

  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.json(); })
  .then(function(cart) { nbRenderCart(cart); })
  .catch(function(e) {
    nbShowToast('Could not update quantity. Please try again.');
    nbRefreshCart();
  });
}

// MULTI-TIER ADD-ON LOOKUP (PREVENTS SILENT FAILS & REPEATED SEARCHES)
function nbAddUpsell(btn, handle, titleQuery, fallbackPriceCents) {
  btn.textContent = 'Adding...';

  function tryAddToCart(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function(item) {
      btn.textContent = '✓ Added';
      btn.style.background = '#2E7D32';
      nbRefreshCart();
    });
  }

  fetch('/products/' + handle + '.js')
    .then(function(r) { return r.json(); })
    .then(function(product) {
      if (product && product.variants && product.variants.length > 0) {
        return tryAddToCart(product.variants[0].id);
      }
      throw new Error('Handle not found');
    })
    .catch(function() {
      fetch('/search/suggest.json?q=' + encodeURIComponent(titleQuery || handle) + '&resources[type]=product')
        .then(function(r) { return r.json(); })
        .then(function(res) {
          var products = (res.resources && res.resources.results && res.resources.results.products) ? res.resources.results.products : [];
          if (products.length > 0) {
            return tryAddToCart(products[0].variants[0].id);
          }
          throw new Error('Suggest not found');
        })
        .catch(function() {
          fetch('/collections/all/products.json')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var prods = data.products || [];
              var matched = prods.find(function(p) { return p.title.toLowerCase().includes((titleQuery || handle).toLowerCase()); });
              if (matched && matched.variants && matched.variants.length > 0) {
                return tryAddToCart(matched.variants[0].id);
              }
              throw new Error('Product not found in catalog');
            })
            .catch(function() {
              btn.textContent = '+ Add';
              nbShowToast('Add-on product "' + titleQuery + '" not found. Please verify product handle in Shopify Admin.');
            });
        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
  var savedGps = localStorage.getItem('nb_gps_detected');
  if (savedGps === 'true') {
    isLocationDetected = true;
    var clearBtn = document.getElementById('nb-clear-location-btn');
    if (clearBtn) clearBtn.style.display = 'inline-block';
  }

  document.addEventListener('click', function(e) {
    var dropdown = document.getElementById('nb-location-suggestions');
    if (dropdown && !e.target.closest('.nb-search-input-wrap')) {
      dropdown.style.display = 'none';
    }
  });

  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (!form.classList.contains('nb-quick-form')) return;
    e.preventDefault();
    var id = form.querySelector('[name="id"]').value;
    if (!id) return;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(id), quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() { nbOpenDrawer(); })
    .catch(function() { window.location.href = '/cart'; });
  });

  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href="/cart"]');
    if (!link) return;
    if (link.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    nbOpenDrawer();
  });

  document.addEventListener('click', function(e) {
    var cartBtn = e.target.closest('[data-cart-toggle], .header__icon--cart, [aria-label="Cart"]');
    if (!cartBtn) return;
    if (cartBtn.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    e.stopPropagation();
    nbOpenDrawer();
  });
});
