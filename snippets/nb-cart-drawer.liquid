.nb-upsell-pill-info { display: flex; flex-direction: column; }
.nb-upsell-pill-name { font-size: 0.78rem; font-weight: 700; color: #2C1810; }
.nb-upsell-pill-price { font-size: 0.74rem; font-weight: 800; color: #C8922A; }
