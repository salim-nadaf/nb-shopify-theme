{% comment %} NIAMAT BIRYANI — Production-Grade Refined Cart Drawer {% endcomment %}

{% liquid
  assign is_instant_enabled = settings.nb_instant_delivery_enabled
  if shop.metafields.niamat.instant_delivery_enabled != blank
    if shop.metafields.niamat.instant_delivery_enabled == false or shop.metafields.niamat.instant_delivery_enabled == 'false'
      assign is_instant_enabled = false
    else
      assign is_instant_enabled = true
    endif
  endif
%}

<div id="nb-drawer-overlay" onclick="nbCloseDrawer()"></div>

<div id="nb-cart-drawer" role="dialog" aria-modal="true" aria-label="Your Order Cart">
  <!-- TOAST NOTIFICATION FOR ERRORS -->
  <div id="nb-cart-toast" class="nb-cart-toast" style="display:none;"></div>

  <!-- HEADER WITH LOGO & CLOSE BUTTON -->
  <div class="nb-drawer__header">
    <div class="nb-drawer__header-logo-wrap">
      <img src="https://cdn.shopify.com/s/files/1/0722/3410/6954/files/BP_by_Niamat-removebg-preview.png?v=1785663837"
           alt="Biryani Palace by Niamat"
           class="nb-drawer__logo">
    </div>
    <button class="nb-drawer__close" onclick="nbCloseDrawer()" aria-label="Close Cart">✕</button>
  </div>

  <!-- FREE DELIVERY PROGRESS BAR BANNER & ETA -->
  <div class="nb-drawer__delivery-progress" id="nb-delivery-progress-banner">
    <div class="nb-progress-text-wrap">
      <span class="nb-progress-icon">🚚</span>
      <span id="nb-progress-msg">Add items to unlock <strong>FREE DELIVERY</strong></span>
    </div>
    <div class="nb-progress-bar-bg">
      <div class="nb-progress-bar-fill" id="nb-progress-fill" style="width: 0%;"></div>
    </div>
    <div class="nb-eta-wrap" id="nb-eta-wrap">
      ⏱️ Estimated delivery: <strong>{{ settings.nb_eta_min | default: 45 }}–{{ settings.nb_eta_max | default: 60 }} min</strong>
    </div>
  </div>

  <!-- MAIN DRAWER BODY -->
  <div class="nb-drawer__body">
    {% unless is_instant_enabled %}
      <div id="nb-instant-disabled-cart-notice" class="nb-instant-disabled-cart-notice" style="margin: 12px 16px 4px; padding: 14px 16px; background: #FFEBEE; border: 1px solid #EF9A9A; border-left: 4px solid #C62828; border-radius: 12px; font-size: 0.85rem;">
        <div style="font-weight: 800; color: #C62828; margin-bottom: 4px;">🔴 Instant Delivery Currently Unavailable</div>
        <p style="color: #5C4033; margin: 0 0 10px; font-size: 0.82rem; line-height: 1.35;">
          {{ settings.nb_instant_delivery_off_msg | default: 'We are currently handling a high volume of orders. Instant Delivery will resume shortly.' }}
        </p>
        <a href="{{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' }}" class="nb-btn nb-btn--gold nb-btn--sm" style="display: block; text-align: center; text-decoration: none;">
          📅 Choose a Scheduled / Pre-Order
        </a>
      </div>
    {% endunless %}

    <!-- DYNAMIC FREE DELIVERY NOTICE BANNER JUST ABOVE ITEMS -->
    <div class="nb-drawer__items-fd-notice" id="nb-items-fd-notice">
      <div class="nb-fd-notice-content">
        <span class="nb-fd-notice-icon">🚚</span>
        <span id="nb-items-fd-text">Add <strong>₹799</strong> more to get <strong>FREE Delivery</strong></span>
      </div>
      <div class="nb-fd-notice-bar-bg">
        <div class="nb-fd-notice-bar-fill" id="nb-items-fd-fill" style="width: 0%;"></div>
      </div>
    </div>

    <!-- CART ITEMS CONTAINER -->
    <div id="nb-cart-items" class="nb-drawer__items"></div>

    <!-- COMPLETE YOUR ORDER (EXTRA RAITA, SHAMI KEBAB, GULAB JAMUN) -->
    <div class="nb-drawer__upsell-section">
      <div class="nb-upsell-header">
        <span>🥣</span>
        <h4>Complete your order</h4>
      </div>
      <div class="nb-upsell-grid">
        <!-- 1. Extra Raita -->
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Niamat Extra Raita</span>
            <span class="nb-upsell-pill-price">₹49</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-raita-btn" onclick="nbAddUpsell(this, 'extra-raita', 'Extra Raita', 4900)">+ Add</button>
        </div>

        <!-- 2. Chicken Shami Kebab -->
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Chicken Shami Kebab</span>
            <span class="nb-upsell-pill-price">₹69</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-kebab-btn" onclick="nbAddUpsell(this, 'shami-kebab', 'Chicken Shami Kebab', 6900)">+ Add</button>
        </div>

        <!-- 3. Gulab Jamun -->
        <div class="nb-upsell-pill-card">
          <div class="nb-upsell-pill-info">
            <span class="nb-upsell-pill-name">Gulab Jamun</span>
            <span class="nb-upsell-pill-price">₹99</span>
          </div>
          <button class="nb-upsell-pill-add" id="nb-add-jamun-btn" onclick="nbAddUpsell(this, 'gulab-jamun', 'Gulab Jamun', 9900)">+ Add</button>
        </div>
      </div>
    </div>

    <!-- INFORMATIONAL STORE DELIVERY POLICY CARD (POINTERS ONLY) -->
    <div class="nb-drawer__policy-card">
      <div class="nb-policy-header">
        <span>📜</span> <strong>Store Delivery Policy</strong>
      </div>
      <ul class="nb-policy-list">
        <li>🚚 <strong>0–5 km (Kalyan / Nearby)</strong>: ₹39 Delivery · <strong>FREE</strong> > ₹799</li>
        <li>🚀 <strong>5–8 km (Extended Zone)</strong>: ₹89 Delivery · <strong>FREE</strong> > ₹1,299</li>
        <li>⛔ <strong>> 8 km</strong>: Outside direct delivery radius</li>
      </ul>
    </div>


    <!-- PRE-FILLED CUSTOMER CONTACT DETAILS CARD (AUTO-POPULATED BEFORE ORDERING) -->
    <div class="nb-drawer__customer-card" id="nb-customer-contact-card" style="margin: 12px 16px; padding: 14px 16px; background: linear-gradient(135deg, #FFFDF7 0%, #FDF5E6 100%); border: 1px solid rgba(200, 146, 42, 0.28); border-left: 4px solid #C8922A; border-radius: 14px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <span style="font-weight: 800; font-size: 0.88rem; color: #2C1810;">📱 Verified Contact Details</span>
        <button type="button" onclick="nbEditCustomerDetails()" style="background: none; border: none; color: #C8922A; font-size: 0.8rem; font-weight: 700; cursor: pointer; text-decoration: underline;">✏️ Change</button>
      </div>
      <div style="font-size: 0.85rem; color: #5C4033; line-height: 1.4;">
        <div><strong>Phone:</strong> <span id="nb-cart-contact-phone">+919876543210</span></div>
        <div id="nb-cart-contact-name-row"><strong>Name:</strong> <span id="nb-cart-contact-name">Rahul</span></div>
        <div id="nb-cart-contact-email-row" style="display:none;"><strong>Email:</strong> <span id="nb-cart-contact-email"></span></div>
      </div>
    </div>

    <!-- ORDER & DELIVERY INSTRUCTIONS -->
    <div class="nb-drawer__instructions-box">
      <label for="nb-cooking-instructions">📝 Order & Delivery Instructions</label>
      <textarea id="nb-cooking-instructions"
                placeholder="Example: Less spicy, no green chilli, call on arrival..."
                rows="2"
                onchange="nbSaveInstructions()"></textarea>
      <p class="nb-instructions-hint">💡 Saved to your order for our kitchen & delivery team</p>
    </div>
  </div>

  <!-- DRAWER FOOTER WITH LIVE SUMMARY & CHECKOUT -->
  <div class="nb-drawer__footer">
    <div class="nb-summary-rows">
      <div class="nb-summary-row">
        <span>Subtotal</span>
        <span id="nb-subtotal-val">₹0</span>
      </div>
      <div class="nb-summary-row">
        <span>Delivery</span>
        <span id="nb-delivery-val" class="nb-delivery-highlight">₹0</span>
      </div>
      <div class="nb-summary-row nb-total-row">
        <span>TOTAL</span>
        <span id="nb-grand-total-val">₹0</span>
      </div>
    </div>

    <div class="nb-secure-badge">
      <span>🔒 100% Secure Checkout</span>
    </div>

    <button class="nb-drawer__checkout-btn" id="nb-checkout-submit-btn" onclick="nbGoToCheckout()">
      <span class="nb-checkout-btn-text" id="nb-checkout-btn-text">Proceed to Checkout</span>
      <span id="nb-btn-total-val" class="nb-checkout-btn-price">₹0</span>
    </button>

    <button class="nb-drawer__continue-btn" onclick="nbContinueOrdering()">
      ← Continue Ordering
    </button>
  </div>
</div>

<style>
/* ===== REFINED COMPACT CART DRAWER STYLES ===== */
#nb-drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(44,24,16,0.6);
  z-index: 99990;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
#nb-drawer-overlay.active { display: block; }

#nb-cart-drawer {
  position: fixed;
  top: 0; right: 0;
  width: 100%;
  max-width: 440px;
  height: 100%;
  background: #FFFAF4;
  z-index: 99991;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: -8px 0 36px rgba(44,24,16,0.22);
}
#nb-cart-drawer.active { transform: translateX(0); }

/* TOAST NOTIFICATION */
.nb-cart-toast {
  position: absolute;
  top: 60px; left: 16px; right: 16px;
  background: #C62828;
  color: #fff;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 700;
  text-align: center;
  z-index: 99999;
  box-shadow: 0 4px 14px rgba(0,0,0,0.2);
}

/* HEADER LOGO ONLY */
.nb-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: #2C1810;
  color: #FDF6EC;
  flex-shrink: 0;
  border-bottom: 2px solid #C8922A;
}
.nb-drawer__header-logo-wrap { display: flex; align-items: center; }
.nb-drawer__logo {
  height: 38px;
  width: auto;
  max-width: 150px;
  object-fit: contain;
}
.nb-drawer__close {
  background: none; border: none; color: #FDF6EC;
  font-size: 1.3rem; cursor: pointer; padding: 4px 8px;
  border-radius: 8px; transition: background 0.15s;
  min-width: 44px; min-height: 44px;
  display: flex; align-items: center; justify-content: center;
}
.nb-drawer__close:hover { background: rgba(255,255,255,0.12); }

/* FREE DELIVERY PROGRESS BANNER & ETA */
.nb-drawer__delivery-progress {
  background: linear-gradient(135deg, #FFFDF7 0%, #F8EED8 100%);
  border-bottom: 1px solid rgba(200,146,42,0.25);
  padding: 8px 16px;
  flex-shrink: 0;
}
.nb-progress-text-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: #2C1810;
  margin-bottom: 6px;
}
.nb-progress-icon { font-size: 1rem; }
.nb-progress-bar-bg {
  width: 100%;
  height: 6px;
  background: rgba(200,146,42,0.2);
  border-radius: 99px;
  overflow: hidden;
}
.nb-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C8922A 0%, #25D366 100%);
  border-radius: 99px;
  transition: width 0.4s ease;
}
.nb-eta-wrap {
  font-size: 0.76rem;
  color: #5C4033;
  margin-top: 4px;
}

/* DRAWER BODY */
.nb-drawer__body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* CART ITEMS */
.nb-drawer__items { display: flex; flex-direction: column; gap: 8px; }
.nb-cart-item {
  display: flex; gap: 10px; align-items: flex-start;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
  box-shadow: 0 2px 6px rgba(44,24,16,0.03);
}
.nb-cart-item__img {
  width: 56px; height: 56px;
  border-radius: 8px; object-fit: cover;
  flex-shrink: 0; background: #F5ECD7;
}
.nb-cart-item__info { flex: 1; min-width: 0; }
.nb-cart-item__name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 0.9rem; font-weight: 700;
  color: #2C1810; margin: 0 0 2px;
  line-height: 1.2;
}
.nb-cart-item__variant { font-size: 0.74rem; color: #7A5C4A; margin: 0 0 4px; }

/* RAITA INCLUDED DISPLAY ATTRIBUTE */
.nb-raita-tag {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: #E8F5E9;
  color: #2E7D32;
  border: 1px solid #A5D6A7;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 6px;
  margin-bottom: 6px;
}

.nb-cart-item__bottom {
  display: flex; align-items: center;
  justify-content: space-between; gap: 8px;
}
.nb-cart-item__price { font-size: 0.98rem; font-weight: 800; color: #C8922A; }
.nb-qty-control { display: flex; align-items: center; gap: 6px; }
.nb-qty-btn {
  width: 36px; height: 36px;
  min-width: 36px; min-height: 36px;
  border-radius: 50%;
  border: 1.5px solid #C8922A;
  background: #FDF6EC;
  color: #C8922A;
  font-size: 1.1rem; font-weight: 800;
  cursor: pointer; display: flex;
  align-items: center; justify-content: center;
  transition: all 0.15s;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.nb-qty-btn:hover, .nb-qty-btn:active { background: #C8922A; color: #fff; }
.nb-qty-num { font-size: 0.92rem; font-weight: 800; color: #2C1810; min-width: 20px; text-align: center; }

/* SYMMETRICAL UPSELL PILL CARDS */
.nb-drawer__upsell-section {
  background: #FFFDF7;
  border: 1px dashed rgba(200,146,42,0.35);
  border-radius: 12px;
  padding: 10px;
}
.nb-upsell-header {
  display: flex; align-items: center; gap: 6px; margin-bottom: 8px;
}
.nb-upsell-header h4 {
  margin: 0; font-family: 'Playfair Display', Georgia, serif;
  font-size: 0.88rem; font-weight: 700; color: #2C1810;
}
.nb-upsell-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}
.nb-upsell-pill-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 1px solid rgba(200,146,42,0.25);
  border-radius: 10px;
  padding: 8px 12px;
  min-height: 52px;
  box-sizing: border-box;
  gap: 8px;
}
.nb-upsell-pill-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  flex: 1;
  min-width: 0;
}
.nb-upsell-pill-name {
  font-size: 0.84rem;
  font-weight: 700;
  color: #2C1810;
  line-height: 1.2;
}
.nb-upsell-pill-price {
  font-size: 0.82rem;
  font-weight: 800;
  color: #C8922A;
}
.nb-upsell-pill-add {
  background: #C8922A;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 6px 12px;
  min-width: 72px;
  height: 34px;
  font-size: 0.76rem;
  font-weight: 800;
  cursor: pointer;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.nb-upsell-pill-add:hover { background: #A67520; }

/* STORE POLICY CARD (POINTERS ONLY) */
.nb-drawer__policy-card {
  background: #FFFDF7;
  border: 1px solid rgba(200,146,42,0.25);
  border-radius: 10px;
  padding: 8px 12px;
}
.nb-policy-header {
  font-size: 0.8rem;
  color: #2C1810;
  margin-bottom: 4px;
  display: flex; align-items: center; gap: 4px;
}
.nb-policy-list {
  margin: 0; padding-left: 16px;
  font-size: 0.74rem; color: #5C4033;
  line-height: 1.4;
}
.nb-policy-list li { margin-bottom: 2px; }


/* DYNAMIC FREE DELIVERY BANNER ABOVE CART ITEMS */
.nb-drawer__items-fd-notice {
  background: #FFFDF7;
  border: 1.5px solid rgba(200, 146, 42, 0.35);
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(44, 24, 16, 0.04);
}
.nb-fd-notice-content {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  color: #2C1810;
  margin-bottom: 6px;
  line-height: 1.3;
}
.nb-fd-notice-icon {
  font-size: 1.15rem;
  flex-shrink: 0;
}
.nb-fd-notice-bar-bg {
  width: 100%;
  height: 6px;
  background: rgba(200, 146, 42, 0.15);
  border-radius: 10px;
  overflow: hidden;
}
.nb-fd-notice-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #D49E35 0%, #C8922A 100%);
  border-radius: 10px;
  transition: width 0.3s ease;
}

/* COOKING INSTRUCTIONS BOX */
.nb-drawer__instructions-box {
  background: #fff;
  border: 1px solid rgba(200,146,42,0.2);
  border-radius: 12px;
  padding: 10px;
}
.nb-drawer__instructions-box label {
  display: block; font-size: 0.8rem;
  font-weight: 700; color: #2C1810; margin-bottom: 4px;
}
.nb-drawer__instructions-box textarea {
  width: 100%; border: 1px solid rgba(200,146,42,0.3);
  border-radius: 8px; padding: 8px 10px;
  font-size: 0.8rem; color: #2C1810;
  background: #FFFDF7; resize: none;
  font-family: inherit; box-sizing: border-box;
}
.nb-drawer__instructions-box textarea:focus {
  outline: none; border-color: #C8922A;
}
.nb-instructions-hint {
  margin: 3px 0 0; font-size: 0.7rem; color: #7A5C4A; font-style: italic;
}

/* FOOTER */
.nb-drawer__footer {
  padding: 10px 16px 16px;
  border-top: 2px solid rgba(200,146,42,0.25);
  background: #FFFAF4;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  position: relative;
  z-index: 1;
}

.nb-summary-rows { display: flex; flex-direction: column; gap: 4px; margin-bottom: 2px; }
.nb-summary-row {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.86rem; color: #5C4033;
}
.nb-summary-row.nb-total-row {
  font-size: 1.02rem; font-weight: 900; color: #2C1810;
  border-top: 1px solid rgba(200,146,42,0.2);
  padding-top: 6px; margin-top: 2px;
}
.nb-delivery-highlight { font-weight: 800; color: #C8922A; }

.nb-secure-badge {
  text-align: center; font-size: 0.74rem; color: #7A5C4A; font-weight: 600;
}

/* HIGH-CONTRAST PROCEED TO CHECKOUT BUTTON */
.nb-drawer__checkout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #C8922A 0%, #A67520 100%);
  color: #FFFFFF !important;
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 800; font-size: 1.05rem;
  padding: 14px 18px; border-radius: 12px;
  border: none; cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 4px 14px rgba(200,146,42,0.35);
  min-height: 50px;
  width: 100%;
  box-sizing: border-box;
}
.nb-drawer__checkout-btn.disabled,
.nb-drawer__checkout-btn:disabled {
  background: #A89F91 !important;
  box-shadow: none !important;
  opacity: 0.65;
  cursor: not-allowed !important;
}
.nb-checkout-btn-text {
  flex: 1;
  text-align: center;
  color: #FFFFFF !important;
  font-weight: 800;
}
.nb-checkout-btn-price {
  background: #FFFFFF !important;
  color: #2C1810 !important;
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 0.92rem;
  font-weight: 900;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.nb-drawer__continue-btn {
  display: block; width: 100%; background: transparent;
  border: 1.5px solid rgba(44,24,16,0.25); color: #2C1810;
  font-size: 0.82rem; font-weight: 600; padding: 8px;
  min-height: 40px;
  border-radius: 10px; cursor: pointer; transition: all 0.15s;
  text-align: center; box-sizing: border-box;
}
.nb-drawer__continue-btn:hover { border-color: #C8922A; color: #C8922A; }

/* MOBILE RESPONSIVE FIT (320px - 430px) */
@media (max-width: 768px) {
  #nb-cart-drawer { max-width: 100%; height: 100dvh; }
  .nb-drawer__footer { padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)) !important; }
}


</style>

<script>
// ===== SINGLE SOURCE OF TRUTH CONFIGURATION =====
{% liquid
  assign is_instant_enabled = settings.nb_instant_delivery_enabled
  if shop.metafields.niamat.instant_delivery_enabled != blank
    if shop.metafields.niamat.instant_delivery_enabled == false or shop.metafields.niamat.instant_delivery_enabled == 'false'
      assign is_instant_enabled = false
    else
      assign is_instant_enabled = true
    endif
  endif
%}

const NB_CONFIG = {
  instantDeliveryEnabled: {{ is_instant_enabled | json }},
  instantDeliveryStatusMsg: {{ settings.nb_instant_delivery_status_msg | default: 'Instant Delivery is available' | json }},
  instantDeliveryOffMsg: {{ settings.nb_instant_delivery_off_msg | default: 'Instant Delivery is temporarily unavailable due to high order volume.' | json }},
  scheduledOrderingUrl: {{ settings.nb_scheduled_ordering_url | default: '/pages/family-orders' | json }},
  zone1Threshold: parseInt("{{ settings.nb_zone1_free_threshold | default: 799 }}", 10) || 799,
  zone2Threshold: parseInt("{{ settings.nb_zone2_free_threshold | default: 1299 }}", 10) || 1299,
  etaMin: parseInt("{{ settings.nb_eta_min | default: 45 }}", 10) || 45,
  etaMax: parseInt("{{ settings.nb_eta_max | default: 60 }}", 10) || 60
};

function nbShowToast(msg, duration) {
  var toast = document.getElementById('nb-cart-toast');
  if (toast) {
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(function() {
      toast.style.display = 'none';
    }, duration || 4000);
  }
}

function nbOpenDrawer() {
  document.getElementById('nb-cart-drawer').classList.add('active');
  document.getElementById('nb-drawer-overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
  nbRefreshCart();
}

function nbCloseDrawer() {
  document.getElementById('nb-cart-drawer').classList.remove('active');
  document.getElementById('nb-drawer-overlay').classList.remove('active');
  document.body.style.overflow = '';
}

function nbFormatMoney(cents) {
  return '₹' + (cents / 100).toFixed(0);
}

function nbSaveInstructions() {
  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 'Order & Delivery Instructions': instructions },
      note: instructions ? ('ORDER & DELIVERY INSTRUCTIONS: ' + instructions) : ''
    })
  }).catch(function(e) {
    nbShowToast('Could not save instructions. Please check network.');
  });
}

function nbBuildCheckoutUrl(phone, name, email) {
  var rawDigits = (phone || '').trim().replace(/\D/g, '');
  var tenDigits = rawDigits.length >= 10 ? rawDigits.slice(-10) : rawDigits;
  var formattedWithPlus = tenDigits ? ('+91' + tenDigits) : '';

  var params = [];
  if (tenDigits) {
    params.push('checkout[shipping_address][phone]=' + encodeURIComponent(formattedWithPlus || tenDigits));
    params.push('checkout[shipping_address][country]=India');
    params.push('checkout[billing_address][phone]=' + encodeURIComponent(formattedWithPlus || tenDigits));
    params.push('checkout[contact][phone]=' + encodeURIComponent(formattedWithPlus || tenDigits));
    params.push('checkout[email_or_phone]=' + encodeURIComponent(formattedWithPlus || tenDigits));
    params.push('checkout[phone]=' + encodeURIComponent(formattedWithPlus || tenDigits));
    params.push('phone=' + encodeURIComponent(tenDigits));
  }

  if (email && email.includes('@')) {
    var cleanEmail = email.trim();
    params.push('checkout[email]=' + encodeURIComponent(cleanEmail));
    params.push('checkout[contact][email]=' + encodeURIComponent(cleanEmail));
    params.push('email=' + encodeURIComponent(cleanEmail));
  }

  if (name) {
    var nameParts = name.trim().split(/\s+/);
    var firstName = nameParts[0] || name;
    var lastName = nameParts.slice(1).join(' ') || 'Customer';
    params.push('checkout[shipping_address][first_name]=' + encodeURIComponent(firstName));
    params.push('checkout[shipping_address][last_name]=' + encodeURIComponent(lastName));
    params.push('checkout[billing_address][first_name]=' + encodeURIComponent(firstName));
    params.push('checkout[billing_address][last_name]=' + encodeURIComponent(lastName));
    params.push('checkout[name]=' + encodeURIComponent(name));
  }

  return params.length > 0 ? ('/checkout?' + params.join('&')) : '/checkout';
}

function nbGoToCheckout() {
  if (NB_CONFIG.instantDeliveryEnabled === false) {
    nbShowToast('🔴 Instant Delivery is temporarily paused.');
    var offNotice = document.getElementById('nb-instant-disabled-cart-notice');
    if (offNotice) offNotice.scrollIntoView({ behavior: 'smooth' });
    return;
  }

  var textarea = document.getElementById('nb-cooking-instructions');
  var instructions = textarea ? textarea.value.trim() : '';

  var phone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone') || '';
  var name  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name')  || '';
  var email = localStorage.getItem('gate_email') || localStorage.getItem('nb_email') || '';

  var cleanPhone = phone.replace(/\D/g, '').slice(-10);
  var targetUrl = nbBuildCheckoutUrl(cleanPhone, name, email);

  var noteText = 'WhatsApp/Delivery Phone: ' + (cleanPhone ? ('+91' + cleanPhone) : 'Not provided');
  if (name) noteText += ' | Name: ' + name;
  if (email) noteText += ' | Email: ' + email;
  if (instructions) noteText += ' | Instructions: ' + instructions;

  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: { 
        'Phone': cleanPhone ? ('+91' + cleanPhone) : '',
        'Customer Phone': cleanPhone ? ('+91' + cleanPhone) : '',
        'Mobile Number': cleanPhone ? ('+91' + cleanPhone) : '',
        'WhatsApp Number': cleanPhone ? ('+91' + cleanPhone) : '',
        'Customer Name': name,
        'Customer Email': email,
        'Email': email,
        'Instant Delivery Status': NB_CONFIG.instantDeliveryEnabled ? 'Available' : 'Paused',
        'Order & Delivery Instructions': instructions
      },
      note: noteText
    })
  }).then(function() {
    window.location.href = targetUrl;
  }).catch(function() {
    window.location.href = targetUrl;
  });
}

function nbUpdateCartCustomerCard() {
  var phone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone') || '';
  var name  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name')  || '';
  var email = localStorage.getItem('gate_email') || localStorage.getItem('nb_email') || '';

  var card = document.getElementById('nb-customer-contact-card');
  var phoneEl = document.getElementById('nb-cart-contact-phone');
  var nameEl = document.getElementById('nb-cart-contact-name');
  var nameRow = document.getElementById('nb-cart-contact-name-row');
  var emailEl = document.getElementById('nb-cart-contact-email');
  var emailRow = document.getElementById('nb-cart-contact-email-row');

  if (phone) {
    if (card) card.style.display = 'block';
    if (phoneEl) phoneEl.textContent = phone;
    if (name) {
      if (nameEl) nameEl.textContent = name;
      if (nameRow) nameRow.style.display = 'block';
    } else if (nameRow) {
      nameRow.style.display = 'none';
    }

    if (email) {
      if (emailEl) emailEl.textContent = email;
      if (emailRow) emailRow.style.display = 'block';
    } else if (emailRow) {
      emailRow.style.display = 'none';
    }
  } else if (card) {
    card.style.display = 'none';
  }
}

function nbEditCustomerDetails() {
  localStorage.removeItem('gate_phone');
  localStorage.removeItem('nb_phone');
  if (typeof nbShowAuthGate === 'function') {
    nbShowAuthGate('cart', null);
  }
}

function nbContinueOrdering() {
  nbCloseDrawer();
  if (window.innerWidth > 768) {
    window.location.href = '/collections/instant-delivery';
  }
}

function nbRenderCart(cart) {
  nbUpdateCartCustomerCard();
  var container = document.getElementById('nb-cart-items');
  var subtotalEl = document.getElementById('nb-subtotal-val');
  var deliveryEl = document.getElementById('nb-delivery-val');
  var grandTotalEl = document.getElementById('nb-grand-total-val');
  var btnTotalEl = document.getElementById('nb-btn-total-val');
  var btnTextEl = document.getElementById('nb-checkout-btn-text');
  var checkoutBtn = document.getElementById('nb-checkout-submit-btn');

  if (NB_CONFIG.instantDeliveryEnabled === false) {
    if (btnTextEl) btnTextEl.textContent = '📅 Switch to Scheduled / Pre-Order';
    if (checkoutBtn) {
      checkoutBtn.onclick = function() {
        window.location.href = NB_CONFIG.scheduledOrderingUrl;
      };
    }
  } else {
    if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';
    if (checkoutBtn) {
      checkoutBtn.onclick = function() {
        nbGoToCheckout();
      };
    }
  }
  var progressMsgEl = document.getElementById('nb-progress-msg');
  var progressFillEl = document.getElementById('nb-progress-fill');
  var itemsFdNotice = document.getElementById('nb-items-fd-notice');
  var itemsFdText = document.getElementById('nb-items-fd-text');
  var itemsFdFill = document.getElementById('nb-items-fd-fill');

  // UPDATE UPSELL BUTTON STATES BASED ON ACTUAL CART CONTENT (RAITA, SHAMI KEBAB, GULAB JAMUN)
  var raitaCount = 0;
  var kebabCount = 0;
  var jamunCount = 0;

  if (cart && cart.items) {
    cart.items.forEach(function(item) {
      var title = (item.product_title || '').toLowerCase();
      if (title.includes('extra raita') || title.includes('raita')) {
        raitaCount += item.quantity;
      } else if (title.includes('shami kebab') || title.includes('shami')) {
        kebabCount += item.quantity;
      } else if (title.includes('gulab jamun') || title.includes('jamun')) {
        jamunCount += item.quantity;
      }
    });
  }

  var raitaBtn = document.getElementById('nb-add-raita-btn');
  if (raitaBtn) {
    if (raitaCount > 0) {
      raitaBtn.textContent = '+ Add More (' + raitaCount + ')';
      raitaBtn.style.background = '#2E7D32';
    } else {
      raitaBtn.textContent = '+ Add';
      raitaBtn.style.background = '#C8922A';
    }
  }

  var kebabBtn = document.getElementById('nb-add-kebab-btn');
  if (kebabBtn) {
    if (kebabCount > 0) {
      kebabBtn.textContent = '+ Add More (' + kebabCount + ')';
      kebabBtn.style.background = '#2E7D32';
    } else {
      kebabBtn.textContent = '+ Add';
      kebabBtn.style.background = '#C8922A';
    }
  }

  var jamunBtn = document.getElementById('nb-add-jamun-btn');
  if (jamunBtn) {
    if (jamunCount > 0) {
      jamunBtn.textContent = '+ Add More (' + jamunCount + ')';
      jamunBtn.style.background = '#2E7D32';
    } else {
      jamunBtn.textContent = '+ Add';
      jamunBtn.style.background = '#C8922A';
    }
  }

  if (!cart || cart.item_count === 0) {
    container.innerHTML = [
      '<div class="nb-drawer__empty" style="text-align: center; padding: 30px 16px;">',
        '<div style="font-size: 2.8rem; margin-bottom: 8px;">🍛</div>',
        '<p style="color: #7A5C4A; font-weight: 600;">Your order is empty.<br>Add delicious Biryani to get started!</p>',
      '</div>'
    ].join('');

    subtotalEl.textContent = '₹0';
    deliveryEl.textContent = '₹0';
    grandTotalEl.textContent = '₹0';
    if (btnTotalEl) btnTotalEl.textContent = '₹0';
    if (btnTextEl) btnTextEl.textContent = 'Proceed to Checkout';
    if (checkoutBtn) {
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add('disabled');
    }
    progressFillEl.style.width = '0%';
    progressMsgEl.innerHTML = 'Add items to unlock <strong>FREE DELIVERY</strong>';
    if (itemsFdNotice) itemsFdNotice.style.display = 'none';
    return;
  }

  var subtotalCents = cart.total_price;
  var subtotalRupees = Math.round(subtotalCents / 100);
  subtotalEl.textContent = '₹' + subtotalRupees;

  // FREE DELIVERY THRESHOLD (₹799)
  var targetThreshold = NB_CONFIG.zone1Threshold || 799;

  if (itemsFdNotice && itemsFdText && itemsFdFill) {
    itemsFdNotice.style.display = 'block';
    if (subtotalRupees >= targetThreshold) {
      itemsFdText.innerHTML = '🎉 <strong style="color:#2E7D32;">You\'ve unlocked FREE Delivery!</strong>';
      itemsFdFill.style.width = '100%';
      itemsFdFill.style.background = '#2E7D32';
    } else {
      var neededAmount = targetThreshold - subtotalRupees;
      var fillPct = Math.min(100, Math.round((subtotalRupees / targetThreshold) * 100));
      itemsFdText.innerHTML = 'Add <strong>₹' + neededAmount + '</strong> more to get <strong style="color:#C8922A;">FREE Delivery</strong> (Free above ₹' + targetThreshold + ')';
      itemsFdFill.style.width = fillPct + '%';
      itemsFdFill.style.background = 'linear-gradient(90deg, #D49E35 0%, #C8922A 100%)';
    }
  }

  // DELIVERY STATUS IN CART SUMMARY
  if (subtotalRupees >= targetThreshold) {
    deliveryEl.textContent = 'FREE 🎉';
    deliveryEl.style.color = '#25D366';
    progressFillEl.style.width = '100%';
    progressMsgEl.innerHTML = '🎉 You\'ve unlocked <strong>FREE DELIVERY</strong>!';
  } else {
    var needed = targetThreshold - subtotalRupees;
    var pct = Math.min(100, Math.round((subtotalRupees / targetThreshold) * 100));
    deliveryEl.textContent = 'Calculated at checkout';
    deliveryEl.style.color = '#C8922A';
    progressFillEl.style.width = pct + '%';
    progressMsgEl.innerHTML = '🚚 Add <strong>₹' + needed + '</strong> more for <strong>FREE DELIVERY</strong> (above ₹' + targetThreshold + ')';
  }

  if (checkoutBtn) {
    checkoutBtn.disabled = false;
    checkoutBtn.classList.remove('disabled');
  }
  if (btnTextEl && NB_CONFIG.instantDeliveryEnabled !== false) {
    btnTextEl.textContent = 'Proceed to Checkout';
  }

  grandTotalEl.textContent = '₹' + subtotalRupees;
  if (btnTotalEl) {
    btnTotalEl.style.display = 'inline-block';
    btnTotalEl.textContent = '₹' + subtotalRupees;
  }

  // PARTITION CART ITEMS: MAIN FOOD ITEMS FIRST, ADDONS AT THE VERY BOTTOM
  var indexedItems = cart.items.map(function(item, idx) {
    return { item: item, originalLineNum: idx + 1 };
  });

  indexedItems.sort(function(a, b) {
    var aTitle = a.item.product_title.toLowerCase();
    var bTitle = b.item.product_title.toLowerCase();
    var aIsAddon = aTitle.includes('raita') || aTitle.includes('coke') || aTitle.includes('drink');
    var bIsAddon = bTitle.includes('raita') || bTitle.includes('coke') || bTitle.includes('drink');

    if (aIsAddon && !bIsAddon) return 1;
    if (!aIsAddon && bIsAddon) return -1;
    return a.originalLineNum - b.originalLineNum;
  });

  // RENDER SORTED CART ITEMS
  container.innerHTML = indexedItems.map(function(entry) {
    var item = entry.item;
    var isBiryani = item.product_title.toLowerCase().includes('biryani') || (item.product_type && item.product_type.toLowerCase().includes('biryani'));
    var raitaHtml = isBiryani ? '<div class="nb-raita-tag"><span>✓</span> Raita included</div>' : '';

    return [
      '<div class="nb-cart-item" data-key="' + item.key + '">',
        '<img class="nb-cart-item__img" src="' + (item.image || '') + '" alt="' + item.product_title + '" onerror="this.style.display=\'none\'">',
        '<div class="nb-cart-item__info">',
          '<p class="nb-cart-item__name">' + item.product_title + '</p>',
          (item.variant_title && item.variant_title !== 'Default Title' ? '<p class="nb-cart-item__variant">' + item.variant_title + '</p>' : ''),
          raitaHtml,
          '<div class="nb-cart-item__bottom">',
            '<span class="nb-cart-item__price">' + nbFormatMoney(item.final_line_price) + '</span>',
            '<div class="nb-qty-control">',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity - 1) + ')" aria-label="Decrease quantity">−</button>',
              '<span class="nb-qty-num">' + item.quantity + '</span>',
              '<button class="nb-qty-btn" onclick="nbUpdateQty(\'' + item.key + '\', ' + (item.quantity + 1) + ')" aria-label="Increase quantity">+</button>',
            '</div>',
          '</div>',
        '</div>',
      '</div>'
    ].join('');
  }).join('');
}

function nbRefreshCart() {
  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) { nbRenderCart(cart); })
    .catch(function(e) {
      nbShowToast('Unable to update cart. Please check your network connection.');
    });
}

function nbUpdateQty(key, qty) {
  if (qty < 0) qty = 0;
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: key, quantity: qty })
  })
  .then(function(r) { return r.json(); })
  .then(function(cart) { nbRenderCart(cart); })
  .catch(function(e) {
    nbShowToast('Could not update quantity. Please try again.');
    nbRefreshCart();
  });
}

// MULTI-TIER ADD-ON LOOKUP (PREVENTS SILENT FAILS & REPEATED SEARCHES)
function nbAddUpsell(btn, handle, titleQuery, fallbackPriceCents) {
  var originalText = btn.textContent;
  btn.textContent = 'Adding...';

  function tryAddToCart(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function(item) {
      btn.textContent = '✓ Added';
      btn.style.background = '#2E7D32';
      nbRefreshCart();
    });
  }

  fetch('/products/' + handle + '.js')
    .then(function(r) { return r.json(); })
    .then(function(product) {
      if (product && product.variants && product.variants.length > 0) {
        return tryAddToCart(product.variants[0].id);
      }
      throw new Error('Handle not found');
    })
    .catch(function() {
      fetch('/search/suggest.json?q=' + encodeURIComponent(titleQuery || handle) + '&resources[type]=product')
        .then(function(r) { return r.json(); })
        .then(function(res) {
          var products = (res.resources && res.resources.results && res.resources.results.products) ? res.resources.results.products : [];
          if (products.length > 0) {
            return tryAddToCart(products[0].variants[0].id);
          }
          throw new Error('Suggest not found');
        })
        .catch(function() {
          fetch('/collections/all/products.json')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var prods = data.products || [];
              var matched = prods.find(function(p) { return p.title.toLowerCase().includes((titleQuery || handle).toLowerCase()); });
              if (matched && matched.variants && matched.variants.length > 0) {
                return tryAddToCart(matched.variants[0].id);
              }
              throw new Error('Product not found in catalog');
            })
            .catch(function() {
              btn.textContent = '+ Add';
              nbShowToast('Add-on product "' + titleQuery + '" not found. Please verify product handle in Shopify Admin.');
            });
        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (!form.classList.contains('nb-quick-form')) return;
    e.preventDefault();
    var id = form.querySelector('[name="id"]').value;
    if (!id) return;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(id), quantity: 1 })
    })
    .then(function(r) { return r.json(); })
    .then(function() { nbOpenDrawer(); })
    .catch(function() { window.location.href = '/cart'; });
  });

  document.addEventListener('click', function(e) {
    var link = e.target.closest('a[href="/cart"]');
    if (!link) return;
    if (link.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    nbOpenDrawer();
  });

  document.addEventListener('click', function(e) {
    var cartBtn = e.target.closest('[data-cart-toggle], .header__icon--cart, [aria-label="Cart"]');
    if (!cartBtn) return;
    if (cartBtn.closest('#nb-cart-drawer')) return;
    e.preventDefault();
    e.stopPropagation();
    nbOpenDrawer();
  });
});
</script>
