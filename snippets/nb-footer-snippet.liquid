<style>
.nb-footer-wrapper {
  background: #1E100A !important;
  color: #FDF6EC !important;
  padding: 60px 16px 30px !important;
  border-top: 2px solid #C8922A !important;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

.nb-footer-container {
  max-width: 1060px;
  margin: 0 auto;
}

.nb-footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 36px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(200, 146, 42, 0.25);
}

@media (min-width: 768px) {
  .nb-footer-grid {
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
  }
}

.nb-footer-brand-title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 1.45rem !important;
  font-weight: 800 !important;
  color: #F3C669 !important;
  margin: 0 0 4px;
}

.nb-footer-tagline {
  display: inline-block;
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #C8922A !important;
  margin-bottom: 14px;
}

.nb-footer-about {
  font-size: 0.88rem;
  color: #D6C2B4 !important;
  line-height: 1.6;
  margin: 0;
}

.nb-footer-heading {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 1.15rem !important;
  font-weight: 700 !important;
  color: #F3C669 !important;
  margin: 0 0 16px;
  border-bottom: 1px solid rgba(200, 146, 42, 0.25);
  padding-bottom: 8px;
}

.nb-footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nb-footer-links a {
  color: #E2D5C5 !important;
  text-decoration: none;
  font-size: 0.88rem;
  transition: color 0.2s ease;
}

.nb-footer-links a:hover {
  color: #F3C669 !important;
}

.nb-footer-hours {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 0.88rem;
}

.nb-hours-days {
  font-weight: 700;
  color: #F3C669;
}

.nb-hours-time {
  color: #FFFFFF;
  font-size: 0.95rem;
  font-weight: 700;
}

.nb-hours-note {
  font-size: 0.8rem;
  color: #B59E8F;
  margin-top: 4px;
}

.nb-footer-social {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.nb-footer-social a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #E2D5C5 !important;
  text-decoration: none;
  font-size: 0.9rem;
  transition: color 0.2s ease;
}

.nb-footer-social a:hover {
  color: #F3C669 !important;
}

.nb-footer-bottom {
  padding-top: 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.nb-footer-copy {
  font-size: 0.85rem;
  font-weight: 700;
  color: #F3C669 !important;
}

.nb-footer-disclaimer {
  font-size: 0.82rem;
  color: #B59E8F !important;
}
</style>
