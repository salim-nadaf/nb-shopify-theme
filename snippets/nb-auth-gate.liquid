document.addEventListener('DOMContentLoaded', function() {

  // ── Global Order Now quick-form submit handler (CAPTURE PHASE + STOP PROPAGATION) ──
  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (!form || !form.classList || !form.classList.contains('nb-quick-form')) return;
    
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    if (form.dataset.submitting === 'true' || window.nbCartAdding) return false;
    form.dataset.submitting = 'true';
    window.nbCartAdding = true;

    var submitBtn = form.querySelector('button[type="submit"]');
    var origText = submitBtn ? submitBtn.textContent : 'Order Now';

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Adding...';
    }

    var suppressionReason = nbGetOrderGateSuppressionReason();

    if (suppressionReason) {
      // Suppressed! Add to cart directly without modal interruption
      if (typeof gtag === 'function') {
        gtag('event', 'order_gate_suppressed', { reason: suppressionReason, trigger_action: 'cart' });
      }
      var variantInput = form.querySelector('[name="id"]');
      var variantId = variantInput ? variantInput.value : null;
      if (!variantId) {
        form.dataset.submitting = 'false';
        window.nbCartAdding = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
        }
        return;
      }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
      })
      .then(function() {
        if (typeof nbOpenDrawer === 'function') nbOpenDrawer();
      })
      .catch(function(err) {
        console.error('Cart add error:', err);
      })
      .finally(function() {
        setTimeout(function() {
          form.dataset.submitting = 'false';
          window.nbCartAdding = false;
          if (submitBtn && !submitBtn.classList.contains('nb-btn--disabled')) {
            submitBtn.disabled = false;
            submitBtn.textContent = origText;
          }
        }, 800);
      });
    } else {
      // First time / not suppressed — unlock button and show auth gate
      setTimeout(function() {
        form.dataset.submitting = 'false';
        window.nbCartAdding = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
        }
      }, 400);
      nbShowAuthGate('cart', form);
    }
  }, true);

  // ── Pre-Order buttons handler ──
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('a[href="/pages/family-orders"], a[href="/pages/family-feast"]');
    if (!btn) return;
    var suppressionReason = nbGetOrderGateSuppressionReason();
    if (suppressionReason) return; // Suppressed — let user navigate through directly!

    e.preventDefault();
    nbShowAuthGate('preorder', null);
  });

  // ── Phone input — numbers only & Enter key ──
  var phoneInput = document.getElementById('nb-phone-input');
  if (phoneInput) {
    phoneInput.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '').slice(0, 10);
      this.style.outline = '';
    });
    phoneInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        nbAuthSubmitPhone();
      }
    });
  }

  // ── Name input — Enter key ──
  var nameInput = document.getElementById('nb-name-input');
  if (nameInput) {
    nameInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        nbAuthSaveName();
      }
    });
  }

  // ── Overlay click — close & dismiss ──
  var overlay = document.getElementById('nb-auth-overlay');
  if (overlay) {
    overlay.addEventListener('click', function() {
      var act = nbAuthPendingAction;
      var frm = nbAuthPendingForm;
      nbAuthPendingAction = null;
      nbAuthPendingForm   = null;
      nbAuthClose('outside_click');
      if (act || frm) {
        nbAuthExecutePendingAction(act, frm);
      }
    });
  }

  // ── Escape key — close & dismiss ──
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Esc') {
      var modal = document.getElementById('nb-auth-modal');
      if (modal && modal.classList.contains('active')) {
        var act = nbAuthPendingAction;
        var frm = nbAuthPendingForm;
        nbAuthPendingAction = null;
        nbAuthPendingForm   = null;
        nbAuthClose('escape_key');
        if (act || frm) {
          nbAuthExecutePendingAction(act, frm);
        }
      }
    }
  });

});
</script>
