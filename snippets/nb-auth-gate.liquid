        if (emailField) emailField.value = (customEmail && customEmail.indexOf('@') > 0) ? customEmail : 'biryanipalacekalyan@gmail.com';
        if (phoneField) phoneField.value = formattedPhone;
        if (bodyField) {
          bodyField.value = [
            '🔔 NEW ORDER GATE POPUP LEAD:',
            '• Name: ' + customerName,
            '• Phone: ' + formattedPhone,
            '• WhatsApp: https://wa.me/91' + cleanPhone10,
            '• Email: ' + emailVal,
            '• Opt-In: ' + (promoConsent ? 'YES' : 'NO'),
            '• Time: ' + timestamp
          ].join('\n');
        }

        var contactData = new FormData(contactForm);
        fetch(contactForm.action || '/contact#contact_form', {
          method: 'POST',
          body: contactData
        }).catch(function() {});
      }
    } catch(e) {}

  } catch(err) {
    console.error('Lead processing error:', err);
  }
}

async function nbAuthSaveName() {
  if (window.nbAuthSaving) return;

  var nameInput = document.getElementById('nb-name-input');
  var name = nameInput ? nameInput.value.trim() : '';
  if (name.length < 2) {
    if (nameInput) nameInput.style.outline = '2px solid #e53e3e';
    return;
  }
  if (nameInput) nameInput.style.outline = '';

  window.nbAuthSaving = true;

  var btn = document.getElementById('nb-lets-order-btn');
  if (btn) {
    btn.textContent = 'Saving...';
    btn.disabled = true;
  }

  var phone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone') || '';

  // 1. Save to localStorage
  localStorage.setItem('gate_phone', phone);
  localStorage.setItem('gate_name', name);
  localStorage.setItem('nb_phone', phone);
  localStorage.setItem('nb_name', name);

  var emailInput = document.getElementById('nb-email-input');
  var customEmail = emailInput ? emailInput.value.trim() : '';
  if (customEmail) {
    localStorage.setItem('gate_email', customEmail);
    localStorage.setItem('nb_email', customEmail);
  }

  var promoConsent = localStorage.getItem('nb_promo_consent') === 'yes';

  // 2. Record successful lead submission state (7-day cooldown)
  nbRecordOrderGateSubmission();

  // 3. Trigger Guaranteed Lead Saving & Email Dispatch
  nbSendLeadContactEmail(phone, name, customEmail, promoConsent);

  // 4. Save to Cart Attributes in Shopify
  try {
    var response = await fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: {
          'Customer Phone': phone,
          'Customer Name': name,
          'Phone': phone,
          'Mobile Number': phone,
          'WhatsApp Number': phone,
          'Customer Email': customEmail || '',
          'WhatsApp Consent': promoConsent ? 'yes' : 'no'
        }
      })
    });

    var cartData = await response.json();
    console.log('Cart attributes updated response:', cartData);
  } catch (err) {
    console.error('Error updating cart attributes:', err);
  }

  if (btn) {
    btn.textContent = "Let's Order! 🍛";
    btn.disabled = false;
  }
  
  var action = nbAuthPendingAction;
  var form   = nbAuthPendingForm;
  nbAuthPendingAction = null;
  nbAuthPendingForm   = null;

  nbAuthClose();
  window.nbAuthSaving = false;
  nbAuthExecutePendingAction(action, form);
}

