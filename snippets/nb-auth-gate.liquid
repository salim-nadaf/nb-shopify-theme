  width: 40px; height: 4px;
  background: rgba(44,24,16,0.15);
  border-radius: 2px;
  margin: 0 auto 16px;
}

/* Hide floating WhatsApp button when auth modal is open so it never obstructs Continue or Skip */
body:has(#nb-auth-modal.active) #nb-whatsapp-float,
body.nb-auth-open #nb-whatsapp-float,
body:has(#nb-auth-modal.active) .nb-whatsapp-float,
body.nb-auth-open .nb-whatsapp-float {
  display: none !important;
  opacity: 0 !important;
  pointer-events: none !important;
  visibility: hidden !important;
}
.nb-auth-step { display: none; }
.nb-auth-step.active { display: block; }

.nb-auth-header { text-align: center; margin-bottom: 24px; }
.nb-auth-logo { font-size: 2.5rem; display: block; margin-bottom: 10px; }
.nb-auth-header h2 { font-size: 1.3rem; font-weight: 800; color: #2C1810; margin: 0 0 6px; }
.nb-auth-header p { font-size: 0.85rem; color: #7A5C4A; margin: 0; line-height: 1.5; }

.nb-auth-body { margin-bottom: 20px; }

.nb-phone-input-wrap {
  display: flex !important;
  align-items: center !important;
  border: 2px solid rgba(200, 146, 42, 0.45) !important;
  border-radius: 14px !important;
  overflow: hidden !important;
  background: #FFFFFF !important;
