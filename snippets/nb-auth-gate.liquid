{% comment %} NIAMAT BIRYANI — Pre-Checkout Auth Gate + Shopify Forms Backend {% endcomment %}

<div id="nb-auth-overlay"></div>

<div id="nb-auth-modal" role="dialog" aria-modal="true">
  <button type="button" class="nb-auth-close-x" onclick="nbAuthClose('close_x_button')" aria-label="Close">✕</button>

  <!-- Step 1: Phone Entry -->
  <div id="nb-auth-step-1" class="nb-auth-step active">
    <div class="nb-auth-header">
      <span class="nb-auth-logo">🍛</span>
      <h2>Before we proceed</h2>
      <p>Enter your mobile number to receive order updates on WhatsApp</p>
    </div>
    <div class="nb-auth-body">
      <div class="nb-phone-input-wrap">
        <span class="nb-phone-prefix">🇮🇳 +91</span>
        <input type="tel" id="nb-phone-input" placeholder="WhatsApp Number"
               maxlength="10" pattern="[0-9]{10}" inputmode="numeric"
               autocomplete="tel-national">
      </div>
      <div class="nb-checkout-sync-notice">
        <span class="nb-sync-icon">📱</span>
        <span>Please use the same mobile number at checkout so you receive your order confirmation and tracking details.</span>
      </div>
      <p class="nb-auth-consent">
        📋 Your number will be used only for order confirmations and delivery updates. We will never share it with third parties.
      </p>
      <label class="nb-promo-consent">
        <input type="checkbox" id="nb-promo-checkbox">
        <span>Send me offers &amp; updates on WhatsApp</span>
      </label>
      <p class="nb-promo-note">Optional · You can unsubscribe anytime</p>
    </div>
    <div class="nb-auth-footer">
      <button class="nb-auth-btn nb-auth-btn--primary" onclick="nbAuthSubmitPhone()">Continue →</button>
      <button class="nb-auth-btn nb-auth-btn--ghost" onclick="nbAuthSkip()">Skip for now</button>
    </div>
  </div>

  <!-- Step 2: Name & Email Entry -->
  <div id="nb-auth-step-2" class="nb-auth-step">
    <div class="nb-auth-header">
      <span class="nb-auth-logo">👋</span>
      <h2>What should we call you?</h2>
      <p>So we can personalise your order experience</p>
    </div>
    <div class="nb-auth-body">
      <div style="margin-bottom: 12px;">
        <input type="text" id="nb-name-input" class="nb-name-input"
               placeholder="Your full name" autocomplete="name" inputmode="text" required>
      </div>
      <div>
        <input type="email" id="nb-email-input" class="nb-name-input"
               placeholder="Email address (Optional for official receipts)" autocomplete="email" inputmode="email">
      </div>
      <div class="nb-checkout-sync-notice" style="margin-top: 10px;">
        <span class="nb-sync-icon">💡</span>
        <span>Please use the same mobile number at checkout so you receive your order confirmation and tracking details.</span>
      </div>
      <p class="nb-auth-returning" id="nb-returning-msg" style="display:none; margin-top: 8px;">
        ✅ Welcome back! We found your previous orders.
      </p>
    </div>
    <div class="nb-auth-footer">
      <button class="nb-auth-btn nb-auth-btn--primary" id="nb-lets-order-btn" onclick="nbAuthSaveName()">
        Let's Order! 🍛
      </button>
    </div>
</div>

<!-- NATIVE SHOPIFY CUSTOMER CREATION & LEAD FORMS -->
{% form 'customer', id: 'nb-gate-liquid-customer-form', style: 'display: none !important;' %}
  <input type="hidden" name="customer[first_name]" id="nb-gate-cust-name" value="New Customer Lead">
  <input type="hidden" name="customer[email]" id="nb-gate-cust-email" value="">
  <input type="hidden" name="customer[note]" id="nb-gate-cust-note" value="">
  <input type="hidden" name="customer[tags]" value="order-gate, lead, whatsapp-optin">
  <input type="hidden" name="customer[accepts_marketing]" value="true">
{% endform %}

{% form 'contact', id: 'nb-gate-liquid-contact-form', style: 'display: none !important;' %}
  <input type="hidden" name="contact[name]" id="nb-gate-lead-name" value="New Customer Lead">
  <input type="hidden" name="contact[email]" id="nb-gate-lead-email" value="">
  <input type="hidden" name="contact[phone]" id="nb-gate-lead-phone" value="">
  <textarea name="contact[body]" id="nb-gate-lead-body" style="display: none;"></textarea>
{% endform %}

<style>
#nb-auth-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(44,24,16,0.65);
  z-index: 2147483645 !important;
  backdrop-filter: blur(4px);
}
#nb-auth-overlay.active { display: block; }

#nb-auth-modal {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 2147483646 !important;
  background: #FFFAF4;
  border-radius: 24px 24px 0 0;
  padding: 24px 20px calc(80px + env(safe-area-inset-bottom, 16px)) !important;
  max-width: 480px;
  margin: 0 auto;
  box-shadow: 0 -8px 40px rgba(44,24,16,0.25);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
  box-sizing: border-box !important;
  max-height: 90vh;
  overflow-y: auto;
}
#nb-auth-modal.active {
  display: block;
  transform: translateY(0);
}
