@media (min-width: 768px) {
  #nb-auth-modal {
    bottom: auto; top: 50%; left: 50%; right: auto;
    transform: translate(-50%, -50%);
    border-radius: 20px; width: 440px; max-width: 90vw;
    padding: 32px 28px !important;
  }
  #nb-auth-modal.active { transform: translate(-50%, -50%); }
  #nb-auth-modal::before { display: none; }
}
</style>

<script>
// ===== NB ORDER GATE FREQUENCY & STATE MANAGER =====
var NB_ORDER_GATE_STORAGE_KEY = 'nb_order_gate_state';
var NB_ORDER_GATE_SESSION_KEY = 'nb_order_gate_dismissed';

// Cooldown Durations (in milliseconds)
var NB_GATE_COOLDOWN = {
  DISMISSAL_HOURS: 24 * 60 * 60 * 1000,     // 24 Hours (86,400,000 ms)
  SUBMISSION_DAYS: 7 * 24 * 60 * 60 * 1000,   // 7 Days (604,800,000 ms)
  ORDER_DAYS: 30 * 24 * 60 * 60 * 1000       // 30 Days (2,592,000,000 ms)
};

function nbGetOrderGateState() {
  try {
    var raw = localStorage.getItem(NB_ORDER_GATE_STORAGE_KEY);
    if (raw) {
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed === 'object') return parsed;
    }
  } catch (e) {}
  return {
    dismissedAt: null,
    submittedAt: null,
    orderedAt: null
  };
}

function nbSaveOrderGateState(updates) {
  try {
    var currentState = nbGetOrderGateState();
    var newState = {
      dismissedAt: (updates && updates.dismissedAt !== undefined) ? updates.dismissedAt : currentState.dismissedAt,
      submittedAt: (updates && updates.submittedAt !== undefined) ? updates.submittedAt : currentState.submittedAt,
      orderedAt: (updates && updates.orderedAt !== undefined) ? updates.orderedAt : currentState.orderedAt
    };
    localStorage.setItem(NB_ORDER_GATE_STORAGE_KEY, JSON.stringify(newState));
  } catch (e) {}
}

function nbRecordOrderGateDismissal(source) {
  try {
    sessionStorage.setItem(NB_ORDER_GATE_SESSION_KEY, 'true');
    nbSaveOrderGateState({ dismissedAt: Date.now() });

    if (typeof gtag === 'function') {
      gtag('event', 'order_gate_dismiss', {
        dismiss_source: source || 'unknown'
      });
    }
  } catch (e) {}
}

function nbRecordOrderGateSubmission() {
  try {
    sessionStorage.setItem(NB_ORDER_GATE_SESSION_KEY, 'true');
    nbSaveOrderGateState({ submittedAt: Date.now() });

    if (typeof gtag === 'function') {
      gtag('event', 'order_gate_submitted');
    }
  } catch (e) {}
}

function nbRecordOrderGateCompletedOrder() {
  try {
    sessionStorage.setItem(NB_ORDER_GATE_SESSION_KEY, 'true');
    nbSaveOrderGateState({ orderedAt: Date.now() });
  } catch (e) {}
}

function nbGetOrderGateSuppressionReason() {
  try {
    var state = nbGetOrderGateState();
    var now = Date.now();

    // 1. Form submitted successfully within 7 days
    if (state.submittedAt && (now - state.submittedAt < NB_GATE_COOLDOWN.SUBMISSION_DAYS)) {
      return 'submitted_recently';
    }

    // 2. Completed order within 30 days
    if (state.orderedAt && (now - state.orderedAt < NB_GATE_COOLDOWN.ORDER_DAYS)) {
      return 'ordered_recently';
    }

    // 3. Dismissed during current browsing session
    if (sessionStorage.getItem(NB_ORDER_GATE_SESSION_KEY) === 'true') {
      return 'session_dismissed';
    }

    // 4. Dismissed within last 24 hours (cross-tab / returning visitor)
    if (state.dismissedAt && (now - state.dismissedAt < NB_GATE_COOLDOWN.DISMISSAL_HOURS)) {
      return 'cooldown_active';
    }

    // Legacy fallback: existing phone + name stored
    var legacyPhone = localStorage.getItem('gate_phone') || localStorage.getItem('nb_phone');
    var legacyName  = localStorage.getItem('gate_name')  || localStorage.getItem('nb_name');
    if (legacyPhone && legacyName) {
      return 'submitted_recently';
    }
  } catch (e) {}

  return null; // Not suppressed
}

var nbAuthPendingAction = null;
var nbAuthPendingForm   = null;

function nbAuthExecutePendingAction(action, form) {
  if (action === 'checkout') {
    window.location.href = '/checkout';
  } else if (action === 'cart' && form) {
    if (window.nbCartAdding) return;
    window.nbCartAdding = true;

    var variantInput = form.querySelector('[name="id"]');
    var variantId = variantInput ? variantInput.value : null;
    if (!variantId) {
      window.nbCartAdding = false;
      return;
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
    })
    .then(function() {
      if (typeof nbOpenDrawer === 'function') nbOpenDrawer();
      else window.location.href = '/cart';
    })
    .catch(function(err) {
      console.error('Cart add error:', err);
    })
    .finally(function() {
      setTimeout(function() { window.nbCartAdding = false; }, 800);
    });
  } else if (action === 'preorder') {
    window.location.href = '/pages/family-orders';
  } else if (typeof action === 'string' && action.startsWith('/')) {
    window.location.href = action;
  } else {
    if (typeof nbOpenDrawer === 'function') nbOpenDrawer();
  }
}

function nbShowAuthGate(action, form, force) {
  var suppressionReason = nbGetOrderGateSuppressionReason();

  if (suppressionReason && !force) {
    if (typeof gtag === 'function') {
      gtag('event', 'order_gate_suppressed', {
        reason: suppressionReason,
        trigger_action: action || 'direct'
      });
    }
    nbAuthExecutePendingAction(action, form);
    return;
  }

  nbAuthPendingAction = action || null;
  nbAuthPendingForm   = form   || null;

  // Reset to step 1
  document.querySelectorAll('.nb-auth-step').forEach(function(s) {
    s.classList.remove('active');
  });
  var step1 = document.getElementById('nb-auth-step-1');
  if (step1) step1.classList.add('active');

  var overlay = document.getElementById('nb-auth-overlay');
  var modal   = document.getElementById('nb-auth-modal');

  document.body.classList.add('nb-auth-open');
  if (overlay) overlay.classList.add('active');
  if (modal) {
    setTimeout(function() {
      modal.classList.add('active');
    }, 10);
  }
  document.body.style.overflow = 'hidden';

  if (typeof gtag === 'function') {
    gtag('event', 'order_gate_opened', {
      trigger_action: action || 'direct'
    });
  }

  setTimeout(function() {
    var p = document.getElementById('nb-phone-input');
    if (p) p.focus();
  }, 300);
}

var nbPendingLeadTimeout = null;

function nbAuthClose(dismissSource) {
  if (nbPendingLeadTimeout) {
    clearTimeout(nbPendingLeadTimeout);
    nbPendingLeadTimeout = null;
  }
  // If user closes modal after entering phone but didn't click save name
  var phone = localStorage.getItem('gate_phone');
  if (phone && !window.nbLeadEmailSent) {
    var promoConsent = localStorage.getItem('nb_promo_consent') === 'yes';
    var savedName = localStorage.getItem('gate_name') || '';
    var savedEmail = localStorage.getItem('gate_email') || '';
    nbSendLeadContactEmail(phone, savedName, savedEmail, promoConsent);
  }

  var overlay = document.getElementById('nb-auth-overlay');
  var modal   = document.getElementById('nb-auth-modal');
  if (overlay) overlay.classList.remove('active');
  if (modal) modal.classList.remove('active');
  document.body.classList.remove('nb-auth-open');
  document.body.style.overflow = '';

  if (dismissSource) {
    nbRecordOrderGateDismissal(dismissSource);
  }
}

function nbAuthSubmitPhone() {
  var phoneInput = document.getElementById('nb-phone-input');
  var phone = phoneInput ? phoneInput.value.replace(/\D/g, '') : '';
  if (phone.length !== 10) {
    if (phoneInput) {
      phoneInput.style.outline = '2px solid #e53e3e';
      phoneInput.placeholder = 'Enter 10-digit number';
    }
    return;
  }
  if (phoneInput) phoneInput.style.outline = '';

  var promoCheckbox = document.getElementById('nb-promo-checkbox');
  var promoConsent  = promoCheckbox ? promoCheckbox.checked : false;
  var formattedPhone = '+91' + phone;

  // Save to localStorage as gate_phone & nb_phone
  localStorage.setItem('gate_phone', formattedPhone);
  localStorage.setItem('nb_phone', formattedPhone);
  localStorage.setItem('nb_promo_consent', promoConsent ? 'yes' : 'no');
  localStorage.setItem('nb_consent_date', new Date().toISOString());

  // Reset sent flag for new phone entry
  window.nbLeadEmailSent = false;

  // Pre-fill name if returning customer
  var savedName = localStorage.getItem('gate_name') || localStorage.getItem('nb_name');
  var nameInput = document.getElementById('nb-name-input');
  var returningMsg = document.getElementById('nb-returning-msg');

  if (savedName && nameInput) {
    if (returningMsg) returningMsg.style.display = 'block';
    nameInput.value = savedName;
  } else if (returningMsg) {
    returningMsg.style.display = 'none';
  }

  document.querySelectorAll('.nb-auth-step').forEach(function(s) {
    s.classList.remove('active');
  });
  var step2 = document.getElementById('nb-auth-step-2');
  if (step2) step2.classList.add('active');
  setTimeout(function() {
    if (nameInput) nameInput.focus();
  }, 200);

  if (nbPendingLeadTimeout) clearTimeout(nbPendingLeadTimeout);
  nbPendingLeadTimeout = setTimeout(function() {
    if (!window.nbLeadEmailSent) {
      var currentPhone = localStorage.getItem('gate_phone') || formattedPhone;
      var currentName = localStorage.getItem('gate_name') || '';
      var currentEmail = localStorage.getItem('gate_email') || '';
      var currentPromo = localStorage.getItem('nb_promo_consent') === 'yes';
      nbSendLeadContactEmail(currentPhone, currentName, currentEmail, currentPromo);
    }
  }, 45000);
}

function nbSendLeadContactEmail(phone, name, customEmail, promoConsent) {
  if (window.nbLeadEmailSent) return;
  window.nbLeadEmailSent = true;
  if (nbPendingLeadTimeout) {
    clearTimeout(nbPendingLeadTimeout);
    nbPendingLeadTimeout = null;
  }
  try {
    var cleanPhone10 = (phone || '').replace(/\D/g,'').slice(-10);
    if (!cleanPhone10 || cleanPhone10.length < 10) return;

    var formattedPhone = '+91 ' + cleanPhone10;
    var customerName = name || 'New Visitor (+91 ' + cleanPhone10 + ')';
    var emailVal = (customEmail && customEmail.indexOf('@') > 0) ? customEmail : 'Not provided';
    var timestamp = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });

    // 1. SAVE NATIVE SHOPIFY CUSTOMER ENTRY
    try {
      var custForm = document.getElementById('nb-gate-liquid-customer-form');
      var custEmail = (customEmail && customEmail.indexOf('@') > 0) 
        ? customEmail 
        : ('lead_' + cleanPhone10 + '@niamatbiryani.com');

      if (custForm) {
        var nameInput = document.getElementById('nb-gate-cust-name');
        var emailInput = document.getElementById('nb-gate-cust-email');
        var noteInput = document.getElementById('nb-gate-cust-note');

        if (nameInput) nameInput.value = customerName;
        if (emailInput) emailInput.value = custEmail;
        if (noteInput) noteInput.value = 'Mobile: ' + formattedPhone + ' | WhatsApp Opt-in: ' + (promoConsent ? 'YES' : 'NO') + ' | Captured: ' + timestamp;

        var custData = new FormData(custForm);
        fetch(custForm.action || '/contact#contact_form', {
          method: 'POST',
          body: custData
        }).catch(function(e) {});
      }
    } catch(e) {}

    // 2. GUARANTEED INSTANT MERCHANT EMAIL NOTIFICATION
    try {
      var emailPayload = {
        _subject: '🔥 New Order Gate Lead: ' + customerName + ' (' + formattedPhone + ')',
        _replyto: (customEmail && customEmail.indexOf('@') > 0) ? customEmail : undefined,
        _captcha: 'false',
        _template: 'table',
        customer_name: customerName,
        mobile_number: formattedPhone,
        whatsapp_chat_link: 'https://wa.me/91' + cleanPhone10,
        email_address: emailVal,
        whatsapp_marketing_opt_in: promoConsent ? 'YES (Opted In)' : 'NO',
