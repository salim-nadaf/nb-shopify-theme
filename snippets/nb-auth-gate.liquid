  margin-top: 2px !important;
}
.nb-auth-btn--ghost:hover,
.nb-auth-btn--ghost:active {
  color: #2C1810 !important;
  background: rgba(200, 146, 42, 0.1) !important;
}

.nb-auth-close-x {
  position: absolute;
  top: 14px;
  right: 14px;
  background: transparent;
  border: none;
  font-size: 1.15rem;
  color: #7A5C4A;
  cursor: pointer;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
