{% comment %}
  NIAMAT BIRYANI — Automatic Item Badge Component for Menu Pages
{% endcomment %}

{% liquid
  assign title_lower = product_title | default: product.title | downcase
  assign item_badge = ''
  assign badge_class = ''
  assign badge_icon = ''

  if title_lower contains 'hyderabadi mutton dum'
    assign item_badge = 'Popular'
    assign badge_class = 'nb-tag--popular'
    assign badge_icon = '🔥'
  elsif title_lower contains 'gosht-e-dum mazedaar' or title_lower contains 'gosht e dum'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'hyderabadi murgh dum'
    assign item_badge = 'Popular'
    assign badge_class = 'nb-tag--popular'
    assign badge_icon = '🔥'
  elsif title_lower contains 'ustaadi murgh dum'
    assign item_badge = 'Classic'
    assign badge_class = 'nb-tag--chef'
    assign badge_icon = '👑'
  elsif title_lower contains 'zam-zam' or title_lower contains 'zam zam' or title_lower contains 'zamzam'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'nayaabi italiano'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'makhmali malai'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'banjara-e-biryani' or title_lower contains 'banjara'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'boneless lazzat-e-tikka' or title_lower contains 'boneless lazzat'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'lababdaar seekh'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'lazzat-e-tikka'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'alishaan'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'paneer-e-tikka' or title_lower contains 'paneer tikka'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'sabz tikka'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'nawabi veg dum'
    assign item_badge = 'Classic'
    assign badge_class = 'nb-tag--chef'
    assign badge_icon = '👑'
  elsif title_lower contains 'nazaakat pulao'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'dhan-e-shikori' or title_lower contains 'dhan e shikori'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'sabziyon ka zaika'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif product.tags contains 'Popular' or product.tags contains 'popular'
    assign item_badge = 'Popular'
    assign badge_class = 'nb-tag--popular'
    assign badge_icon = '🔥'
  elsif product.tags contains 'Must Try' or product.tags contains 'Must try' or product.tags contains 'must-try'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif product.tags contains 'Best Seller' or product.tags contains 'Best seller' or product.tags contains 'bestseller' or product.tags contains 'Bestseller'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif product.tags contains "Chef's Special" or product.tags contains "Chef's special" or product.tags contains 'Classic' or product.tags contains 'classic'
    assign item_badge = 'Classic'
    assign badge_class = 'nb-tag--chef'
    assign badge_icon = '👑'
  elsif product.tags contains 'New' or product.tags contains 'new'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  endif
%}

{% if item_badge != blank %}
  <span class="nb-item-badge {{ badge_class }}">
    {{ badge_icon }} {{ item_badge }}
  </span>
{% endif %}
