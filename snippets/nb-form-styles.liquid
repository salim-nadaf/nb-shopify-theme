{% comment %}
  NIAMAT BIRYANI — Master Shopify Forms & Pre-Order App Form Styling & Centering
{% endcomment %}

<style>
/* ===== SHOPIFY FORMS APP & PRE-ORDER FORM CENTER ALIGNMENT & BRAND STYLING ===== */

/* Form Wrapper Centering */
shopify-form,
.shopify-form,
[data-shopify-form],
.form-block,
.shopify-app-block,
div[class*="shopify-form"],
div[id*="shopify-form"],
div[class*="form-builder"],
div[class*="form-app"],
form[action*="contact"],
form[action*="form"] {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 auto 30px !important;
  text-align: center !important;
  max-width: 680px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* Card Outer Container */
shopify-form form,
.shopify-form form,
[data-shopify-form] form,
.form-block form,
div[class*="shopify-form"] form,
div[class*="form-builder"] form,
div[class*="form-app"] form,
.shopify-app-block-content {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
  border: 1px solid rgba(200, 146, 42, 0.32) !important;
  border-top: 5px solid #C8922A !important;
  border-radius: 24px !important;
  padding: 38px 32px !important;
  box-shadow: 0 16px 40px -10px rgba(44, 24, 16, 0.12), 0 4px 12px rgba(200, 146, 42, 0.08) !important;
  margin: 0 auto !important;
  width: 100% !important;
  box-sizing: border-box !important;
  text-align: left !important;
}

/* Headings & Subheadings */
shopify-form h1, shopify-form h2, shopify-form h3, shopify-form h4,
.shopify-form h1, .shopify-form h2, .shopify-form h3, .shopify-form h4,
[data-shopify-form] h1, [data-shopify-form] h2, [data-shopify-form] h3,
div[class*="shopify-form"] h1, div[class*="shopify-form"] h2, div[class*="shopify-form"] h3,
div[class*="form-builder"] h2, div[class*="form-builder"] h3 {
  font-family: 'Playfair Display', Georgia, serif !important;
  color: #2C1810 !important;
  text-align: center !important;
  font-weight: 800 !important;
  font-size: 1.8rem !important;
  margin-bottom: 12px !important;
  letter-spacing: -0.01em !important;
}

shopify-form p, .shopify-form p, [data-shopify-form] p,
div[class*="shopify-form"] p, div[class*="form-builder"] p {
  color: #7A5C4A !important;
  text-align: center !important;
  font-size: 0.94rem !important;
  line-height: 1.55 !important;
  margin-bottom: 24px !important;
  font-family: 'Inter', system-ui, sans-serif !important;
}

/* Labels */
shopify-form label, .shopify-form label, [data-shopify-form] label,
div[class*="shopify-form"] label, div[class*="form-builder"] label {
  color: #2C1810 !important;
  font-weight: 700 !important;
  font-size: 0.85rem !important;
  text-transform: uppercase !important;
  letter-spacing: 0.5px !important;
  margin-bottom: 8px !important;
  display: block !important;
  font-family: 'Inter', system-ui, sans-serif !important;
}

/* Inputs, Selects, Textareas */
shopify-form input, shopify-form select, shopify-form textarea,
.shopify-form input, .shopify-form select, .shopify-form textarea,
[data-shopify-form] input, [data-shopify-form] select, [data-shopify-form] textarea,
div[class*="shopify-form"] input, div[class*="shopify-form"] select, div[class*="shopify-form"] textarea,
div[class*="form-builder"] input, div[class*="form-builder"] select, div[class*="form-builder"] textarea {
  background-color: #FFFFFF !important;
  color: #2C1810 !important;
  border: 1px solid rgba(200, 146, 42, 0.35) !important;
  border-radius: 12px !important;
  padding: 14px 18px !important;
  font-family: 'Inter', system-ui, sans-serif !important;
  font-size: 0.95rem !important;
  transition: all 0.25s ease !important;
  outline: none !important;
  box-shadow: inset 0 1px 3px rgba(0,0,0,0.02) !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

shopify-form input:focus, shopify-form select:focus, shopify-form textarea:focus,
.shopify-form input:focus, .shopify-form select:focus, .shopify-form textarea:focus,
div[class*="shopify-form"] input:focus, div[class*="form-builder"] input:focus {
  border-color: #C8922A !important;
  box-shadow: 0 0 0 3px rgba(200, 146, 42, 0.22) !important;
  background-color: #FFFDF9 !important;
}

/* Submit Buttons */
shopify-form button[type="submit"], shopify-form input[type="submit"],
.shopify-form button[type="submit"], .shopify-form input[type="submit"],
[data-shopify-form] button[type="submit"], [data-shopify-form] input[type="submit"],
div[class*="shopify-form"] button, div[class*="shopify-form"] input[type="submit"],
div[class*="form-builder"] button, div[class*="form-builder"] input[type="submit"],
div[class*="form-app"] button {
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: 700 !important;
  font-size: 1rem !important;
  padding: 16px 40px !important;
  border-radius: 12px !important;
  border: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 20px rgba(200,146,42,0.35), inset 0 1px 0 rgba(255,255,255,0.3) !important;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
  margin: 20px auto 0 !important;
  display: block !important;
  width: fit-content !important;
  min-width: 220px !important;
  text-align: center !important;
}

shopify-form button[type="submit"]:hover,
.shopify-form button[type="submit"]:hover,
div[class*="shopify-form"] button:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 10px 25px rgba(200,146,42,0.45) !important;
}

@media (max-width: 767px) {
  shopify-form form, .shopify-form form, [data-shopify-form] form, div[class*="shopify-form"] form {
    padding: 28px 20px !important;
  }
}
</style>

<script>
  // Dynamic Shadow DOM & App Form Styler
  (function nbStyleShopifyForms() {
    function applyStylesToShadow(shadowRoot) {
      if (!shadowRoot) return;
      let styleEl = shadowRoot.querySelector('#nb-form-style');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'nb-form-style';
        styleEl.textContent = `
          form, .form-container, .shopify-form-wrapper {
            background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
            border: 1px solid rgba(200, 146, 42, 0.32) !important;
            border-top: 5px solid #C8922A !important;
            border-radius: 24px !important;
            padding: 34px 28px !important;
            box-shadow: 0 16px 40px -10px rgba(44, 24, 16, 0.12) !important;
            margin: 0 auto !important;
            max-width: 680px !important;
            width: 100% !important;
          }
          h1, h2, h3, .heading { font-family: 'Playfair Display', Georgia, serif !important; color: #2C1810 !important; text-align: center !important; }
          p, span, label { font-family: 'Inter', system-ui, sans-serif !important; }
          input, select, textarea {
            background-color: #FFFFFF !important;
            border: 1px solid rgba(200, 146, 42, 0.35) !important;
            border-radius: 12px !important;
            padding: 14px 16px !important;
            color: #2C1810 !important;
          }
          button[type="submit"], input[type="submit"], .submit-button {
            background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            border-radius: 12px !important;
            border: none !important;
            box-shadow: 0 6px 20px rgba(200,146,42,0.35) !important;
            padding: 14px 32px !important;
            margin: 16px auto 0 !important;
            display: block !important;
          }
        `;
        shadowRoot.appendChild(styleEl);
      }
    }

    function checkAndStyleForms() {
      const formHosts = document.querySelectorAll('shopify-form, [data-shopify-form], div[class*="shopify-form"]');
      formHosts.forEach(host => {
        if (host.shadowRoot) {
          applyStylesToShadow(host.shadowRoot);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAndStyleForms);
    } else {
      checkAndStyleForms();
    }
    setInterval(checkAndStyleForms, 1500);
  })();
</script>
