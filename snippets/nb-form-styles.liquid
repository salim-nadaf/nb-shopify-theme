<script>
  // Dynamic Shadow DOM & App Form Styler & Centering Engine
  (function nbStyleShopifyForms() {
    function applyStylesToShadow(shadowRoot) {
      if (!shadowRoot) return;
      let styleEl = shadowRoot.querySelector('#nb-form-style');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'nb-form-style';
        styleEl.textContent = `
          :host {
            display: block !important;
            margin: 0 auto !important;
            max-width: 680px !important;
            width: 100% !important;
            text-align: center !important;
          }
          form, .form-container, .shopify-form-wrapper, div[class*="form"] {
            background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
            border: 1px solid rgba(200, 146, 42, 0.32) !important;
            border-top: 5px solid #C8922A !important;
            border-radius: 24px !important;
            padding: 34px 28px !important;
            box-shadow: 0 16px 40px -10px rgba(44, 24, 16, 0.12) !important;
            margin: 0 auto !important;
            max-width: 680px !important;
            width: 100% !important;
            box-sizing: border-box !important;
          }
          h1, h2, h3, .heading { font-family: 'Playfair Display', Georgia, serif !important; color: #2C1810 !important; text-align: center !important; }
          p, span, label { font-family: 'Inter', system-ui, sans-serif !important; }
          input, select, textarea {
            background-color: #FFFFFF !important;
            border: 1px solid rgba(200, 146, 42, 0.35) !important;
            border-radius: 12px !important;
            padding: 14px 16px !important;
            color: #2C1810 !important;
            font-family: 'Inter', system-ui, sans-serif !important;
            width: 100% !important;
            box-sizing: border-box !important;
          }
          button[type="submit"], input[type="submit"], .submit-button {
            background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
            color: #FFFFFF !important;
            font-weight: 700 !important;
            border-radius: 12px !important;
            border: none !important;
            box-shadow: 0 6px 20px rgba(200,146,42,0.35) !important;
            padding: 14px 32px !important;
            margin: 16px auto 0 !important;
            display: block !important;
            min-width: 200px !important;
          }
        `;
        shadowRoot.appendChild(styleEl);
      }
    }

    function checkAndStyleForms() {
      const formHosts = document.querySelectorAll('shopify-form, [data-shopify-form], div[class*="shopify-form"], iframe[src*="form"]');
      formHosts.forEach(host => {
        host.style.marginLeft = 'auto';
        host.style.marginRight = 'auto';
        host.style.maxWidth = '680px';
        host.style.width = '100%';
        if (host.shadowRoot) {
          applyStylesToShadow(host.shadowRoot);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAndStyleForms);
    } else {
      checkAndStyleForms();
    }
    setInterval(checkAndStyleForms, 1000);
  })();
</script>
