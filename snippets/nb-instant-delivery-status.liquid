{% comment %}
  NIAMAT BIRYANI — Instant Delivery Status Indicator Badge
{% endcomment %}

{% render 'nb-instant-schedule' %}

{% if is_instant_enabled %}
  <div class="nb-status-pill nb-status-pill--on" id="nb-status-indicator">
    <span class="nb-status-dot">🟢</span>
    <span class="nb-status-text">{{ settings.nb_instant_delivery_status_msg | default: 'Instant Delivery Available' }}</span>
  </div>
{% else %}
  <div class="nb-status-pill nb-status-pill--off" id="nb-status-indicator">
    <span class="nb-status-dot">🔴</span>
    <span class="nb-status-text">Instant Delivery Temporarily Unavailable</span>
  </div>
{% endif %}

<style>
.nb-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.2px;
  transition: all 0.2s ease;
}
.nb-status-pill--on {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1px solid #A5D6A7;
}
.nb-status-pill--off {
  background: #FFEBEE;
  color: #C62828;
  border: 1px solid #EF9A9A;
}
.nb-status-dot {
  font-size: 0.75rem;
  line-height: 1;
}
</style>
