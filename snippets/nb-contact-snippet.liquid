{% comment %}
  NIAMAT BIRYANI — Ultra-Premium Contact Us Snippet
{% endcomment %}

<div class="nb-contact-page-section">
  <div class="nb-container">

    <!-- HEADER -->
    <div class="nb-section-header">
      <span class="nb-tag-badge">GET IN TOUCH</span>
      <h2>We'd Love to Hear From You</h2>
      <p class="nb-contact-subheading">Have questions about pre-orders, family handis, or catering? Reach out to us below.</p>
    </div>

    <!-- CONTACT INFO CARDS GRID -->
    <div class="nb-contact-cards-grid">

      <!-- CARD 1: LOCATION -->
      <div class="nb-contact-card">
        <div class="nb-contact-icon">📍</div>
        <h3>Delivery Only Kitchen</h3>
        <p>Delivery Only Kitchen, Kalyan-West, Maharashtra 421301</p>
        <span class="nb-contact-badge">Delivery Only Kitchen</span>
      </div>

      <!-- CARD 2: PRE-ORDERS & CATERING -->
      <div class="nb-contact-card">
        <div class="nb-contact-icon">🍲</div>
        <h3>Pre-Orders & Catering</h3>
        <p>Minimum pre-order quantity starts from 1 Kg for Dum Biryani & 12 pcs for Kebabs.</p>
        <span class="nb-contact-badge">7 Kg & 9 Kg Bulk Orders</span>
      </div>

      <!-- CARD 3: DISPATCH HOURS -->
      <div class="nb-contact-card">
        <div class="nb-contact-icon">⏰</div>
        <h3>Kitchen Timings</h3>
        <p>Lunch: 12:00 PM – 3:00 PM<br>Dinner: 6:00 PM – 9:00 PM</p>
        <span class="nb-contact-badge">Free Delivery in Kalyan > ₹799</span>
      </div>

    </div>

    <!-- CONTACT FORM CONTAINER -->
    <div class="nb-contact-form-card">
      <div class="nb-form-header" style="margin-bottom: 20px;">
        <h3>Send Us a Message</h3>
        <p>Fill out the form below and our team will get back to you promptly.</p>
      </div>

      <!-- SHOPIFY FORMS APP EMBED SUPPORT (ONLY SHOWS IF ACTIVE) -->
      {% if page.content != blank %}
        <div class="nb-shopify-forms-app-wrapper" style="margin-bottom: 16px;">
          <div class="page-content-forms">{{ page.content }}</div>
        </div>
      {% endif %}

      {% form 'contact', class: 'nb-contact-form-inner' %}
        {% if form.posted_successfully? %}
          <div class="nb-form-success">
            Thank you! Your message has been sent successfully. We will reach out to you shortly.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="nb-form-error">
            Please check your input and try submitting again.
          </div>
        {% endif %}

        <div class="nb-form-row">
          <div class="nb-form-group">
            <label for="ContactFormName">Your Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" placeholder="Enter your full name" required class="nb-input">
          </div>
          <div class="nb-form-group">
            <label for="ContactFormEmail">Email Address</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="name@example.com" required class="nb-input">
          </div>
        </div>

        <div class="nb-form-row">
          <div class="nb-form-group">
            <label for="ContactFormPhone">WhatsApp Number</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="WhatsApp Number" class="nb-input">
          </div>
          <div class="nb-form-group">
            <label for="ContactFormInquiry">Inquiry Type</label>
            <select id="ContactFormInquiry" name="contact[Inquiry Type]" class="nb-input nb-select">
              <option value="General Question">General Question</option>
              <option value="Instant Delivery Inquiry">Instant Delivery Inquiry</option>
              <option value="Family Pre-Order (1-10 Kg)">Family Pre-Order (1-10 Kg)</option>
              <option value="Event Catering (40-50+ People)">Event Catering (40-50+ People)</option>
            </select>
          </div>
        </div>

        <div class="nb-form-group nb-w-full">
          <label for="ContactFormMessage">Your Message</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" placeholder="Tell us how we can help you..." required class="nb-input nb-textarea"></textarea>
        </div>

        <div class="nb-form-submit-wrap">
          <button type="submit" class="nb-btn-gold nb-btn-lg">
            Send Message
          </button>
        </div>
      {% endform %}
    </div>

  </div>
</div>

<style>
.nb-contact-page-section {
  background-color: #FFFAF4 !important;
  color: #2C1810 !important;
  padding: 52px 0 !important;
  width: 100%;
}
.nb-container { max-width: 940px; margin: 0 auto; padding: 0 20px; }

.nb-section-header { text-align: center; margin-bottom: 36px; }
.nb-tag-badge { display: inline-block; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #C8922A !important; margin-bottom: 8px; }
.nb-section-header h2 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 2.3rem; font-weight: 800; color: #2C1810 !important; margin: 0 0 8px; letter-spacing: -0.01em; }
.nb-contact-subheading { font-size: 1rem; color: #7A5C4A !important; margin: 0; max-width: 600px; margin: 0 auto; }

/* CONTACT INFO CARDS GRID */
.nb-contact-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-bottom: 40px;
}

.nb-contact-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
  border: 1px solid rgba(200, 146, 42, 0.25) !important;
  border-radius: 20px;
  padding: 26px 20px;
  text-align: center;
  box-shadow: 0 10px 30px -12px rgba(44, 24, 16, 0.08) !important;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  position: relative;
  overflow: hidden;
}
.nb-contact-card:hover {
  transform: translateY(-5px);
  border-color: rgba(200, 146, 42, 0.48) !important;
  box-shadow: 0 18px 40px -10px rgba(200, 146, 42, 0.22) !important;
}

.nb-contact-icon { font-size: 2.4rem; margin-bottom: 12px; filter: drop-shadow(0 4px 10px rgba(200, 146, 42, 0.22)); }
.nb-contact-card h3 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 1.15rem; font-weight: 800; color: #2C1810 !important; margin: 0 0 8px; }
.nb-contact-card p { font-size: 0.88rem; color: #7A5C4A !important; line-height: 1.5; margin: 0 0 14px; }
.nb-contact-badge { display: inline-block; font-size: 0.76rem; font-weight: 700; background: rgba(200, 146, 42, 0.12); color: #C8922A !important; padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(200, 146, 42, 0.3); }

/* FORM CARD */
.nb-contact-form-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
  border: 1px solid rgba(200, 146, 42, 0.28) !important;
  border-top: 4px solid #C8922A !important;
  border-radius: 22px;
  padding: 36px 28px;
  box-shadow: 0 12px 35px -10px rgba(44, 24, 16, 0.09) !important;
}
.nb-form-header { text-align: center; margin-bottom: 28px; }
.nb-form-header h3 { font-family: 'Playfair Display', Georgia, serif !important; font-size: 1.6rem; font-weight: 800; color: #2C1810 !important; margin: 0 0 6px; }
.nb-form-header p { font-size: 0.9rem; color: #7A5C4A !important; margin: 0; }

.nb-contact-form-inner { display: flex; flex-direction: column; gap: 20px; }
.nb-form-row { display: grid; grid-template-columns: 1fr; gap: 20px; }
.nb-form-group { display: flex; flex-direction: column; gap: 6px; }
.nb-form-group label { font-size: 0.84rem; font-weight: 700; color: #2C1810 !important; text-transform: uppercase; letter-spacing: 0.5px; }

.nb-input {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid rgba(200, 146, 42, 0.3) !important;
  border-radius: 12px;
  background-color: #FFFFFF !important;
  color: #2C1810 !important;
  font-size: 0.94rem;
  outline: none;
  transition: all 0.25s ease;
  box-sizing: border-box;
}
.nb-input:focus {
  border-color: #C8922A !important;
  box-shadow: 0 0 0 3px rgba(200, 146, 42, 0.2) !important;
}
.nb-select { cursor: pointer; }
.nb-textarea { resize: vertical; min-height: 120px; }

.nb-form-success { background: #DCFCE7; border: 1px solid #86EFAC; color: #166534; padding: 14px 18px; border-radius: 12px; text-align: center; font-weight: 600; font-size: 0.92rem; }
.nb-form-error { background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; padding: 14px 18px; border-radius: 12px; text-align: center; font-weight: 600; font-size: 0.92rem; }

.nb-form-submit-wrap { display: flex; justify-content: center; margin-top: 10px; }
.nb-btn-gold {
  background: linear-gradient(135deg, #D49E35 0%, #C8922A 60%, #B07C1C 100%) !important;
  color: #FFFFFF !important;
  font-weight: 700;
  font-size: 1rem;
  padding: 16px 36px;
  border-radius: 12px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 20px rgba(200,146,42,0.35) !important;
  transition: all 0.25s ease;
}
.nb-btn-gold:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(200,146,42,0.45) !important; }

@media (min-width: 768px) {
  .nb-contact-cards-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .nb-form-row { grid-template-columns: 1fr 1fr; }
  .nb-section-header h2 { font-size: 2.7rem; }
  .nb-contact-form-card { padding: 44px 40px; }
}
</style>
