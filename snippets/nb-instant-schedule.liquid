{% comment %}
  NIAMAT BIRYANI — Automated Instant Delivery Schedule & Manual Override Engine
  Store Timings (IST - Asia/Kolkata):
  - Mon, Tue, Wed, Thu, Sat, Sun: 12:00 PM - 3:00 PM & 7:00 PM - 10:00 PM IST
  - Friday: ONLY 7:00 PM - 10:00 PM IST (Lunch closed)
  Modes:
  - 'auto' (Default): Automatically follow kitchen timings above
  - 'force_open': Override schedule to keep open/online anytime
  - 'force_closed': Override schedule to pause/close delivery anytime
{% endcomment %}

{% liquid
  # 1. Determine Mode from Section or Global Theme Settings
  assign current_mode = section.settings.instant_availability_mode
  if current_mode == blank
    assign current_mode = settings.nb_instant_delivery_mode | default: 'auto'
  endif

  # Master killswitch: if settings.nb_instant_delivery_enabled is explicitly false, force closed
  if settings.nb_instant_delivery_enabled == false
    assign current_mode = 'force_closed'
  endif

  # 2. Evaluate Operating Status
  assign is_instant_enabled = false

  if current_mode == 'force_open'
    assign is_instant_enabled = true
  elsif current_mode == 'force_closed'
    assign is_instant_enabled = false
  else
    # AUTO MODE: Calculate IST Opening Hours
    # In Shopify Liquid, 'now' uses store timezone (Asia/Kolkata)
    assign current_hour = 'now' | date: '%H' | plus: 0
    assign current_min = 'now' | date: '%M' | plus: 0
    assign current_day = 'now' | date: '%u' | plus: 0
    # %u: 1 = Mon, 2 = Tue, 3 = Wed, 4 = Thu, 5 = Fri, 6 = Sat, 7 = Sun
    assign total_mins = current_hour | times: 60 | plus: current_min

    # Lunch: 12:00 PM (720 min) to 3:00 PM (900 min)
    # Dinner: 7:00 PM (1140 min) to 10:00 PM (1320 min)
    if current_day == 5
      # Friday: Only Dinner 7 PM - 10 PM
      if total_mins >= 1140 and total_mins < 1320
        assign is_instant_enabled = true
      endif
    else
      # Other Days: Lunch 12 PM - 3 PM or Dinner 7 PM - 10 PM
      if total_mins >= 720 and total_mins < 900
        assign is_instant_enabled = true
      elsif total_mins >= 1140 and total_mins < 1320
        assign is_instant_enabled = true
      endif
    endif
  endif
%}
