{% comment %}
  NIAMAT BIRYANI — Zomato/Behrouz style horizontal food card
  Usage: {% render 'food-card-horizontal', product: product %}
{% endcomment %}

{% liquid
  assign is_preorder = true
  if force_instant == true
    assign is_preorder = false
  endif
  assign first_variant = product.selected_or_first_available_variant
  assign is_available = first_variant.available
  if product.tags contains 'sold-out' or product.tags contains 'soldout' or product.tags contains 'out-of-stock'
    assign is_available = false
  endif

  assign title_lower = product.title | downcase
  assign item_badge = ''
  assign badge_class = ''
  assign badge_icon = ''

  if title_lower contains 'hyderabadi mutton dum'
    assign item_badge = 'Popular'
    assign badge_class = 'nb-tag--popular'
    assign badge_icon = '🔥'
  elsif title_lower contains 'gosht-e-dum' or title_lower contains 'gosht e dum'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'hyderabadi murgh dum'
    assign item_badge = 'Popular'
    assign badge_class = 'nb-tag--popular'
    assign badge_icon = '🔥'
  elsif title_lower contains 'ustaadi murgh dum'
    assign item_badge = 'Classic'
    assign badge_class = 'nb-tag--chef'
    assign badge_icon = '👑'
  elsif title_lower contains 'zam-zam' or title_lower contains 'zam zam' or title_lower contains 'zamzam'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'nayaabi italiano'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'makhmali malai' or title_lower contains 'makhmali'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'banjara'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'boneless lazzat'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'lababdaar seekh'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'lazzat-e-tikka' or title_lower contains 'lazzat e tikka'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'alishaan'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'paneer'
    assign item_badge = 'Must try'
    assign badge_class = 'nb-tag--musttry'
    assign badge_icon = '⭐'
  elsif title_lower contains 'sabz tikka'
    assign item_badge = 'Bestseller'
    assign badge_class = 'nb-tag--bestseller'
    assign badge_icon = '🏆'
  elsif title_lower contains 'nawabi veg'
    assign item_badge = 'Classic'
    assign badge_class = 'nb-tag--chef'
    assign badge_icon = '👑'
  elsif title_lower contains 'nazaakat'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'dhan-e-shikori' or title_lower contains 'dhan e shikori'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  elsif title_lower contains 'sabziyon'
    assign item_badge = 'New'
    assign badge_class = 'nb-tag--new'
    assign badge_icon = '✨'
  endif
%}

<div class="nb-food-card {% if is_preorder %}nb-food-card--preorder{% endif %}">
  <div class="nb-diet-corner-badge" aria-hidden="true">
    {% render 'nb-diet-icon', product: product %}
  </div>
  <div class="nb-food-card__image">
    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 220, format: 'webp' }}"
        srcset="{{ product.featured_media | image_url: width: 140, format: 'webp' }} 140w, {{ product.featured_media | image_url: width: 220, format: 'webp' }} 220w"
        sizes="(max-width: 768px) 85px, 110px"
        alt="{{ product.featured_media.alt | default: product.title | escape }}"
        width="110"
        height="110"
        loading="{% if priority %}eager{% else %}lazy{% endif %}"
        {% if priority %}fetchpriority="high"{% endif %}
        decoding="async"
        style="aspect-ratio: 1 / 1;"
      >
    {%- else -%}
      <div class="nb-food-card__image-placeholder">🍛</div>
    {%- endif -%}
    {%- if item_badge != blank -%}
      <span class="nb-badge {{ badge_class }}">{{ badge_icon }} {{ item_badge }}</span>
    {%- elsif is_available == false -%}
      <span class="nb-badge nb-badge--soldout">Sold Out</span>
    {%- endif -%}
  </div>

  <div class="nb-food-card__body">
    <div class="nb-food-card__top">
      <h3 class="nb-food-card__title">{{ product.title }}</h3>
      {%- liquid
        assign item_desc = product.description | strip_html
        if item_desc == blank
          assign item_desc = product.content | strip_html
        endif
        if item_desc == blank and product.handle == 'chicken-tikka-biryani'
          assign item_desc = 'Chicken tikka tossed in smoky, aromatic rice with rich undertones of flavor.'
        endif
        if item_desc == blank and product.handle == 'chicken-tikka-boneless-biryani'
          assign item_desc = 'Boneless chicken tikka tossed in smoky, aromatic rice with rich undertones of flavor.'
        endif
      -%}
      {%- if item_desc != blank -%}
        <p class="nb-food-card__desc">{{ item_desc }}</p>
      {%- endif -%}
      <div class="nb-food-card__meta">
        {%- if is_preorder -%}
          <span class="nb-meta-tag">1:1 Portion (1Kg Meat + 1Kg Rice)</span>
        {%- else -%}
          <span class="nb-meta-tag">⚡ 45-60 mins</span>
        {%- endif -%}
      </div>
    </div>

    <div class="nb-food-card__bottom">
      <span class="nb-food-card__price">
        {%- if product.price_varies -%}
          From {{ product.price_min | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>

      {%- if is_preorder -%}
        <a href="/pages/family-orders" class="nb-btn nb-btn--outline">
          Pre-Order →
        </a>
      {%- elsif is_available -%}
        {%- if product.variants.size > 1 -%}
          <a href="/collections/instant-delivery" class="nb-btn nb-btn--gold">
            Choose →
          </a>
        {%- else -%}
          <form action="/cart/add" method="post" class="nb-quick-form">
            <input type="hidden" name="id" value="{{ first_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="nb-btn nb-btn--gold">Order Now</button>
          </form>
        {%- endif -%}
      {%- else -%}
        <button class="nb-btn nb-btn--disabled" disabled>Sold Out Today</button>
      {%- endif -%}
    </div>
  </div>
</div>
