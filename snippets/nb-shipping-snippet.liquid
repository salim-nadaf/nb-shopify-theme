{% comment %}
  NIAMAT BIRYANI — Shipping & Delivery Policy Page Snippet
{% endcomment %}

<div class="nb-shipping-page">
  <div class="nb-shipping-container">

    <!-- PAGE HEADER -->
    <div class="nb-shipping-header text-center">
      <span class="nb-shipping-badge">🚚 OFFICIAL POLICY</span>
      <h1 class="nb-shipping-title">Shipping & Delivery Policy</h1>
      <p class="nb-shipping-subtitle">
        Freshly cooked authentic Dum Biryani delivered hot, safe, and prompt to your doorstep across Kalyan and nearby areas.
      </p>
    </div>

    <!-- MAIN GRID -->
    <div class="nb-shipping-grid">

      <!-- SECTION 1: INSTANT DELIVERY -->
      <div class="nb-shipping-card">
        <div class="nb-shipping-card__icon">⚡</div>
        <div class="nb-shipping-card__content">
          <h2>1. Instant Delivery (Plate / Half Kg)</h2>
          <div class="nb-shipping-highlight">
            <span class="nb-clock-icon">⏱️</span>
            <strong>Delivery in 45–60 mins</strong>
          </div>
          <p>
            Our instant delivery menu features freshly prepared single plates, meal combos, starters, and desserts. Every portion is cooked fresh in dum batches to maintain authentic aroma and moisture.
          </p>
          <ul class="nb-shipping-list">
            <li><strong>Coverage:</strong> Available within an 8 km radius of our kitchen in Kalyan West.</li>
            <li><strong>Delivery Time:</strong> 45–60 minutes.</li>
            <li><strong>Zone 1 (0–5 km):</strong> Free delivery on orders above ₹799. Orders below ₹799 are charged ₹49 delivery fee. Hot biryani delivered within 5 km of our kitchen.</li>
            <li><strong>Zone 2 (5–8 km):</strong> ₹89 delivery charge · <strong>FREE Delivery on orders ₹1,299 and above</strong>.</li>
            <li><strong>Beyond 8 km:</strong> Delivery beyond 8 km is not available for Instant Delivery orders.</li>
          </ul>
        </div>
      </div>

      <!-- SECTION 2: FAMILY PRE-ORDERS -->
      <div class="nb-shipping-card">
        <div class="nb-shipping-card__icon">🥘</div>
        <div class="nb-shipping-card__content">
          <h2>2. Family Feast & Party Pre-Orders (1 Kg – 10 Kg Handis)</h2>
          <div class="nb-shipping-highlight">
            <span class="nb-clock-icon">📅</span>
            <strong>Advance Notice: Minimum 3 Hours (or Scheduled in Advance)</strong>
          </div>
          <p>
            For family dinners, celebrations, and corporate gatherings, our larger handi orders (1 Kg, 2 Kg, and up to 10+ Kg) are prepared slow-dum specifically for your event.
          </p>
          <ul class="nb-shipping-list">
            <li><strong>Advance Booking:</strong> Please place pre-orders at least 3 hours before your required meal time, or select your preferred date and time slot in advance.</li>
            <li><strong>Extended Service Area:</strong> Kalyan, Dombivli, Ulhasnagar, Ambernath, and nearby locations.</li>
            <li><strong>Scheduled Delivery:</strong> Dispatched right on time to arrive piping hot at your designated venue or home.</li>
          </ul>
        </div>
      </div>

      <!-- SECTION 3: OPERATING HOURS -->
      <div class="nb-shipping-card">
        <div class="nb-shipping-card__icon">🕒</div>
        <div class="nb-shipping-card__content">
          <h2>3. Operating & Delivery Hours</h2>
          <p>We accept and deliver orders during our official kitchen operational timings:</p>
          <div class="nb-hours-badge-wrap">
            <div class="nb-hours-box">
              <span class="nb-hours-label">Monday – Sunday</span>
              <span class="nb-hours-val">12:00 PM – 10:00 PM</span>
            </div>
            <div class="nb-hours-box">
              <span class="nb-hours-label">Friday Timings</span>
              <span class="nb-hours-val">04:00 PM – 10:00 PM</span>
            </div>
          </div>
          <p style="font-size: 0.85rem; color: #7A5C4A; margin-top: 10px;">
            Orders placed outside operational hours will be scheduled for the next immediate operational opening slot.
          </p>
        </div>
      </div>

      <!-- SECTION 4: PACKAGING & QUALITY -->
      <div class="nb-shipping-card">
        <div class="nb-shipping-card__icon">🛡️</div>
        <div class="nb-shipping-card__content">
          <h2>4. Packaging, Food Safety & Hygiene</h2>
          <p>
            We take food hygiene and presentation with utmost seriousness:
          </p>
          <ul class="nb-shipping-list">
            <li><strong>100% Halal Certified:</strong> All meat is strictly halal and procured from verified quality suppliers.</li>
            <li><strong>Tamper-Evident Packaging:</strong> Food is sealed in food-grade, leak-proof, temperature-insulated containers to ensure it arrives fresh and untouched.</li>
            <li><strong>Contactless Handover:</strong> Available upon request during checkout or delivery coordinator call.</li>
          </ul>
        </div>
      </div>

      <!-- SECTION 5: TRACKING & SUPPORT -->
      <div class="nb-shipping-card">
        <div class="nb-shipping-card__icon">💬</div>
        <div class="nb-shipping-card__content">
          <h2>5. Order Tracking & Customer Support</h2>
          <p>
            Have a question about your active delivery or need special delivery instructions? Our team is directly reachable:
          </p>
          <div class="nb-support-actions">
            <a href="https://wa.me/919167682582?text=Hi%20Biryani%20Palace%20by%20Niamat,%20I%20have%20an%20inquiry%20about%20my%20delivery." target="_blank" class="nb-btn-gold">
              <span>💬</span> WhatsApp Order Support
            </a>
            <a href="tel:+919167682582" class="nb-btn-dark">
              <span>📞</span> Call +91 91676 82582
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTTOM CTA BANNER -->
    <div class="nb-shipping-cta text-center">
      <h3>Ready to Taste Kalyan's Finest Biryani?</h3>
      <p>Order fresh instant delivery (45–60 mins) or plan your family feast today.</p>
      <div class="nb-cta-buttons">
        <a href="/collections/instant-delivery" class="nb-btn-gold nb-btn-lg">Explore Instant Menu (45–60 Mins) →</a>
        <a href="/pages/family-orders" class="nb-btn-dark nb-btn-lg">Plan Family Pre-Order →</a>
      </div>
    </div>

  </div>
</div>

