<style>
#nb-announcement-bar {
  background: linear-gradient(90deg, #160B07 0%, #2C1810 50%, #160B07 100%) !important;
  color: #FFFDF7 !important;
  border-bottom: 1px solid rgba(200, 146, 42, 0.4) !important;
  font-size: 0.85rem;
  font-weight: 600;
  height: 40px;
  overflow: hidden;
  position: relative !important;
  z-index: 10000 !important;
  display: flex !important;
  align-items: center;
  width: 100% !important;
  box-sizing: border-box;
}

.nb-announcement-track {
  display: flex;
  width: max-content;
  animation: nbMarqueeRotate 28s linear infinite;
}

#nb-announcement-bar:hover .nb-announcement-track {
  animation-play-state: paused;
}

.nb-announcement-content {
  display: flex;
  align-items: center;
  white-space: nowrap;
  gap: 20px;
  padding-right: 20px;
}

.nb-ann-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #FDF6EC;
}

.nb-ann-item strong {
  color: #F3C669 !important;
  font-weight: 700;
}

.nb-ann-icon {
  font-size: 0.95rem;
}

.nb-ann-divider {
  color: #C8922A;
  font-size: 0.9rem;
  opacity: 0.6;
}

@keyframes nbMarqueeRotate {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (max-width: 767px) {
  #nb-announcement-bar { font-size: 0.78rem; height: 34px; }
  .nb-announcement-track { animation-duration: 22s; }
}
</style>
