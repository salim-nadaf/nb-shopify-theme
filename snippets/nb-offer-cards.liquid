<script>
// ========================================================
// OFFER SELECTION & ADD-ON BATCH DISPATCH LOGIC
// ========================================================

function nbSwitchOfferTab(tier) {
  // Update Tab buttons
  var tabs = document.querySelectorAll('.nb-portion-tab');
  tabs.forEach(function(btn) {
    btn.classList.remove('active');
    btn.setAttribute('aria-selected', 'false');
  });
  var activeBtn = document.getElementById('nb-tab-btn-' + tier);
  if (activeBtn) {
    activeBtn.classList.add('active');
    activeBtn.setAttribute('aria-selected', 'true');
  }

  // Update Cards on mobile
  var cards = document.querySelectorAll('.nb-offer-card');
  cards.forEach(function(card) {
    card.classList.remove('active');
  });
  var targetCardId = tier === '199' ? 'offer-regular-199' : 'offer-trial-99';
  var activeCard = document.getElementById(targetCardId);
  if (activeCard) {
    activeCard.classList.add('active');
  }
}

function nbToggleAddonPanel(tier) {
  var content = document.getElementById('nb-addon-content-' + tier);
  var toggle = content ? content.previousElementSibling : null;
  if (content) {
    if (content.style.display === 'block') {
      content.style.display = 'none';
      if (toggle) toggle.classList.remove('open');
    } else {
      content.style.display = 'block';
      if (toggle) toggle.classList.add('open');
    }
  }
}

function nbUpdateOfferTotal(tier) {
  var basePrice = tier === '199' ? 199 : 99;
  var checkboxes = document.querySelectorAll('.nb-addon-cb[data-tier="' + tier + '"]:checked');
  var addonSum = 0;
  checkboxes.forEach(function(cb) {
    addonSum += parseInt(cb.dataset.price || '0', 10);
  });
  var total = basePrice + addonSum;
  var tagEl = document.getElementById('nb-price-tag-' + tier);
  if (tagEl) tagEl.textContent = '₹' + total;
}

async function nbSubmitOfferOrder(tier, mainVariantId, mainTitle, basePrice) {
  var btn = document.getElementById('nb-btn-submit-' + tier);
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.75';
  }

  // 1. Prepare main item
  var itemsToSubmit = [
    {
      id: parseInt(mainVariantId, 10),
      quantity: 1,
      properties: tier === '199' ? { '_offer': '₹199 Regular Portion', '_portion': 'Regular Portion', 'Free Sweet': '1x Gulab Jamun Included' } : { '_offer': '₹99 Small Portion', '_portion': 'Small Portion' }
    }
  ];

  // 2. Add selected add-ons
  var checkboxes = document.querySelectorAll('.nb-addon-cb[data-tier="' + tier + '"]:checked');
  checkboxes.forEach(function(cb) {
    var vId = parseInt(cb.dataset.variantId, 10);
    if (vId) {
      itemsToSubmit.push({
        id: vId,
        quantity: 1,
        properties: { '_addon_for': mainTitle }
      });
    }
  });

  try {
    var response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: itemsToSubmit })
    });

    if (!response.ok) {
      throw new Error('Failed to add items to cart');
    }

    // Open Cart Drawer
    if (typeof nbOpenDrawer === 'function') {
      nbOpenDrawer();
    } else {
      window.location.href = '/cart';
    }
  } catch (e) {
    console.error('Error adding offer to cart:', e);
    if (typeof nbShowToast === 'function') {
      nbShowToast('Unable to add offer to cart. Please try again.');
    } else {
      alert('Unable to add offer to cart. Please try again.');
    }
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }
}
</script>
