  border-radius: 12px !important;
  border: none !important;
  cursor: pointer !important;
  box-shadow: 0 6px 20px rgba(200,146,42,0.35), inset 0 1px 0 rgba(255,255,255,0.3) !important;
  transition: all 0.25s ease !important;
  margin-top: 10px;
}

.nb-submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(200,146,42,0.45) !important;
}

.nb-whatsapp-divider {
  display: flex;
  align-items: center;
  text-align: center;
  margin: 28px 0 18px;
  color: #8C6A54;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1px;
}

.nb-whatsapp-divider::before,
.nb-whatsapp-divider::after {
  content: '';
  flex: 1;
  border-bottom: 1px solid rgba(200, 146, 42, 0.25);
}

.nb-whatsapp-divider span {
  padding: 0 12px;
}

.nb-whatsapp-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  background: #25D366 !important;
  color: #FFFFFF !important;
  font-weight: 700;
  font-size: 0.98rem;
  padding: 14px 24px;
  border-radius: 12px;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.nb-whatsapp-btn:hover {
  background: #20BA5A !important;
  transform: translateY(-2px);
}

.nb-form-success {
  text-align: center;
  padding: 30px 20px;
}

.nb-success-icon {
  font-size: 3rem;
  display: block;
  margin-bottom: 12px;
}

.nb-form-success h3 {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 1.6rem;
  color: #2C1810;
