}

.nb-form-group {
  margin-bottom: 20px;
}

.nb-form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media (min-width: 600px) {
  .nb-form-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.nb-preorder-card label {
  display: block;
  font-size: 0.82rem;
  font-weight: 700;
  color: #2C1810 !important;
  text-transform: uppercase;
