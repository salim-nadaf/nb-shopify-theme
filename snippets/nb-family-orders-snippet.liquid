  display: inline-block;
  background: linear-gradient(135deg, #2C1810 0%, #1E100A 100%);
  color: #F3C669 !important;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 1px;
  padding: 4px 12px;
  border-radius: 12px;
  margin-bottom: 12px;
}

