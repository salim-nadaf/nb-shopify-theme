{% comment %}
  NIAMAT BIRYANI — Family Orders Page Snippet & Luxury Pre-Order Form
{% endcomment %}

<div class="nb-family-orders-container">
  <div class="nb-family-orders-header">
    <span class="nb-pill-badge">👑 FAMILY ORDERS</span>
    <h1>Family Orders</h1>
    <p class="nb-family-sub">
      Place a Family Order with Biryani Palace by Niamat. Fill in the form below to submit your pre-order details. Our team will contact you on WhatsApp or phone to confirm availability, delivery charges, and timing.
    </p>
    
    <div class="nb-notice-box">
      <span>⏰ Minimum 3-hour advance notice required for pre-orders.</span>
      <span>🚚 Delivery within Kalyan, Ulhasnagar, Dombivli, Ambernath & nearby areas confirmed upon order placement.</span>
    </div>
  </div>

  <!-- LUXURY CENTERED PRE-ORDER FORM CARD -->
  <div class="nb-preorder-card">
    <div class="nb-card-badge">✨ PRE-ORDER FORM</div>
    <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2.1rem; color: #2C1810; margin-bottom: 6px; text-align: center;">Pre-Order</h2>
    <p class="nb-card-subtitle" style="text-align: center; color: #7A5C4A; font-size: 0.96rem; margin-bottom: 24px;">Complete the form to place your order.</p>

    <!-- NATIVE CUSTOM PRE-ORDER FORM (RECORDS 100% IN SHOPIFY ADMIN -> CUSTOMERS & SUBMISSIONS) -->
    <div id="nb-family-form-container">
      {% form 'contact', id: 'nb-family-preorder-form', action: '/contact#nb-family-preorder-form' %}
        <input type="hidden" name="contact[body]" id="nb-family-body-hidden" value="Family Pre-Order Request" />
        
        {% if form.posted_successfully? %}
          <div class="nb-form-success" style="padding: 36px 20px; text-align: center; background: linear-gradient(145deg, #FFFDF7 0%, #F5ECD7 100%); border: 2px solid #C8922A; border-radius: 20px; box-shadow: 0 10px 30px rgba(44, 24, 16, 0.1);">
            <span class="nb-success-icon" style="font-size: 3.5rem; display: block; margin-bottom: 12px;">🎉</span>
            <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; color: #2C1810; margin-bottom: 10px;">Pre-Order Request Received!</h3>
            <p style="font-size: 1.02rem; color: #5C4033; max-width: 540px; margin: 0 auto 20px; line-height: 1.6;">
              Thank you! Your pre-order details have been successfully registered and saved in our system. Salim Nadaf & the Niamat Biryani team will review your order and contact you shortly via WhatsApp or Phone to confirm delivery.
            </p>
            <a href="https://wa.me/919920042456?text=Hi%20Niamat%20Biryani!%20I%20just%20submitted%20a%20Family%20Pre-Order%20Request%20on%20your%20website.%20Please%20confirm%20my%20order." target="_blank" rel="noopener" class="nb-whatsapp-btn" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 380px; margin: 0 auto; background: #25D366; color: #fff; font-weight: 700; padding: 15px 24px; border-radius: 12px; text-decoration: none; box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);">
              <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              Confirm & Chat on WhatsApp →
            </a>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="nb-form-error" style="margin-bottom: 20px; padding: 12px 18px; background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; border-radius: 12px; text-align: center;">
              <p style="margin: 0; font-weight: 600;">Please fix the required fields below to submit your pre-order.</p>
            </div>
          {% endif %}

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <input type="text" id="nb-name" name="contact[Name]" placeholder="Name" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <input type="email" id="nb-email" name="contact[email]" placeholder="Email" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <input type="tel" id="nb-phone" name="contact[WhatsApp Number]" placeholder="WhatsApp Number" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <textarea id="nb-address" name="contact[Complete Address]" rows="3" placeholder="Complete Address" required class="nb-input nb-textarea"></textarea>
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <input type="text" id="nb-pincode" name="contact[PIN Code]" placeholder="PIN Code" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <input type="text" id="nb-item-name" name="contact[Item Name]" placeholder="Item Name" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 16px;">
            <label for="nb-date" style="display: block; font-size: 0.84rem; font-weight: 700; color: #2C1810; margin-bottom: 6px;">Preferred Delivery Date</label>
            <input type="date" id="nb-date" name="contact[Preferred Delivery Date]" required class="nb-input" />
          </div>

          <div class="nb-form-group" style="margin-bottom: 24px;">
            <input type="text" id="nb-time" name="contact[Preferred Delivery Time]" placeholder="Preferred Delivery Time" required class="nb-input" />
          </div>

          <button type="submit" id="nb-family-submit-btn" class="nb-submit-btn" style="width: 100%; padding: 16px; font-size: 1.05rem; font-weight: 800; background: linear-gradient(135deg, #2C1810 0%, #1A0D08 100%); color: #F3C669; border: 1px solid #C8922A; border-radius: 12px; cursor: pointer; transition: all 0.25s ease; letter-spacing: 0.5px;">
            Submit Order Request
          </button>

          <p class="nb-form-footer-notice" style="margin-top: 18px; font-size: 0.82rem; color: #7A5C4A; text-align: center; line-height: 1.5; font-style: italic;">
            Family Orders require a minimum 3-hour advance notice. Delivery within Kalyan is FREE. Delivery charges for locations outside Kalyan (Ulhasnagar, Dombivli, Ambernath, etc.) are calculated based on your delivery location and will be confirmed before payment.
          </p>
        {% endif %}
      {% endform %}
    </div>

    <script>
      (function initFamilyFormSubmit() {
        var form = document.getElementById('nb-family-preorder-form');
        if (form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();

            var name = document.getElementById('nb-name') ? document.getElementById('nb-name').value.trim() : '';
            var phone = document.getElementById('nb-phone') ? document.getElementById('nb-phone').value.trim() : '';
            var emailEl = document.getElementById('nb-email');
            var email = emailEl ? emailEl.value.trim() : '';
            var address = document.getElementById('nb-address') ? document.getElementById('nb-address').value.trim() : '';
            var pincode = document.getElementById('nb-pincode') ? document.getElementById('nb-pincode').value.trim() : '';
            var itemName = document.getElementById('nb-item-name') ? document.getElementById('nb-item-name').value.trim() : '';
            var date = document.getElementById('nb-date') ? document.getElementById('nb-date').value : '';
            var time = document.getElementById('nb-time') ? document.getElementById('nb-time').value.trim() : '';

            var bodyHidden = document.getElementById('nb-family-body-hidden');
            if (bodyHidden) {
              bodyHidden.value = [
                '=== FAMILY PRE-ORDER DETAILS ===',
                'Name: ' + name,
                'Email: ' + email,
                'WhatsApp Number: ' + phone,
                'Complete Address: ' + address,
                'PIN Code: ' + pincode,
                'Item Name: ' + itemName,
                'Preferred Delivery Date: ' + date,
                'Preferred Delivery Time: ' + time
              ].join('\n');
            }

            var btn = document.getElementById('nb-family-submit-btn');
            if (btn) {
              btn.disabled = true;
              btn.innerText = 'Submitting Request...';
            }

            var formData = new FormData(form);

            fetch('/contact', {
              method: 'POST',
              body: formData
            }).then(function() {
              var container = document.getElementById('nb-family-form-container');
              var waMsg = encodeURIComponent(
                "Hi Niamat Biryani! I just submitted a Pre-Order Request on your website:\n" +
                "• Name: " + name + "\n" +
                "• Phone: " + phone + "\n" +
                "• Item: " + itemName + "\n" +
                "• Date: " + date + " (" + time + ")\n" +
                "• Address: " + address + " (PIN: " + pincode + ")"
              );
              if (container) {
                container.innerHTML = [
                  '<div class="nb-form-success" style="padding: 36px 20px; text-align: center; background: linear-gradient(145deg, #FFFDF7 0%, #F5ECD7 100%); border: 2px solid #C8922A; border-radius: 20px; box-shadow: 0 10px 30px rgba(44, 24, 16, 0.1);">',
                    '<span class="nb-success-icon" style="font-size: 3.5rem; display: block; margin-bottom: 12px;">🎉</span>',
                    '<h3 style="font-family: \'Playfair Display\', Georgia, serif; font-size: 2rem; color: #2C1810; margin-bottom: 10px;">Pre-Order Request Received!</h3>',
                    '<p style="font-size: 1.02rem; color: #5C4033; max-width: 540px; margin: 0 auto 20px; line-height: 1.6;">',
                      'Thank you, ' + name + '! Your pre-order details have been successfully registered and saved in our system. Salim Nadaf & the Niamat Biryani team will review your order and contact you shortly.',
                    '</p>',
                    '<a href="https://wa.me/919920042456?text=' + waMsg + '" target="_blank" rel="noopener" class="nb-whatsapp-btn" style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 380px; margin: 0 auto; background: #25D366; color: #fff; font-weight: 700; padding: 15px 24px; border-radius: 12px; text-decoration: none; box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);">',
                      '<svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>',
                      'Confirm & Chat on WhatsApp →',
                    '</a>',
                  '</div>'
                ].join('');
              }
            }).catch(function() {
              form.submit();
            });
          });
        }
      })();
    </script>

    <!-- WHATSAPP FAST OPTION -->
    <div class="nb-whatsapp-divider">
      <span>OR ORDER INSTANTLY VIA WHATSAPP</span>
    </div>
    <a href="https://wa.me/919920042456?text=Hi%20Niamat%20Biryani!%20I%20want%20to%20place%20a%20Family%20Order%20for%20pre-order." target="_blank" rel="noopener" class="nb-whatsapp-btn">
      <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
      Quick Pre-Order on WhatsApp
    </a>
  </div>

  <!-- EMBEDDED SHOPIFY FORMS APP & APP BLOCKS CONTAINER -->
  <div class="nb-page-app-content">
    {% content_for 'blocks' %}
    {% if page.content != blank %}
      <div class="nb-embedded-app-card">
        {{ page.content }}
      </div>
    {% endif %}
  </div>
</div>

<style>
.nb-page-app-content h1,
.nb-page-app-content .page-title,
.nb-page-app-content .main-page-title {
  display: none !important;
}

.nb-embedded-app-card {
  width: 100%;
  max-width: 720px;
  margin: 20px auto 40px;
  box-sizing: border-box;
}
.nb-family-orders-container {
  max-width: 820px;
  margin: 0 auto;
  padding: 40px 16px 80px;
  text-align: center;
  box-sizing: border-box;
}

.nb-family-orders-header {
  margin-bottom: 36px;
}

.nb-pill-badge {
  display: inline-block;
  background: rgba(200, 146, 42, 0.12);
  color: #C8922A !important;
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 1px;
  padding: 6px 16px;
  border-radius: 20px;
  margin-bottom: 12px;
  border: 1px solid rgba(200, 146, 42, 0.3);
}

.nb-family-orders-header h1 {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 2.6rem !important;
  font-weight: 800 !important;
  color: #2C1810 !important;
  margin: 0 0 16px;
}

.nb-family-sub {
  font-size: 1.02rem;
  color: #5C4033 !important;
  line-height: 1.6;
  max-width: 720px;
  margin: 0 auto 24px;
}

.nb-notice-box {
  background: #FFFDF7;
  border: 1px dashed rgba(200, 146, 42, 0.4);
  border-radius: 14px;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.88rem;
  color: #7A5C4A;
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}

.nb-preorder-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFDF7 60%, #FDF5E6 100%) !important;
  border: 1px solid rgba(200, 146, 42, 0.32) !important;
  border-top: 5px solid #C8922A !important;
  border-radius: 24px !important;
  padding: 42px 36px !important;
  box-shadow: 0 16px 40px -10px rgba(44, 24, 16, 0.12), 0 4px 12px rgba(200, 146, 42, 0.08) !important;
  margin: 0 auto 40px !important;
